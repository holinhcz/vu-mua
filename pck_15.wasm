"dau_xanh":1,"bap":1,"nep":1,"khoai":1,"la_dua":1,"me":1,"dauphong":1,"dau_nanh":1,"bido":1,"mia":1,"sua":1,"sua_de":1,"nuoc_cot":1,"duong":1,"mat_mia":1,"bot_nep":1,"bot_gao":1,"bot_bap":1,"duahau":1,"dau":1}},"Tạp hóa":{"c":{"muoihot":1,"duong":1,"rang":1,"say":1,"btrang":1,"muoidua":1,"bot":1,"trung":1,"sua":1,"nuoc":1,"cha":1,"banh":1,"banhque":1,"trai":1,"khac":1},"i":{"gao":1}},"Quán phở":{"c":{},"i":{"thit_bo":1,"thit_ga":1,"thit":1,"suon":1,"hanh":1,"hanh_tay":1,"gung":1,"ot":1,"rau_ram":1,"xa_lach":1,"tieu":1,"sa":1,"bot_gao":1,"gao":1,"bo_vien":1,"cha_lua":1,"tuong_ot":1,"muoi_hot":1,"duong":1}},"Trường học":{"c":{"sua":1,"trung":1,"che":1,"banhque":1},"i":{"thit_ga":1,"thit":1,"thit_bo":1,"rau_muong":1,"cai":1,"carot":1,"bido":1,"khoai":1,"cachua":1,"dua_leo":1,"xa_lach":1,"gao":1,"bong_lan":1,"banh":1,"kem":1,"sua_chua_de":1,"sua_bap":1,"sua_dau_nanh":1,"sua_dau_xanh":1,"nuoc_cam":1,"sinh_to":1,"st_thanhlong":1,"nuoc_duahau":1,"chuoi_say":1,"khoai_say":1,"duahau":1,"dau":1,"cha_bong":1}},"Nhà hàng":{"c":{"mon":1,"thit":1,"ca":1,"rau":1,"gvi":1,"cha":1,"muoidua":1,"nuoc":1,"che":1,"trung":1,"sua":1},"i":{"gao":1,"banh_trang":1,"goi_cuon":1,"bo_bia":1,"bt_tron":1,"bt_chabong":1,"banh_mi_thit":1,"banh_mi_cha":1,"kem":1,"banh_flan":1}},"Tiệm may":{"c":{"soi":1,"vai":1},"i":{}},"Vựa lúa":{"c":{"hat":1},"i":{"gao":1}},"Quầy rau":{"c":{"rau":1,"gvi":1,"traic":1,"trai":1},"i":{"bap":1}},"Tiệm bánh":{"c":{"bot":1,"trung":1,"sua":1},"i":{"duong":1,"mat_mia":1,"nuoc_cot":1,"me":1,"dau_xanh":1,"dauphong":1,"bido":1,"khoai":1,"la_dua":1,"nep":1,"pho_mai_de":1,"cha_bong":1,"dau":1,"mut_dau":1}}}␀␀␀␀␀␀␀␀["Chè đây! Chè ba màu đây!","Ai ăn chè đậu đỏ hông?","Chè chuối nước cốt dừa nè!","Leng keng... chè đây bà con ơi!"]␀␀␀␀␀␀␀␀␀␀␀␀["Rau tươi đây bà con ơi!","Ghé coi đi cô chú ơi!","Hàng nhà vườn nè!","Mua giùm em nha!","Trứng gà ta mới lượm nè!","Rẻ mà ngon nè!"]␀␀␀␀␀␀␀␀␀␀␀[["Nghe nói mai thương lái về thu mua {m}, giá lên.",1.3],["Mai có ghe ở Sa Đéc ghé mua {m} giá cao.",1.3],["Bên chợ huyện đang thiếu {m}, mai giá lên.",1.3],["Mai ghe {m} từ Long An về đông, coi chừng rớt giá.",0.75],["Nghe nói nhà vườn xóm trên được mùa {m}, mai rớt giá.",0.75],["Chợ huyện đang dư {m}, mai giá xuống.",0.75]]␀␀␀␀␀␀␀␀␀␀␀␀["Ông Sáu kể hồi xưa đêm nào cũng thấy lửa ma trơi ở gò mả đầu làng, ai đi theo là lạc tới sáng.","Bà Năm nói đó là hồn mấy người chôn hũ bạc bỏ quên, ai có phước thì được chỉ chỗ.","Tụi nhỏ trong xóm đồn ma trơi sợ tiếng chó sủa, nên chó Vện sủa là nó biến mất.","Chú Bảy bảo thật ra là khí đầm lầy bốc cháy, nhưng nói vậy chứ đêm tối vẫn không dám đi một mình."]␀␀␀␀["bầy gà","bầy vịt","con heo nái","con bò","bầy dê","con trâu"]␀␀␀␀[{"c":"A","t":"{A} đi câu từ sáng tới trưa, được đúng con cá rô bằng ba ngón tay."},{"c":"A","t":"{A} phơi lúa ngoài sân, mưa ập tới cả xóm chạy ra hốt phụ."},{"c":"A","t":"Con chó nhà {A} tha mất chiếc dép, cả nhà lục tung vườn mới thấy."},{"c":"A","t":"{A} trồng thử luống {cay} mới, khoe với ai đi ngang cũng chỉ cho coi."},{"c":"A","t":"Nhà {A} nấu nồi {mon} thơm lừng, mùi bay qua tới mấy nhà bên."},{"c":"A","t":"{A} ngồi vá lưới trước hiên từ chiều tới tối mịt."},{"c":"A","t":"Tụi nhỏ nhà {A} trèo cây ổi, té một cái nhưng phủi đít đứng dậy cười."},{"c":"A","t":"{A} sửa lại cái chái bếp, đóng đinh cốc cốc nguyên buổi."},{"c":"A","t":"{A} đi chợ về mua được con cá lóc to, khoe cả xóm."},{"c":"A","t":"{A} mất ngủ, ra ngồi uống trà dưới gốc dừa tới khuya."},{"c":"A","t":"Nhà {A} mới sơn lại cánh cửa màu xanh, ai đi ngang cũng ngó."},{"c":"A","t":"{A} đi đám xóm trên về kể chuyện ăn uống quá trời."},{"c":"A","t":"Con gà mái nhà {A} đẻ trứng hai lòng đỏ, cả nhà lấy làm lạ."},{"c":"A","t":"{A} tập đờn kìm, cả xóm nghe bài vọng cổ hơi bị lạc dây."},{"c":"A","t":"Đêm qua chuột cắn bao lúa nhà {A}, sáng ra lúa vương đầy sân."},{"c":"A","t":"{A} dẫn tụi nhỏ ra mương tắm, tiếng cười rộn cả khúc sông."},{"c":"A","t":"{A} đan xong cái rổ tre, nói để dành đựng trái cây cúng rằm."},{"c":"A","t":"{A} lên tỉnh khám răng, về tới nhà còn ôm má."},{"c":"A","t":"Nhà {A} có khách dưới quê lên chơi, nhà cửa rộn ràng cả ngày."},{"c":"A","t":"{A} kể chuyện ma cây gáo, tụi nhỏ trong xóm sợ không dám ra sau hè."},{"c":"A","t":"{A} bắt được con rắn nước trong bờ đìa, cả xóm bu lại coi."},{"c":"A","t":"{A} đổi cái nồi đồng cũ lấy bộ chén mới của ghe hàng."},{"c":"A","t":"Con mèo nhà {A} đẻ một ổ bốn con, đứa nào cũng đòi xin."},{"c":"A","t":"{A} thức sớm quét sân, quét luôn khúc đường trước ngõ."},{"c":"A","t":"Nhà {A} cúng rằm, bày mâm trái cây đẹp như tranh."},{"c":"A","t":"Cây mai trước ngõ nhà {A} trổ bông lác đác, ai cũng khen.","s":[0]},{"c":"A","t":"{A} đặt lờ dưới mương, sáng ra được mớ tép đem kho."},{"c":"A","t":"{A} trúng số an ủi, khao cả nhà nồi chè đậu."},{"c":"A","t":"Nhà {A} cất thêm cái chuồng mới cho {con}."},{"c":"A","t":"{A} ngồi chẻ lạt tre, nói mai mốt bó chả cho đám giỗ."},{"c":"A","tp":"vui","t":"{A} nhậu tới khuya, sáng ngủ quên trễ giờ ra đồng."},{"c":"A","tp":"vui","t":"{A} rủ cả xóm ra bờ sông hát karaoke, vui tới nửa đêm."},{"c":"A","tp":"vui","t":"{A} bày trò đá gà kiểng ngoài sân, thua một chầu cà phê."},{"c":"A","tp":"vui","t":"{A} mới mua cái loa kẹo kéo, mở nhạc bolero cả ngày."},{"c":"A","tp":"kho","t":"{A} cự thằng nhỏ thả trâu ăn lúa nguyên buổi sáng."},{"c":"A","tp":"kho","t":"{A} chê nồi canh chua của chợ thiếu me, đòi nấu lại."},{"c":"A","tp":"kho","t":"{A} rào lại cái ngõ, cấm tụi nhỏ đi tắt qua vườn."},{"c":"A","tp":"kho","t":"{A} đòi bên ghe hàng bớt tiền vì bó rau héo."},{"c":"A","tp":"tk","t":"{A} mặc cả với ghe hàng tới nửa buổi, bớt được hai trăm."},{"c":"A","tp":"tk","t":"{A} gom vỏ dừa khô về để dành nhóm bếp cả tháng."},{"c":"A","tp":"tk","t":"{A} vá lại cái áo cũ lần thứ ba, nói còn mặc tốt chán."},{"c":"A","tp":"tk","t":"{A} bỏ ống heo được nửa năm, đập ra đếm cả buổi."},{"c":"A","tp":"cham","t":"{A} ra đồng từ lúc gà chưa gáy, tối mịt mới về."},{"c":"A","tp":"cham","t":"{A} cuốc xong nguyên công đất trong một buổi sáng."},{"c":"A","tp":"cham","t":"{A} vừa gặt xong lúa đã lo cày ải cho vụ sau."},{"c":"A","tp":"cham","t":"{A} tranh thủ trưa nắng đan thêm mấy cái giỏ đem bán."},{"c":"A","tp":"hien","t":"{A} đem nồi cháo qua cho bà cụ neo đơn đầu xóm."},{"c":"A","tp":"hien","t":"{A} cho tụi nhỏ trong xóm hái ổi nhà mình ăn thoải mái."},{"c":"A","tp":"hien","t":"{A} lượm được cái ví rớt ngoài đường, đem lên ấp trả lại."},{"c":"A","tp":"hien","t":"{A} nhường chỗ phơi lúa cho nhà bên vì sân nhà họ ngập."},{"c":"A","tp":"sd","t":"{A} mới sắm bộ bàn ghế gỗ, mời cả xóm qua uống trà coi."},{"c":"A","tp":"sd","t":"{A} mặc áo dài khăn đóng đi chợ, ai hỏi cũng nói đi việc lớn."},{"c":"A","tp":"sd","t":"{A} treo bằng khen của con lên giữa nhà, ai tới cũng chỉ."},{"c":"A","tp":"sd","t":"{A} cúng đình mâm xôi gà to nhất xóm."},{"c":"AB","t":"{A} với {B} cãi nhau vì con mương ranh đất, ai cũng nói mình đúng.","a":{"l":"Qua khuyên giải","th":10,"tb":10,"ut":2,"m":"Bạn qua phân trần, hai nhà dịu lại, bắt tay làm hòa."}},{"c":"AB","t":"Gà nhà {A} qua bới nát luống rau nhà {B}, hai nhà to tiếng.","a":{"l":"Qua khuyên giải","th":10,"tb":10,"ut":2,"m":"Bạn đứng giữa nói đỡ, {A} chịu đền bó rau, chuyện êm."}},{"c":"AB","t":"{A} cho {B} mượn chiếc xuồng đi chợ, tới chiều chưa thấy trả."},{"c":"AB","t":"{A} với {B} ngồi đánh cờ tướng dưới gốc me, thua thắng cãi rân."},{"c":"AB","t":"{A} qua phụ {B} lợp lại mái nhà trước mùa mưa.","a":{"l":"Qua phụ một tay","xu":0,"th":15,"tb":15,"m":"Bạn leo lên phụ lợp, ba người làm nhanh hơn hẳn."}},{"c":"AB","t":"Nhà {A} với nhà {B} góp gạo nấu nồi cơm chung đãi thợ."},{"c":"AB","t":"{A} hỏi mượn {B} cái cối xay bột, hứa mai trả."},{"c":"AB","t":"{A} với {B} hùn tiền mua con heo giống về nuôi chung."},{"c":"AB","t":"Tụi nhỏ nhà {A} và nhà {B} giành nhau con diều, khóc bù lu.","a":{"l":"Làm thêm con diều","xu":60,"th":15,"tb":15,"m":"Bạn làm thêm con diều, tụi nhỏ mỗi đứa một con, hết giành."}},{"c":"AB","t":"{A} đi ngang nghe {B} than nhà hết gạo.","a":{"l":"Đem gạo qua","it":["gao",2],"tb":25,"ut":2,"m":"Bạn đem gạo qua, {B} cảm động cảm ơn hoài."}},{"c":"AB","t":"{A} kể {B} vừa trúng mùa {cay}, ai nghe cũng mừng lây."},{"c":"AB","t":"{A} với {B} rủ nhau đi xem hát bội ở chợ quận."},{"c":"AB","t":"{A} nói xấu {B} sau lưng, chuyện tới tai cả xóm.","a":{"l":"Nói giùm một câu","th":-5,"tb":20,"m":"Bạn lên tiếng bênh {B}, {A} hơi phật ý nhưng xóm thấy bạn phải."}},{"c":"AB","t":"Trâu nhà {A} sổng chuồng chạy qua ruộng {B}.","a":{"l":"Phụ bắt trâu","th":15,"tb":10,"m":"Bạn chạy phụ lùa trâu về, lúa nhà {B} bớt dập."}},{"c":"AB","t":"{A} đem biếu {B} buồng chuối chín cây."},{"c":"AB","t":"{A} với {B} cá cược coi ai câu được nhiều cá hơn, rốt cuộc huề."},{"c":"sui","t":"Hai nhà sui {A} và {B} qua lại biếu nhau mâm bánh."},{"c":"sui","t":"Sui gia {A} với {B} giận nhau vì chuyện đám giỗ mời trễ.","a":{"l":"Qua nói giùm","th":15,"tb":15,"ut":3,"m":"Bạn nói vô vài câu, hai nhà sui cười xòa bỏ qua."}},{"c":"sui","t":"Nhà sui {B} lên thăm {A}, đem theo giỏ trái cây miệt vườn."},{"c":"sui","t":"{A} với sui gia {B} hẹn nhau đi chùa đầu tháng."},{"c":"ae","t":"Anh em họ {A} và {B} họp mặt bàn chuyện sửa mả ông bà."},{"c":"ae","t":"{A} và {B} chung họ mà giành nhau miếng đất hương hỏa.","a":{"l":"Qua hòa giải","th":10,"tb":10,"ut":4,"m":"Bạn khuyên chia đôi lo hương khói chung, hai nhà nghe theo."}},{"c":"ae","t":"Cả họ {A} kéo qua nhà {B} ăn mừng cháu đầu lòng."},{"c":"ae","t":"{A} dẫn đám con cháu trong họ qua nhà {B} học đờn."},{"c":"A","t":"Heo nhà {A} đẻ một bầy {so} con, ai cũng qua coi.","a":{"l":"Qua mừng","xu":50,"th":20,"m":"Bạn đem chút quà qua mừng, {A} vui lắm."}},{"c":"A","t":"Nhà {A} mới cất xong căn bếp, mời bà con qua ăn tân gia.","a":{"l":"Qua ăn tân gia","xu":100,"th":25,"m":"Bạn bỏ phong bì mừng tân gia, {A} quý lắm."}},{"c":"A","t":"Con nhà {A} đậu đại học trên thành phố, cả xóm mừng.","a":{"l":"Qua chúc mừng","xu":100,"th":25,"ut":1,"m":"Bạn qua chúc mừng, cho đứa nhỏ chút tiền xe."}},{"c":"A","t":"{A} bị trặc chân lúc gánh lúa, nằm nhà mấy bữa.","a":{"l":"Qua thăm","it":["trung",3],"th":25,"m":"Bạn đem mấy trứng gà qua thăm, {A} cảm động lắm."}},{"c":"A","t":"Nhà {A} thiếu người gặt, lúa chín rục ngoài đồng.","a":{"l":"Qua phụ gặt","th":25,"ut":2,"m":"Bạn ra phụ gặt nguyên buổi, lúa vô bồ kịp."}},{"c":"A","t":"Bà cụ nhà {A} tròn tám mươi, con cháu làm mâm mừng thọ.","a":{"l":"Qua mừng thọ","xu":80,"th":25,"m":"Bạn qua mừng thọ bà cụ, được mời ở lại ăn cơm."}},{"c":"A","t":"Nhà {A} hết củi nấu cơm mà trời mưa dầm.","a":{"l":"Đem củi qua","it":["cui",3],"th":20,"m":"Bạn đem củi khô qua, nồi cơm nhà {A} kịp chín."}},{"c":"A","t":"{A} sắp đi xa làm ăn, nhờ người coi nhà giùm mấy bữa.","a":{"l":"Nhận coi giùm","th":20,"m":"Bạn nhận coi nhà giùm, {A} yên tâm lên đường."}},{"c":"A","t":"Đứa nhỏ nhà {A} sốt cả đêm, nhà lo cuống lên.","a":{"l":"Chở đi trạm","xu":40,"th":25,"ut":1,"m":"Bạn chở đứa nhỏ đi trạm, sáng ra hạ sốt."}},{"c":"A","t":"{A} làm mâm cỗ cúng tạ đất, mời hàng xóm ở lại ăn.","a":{"l":"Ghé dự","th":15,"m":"Bạn ghé dự, ăn no mà ngồi nghe chuyện tới tối."}},{"c":"A","t":"{A} tậu được chiếc ghe mới, làm lễ hạ thủy ở bến.","a":{"l":"Qua mừng","xu":60,"th":20,"m":"Bạn qua mừng ghe mới, {A} chở một vòng vàm sông."}},{"c":"","s":[0],"t":"Mùa xuân, cả xóm rủ nhau dọn mả ông bà, cắm nhang khói nghi ngút."},{"c":"A","s":[0],"t":"{A} lặt lá mai cho kịp Tết, cả nhà ngồi lặt tới tối."},{"c":"A","s":[0],"t":"Nhà {A} gói bánh tét, nồi bánh luộc cả đêm, tụi nhỏ ngồi canh lửa."},{"c":"","s":[0],"t":"Hoa đào hoa mai nở rộ dọc đường làng, ai đi ngang cũng chụp hình."},{"c":"","s":[1],"t":"Mưa đầu mùa, cả xóm ra hứng nước mưa đổ lu đổ khạp."},{"c":"A","s":[1],"t":"Mưa xuống, ếch nhái kêu inh ỏi, {A} đi soi ếch được cả giỏ."},{"c":"","s":[1],"t":"Gió mùa về, tụi nhỏ trong xóm thả diều kín trời chiều."},{"c":"A","s":[1],"t":"{A} đội nón lá ra đồng cấy, mưa lâm râm cả buổi."},{"c":"","s":[2],"t":"Nước nổi tràn đồng, xóm dưới đi giăng lưới cá linh."},{"c":"A","s":[2],"t":"Bông điên điển nở vàng mương, {A} hái về nấu canh chua."},{"c":"A","s":[2],"t":"Nước lên tới mé sân nhà {A}, cả nhà kê đồ lên cao."},{"c":"","s":[2],"t":"Trăng rằm tháng Tám sáng vằng vặc, tụi nhỏ rước đèn khắp xóm."},{"c":"","s":[3],"t":"Nắng hạn, giếng làng cạn, bà con xếp hàng gánh nước từ sáng sớm."},{"c":"A","s":[3],"t":"{A} ngồi canh lúa phơi ngoài sân, nắng chang chang tới trưa."},{"c":"","s":[3],"t":"Nước mặn lấn vô kênh, xóm dưới lo trữ nước ngọt trong lu."},{"c":"A","s":[3],"t":"Ruộng khô nứt nẻ, {A} tát nước từ mương lên tưới cả buổi."},{"c":"","s":[3],"t":"Mùa khô, cả xóm rủ nhau tát đìa bắt cá lóc, cá trê."},{"c":"","t":"Ghe hàng bông từ chợ nổi ghé bến, cả xóm ra mua bán rộn ràng."},{"c":"","t":"Đêm qua cúp điện, cả xóm thắp đèn dầu ngồi kể chuyện xưa."},{"c":"","t":"Có gánh hát lô tô ghé ngã ba, xóm kéo nhau ra coi tới khuya."},{"c":"","t":"Ông thầy thuốc nam đi ngang, bà con ra hỏi thuốc nhức mỏi."},{"c":"","t":"Ngoài vàm có ghe chài chở gạo neo lại, dân xóm ra coi đông nghẹt."},{"c":"","t":"Ấp họp bàn chuyện sửa lại cây cầu khỉ đầu xóm."},{"c":"","t":"Đám trẻ trong xóm đá banh ngoài ruộng khô, la hét cả chiều."},{"c":"","t":"Chiều nay chùa đánh chuông, tiếng ngân xa tới tận cuối xóm."},{"c":"","t":"Có người lạ đi bán cây giống, xóm mua mỗi nhà một hai cây."},{"c":"","t":"Ông bán kem đạp xe leng keng, tụi nhỏ bu lại đòi mua."}]␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀{"nha":"Nhà mình","xom":"Xóm làng","tt":"Thiên tai","buon":"Buôn bán"}␀␀␀{"well":1,"shrine":1,"bridge":1,"caukhi":1,"caukhid":1,"choi":1,"causong":2,"gate":2,"tramyt":2,"truong":2,"dinh":3,"chua":3}␀␀␀{"tramyt":1}␀␀␀␀[["xu","Xu",1],["cui","Củi khô",8],["gach","Gạch nung",30],["cong","Công phụ dựng",100]]␀␀␀␀␀␀␀␀␀␀␀␀␀␀[0,0,4,12]␀␀␀␀␀␀[0,0,4,7]␀␀␀␀␀␀␀{"tk":"cui","hien":"gach","cham":"cong"}␀␀␀␀␀␀␀␀["","bậc xóm","bậc ấp","bậc làng"]␀␀␀␀[{"id":"p1","vnd":20000,"ng":60,"b":0,"pile":1},{"id":"p2","vnd":50000,"ng":150,"b":15,"pile":2,"tag":"Phổ biến"},{"id":"p3","vnd":100000,"ng":300,"b":45,"pile":3},{"id":"p4","vnd":200000,"ng":600,"b":120,"pile":4},{"id":"p5","vnd":500000,"ng":1500,"b":400,"pile":6,"tag":"Lời nhất"}]␀␀␀␀␀␀␀␀␀␀␀␀[{"vnd":10000,"t":"60 sen đỏ + đèn lồng đỏ"},{"vnd":10000,"t":"60 sen đỏ + 10 vật liệu xưởng"},{"vnd":20000,"t":"130 sen đỏ + 3 con gà mái đẻ"},{"vnd":20000,"t":"130 sen đỏ + nâng kho 1 bậc"},{"vnd":20000,"t":"130 sen đỏ + thợ giỏi 2★"},{"vnd":50000,"t":"350 sen đỏ + bùa +50% EXP 7 ngày"},{"vnd":50000,"t":"350 sen đỏ + khăn đỏ mới cho trâu"}]␀␀␀␀␀␀␀␀␀␀␀␀␀␀[{"p":40,"n":"1.000 xu","ic":"coin"},{"p":100,"n":"10 sen đỏ","ic":"pearl"},{"p":160,"n":"Rương vật liệu lớn","ic":"crate"},{"p":220,"n":"Thợ giỏi 3★ về làng","ic":"tal"},{"p":280,"n":"60 sen đỏ","ic":"pearl"}]␀␀␀␀␀␀␀[{"p":20,"n":"+1.000 xu"},{"p":60,"n":"5 vật liệu kho"},{"p":150,"n":"Bùa +50% EXP 3 ngày + 3.000 xu"},{"p":300,"n":"20 sen đỏ hoàn lại + 10 vật liệu"}]␀␀␀␀␀␀␀␀[{"k":"pearl","n":"Sen đỏ x2","d":"gấp đôi sen đỏ gói đầu"},{"k":"coin","n":"1.000 xu"},{"k":"crate","n":"Rương vật liệu","d":"5 vật liệu kho mỗi loại, 2 mỗi loại khác"},{"k":"ghe","n":"Ghe hoa","d":"đồ trang trí độc quyền"},{"k":"ao","n":"Bà ba hồng sen","d":"trang phục độc quyền"},{"k":"bua","n":"Bùa +50% EXP 3 ngày","d":"+50% kinh nghiệm, cất trong kho"}]␀␀␀␀␀␀␀␀␀␀␀␀␀␀[{"id":"che","n":"Nồi chè hồi sức","d":"Hồi đầy thể lực ngay. Mỗi ngày 1 lần miễn phí","c":8,"ic":"che","f":null},{"id":"ghe","n":"Gọi ghe thương hồ","d":"Ghe ghé bến ngay để mua bán, đổi vật liệu","c":5,"ic":"ghe","f":null},{"id":"mkho","n":"Rương vật liệu kho","d":"2 then cài, 2 bao bố, 2 tấm tôn","c":20,"ic":"crate"},{"id":"mruong","n":"Rương vật liệu ruộng","d":"2 rơm khô, 2 phân chuồng, 2 vôi bột","c":15,"ic":"crate"},{"id":"mxuong","n":"Rương vật liệu xưởng","d":"2 ván gỗ, 2 đinh sắt, 2 gạch nung","c":15,"ic":"crate"},{"id":"mchuong","n":"Rương vật liệu chuồng","d":"2 cây tre, 2 lá dừa nước, 2 dây mây","c":15,"ic":"crate"},{"id":"msap","n":"Rương vật liệu sạp","d":"2 tấm bạt, 2 bảng hiệu, 2 cân đòn","c":15,"ic":"crate"},{"id":"bua1","n":"Bùa +50% EXP 1 ngày","d":"+50% kinh nghiệm trong 24 giờ, cất trong kho dùng khi cần","c":25,"ic":"bua"}]␀␀␀␀␀␀␀␀␀␀␀␀␀␀{"vnd":50000,"now":60,"day":10,"days":30}␀␀␀␀␀␀␀{"chung":["Bữa nay trời đẹp ghê!","Lúa năm nay trúng mùa nghen.","Ăn cơm chưa bà con?","Chiều nay ra sông tắm hông?","Nghe nói ghe Cái Bè sắp ghé.","Tụi nhỏ đi học về chưa?"],"mua":["Mưa quá trời, khỏi tưới cây.","Đội nón vô kẻo ướt!","Mưa dầm thấm lâu ghê."],"han":["Nắng muốn cháy da luôn.","Nhớ tưới cây nghen, nắng hạn rồi."],"hoi":["Sắp tới ngày hội rồi đó!","Góp lễ cho đình chưa?"],"quan":["Quán cơm đầu xóm ngon lắm.","Trưa nay ra quán ăn cơm tấm hông?"],"ray":["Ngoài đồng có rầy đó, coi chừng.","Phun thuốc chưa? Rầy lên rồi."],"dem":["Tối rồi, về nghỉ thôi."]}␀␀␀␀␀␀{"ruong":["Lúa lên đều quá trời!","Tưới xong luống này nghỉ chút.","Sâu ở đâu ra hoài vậy nè!","Năm nay chắc trúng mùa!","Cấy lẹ lẹ còn về ăn cơm.","Đất này tốt ghê, cắm cây gì cũng lên."],"xuong":["Máy chạy êm ru!","Mẻ này thơm phức luôn!","Làm xong mẻ này đi ăn cơm.","Bà con đặt hàng quá trời.","Coi chừng khét nghen!"],"vuon":["Trái chín cây rồi nè!","Tưới gốc này cái đã.","Xoài năm nay sai trái ghê!","Con chim nào mổ trái vậy nè?"],"chan":["Ăn đi tụi bây!","Con heo này mập ghê!","Gà đẻ trứng rồi nè!","Đứng yên coi, cho ăn nè!"],"nha":["Ăn cơm chưa con?","Bữa nay trời đẹp ghê!","Tụi nhỏ đi học về chưa?","Chiều nay đi chợ hông?","Ủa, con Vện đi đâu rồi?","Nồi cá kho tộ thơm nức mũi!","Rảnh ghé nhà chơi nghen!"],"quan":["Cơm ngon quá trời!","Canh này nêm vừa ăn ghê.","Cho thêm chén nữa nghen!","Quán này phải ghé hoài.","No căng bụng rồi!","Nước mắm pha ngon ghê!"],"sap":["Rau tươi ghê!","Bớt chút đi cô ơi!","Mua về nấu canh chiều.","Trứng gà ta hả? Lấy chục!"],"go":{"hoicho":["Đi hội chợ thôi!","Tối nay sân đình vui lắm!"],"yte":["Đi khám bệnh chút.","Ra trạm xin thuốc."],"quan":["Đi ăn cơm tấm thôi!","Đói bụng quá trời!"],"sap":["Ra sạp mua rau.","Đi chợ chút nè."],"dinh":["Lên đình thắp nhang.","Cầu cho mưa thuận gió hòa."],"xom":["Qua nhà hàng xóm chơi.","Đi tám chuyện chút!"],"dong":["Ra đồng coi lúa.","Đi thăm ruộng nè."],"tham":["Ghé thăm nhà con nè!"],"back":["Về nhà nghỉ thôi.","Về nấu cơm chiều."]},"vui":["Hôm qua câu được con cá lóc bự lắm!","Con gà nhà ai chạy qua đây vậy?","Trời ơi, quên tắt bếp rồi!","Ai thấy cái nón lá của tui hông?","Tối nay đờn ca tài tử nghen!","Thằng Tèo lại trốn học đi thả diều!","Bữa nay ăn gì ta?"],"mua":["Mưa quá trời, khỏi tưới cây.","Đội nón vô kẻo ướt!","Mưa dầm thấm lâu ghê."],"han":["Nắng muốn cháy da luôn.","Nắng hạn, nhớ tưới cây nghen!"],"dem":["Tối rồi, về nghỉ thôi.","Trăng sáng ghê ta."],"sang":["Sáng sớm mát ghê!","Chào buổi sáng bà con!"],"hoi":["Sắp tới ngày hội rồi đó!","Góp lễ cho đình chưa?"],"ray":["Ngoài đồng có rầy đó, coi chừng!","Phun thuốc chưa? Rầy lên rồi."],"nuoc":["Nước nổi rồi, đi bắt cá linh!","Bông điên điển nở vàng sông rồi."]}␀␀␀␀␀␀␀[{"c":"chao","mo":"Ủa, bữa nay ghé sớm vậy? Bộ ruộng nhà {c} tự mọc lúa hả?","r":[["dua","Dạ, lúa nhà {c} biết tự lo rồi, {c} rảnh đi thăm xóm.","Ha ha, lúa gì ngoan dữ. Cho {x} mượn vài bụi về dạy lúa nhà {x} coi.","Lúa tự lo hả? Vậy cho {x} mượn vài bụi về dạy lúa nhà {x}, xạo là biết liền.",[["dua","Lúa nhà {c} mắc lắm, {x} trả bằng ly trà nha.","Ly trà thì có. Vô ngồi đi, cái miệng dẻo ghê.",""],["viec","Mượn thì không có, mà {c} chỉ {x} cách bón cho lúa lên đều.","Ờ, chỉ thì {x} nghe. Mà {x} cũng có mẹo riêng nè.","ke"],["ca","Lúa nhà {x} mà dạy được thì cỏ nhà {x} đã biết tự nhổ rồi.","Cỏ đó {x} để làm hàng rào, biết gì mà nói.",""]]],["viec","Dạ, {c} mới tưới xong, ghé coi ruộng nhà {x} sao.","Ruộng {x} thì lúa trổ đều, mà con chuột nó phá quá trời.","Coi thì coi, đừng có chỉ trỏ. Lúa trổ đều, chỉ có con chuột là phá.",[["viec","Chuột nhiều thì đặt bẫy tre, {c} đặt giùm cho.","Vậy hả, vậy {x} nhờ {c} một chuyện luôn.","nho"],["dua","Nuôi con mèo đi {x}, chuột nó sợ chạy hết.","Mèo nhà {x} với chuột là bạn nhậu đó {c}.",""],["hoi","Chuột phá vậy {x} có lỗ nhiều hông?","Lỗ thì hông, mà tức. Thôi có {c} hỏi là đỡ tức.",""]]],["ca","Dạ, {c} ghé coi {x} còn sống hông.","Còn, còn khỏe hơn {c} nữa đó.","Mới sáng sớm mà ăn nói vậy hả? Còn sống, còn khỏe hơn {c} nữa đó.",[["dua","Khỏe vậy mai {x} ra ruộng phụ {c} đi.","Phụ thì phụ, nhưng {c} bao cơm.",""],["le","Dạ {c} giỡn chơi, {x} khỏe là {c} mừng.","Ờ, {x} biết mà, giỡn thì giỡn vừa thôi.",""],["ca","Khỏe mà sao mặt {x} như mất sổ gạo vậy?","Mặt {x} vậy từ hồi sinh ra rồi. Thôi về đi.",""]]]]},{"c":"chao","mo":"Bữa nay giá phân bón lên nữa rồi đó {c}. Kiểu này làm ruộng nuôi tiệm phân chớ nuôi ai.","r":[["viec","Vậy mình ủ phân chuồng xài đi {x}, đỡ được khối.","Đó, có đứa biết tính. Mà ủ thì hôi lắm à nha.","Ủ phân thì hôi rình, {c} ủ đi, {x} không rảnh ngửi.",[["viec","Hôi mà ra tiền thì {c} chịu.","Được, mai {x} gom phân gà cho {c} một bao.","tang"],["dua","Hôi thì mình ủ sát nhà hàng xóm.","Ha ha, ác dữ. Mà hay à nha.",""],["hoi","Mà {x} có biết cách ủ cho mau hoai, đỡ hôi hông?","Biết chớ. Trộn tro bếp với chút rơm, đậy kỹ là xong.","ke"]]],["ca","Thì {x} trồng ít lại, khỏi bón.","Trồng ít thì lấy gì ăn, {c} nói như đúng rồi.","Ăn nói kiểu đó mà cũng làm ruộng được hả? Trồng ít thì lấy gì ăn?",[["dua","Thì ăn ké nhà {x} chớ sao.","Ăn ké thì phải rửa chén nghen.",""],["viec","Ý {c} là trồng ít mà trồng thứ có giá.","Ờ, vậy nghe còn lọt tai. Trồng ớt, trồng gừng coi bộ được.","ke"],["ca","Thì ăn cháo, cháo cũng no.","Thôi {c} về ăn cháo một mình đi.",""]]],["hoi","Giá lên vậy {x} có xoay xở nổi hông?","Xoay chớ sao. Nghèo quen rồi, nghèo thêm chút cũng vậy.","Hỏi chi, bộ {c} cho {x} mượn tiền hả? Nghèo quen rồi, nghèo thêm chút cũng vậy.",[["le","Tiền thì {c} không có, mà việc gì {c} phụ được thì {x} cứ nói.","Có, {x} đang kẹt món này, nhờ {c} nha.","nho"],["dua","Nghèo mà vui là được {x} ơi.","Vui cái gì, vui thì {c} lấy tiền vui đóng phân giùm {x}.",""],["viec","{C} có mớ phân dư, để {c} chia {x}.","Thiệt hả? Vậy {x} đổi lại cho {c} ít đồ nhà làm.","tang"]]]]},{"c":"chao","mo":"Hồi khuya con chó nhà {x} sủa cả đêm, chắc có trộm rình gà.","r":[["hoi","Mất con gà nào hông {x}?","Hông mất, mà {x} thức trắng đêm canh, giờ mắt như con cú.","Hỏi gà hoài, bộ {c} tính mua hả? Hông mất con nào, mà {x} thức trắng đêm canh.",[["viec","Để {c} làm cái chuồng gà chắc chắn, {x} khỏi thức.","Ờ, vậy được. Mà {x} thiếu đồ làm, {c} kiếm giùm nghen.","nho"],["dua","Chắc trộm thấy {x} thức nên sợ quá bỏ chạy.","Ha ha, thấy cái mặt {x} lúc ba giờ sáng ai mà không sợ.",""],["hoi","{X} có báo ấp hông?","Báo làm gì, ông trưởng ấp còn ngủ say hơn {x}.",""]]],["dua","Chắc con chó nó thấy ma chớ trộm đâu.","Ma gì, ma đói thì có. Mà nói vậy {x} nổi da gà nè.","Nói chuyện ma lúc này là {x} đuổi về đó. Ma gì, ma đói rình gà thì có.",[["dua","Ma đói thì {x} cúng nó nồi cháo gà.","Gà còn không đủ nuôi người, cúng ma cái gì.",""],["hoi","{X} có nghe ai trong xóm mất đồ hông?","Nghe nói nhà bên kia mất bao lúa. Ờ mà {c} nhớ khóa cửa đó.","ke"],["ca","Hay con chó nó sủa tại {x} ngáy to quá.","Nói ai ngáy? Về đi.",""]]],["viec","{X} gắn cái đèn ngoài chuồng đi, trộm sợ ánh sáng.","Ờ, ý hay. Mà đèn thì tốn điện, điện thì mắc.","Đèn đóm gì, điện mắc muốn chết.",[["viec","Gắn đèn dầu thôi {x}, rẻ mà sáng.","Ờ, vậy được. Bữa nào {x} cho {c} ít trứng gà để cảm ơn.","tang"],["dua","Vậy {x} ngồi canh luôn khỏi gắn đèn.","Canh thì {c} canh, {x} già rồi.",""],["ca","Tiếc điện mà không tiếc gà, {x} tính kỳ ghê.","{C} có tính hơn {x} đâu.",""]]]]},{"c":"chao","mo":"Thằng cháu {x} mới đậu đại học trên thành phố đó {c}. Cả xóm chưa đứa nào đậu.","r":[["khen","Trời, giỏi dữ! Nhà {x} đúng là có học.","Chớ sao, giống ông nội nó. Bữa nào nó về {x} đãi cả xóm.","Khen gì, nó giỏi chứ có phải {x} đâu. Mà bữa nào nó về {x} cũng đãi cả xóm.",[["khen","Đãi thì {c} qua phụ, nhà {x} làm gì cũng lớn.","Đó, nói vậy {x} ưng. Tới bữa đó {x} kêu {c}.","moi"],["hoi","Nó học ngành gì vậy {x}?","Nông nghiệp! Học xong về làm ruộng giỏi hơn {c}.","ke"],["ca","Lên thành phố rồi chắc nó hết muốn về.","Trù nó hả? Ăn nói vậy hả?",""]]],["viec","Học xong về làng mở trại giống là giàu luôn {x}.","Đó, {x} cũng nói vậy. Mà tiền học phí nghe muốn xỉu.","Mở trại thì tính sau, tiền học phí trước mắt còn muốn xỉu đây nè.",[["viec","Thiếu thì {c} phụ {x} bán ít đồ gom tiền.","Thiệt hả? Vậy {x} nhờ {c} chút việc.","pq"],["dua","Thì {x} bán bớt con heo chớ sao.","Heo nó nghe là nó trốn đó.",""],["hoi","Nhà mình tính sao cho nó học nổi {x}?","Thì gom góp, xóm giềng phụ chút đỉnh. {C} hỏi vậy {x} thấy thương.",""]]],["dua","Đậu đại học rồi thì nó hết thèm phụ {x} cắt lúa.","Ha ha, nó có phụ bao giờ đâu mà hết.","Nói gì kỳ vậy, nó ngoan lắm. Có điều… ờ, nó chưa phụ bữa nào.",[["dua","Vậy {c} phụ {x} thế nó.","Được, {c} còn siêng hơn nó. Vậy {x} nhờ {c} chuyện này nè.","nho"],["khen","Thôi nó học giỏi là nhà {x} có tiếng rồi.","Chớ sao. Cả xóm phải nể.",""],["ca","Học xong chắc nó làm ông này bà nọ, quên {x} luôn.","Nói vậy {x} buồn đó.",""]]]]},{"c":"chao","mo":"{X} mới mua cái tivi màn hình bự, coi đá banh đã gì đâu {c} ơi.","r":[["khen","Tivi bự vậy là nhất xóm rồi {x}!","Chớ sao! Tối nay qua coi chung, {x} nấu nồi chè.","Khen nghe giả trân quá. Mà thôi, tối nay qua coi chung, {x} nấu nồi chè.",[["khen","Tối {c} qua liền, kêu cả xóm qua luôn.","Ờ, kêu đi, cho người ta biết nhà {x} có tivi mới.","moi"],["dua","Tivi bự quá {x} coi muốn lé mắt.","Ha ha, lé thì lé, coi đã là được.",""],["viec","Mà tivi đó chắc tốn dữ lắm {x}.","Tốn thì tốn, sống mấy hồi. Mà {c} hỏi tiền làm chi?",""]]],["ca","Mua tivi bự mà nhà còn dột {x} ơi.","Dột thì {x} để cái thau, tivi thì phải bự.","Qua đây để chê hả? Dột thì để cái thau, tivi thì phải bự.",[["dua","Vậy coi đá banh mà nghe mưa nhỏ giọt cũng vui.","Ha ha, như ngồi sân vận động vậy.",""],["viec","Để {c} vá mái giùm, {x} kiếm đồ nghen.","Ờ, vậy được, {x} nhờ {c} luôn.","nho"],["ca","Tivi bự mà coi toàn phim bộ thì phí.","Phim bộ là nghệ thuật, {c} hiểu gì.",""]]],["hoi","Bữa nay đá trận nào vậy {x}?","Đội nhà đá với đội Thái, tối nay {x} hét banh nóc.","{C} có coi đâu mà hỏi. Đội nhà đá với đội Thái, tối nay {x} hét banh nóc.",[["dua","Hét nhỏ nhỏ thôi {x}, con chó nhà bên nó sợ.","Kệ nó, nó cũng phải yêu nước chớ.",""],["le","Tối {c} xin qua coi ké được hông {x}?","Được chớ, mà nhớ đem theo bịch đậu phộng.","moi"],["ca","Đội nhà đá thua là {x} khỏi ngủ.","Trù hoài à, về đi.",""]]]]},{"c":"chao","mo":"Mấy bữa nay con gà mái nhà {x} đẻ trứng đôi hoài, chắc trúng số.","r":[["dua","Trứng đôi là điềm giàu đó {x}, mua vé số liền đi.","Ha ha, mua rồi, trúng thì {x} chia {c} một nửa.","Vé số {x} lỡ mua rồi, mà nói trước, trúng là không chia ai hết.",[["dua","Trúng rồi nhớ mua cho {c} con trâu.","Trâu thì hơi mắc, cho {c} con gà mái đẻ trứng đôi.","tang"],["viec","Trúng hay không thì trứng đôi bán chợ cũng được giá hơn đó {x}.","Thiệt hả? Vậy {x} để dành bán. Mà nói nhỏ, {x} mê nhất món này nè.","ke"],["ca","Gà đẻ trứng đôi chắc tại {x} cho ăn nhiều quá, mập.","Gà mập vậy mới đẻ, còn {c} mập thì làm được gì?",""]]],["hoi","{X} cho gà ăn gì mà đẻ dữ vậy?","Lúa với cám, thêm chút rau muống. Bí quyết đó nghen.","Bí mật… thôi nói nhỏ: lúa với cám, thêm chút rau muống.",[["viec","Vậy {c} đổi {x} ít lúa lấy mớ trứng nha.","Được, đổi thì đổi, mà {x} cần ít đồ nữa.","nho"],["le","Dạ, {c} cảm ơn {x} chỉ, về {c} làm theo.","Ờ, còn mẹo này nữa, nói nhỏ thôi nghen.","ke"],["dua","Rau muống thì {c} cũng ăn mà có đẻ trứng đâu.","Ha ha, {c} mà đẻ trứng thì nổi tiếng rồi.",""]]],["khen","Gà nhà {x} đẹp nhất xóm luôn.","Đó, {c} có mắt nhìn. Con mái đó {x} cưng nhất.","Khen gà làm chi, bộ tính xin hả? Con mái đó {x} cưng nhất, đừng có mơ.",[["khen","Nuôi gà khéo vậy chắc trồng cây cũng khéo.","Khéo chớ, {x} mê nhất là món này nè.","ke"],["dua","Cưng vậy bữa nào {x} cho nó đi thi hoa hậu gà.","Ha ha, thi chắc đậu.",""],["ca","Đẹp vậy mà để chồn tha thì tiếc.","Trù {c} bị chồn tha trước.",""]]]]},{"c":"chao","mo":"Bà sui bên kia lại nói xấu nhà {x} nữa đó {c}. Nói {x} keo.","r":[["hoi","Bả nói vậy {x} có buồn hông?","Buồn gì, nghe hoài quen rồi. Mà tức thì có.","Hỏi chi, bộ {c} cũng thấy {x} keo hả? Buồn thì không, mà tức.",[["khen","Nhà {x} mà keo thì cả làng này keo hết.","Đó, nói vậy {x} mát ruột. Cầm nè, {x} cho.","tang"],["dua","Thôi {x} mời bả qua ăn một bữa cho bả hết nói.","Mời thì tốn, mà thôi cũng được. Bữa đó {c} qua ngồi chung cho {x} có đồng minh nghen.","moi"],["ca","Thì {x} keo thiệt mà.","Về đi.",""]]],["dua","Bả nói {x} keo thì {x} đãi bả nước lã cho đúng luôn.","Ha ha, ý hay! Nước lã thêm cục đá cho sang.","Giỡn hoài, {x} tức thiệt đó. Mà nước lã… nghe cũng đáng.",[["dua","Thêm cái bánh tráng cho bả nhai đỡ buồn.","Ha ha, {c} ác ghê, mà {x} thích.",""],["hoi","Hai nhà có chuyện gì mà căng vậy {x}?","Chuyện hồi đám cưới, lấy thiếu một mâm quả. Lớn chuyện ghê.","ke"],["le","Thôi {x} bỏ qua đi, nhà sui mà.","Ừ, {c} nói cũng phải.",""]]],["ca","Chắc bả rảnh quá nên mới đi nói.","Đúng! Rảnh thì đi cấy giùm {x} đi.","Nói vậy chớ {c} cũng rảnh có thua ai. Mà đúng, bả rảnh thì đi cấy giùm {x} đi.",[["dua","Vậy {x} giao ruộng cho bả làm luôn.","Ha ha, cho bả biết tay.",""],["viec","Mình sống tốt là bả hết nói {x}.","Ừ, mà {x} nhờ {c} chuyện này.","nho"],["ca","Hay tại {x} keo thiệt nên bả nói.","Thôi về, khỏi ở đây.",""]]]]},{"c":"chao","mo":"Bữa nay ra đồng thấy con rắn bự cỡ cổ tay, {x} chạy muốn rớt dép.","r":[["dua","Rắn nó thấy {x} chắc nó cũng chạy muốn rớt vảy.","Ha ha ha, cái đứa này. Mà thiệt, nó bự lắm.","Giỡn hoài, {x} sợ muốn chết. Con rắn đó bự thiệt chớ bộ.",[["viec","Rắn nhiều là ruộng nhiều chuột, phải bẫy chuột đi {x}.","Đó, đúng rồi. {C} phụ {x} đặt bẫy nha.","nho"],["hoi","Nó có cắn {x} hông?","Hông, nó bò mất tiêu. May dữ.",""],["dua","Bự vậy bắt về ngâm rượu đi {x}.","Bắt? {C} bắt đi, {x} đứng coi.",""]]],["hoi","{X} có sao hông? Rắn đó có độc hông?","Không sao, rắn nước thôi. Mà nhìn nó sợ thiệt.","Hỏi hoài, không sao. Rắn nước thôi.",[["le","Lần sau {x} đi đồng nhớ mang ủng nha.","Ờ, {c} lo cho {x} vậy là quý.",""],["viec","Để {c} dọn bờ cỏ cho {x}, rắn hết chỗ trốn.","Vậy {x} nhờ {c} luôn, cảm ơn trước.","nho"],["dua","Rắn nước thì nó chỉ muốn tắm chung với {x} thôi.","Ha ha, tắm một mình được rồi.",""]]],["ca","Ruộng {x} cỏ cao vậy rắn không ở mới lạ.","Cỏ cao tại {x} đau lưng, chứ ai muốn.","Nói ruộng {x} dơ hả? Cỏ cao tại {x} đau lưng chớ ai muốn.",[["viec","Để {c} phát cỏ giùm cho.","Vậy hả, vậy {x} cho {c} ít đồ.","tang"],["dua","Thì {x} nuôi rắn luôn, bán cho quán nhậu.","Ý hay mà {x} sợ rắn.",""],["ca","Đau lưng mà đi nhậu được.","Thôi đi về đi.",""]]]]},{"c":"chao","mo":"Thấy {c} hồi sáng chạy ngang đây, đi đâu mà vội vậy?","r":[["viec","Dạ, {c} chở hàng đi giao đơn cho kịp.","Siêng dữ. Bữa nào {x} gửi hàng {c} chở luôn, mà chạy chậm chút nghen.","Giao gì mà chạy như ăn cướp. Bữa nào {x} gửi hàng thì chạy chậm thôi nghen.",[["viec","Được, {x} có gì cần cứ gửi.","Vậy {x} nhờ {c} gom ít đồ.","nho"],["dua","Chạy chậm thì hàng tới nơi khách đói xỉu rồi.","Ha ha, khách gì yếu dữ.",""],["le","Dạ, lần sau {c} chạy chậm lại.","Ừ, đường xóm con nít chơi, coi chừng.",""]]],["dua","Dạ, {c} chạy trốn con chó nhà {x} đó.","Ha ha, con Vện nó hiền mà, sủa vậy thôi.","Chó nhà {x} hiền khô, nó sủa vậy thôi, ai mà sợ.",[["dua","Hiền mà nó rượt {c} ba vòng xóm.","Tại {c} chạy nên nó tưởng chơi.",""],["hoi","Con Vện bao nhiêu tuổi rồi {x}?","Mười tuổi rồi, tính theo tuổi chó là già hơn {x}.","ke"],["ca","Hiền mà nhe răng như muốn ăn thịt người.","Nó ghét người ăn nói như {c} đó.",""]]],["ca","Bộ {x} rảnh lắm hả, ngồi canh người ta đi đâu.","Già rồi không canh thì làm gì. Mà {c} ăn nói vậy hả?","Rảnh thì sao? Già rồi không canh người ta thì làm gì.",[["dua","Vậy {x} làm bảo vệ xóm luôn đi.","Ha ha, có lương hông?",""],["le","{C} giỡn chơi thôi {x}.","Ờ, giỡn vừa vừa.",""],["ca","Canh vậy chắc biết hết chuyện xóm ha.","Biết hết, kể cả chuyện {c} nợ tiền quán.",""]]]]},{"c":"chao","mo":"Trời ơi mấy đứa nhỏ trong xóm hái trộm xoài nhà {x} hoài.","r":[["hoi","Mất nhiều hông {x}?","Mất mấy chục trái, cây còn trơ cuống.","Mất nhiều thì {c} đền hả? Mấy chục trái chớ ít gì.",[["viec","{X} rào cái bờ tre lại, tụi nhỏ hết leo.","Ừ, mà {x} thiếu tre, {c} kiếm giùm.","nho"],["dua","Tụi nhỏ hái thì cho nó ăn đi {x}, tuổi thơ mà.","Tuổi thơ của nó là tuổi già của {x} đó.",""],["le","Để {c} nói ba má tụi nhỏ giùm {x}.","Ừ, có người nói giùm thì đỡ.",""]]],["dua","Hồi nhỏ {x} chắc cũng hái trộm xoài nhà người ta.","Ha ha, có, mà {x} hái lẹ hơn, không bị bắt.","Hồi nhỏ {x} ngoan lắm. Có hái thì… cũng hái lẹ, không bị bắt.",[["dua","Vậy {x} dạy tụi nhỏ hái cho chuyên nghiệp.","Ha ha, dạy rồi tụi nó hái sạch.",""],["khen","Xoài nhà {x} ngọt nhất xóm nên tụi nó mới mê.","Chớ sao. Cầm vài trái về ăn nè.","tang"],["ca","Hồi nhỏ hái trộm, giờ già thì giữ của.","Nói ai giữ của?",""]]],["viec","Để {c} làm con bù nhìn dựng dưới gốc cho tụi nhỏ sợ.","Ý hay! Làm cái mặt cho dữ dữ nghen.","Bù nhìn gì, tụi nó lớn rồi. Mà làm cái mặt dữ dữ thì may ra.",[["dua","Lấy cái áo cũ của {x} làm, tụi nó tưởng {x} đứng canh.","Ha ha, vậy chắc tụi nó sợ thiệt.",""],["viec","{X} kiếm cho {c} ít rơm với tre.","Được, mà {x} còn nhờ {c} chuyện nữa.","nho"],["ca","Thôi {x} ngồi đó canh luôn, khỏi bù nhìn.","{C} ngồi đi, {x} ngủ.",""]]]]},{"c":"chao","mo":"Giá lúa bữa nay lên đó {c}. Lên được có trăm đồng mà thương lái làm như ban ơn.","r":[["viec","Vậy mình gom lúa cả xóm bán chung cho được giá {x}.","Đó, ý hay. Có người đứng ra là {x} theo liền.","Gom chung rồi ai giữ tiền? {C} hả? Có người đứng ra đàng hoàng thì {x} mới theo.",[["viec","{C} đứng ra lo, {x} phụ gom đồ.","Được, vậy {x} nhờ {c} việc riêng này.","pq"],["dua","Thì {x} đứng ra luôn đi, thương lái thấy mặt {x} là hết dám ép giá.","Ha ha, đúng, {x} mà ra mặt thì tụi nó run.",""],["le","Dạ, mình bàn với xóm trước đã {x}.","Ừ, từ từ mà làm.",""]]],["ca","Thương lái là vậy mà, {x} còn lạ gì.","Biết mà vẫn tức. {C} không tức hả?","Biết rồi, nhắc làm gì cho thêm tức.",[["dua","Tức thì {x} nhậu cho quên.","Nhậu thì cũng tốn tiền, càng tức.",""],["viec","Mình phơi lúa thật khô là ép lại giá được.","Ừ, lúa khô bán được hơn thiệt. Mà {x} có mẹo phơi này nè.","ke"],["ca","Tức thì tự chở lên huyện bán.","Nói như đúng rồi, chở bằng gì?",""]]],["hoi","Năm nay nhà {x} được mùa hông?","Được, mà được mùa thì mất giá. Làm ruộng là vậy.","Được hay không thì cũng vậy. Được mùa thì mất giá.",[["le","Dạ, có gì cần {c} phụ thì {x} nói.","Có, {x} đang cần ít đồ.","nho"],["dua","Mất giá thì {x} nấu rượu bán.","Ha ha, nấu rượu xong uống hết thì lấy gì bán.",""],["khen","Mà ruộng {x} lúc nào cũng tốt nhất xóm.","Đó, {c} nói phải. Cầm ít gạo về nấu.","tang"]]]]},{"c":"chao","mo":"Nghe nói tối qua ông trưởng ấp nhậu xỉn té ao đó {c}.","r":[["dua","Ổng té ao chắc cá trong ao cũng say luôn.","Ha ha ha, cá say nổi lềnh bềnh hết.","Chuyện người ta, nói vậy coi chừng ổng nghe. Mà ao đó cá chắc cũng say thiệt.",[["dua","Vậy sáng nay ra vớt cá say đem nấu.","Ha ha, cá ướp rượu sẵn.",""],["hoi","Ổng có sao hông {x}?","Không sao, ổng bò lên ngủ luôn ở bờ ao.",""],["viec","Ao đó nên rào lại {x}, con nít lỡ té.","Ừ, {c} nói phải, {x} nhờ {c} rào giùm.","nho"]]],["hoi","Ổng có bị gì hông {x}?","Không, ướt như chuột lột thôi. Sáng nay còn đi họp.","Hỏi ổng làm gì. Ướt như chuột lột, sáng nay còn đi họp.",[["dua","Họp chắc ổng ngồi nhỏ nước.","Ha ha, nhỏ nước tong tong.",""],["le","Dạ, vậy là may rồi.","Ừ, may.",""],["ca","Trưởng ấp gì mà nhậu tới té ao.","Ờ, mà đừng nói to, ổng nghe.",""]]],["le","Dạ, chuyện người ta mình không nên nói {x}.","Ờ, {c} nói phải. Mà thôi, {x} kể {c} chuyện khác.","Ờ, đứng đắn quá ha. Vậy {x} kể chuyện khác.",[["hoi","Chuyện gì vậy {x}?","{X} kể nè, mà {c} đừng nói ai nghe.","ke"],["dua","Chuyện khác mà là chuyện ma thì thôi nha {x}, {c} sợ.","Ha ha, ma đâu, chuyện nhà {x} thôi.",""],["ca","Chuyện khác chắc cũng chuyện người ta.","Vậy thôi về đi.",""]]]]},{"c":"chao","mo":"Nhà {x} mới sửa cái bếp, nấu cơm không còn khói nữa.","r":[["khen","Bếp mới đẹp quá {x}, nấu ăn chắc ngon hơn.","Chớ sao, trưa nay {x} nấu cá kho, ở lại ăn.","Ngon dở là do người nấu. Mà trưa nay {x} kho cá, ở lại ăn thử thì biết.",[["khen","Cá kho {x} nấu là nhất rồi.","Ăn đi rồi biết, cầm về một tô nữa.","tang"],["dua","{C} ở lại ăn hết nồi luôn nha.","Ăn hết thì rửa nồi.",""],["ca","Bếp mới mà cá kho khét như bếp cũ thì sao.","Ăn hết rồi mới chê.",""]]],["viec","Bếp này tốn nhiều củi hông {x}?","Ít củi hơn, mà {x} vẫn thiếu củi, kiếm hoài không đủ.","Củi đóm gì, hỏi kỹ dữ. Ít củi hơn, mà {x} vẫn thiếu.",[["viec","Để {c} kiếm củi giùm.","Được, vậy {x} nhờ {c}.","nho"],["dua","Thiếu củi thì đốt bớt đồ cũ đi {x}.","Đồ cũ của {x} toàn đồ quý nha.",""],["hoi","{X} sửa bếp hết bao nhiêu vậy?","Có mấy trăm, mà đáng.",""]]],["dua","Hết khói thì muỗi nó về đầy nhà đó {x}.","Ha ha, đúng rồi, tối qua bị muỗi chích quá trời.","Muỗi thì có mùng, lo xa. Mà tối qua bị chích quá trời thiệt.",[["dua","Vậy {x} nấu cơm xong hun chút khói đuổi muỗi.","Ha ha, vậy sửa bếp làm chi.",""],["viec","Trồng vài bụi sả quanh nhà là muỗi chạy.","Ý hay, {x} mê sả lắm đó.","ke"],["ca","Muỗi chích chắc tại {x} ngọt.","Nói như đúng rồi.",""]]]]},{"c":"chao","mo":"Con trâu nhà {x} hồi sáng sổng chuồng chạy vô ruộng nhà {c}, có phá gì hông?","r":[["dua","Nó ăn có hai bụi lúa, chắc nó đói.","Ha ha, trâu nhà {x} biết chọn ruộng ngon.","Hai bụi cũng là lúa. Thôi {x} đền, đừng có kể công.",[["dua","Bữa sau {x} cho nó ăn sáng rồi hẵng thả.","Ha ha, được, {x} cho nó ăn no.",""],["le","Thôi không sao đâu {x}, hai bụi lúa mà.","Vậy hả, {x} cảm ơn, cầm ít đồ về.","tang"],["ca","Trâu gì mà hư như chủ.","Nói ai hư?",""]]],["viec","Dạ, nó giẫm hư một góc bờ, {x} phụ đắp lại nha.","Được, mai {x} qua đắp, mà {c} phụ đem đất.","Đắp thì {x} đắp, mà {c} cũng phải đem đất chớ.",[["viec","Được, {c} đem đất, {x} đem cuốc.","Ừ, vậy {x} nhờ {c} thêm chuyện này.","nho"],["dua","Cho con trâu đắp luôn {x}, nó làm hư thì nó sửa.","Ha ha, trâu biết đắp bờ thì {x} đã giàu.",""],["ca","{X} không đắp là {c} giữ trâu luôn.","Dám hông?",""]]],["hoi","Con trâu có bị gì hông {x}? Nó chạy dữ quá.","Không sao, nó khỏe re. Cảm ơn {c} hỏi.","Hỏi trâu mà không hỏi người. Trâu thì khỏe re.",[["hoi","Còn {x} có mệt hông, rượt trâu cả buổi.","Mệt muốn đứt hơi. Có {c} hỏi là đỡ.",""],["viec","Để {c} làm lại cái chốt chuồng chắc hơn.","Vậy {x} nhờ {c} luôn.","nho"],["dua","Trâu khỏe vậy cho nó đi chọi đi {x}.","Ha ha, chọi thì nó chạy mất.",""]]]]},{"c":"chao","mo":"{X} mới học được món mắm kho, mai {x} nấu thử, dám ăn hông?","r":[["dua","Dám chớ, {c} ăn xong mà còn sống là món ngon.","Ha ha, coi thường {x} quá.","Không ăn thì thôi, nói chi kỳ. Mai {x} nấu, dám thì qua.",[["dua","{C} ăn với hai chén cơm cho chắc.","Ba chén nha, mắm kho mà.","moi"],["khen","Món gì {x} nấu cũng ngon, mai {c} qua liền.","Đó, nói vậy {x} mới vui.",""],["ca","Mắm kho mà {x} nấu chắc mặn chát.","Không ăn thì đừng có chê.",""]]],["khen","{X} nấu ăn khéo nhất xóm, món gì cũng ngon.","Đó, có người biết khen. Mai qua ăn nha.","Khen để được ăn chớ gì. Thôi mai qua ăn.",[["khen","Mai {c} qua sớm phụ {x} nấu.","Được, mà {x} còn thiếu đồ, {c} kiếm giùm.","nho"],["hoi","Mắm kho nấu với rau gì {x}?","Rau đồng, bông điên điển, {x} mê nhất món này đó.","ke"],["dua","Ngon thì {x} mở quán luôn đi.","Mở quán thì {c} rửa chén.",""]]],["ca","Mắm kho mùi nồng lắm, hàng xóm than đó {x}.","Than thì than, ăn thì ai cũng xin.","Hàng xóm nào than? {C} hả? Than mà tới bữa ai cũng xin.",[["dua","Vậy {x} nấu xong mời hết xóm ăn cho hết than.","Ha ha, ý hay, mời luôn.","moi"],["le","{C} giỡn thôi, mai {c} qua ăn.","Ừ, qua đi.",""],["ca","{C} than đó, mà {c} cũng muốn ăn.","Muốn ăn mà than, kiểu gì vậy.",""]]]]},{"c":"chao","mo":"Đứa con gái {x} đòi lên thành phố làm công nhân, {x} rầu quá {c} ơi.","r":[["hoi","Nó đi rồi nhà còn ai phụ {x}?","Còn ai, còn {x} với con trâu thôi.","Thì còn {x} với con trâu, mắc gì {c} hỏi.",[["viec","Thiếu người thì {x} cứ kêu {c} phụ.","Vậy {x} nhờ {c} chuyện này luôn.","nho"],["dua","Con trâu siêng hơn người là được {x}.","Ha ha, trâu nó cũng biết mệt.",""],["le","{X} đừng buồn, nó lớn rồi để nó đi.","Ừ, {c} nói cũng phải.",""]]],["dua","Lên thành phố rồi chừng Tết nó về chở {x} đi chơi.","Ha ha, chở bằng xe gì, nó còn chưa có xe.","Đi chơi gì, nó đi là {x} cực. Mà nó có xe đâu mà chở.",[["dua","Thì nó chở bằng xe buýt.","Xe buýt chật như nêm, {x} chịu sao nổi.",""],["viec","Nó đi làm gửi tiền về là mua xe được thôi {x}.","Ừ, mà {x} vẫn lo. Cảm ơn {c}.",""],["khen","Con gái {x} giỏi, đi đâu cũng làm được.","Đó, nó giống {x}. Cầm ít trái cây về nè.","tang"]]],["ca","Thành phố có gì đâu mà mê, khói bụi muốn chết.","Đó, {x} nói vậy mà nó đâu có nghe.","Nói vậy rồi sao, {c} khuyên nó giùm hả? Nó có nghe {x} đâu.",[["le","Để bữa nào {c} nói chuyện với nó.","Ừ, có người nói giùm thì {x} mừng.",""],["dua","Cho nó đi một tháng, hít bụi đã là về.","Ha ha, chắc vậy thiệt.",""],["ca","Chắc ở nhà {x} cằn nhằn quá nên nó muốn đi.","Về đi.",""]]]]},{"c":"lai","mo":"Ủa, lại ghé nữa hả? Bộ nhà {c} hết gạo nấu hả?","r":[["dua","Dạ, nhà {c} hết chuyện nói nên qua nói với {x}.","Ha ha, vậy ngồi đi, {x} cũng đang rảnh.","Hết chuyện thì về ngủ. Mà thôi, ngồi đi, {x} cũng đang rảnh.",[["hoi","{X} rảnh thì kể {c} nghe chuyện xóm.","Chuyện xóm thì nhiều, mà nghe nè.","ke"],["dua","Rảnh thì mình ngồi đếm muỗi.","Ha ha, đếm tới trăm rồi đó.",""],["viec","Rảnh thì {x} có cần phụ gì hông?","Có chớ, {x} đang cần nè.","nho"]]],["le","Dạ, {c} quên hỏi {x} chuyện hồi sáng.","Chuyện gì, nói đi.","Hỏi gì hỏi lẹ, {x} sắp nấu cơm.",[["viec","Hồi sáng {x} nói cần đồ, giờ còn cần hông?","Còn chớ, {x} nhờ {c} nha.","nho"],["hoi","Dạ, {x} ăn cơm chưa mà mặt mệt vậy?","Chưa, đói muốn xỉu. Bộ {c} mời hả?",""],["dua","Dạ… đi tới đây quên mất tiêu rồi.","Ha ha, đi tới đây mới quên.",""]]],["ca","Bộ {x} không muốn {c} ghé hả?","Muốn chớ, mà ghé hoài thì {x} hết đồ đãi.","Ghé hoài thì người ta nói, {x} cũng hết đồ đãi.",[["dua","Khỏi đãi, {c} ngồi chơi thôi.","Vậy ngồi đi, ngồi ghế đó, ghế này gãy.",""],["le","Dạ, vậy {c} ghé chút rồi về.","Ừ, vậy cũng được.",""],["ca","Người ta nói thì kệ người ta.","Nói nghe dễ ghê.",""]]]]},{"c":"lai","mo":"Lại là {c}. Ghé lần này là lần thứ mấy rồi, {x} tính tiền ghế ngồi à nha.","r":[["dua","Tiền ghế {x} ghi sổ, cuối năm {c} trả bằng lúa.","Ha ha, ghi rồi, nợ chồng chất rồi đó.","Ghi sổ thì ghi, {x} tính thiệt đó. Nợ chồng chất rồi.",[["dua","Nợ nhiều thì {c} ở lại làm công trả nợ.","Được, vậy làm giùm {x} việc này.","nho"],["viec","Mà {x} có cần lúa thiệt hông?","Cần chớ, đổi đi, {x} cho lại đồ khác.","tang"],["ca","{X} tính toán quá trời.","Không tính sao giàu.",""]]],["hoi","Dạ, {c} ghé coi {x} nghỉ trưa chưa.","Chưa, đang tính nằm thì {c} tới.","Đang tính nằm thì bị {c} tới, vui ghê.",[["le","Vậy {c} về cho {x} nghỉ.","Thôi ngồi chút đi, {x} kể chuyện này.","ke"],["dua","{C} ngồi quạt cho {x} ngủ luôn.","Ha ha, có người quạt thì sướng.",""],["ca","Ngủ hoài vậy {x}?","Già rồi ngủ là chuyện thường.",""]]],["viec","Dạ, {c} ghé hỏi {x} có gì nhờ hông.","Có chớ, đang tính kêu {c} đây.","Nhờ gì… mà thôi, cũng đang tính kêu {c}.",[["viec","Gì cũng được, {c} làm liền.","Vậy {x} nhờ {c} nè.","nho"],["dua","Nhờ ăn cơm giùm thì {c} rành nhất.","Ha ha, mấy cái đó thì {c} giỏi.",""],["le","Dạ, vậy {x} cứ từ từ nghĩ, có gì kêu {c}.","Ừ, có gì {x} kêu.",""]]]]},{"c":"lai","mo":"Ghé nữa hả? Coi bộ ở nhà {c} buồn lắm.","r":[["dua","Dạ, ở nhà nói chuyện với con gà mà nó không thèm trả lời.","Ha ha, ít ra {x} còn biết trả lời.","Gà không trả lời thì qua đây bắt {x} trả lời hả?",[["dua","Dạ, {x} trả lời hay hơn con gà nhiều.","Ha ha, so {x} với con gà. Thôi ngồi đi.",""],["hoi","Vậy {x} kể {c} nghe chuyện gì vui đi.","Chuyện vui hả, nghe nè.","ke"],["le","Dạ, {c} qua ngồi chút cho có người nói chuyện.","Ờ, ngồi đi, {x} cũng buồn.",""]]],["hoi","Dạ, {c} ghé coi {x} có cần gì thêm hông.","Có đó, đang thiếu chút đồ.","Ghé hoài để hỏi câu đó. Ờ thì cũng đang thiếu chút đồ.",[["viec","Thiếu gì {x} nói {c} đi kiếm.","Vậy {x} nhờ {c} nè.","nho"],["dua","Thiếu tiền thì {c} cũng thiếu.","Ha ha, vậy thôi khỏi.",""],["le","Dạ, cần gì {x} cứ kêu {c}.","Ừ, có gì {x} kêu.",""]]],["ca","Bộ nhà {x} vui lắm hả mà {c} không ghé được?","Vui chớ, có con chó với con mèo.","Bắt bẻ hả? Vui chớ, có con chó với con mèo, đỡ hơn {c}.",[["dua","Vậy {c} ghé chơi với con mèo.","Mèo nó khó tính lắm đó.",""],["le","{C} giỡn thôi, nhà {x} vui mà.","Ừ, giỡn vậy được.",""],["ca","Chó mèo mà vui gì.","Vậy về đi.",""]]]]},{"c":"lai","mo":"Mới đi đó đã quay lại, bộ để quên cái gì hả?","r":[["dua","Dạ, để quên cái bụng đói ở đây.","Ha ha, vô lấy chén cơm nguội nè.","Đói thì về nhà nấu. Còn chén cơm nguội đó, ăn thì ăn.",[["dua","Cơm nguội với mắm là ngon nhất.","Đó, biết ăn. Cầm về ít mắm nữa nè.","tang"],["le","Dạ, {c} giỡn, {c} ăn rồi.","Ờ, vậy ngồi chơi.",""],["ca","Cơm nguội thì thôi {c} nhịn.","Kén ăn dữ.",""]]],["viec","Dạ, quên hỏi {x} có muốn {c} mang gì qua hông.","Có, {x} cần nè.","Cần gì {x} tự kiếm… mà thôi, cũng đang cần chút đồ.",[["viec","{X} cứ nói, {c} kiếm.","Vậy nhờ {c} nha.","nho"],["hoi","Mà {x} thích ăn gì nhất?","À, {x} mê món này nhất.","ke"],["dua","Mang con gà qua nhậu được hông?","Ha ha, nhậu thì tối nha.",""]]],["le","Dạ, quên chào {x} cho đàng hoàng.","Trời, lễ phép dữ, chào rồi đó thôi.","Chào gì chào hoài, chào rồi đó thôi.",[["dua","Chào hai lần cho chắc.","Ha ha, ba lần đi cho đủ bộ.",""],["le","Dạ, chào {x} rồi {c} về, {x} giữ sức khỏe nha.","Ừ, {c} cũng vậy.",""],["ca","Chào mà {x} không chào lại.","Chào chào chào, được chưa.",""]]]]},{"c":"lai","mo":"Trời, {c} lại tới. Chắc {c} thương {x} rồi đó.","r":[["dua","Dạ, thương nhà {x} có nồi cơm ngon.","Ha ha, thương cơm chớ thương ai.","Thương cơm chớ thương ai, biết mà.",[["dua","Thương luôn người nấu.","Ha ha, miệng dẻo. Cầm ít bánh về ăn.","tang"],["le","Dạ, thương {x} thiệt mà.","Ờ, vậy được.",""],["ca","Cơm nhà {x} cũng thường.","Thường mà ăn ba chén.",""]]],["khen","Dạ, nhà {x} vui nhất xóm nên {c} ghé hoài.","Đó, nói phải. Ngồi đi.","Vui gì, nhà {x} buồn hiu.",[["khen","Có {x} là vui rồi.","Trời, nghe sướng lỗ tai.",""],["hoi","Bữa nay {x} có chuyện gì vui hông?","Có, nghe nè.","ke"],["viec","Vậy để {c} phụ {x} chút việc cho có không khí.","Ờ, vậy nhờ {c} nha.","nho"]]],["ca","Thương gì, {c} ghé coi {x} có nấu gì ngon hông thôi.","Ha ha, thiệt thà ghê. Có nồi canh chua nè.","Biết ngay mà. Có nồi canh chua đó.",[["dua","Canh chua thì {c} ở lại tới chiều.","Ở đi, rửa chén giùm.",""],["le","Dạ, {c} giỡn thôi, mà canh chua thì {c} xin một chén.","Ừ, múc đi.",""],["ca","Canh chua mà không có cá.","Có thì ăn, không thì thôi.",""]]]]},{"c":"lai","mo":"Lần thứ ba trong ngày rồi đó. Mai {x} phải treo bảng \"Nghỉ tiếp khách\".","r":[["dua","Treo bảng thì {c} trèo cửa sổ vô.","Ha ha, vậy {x} thả con Vện canh cửa sổ.","Trèo cửa sổ là {x} thả chó ra liền.",[["dua","Thả chó thì {c} mang theo cục xương.","Ha ha, con chó nó theo {c} luôn.",""],["le","Dạ, vậy lần này {c} ghé chút rồi thôi.","Ừ, vậy được.",""],["hoi","Bữa nay {x} mệt hả, sao khó dữ?","Hơi mệt, mà {c} hỏi là vui. Nghe nè.","ke"]]],["le","Dạ, {c} xin lỗi làm phiền {x} hoài.","Phiền gì, {x} giỡn đó.","Ờ, biết phiền là tốt.",[["viec","Phiền thì {c} trả bằng công, có gì cần {x} cứ nói.","Có nè, nhờ {c} nha.","nho"],["dua","Vậy mai {c} ghé bốn lần cho đủ bộ.","Ha ha, chịu thua.",""],["le","Dạ, {c} về cho {x} nghỉ.","Ừ, về cẩn thận.",""]]],["ca","Treo bảng thì xóm tưởng nhà {x} có chuyện.","Ha ha, có chuyện thiệt đó, chuyện {c} ghé hoài.","Kệ xóm. Chuyện nhà {x} là chuyện {c} ghé hoài đó.",[["dua","Chuyện này chắc lên loa phường.","Loa xóm thôi.",""],["le","Thôi {c} về cho {x} nghỉ.","Ừ.",""],["ca","{X} khó tính quá à.","Ờ, khó mà vẫn mở cửa cho {c} vô đó.",""]]]]},{"c":"lau","mo":"Ủa, còn sống hả? Tưởng {c} dọn đi đâu mà không chào ai.","r":[["dua","Dạ, {c} đi trốn nợ mấy bữa, giờ êm rồi mới về.","Nợ ai? Nói nghe coi, {x} còn biết đường né.","Trốn nợ mà khoe, giỏi ghê. Nợ ai, nói nghe coi.",[["viec","Nợ tiền phân bón, giá lên cắt cổ.","Đó, {x} nói hoài, ủ phân chuồng mà xài.","ke"],["dua","Nợ {x} chứ ai.","{X} có cho mượn đồng nào đâu? À mà khoan…",""],["ca","Nợ ai thì bí mật, {x} đừng hỏi.","Bí mật thì về đi, {x} không rảnh.",""]]],["viec","Dạ, {c} lo mùa vụ quá, mà lúa năm nay rớt giá.","Rớt giá thì đừng bán, phơi khô cất đó. Đứa nào bán lúc rẻ là đứa đó dại.","Ai biểu bán lúc rẻ. Rớt giá thì phơi khô cất đó.",[["viec","Vậy {c} cất, chờ lên giá {x} nhắc {c} nha.","Được, mà {x} gom lúa bán chung, {c} phụ {x}.","pq"],["hoi","Mà {c} cần tiền liền {x} ơi.","Cần tiền thì làm thêm, đừng bán lúa rẻ.",""],["ca","{X} tính kỹ dữ, hèn chi giàu mà ở nhà lá.","Nhà lá mát, {c} biết gì.",""]]],["le","Dạ, {c} xin lỗi, tại {c} bận quá.","Bận thì bận, ghé được là {x} mừng rồi.","Bận gì mà bận, bận cũng phải ăn cơm. Đừng có màu mè.",[["dua","Thiệt ra {c} ham ngủ quá nên quên ghé {x}.","Ha, thẳng vậy được.",""],["le","Dạ, {c} biết lỗi rồi, mai {c} ghé nữa.","Ừ, thôi bỏ qua.",""],["ca","Bận mà còn ghé là quý rồi, {x} đừng có kể.","Ừ, quý dữ, tháng ghé có một lần.",""]]]]},{"c":"lau","mo":"Mấy bữa nay hổng thấy mặt, {x} tưởng {c} giận xóm.","r":[["hoi","Dạ đâu có, mấy bữa nay nhà {x} khỏe hông?","Khỏe, mà nhớ {c} đó. Có {c} ghé là vui.","Khỏe hay không thì {c} cũng có ghé đâu mà biết. Mà nhớ {c} đó.",[["le","Dạ, từ nay {c} ghé thường.","Nhớ đó, nói là phải làm.",""],["dua","{C} nhớ {x} muốn khóc mà không dám ghé.","Ha ha, xạo ghê.",""],["viec","Có gì cần {c} phụ hông {x}?","Có, để dành cả tuần chờ {c} nè.","nho"]]],["dua","Giận gì, {c} đi thi hoa hậu nên bận.","Ha ha, thi đậu chưa?","Hoa hậu gì, soi gương chưa? Thi chắc rớt.",[["dua","Rớt, tại giám khảo không có mắt nhìn.","Ha ha, đúng rồi, giám khảo dở.",""],["hoi","Mấy bữa nay xóm có chuyện gì hông {x}?","Có, chuyện này nè.","ke"],["ca","Đậu hay rớt gì {c} cũng đẹp hơn {x}.","Về soi gương lại đi.",""]]],["ca","Xóm có gì đâu mà giận.","Ờ, mà xóm nhắc {c} quá trời.","Không giận mà nói giọng đó. Xóm nhắc {c} quá trời kìa.",[["hoi","Xóm nhắc {c} chuyện gì vậy {x}?","Nhắc {c} nợ tiền quán đó.",""],["dua","Nhắc chắc tại {c} đẹp.","Ha ha, tự tin ghê.",""],["le","{C} giỡn thôi {x}, {c} nhớ xóm lắm.","Ừ, nhớ thì ghé.",""]]]]},{"c":"lau","mo":"Trời đất, {c} đi đâu mất biệt mấy bữa nay? Ruộng nhà {c} cỏ lên tới đầu gối rồi kìa.","r":[["viec","Dạ, {c} về nhổ liền đây, mà {x} có cuốc dư hông?","Có, mượn đi, mà nhớ trả.","Cuốc thì mua, mượn hoài. Thôi mượn đi, nhớ trả.",[["viec","Mượn xong {c} trả kèm ít đồ.","Vậy {x} nhờ {c} chút việc luôn.","nho"],["dua","Trả kèm cái cảm ơn được hông?","Cảm ơn không ăn được.",""],["le","Dạ, nhổ xong {c} rửa sạch rồi trả.","Ừ, vậy được.",""]]],["dua","Cỏ lên cao thì {c} nuôi bò, khỏi nhổ.","Ha ha, bò ở đâu?","Lười mà còn kiếm cớ. Bò đâu mà nuôi?",[["dua","Thì mượn bò nhà {x}.","Ha ha, mượn thì trả cỏ.",""],["viec","Thôi {c} về nhổ, cảm ơn {x} nhắc.","Ừ, nhổ xong rải tro là cỏ lâu mọc lại, mẹo của {x} đó.","ke"],["ca","Cỏ thì kệ cỏ.","Kệ thì kệ.",""]]],["hoi","Dạ, {c} bị ốm mấy bữa. Nhà {x} có ai ốm hông?","Trời, ốm hả? Vậy mà không nói. Nhà {x} khỏe.","Ốm mà còn ghé được, chắc ốm nhẹ. Nhà {x} thì khỏe.",[["le","Dạ, giờ khỏe rồi.","Ừ, giữ sức. Cầm ít đồ bồi bổ nè.","tang"],["dua","Ốm mà nhớ cơm nhà {x}.","Ha ha, cơm là thuốc.",""],["ca","Ốm mà không ai thăm.","Ai biết mà thăm.",""]]]]},{"c":"lau","mo":"Ủa, ai đây? Nhìn quen quen mà không nhớ tên.","r":[["dua","Dạ, người quen cũ của {x} nè, bị {x} quên rồi.","Ha ha, nhớ chớ, giỡn thôi.","Quên thiệt luôn đó, nhắc tên coi.",[["dua","{X} quên thì {c} buồn ba ngày.","Ba ngày thì lâu quá, một ngày thôi.",""],["le","Dạ, {c} nè, lâu quá mới ghé thăm {x}.","Đó, giỡn chút mà tưởng thiệt. Ngồi đi, {x} kể chuyện này.","ke"],["ca","Già rồi quên là phải.","{C} mới già.",""]]],["le","Dạ, {c} đây, lâu quá {c} mới ghé.","Ừ, nhớ rồi. Lâu quá.","Lâu thiệt, lâu tới quên luôn.",[["hoi","Dạo này nhà mình sao {x}?","Cũng vậy, mà có chuyện này nè.","ke"],["viec","Có gì cần {c} phụ hông?","Có, nhờ {c} nè.","nho"],["dua","Lâu vậy mà {x} còn nhận ra {c} là giỏi rồi.","Nhận ra chớ, cái đứa hay ăn ké.",""]]],["ca","Có ghé hay không thì {x} cũng đâu có nhớ.","Ờ, mà ghé thì vẫn mừng.","Nói vậy thì về đi… mà thôi, ghé rồi thì ngồi.",[["dua","Vậy {c} ghé hoài cho {x} nhớ.","Ha ha, vậy được.",""],["le","{C} giỡn, từ nay {c} ghé thường.","Ừ.",""],["ca","Vậy {c} về thiệt nha.","Ừ… mà mai ghé nữa.",""]]]]},{"c":"lau","mo":"Lâu dữ, {c} mà không ghé là {x} tưởng {c} đi lấy vợ lấy chồng xứ khác rồi.","r":[["dua","Dạ, chưa ai thèm lấy {c} nên còn ở đây.","Ha ha, tội nghiệp. Để {x} mai mối cho.","Không ai lấy là phải. Thôi để {x} mai mối cho.",[["dua","Mai mối thì chọn người nấu ăn ngon.","Ha ha, có một người này nè.",""],["hoi","{X} biết ai được hông?","Biết chớ, nói nhỏ nè, có đứa xóm trên để ý {c} lâu rồi.","ke"],["ca","Thôi {x} lo cho nhà {x} trước.","Nói gì đó?",""]]],["viec","Dạ, {c} lo làm ăn, chưa tính chuyện đó.","Ừ, làm ăn trước, mà đừng để lâu.","Lo làm hoài thành ông già bà cả luôn.",[["viec","Làm có của rồi mới tính {x}.","Phải. Mà {x} nhờ {c} chút việc.","nho"],["dua","Thành ông già thì {c} làm ông mai.","Ha ha.",""],["hoi","Hồi đó {x} lấy nhau sao vậy?","Coi mắt có một lần là chịu. Nghe {x} kể nè.","ke"]]],["ca","Xứ khác có gì hay đâu mà đi.","Ờ, ở làng là nhất.","Không hay mà ai cũng đi.",[["khen","Làng mình nhất, nhà {x} nhì.","Ha ha, nói vậy {x} ưng.","tang"],["dua","Đi rồi cũng về, xứ khác đâu có cơm nhà {x}.","Ha ha.",""],["ca","Ai đi thì đi, {c} ở lại ăn ké {x}.","Ăn ké hoài, về đi.",""]]]]},{"c":"mua","mo":"Mưa dầm gì mà mấy bữa không ngớt, nhà {x} ẩm mốc hết trơn.","r":[["hoi","Nhà {x} có dột chỗ nào hông?","Dột chỗ bàn thờ, {x} lo quá.","Dột thì {x} tự sửa. Dột ngay chỗ bàn thờ chớ đâu.",[["viec","Để {c} sửa mái giùm {x}.","Được, vậy {x} nhờ {c} kiếm đồ.","nho"],["dua","Dột chỗ bàn thờ chắc ông bà muốn tắm.","Ha ha, giỡn vậy ông bà quở đó.",""],["le","Chỗ đó {x} kê tạm cái thau đi, kẻo ướt lư hương.","Ờ, kê rồi, mưa nữa là tràn.",""]]],["dua","Mưa vầy khỏi tưới, {c} ngủ nướng cả tuần.","Ha ha, sướng ghê. Mà ruộng ngập tới nơi rồi đó.","Ngủ hoài, ruộng ngập kìa.",[["dua","Ruộng ngập thì nuôi cá luôn.","Ha ha, ý hay.",""],["viec","Ngập thì phải khơi mương thoát nước.","Ừ, mai {x} khơi, {c} phụ nha.","nho"],["ca","Ngập thì kệ, trời làm.","Kệ thì lúa chết.",""]]],["viec","Mưa vầy phải lo gom lúa vô kho {x}.","Đúng, {x} gom gần hết rồi. Còn thiếu bao.","Lo cho {c} đi. Mà nhà {x} cũng còn thiếu bao.",[["viec","{C} có bao dư, để {c} đem qua.","Vậy {x} đổi lại cho {c} ít đồ.","tang"],["dua","Thiếu bao thì đựng trong nón.","Ha ha.",""],["hoi","{X} cần bao nhiêu bao?","Vài cái thôi, có thì đem qua.",""]]]]},{"c":"mua","mo":"Trời mưa vầy {c} còn đi được, chắc nhà {c} có áo mưa xịn.","r":[["dua","Dạ, áo mưa là bao nilon đó {x}.","Ha ha, bao nilon mà chạy như ninja.","Bao nilon mà khoe.",[["dua","Bao nilon mà khô hơn áo mưa nhà {x} đó.","Ha ha, cái này thì {x} chịu.",""],["hoi","Nhà {x} có cần {c} mua giùm gì hông?","Có, nhờ {c} nè.","nho"],["ca","Áo mưa nhà {x} chắc còn thủng hơn.","Thủng mà còn hơn bao nilon.",""]]],["le","Dạ, mưa nhỏ thôi {x}, {c} ghé thăm chút.","Ghé thì vô trong cho khỏi ướt.","Mưa mà ghé, rảnh dữ. Vô trong lẹ đi.",[["hoi","Mưa vậy {x} có lạnh hông?","Lạnh chút, nấu nồi cháo nè, ăn đi.","tang"],["dua","Vô trong {c} ở luôn tới tạnh.","Tạnh thì tối luôn.",""],["viec","Mưa vầy {x} có cần dọn gì hông?","Có, nhờ {c} nè.","nho"]]],["ca","Áo mưa xịn gì, ướt như chuột.","Ha ha, chuột lột.","Ướt nhẹp vầy thì đứng ngoài, đừng vô.",[["dua","Chuột lột cũng cần chén cháo nóng.","Ha ha, vô ăn đi.","tang"],["le","Dạ, {c} đứng ngoài hiên thôi.","Thôi vô đi.",""],["ca","Cười gì, {x} ra đứng mưa thử coi.","{X} khùng đâu mà ra. Vô đi.",""]]]]},{"c":"han","mo":"Nắng gì mà cái lu nước nhà {x} còn có cái đáy. Chiều nay {x} ra bờ kênh tắm luôn.","r":[["dua","{X} tắm thì cho {c} theo, {c} mang xà bông, {x} mang cà phê.","Ha ha, được! Nhớ đem thêm cái loa.","Tắm ai nấy tắm. Cà phê thì {c} tự đem.",[["dua","{C} hát cho {x} nghe.","Hát dở thì cá trốn. Thôi chiều qua nhậu!","moi"],["viec","Mà nắng vầy phải đào mương dẫn nước {x}.","Ừ, {c} phụ {x} đào nha.","nho"],["le","Dạ, {c} giỡn, mà chiều {c} ra bờ kênh thiệt.","Ra thì ra, mà tắm xa xa {x} ra nghen.",""]]],["viec","Nắng vầy phải đào thêm mương dẫn nước {x} ơi.","Đào thì đào, mà ai đào? {X} vác cuốc là đau lưng ba ngày.","Nói thì dễ, ai đào? {X} vác cuốc là đau lưng ba ngày.",[["viec","{C} đào, {x} nấu cơm.","Chịu! Vậy nhờ {c} đem đồ qua làm.","nho"],["dua","Thuê con trâu đào.","Ha ha, trâu nó lười hơn {x}.",""],["ca","Lười thì chịu khát.","Nói giống ông hàng xóm quá.",""]]],["khen","Nắng vậy mà vườn {x} vẫn xanh, {x} giỏi ghê.","Xanh nhờ {x} gánh nước từ sáng. Mệt muốn xỉu.","Khen kiểu đó ai tin. Xanh nhờ {x} gánh nước từ sáng.",[["khen","Vậy mới nói {x} siêng nhất xóm.","Ha, nói vậy nghe sướng.",""],["viec","Để {c} gánh giùm {x} vài đôi.","Vậy {x} nhờ {c} luôn.","nho"],["ca","Gánh cả sáng mà mới xanh có nhiêu đó.","Lo vườn {c} đi.",""]]]]},{"c":"han","mo":"Nắng hạn quá, ruộng {c} có đủ nước hông?","r":[["viec","Dạ, {c} tưới ngày hai lần mà đất vẫn nứt.","Phủ rơm lên gốc đi, giữ ẩm được lâu.","Tưới vậy là phí nước. Phủ rơm lên gốc mà giữ ẩm.",[["viec","Rơm thì {c} thiếu, {x} có dư hông?","Có, mà {x} cũng cần đồ, đổi nha.","nho"],["le","Dạ, {c} cảm ơn {x} chỉ.","Ừ, còn mẹo này nữa nè, nghe nè.","ke"],["dua","Phủ rơm thì {c} nằm lên ngủ luôn.","Ha ha.",""]]],["dua","Dạ, ruộng {c} nứt nẻ như mặt {c} hồi sáng.","Ha ha, mặt {c} thì ai tưới.","Giỡn hoài. Mặt nứt thì tự rửa, ruộng nứt thì lo tưới.",[["dua","Thì {x} tưới giùm luôn cái mặt.","Ha ha, xách cái gáo lại đây.",""],["viec","Mà {x} có kinh nghiệm chống hạn hông?","Có chớ, nghe nè.","ke"],["ca","Nứt hết thì trồng xương rồng.","Trồng đi rồi ăn.",""]]],["hoi","Dạ đủ, còn nhà {x} sao?","Thiếu, cái giếng cạn gần đáy rồi.","Đủ thì thôi. Nhà {x} thì giếng cạn gần đáy.",[["viec","Để {c} gánh nước giùm {x}.","Vậy {x} nhờ {c} luôn.","nho"],["dua","Cạn giếng thì xuống đó bắt ếch.","Ha ha, ếch nó cũng đi rồi.",""],["le","Giếng nhà {c} còn nước, {x} qua múc nha.","Thiệt hả? Vậy {x} đổi cho {c} ít đồ.","tang"]]]]},{"c":"giong","mo":"Giông tới nơi rồi, mây đen kịt. {X} lo cái mái lá quá.","r":[["viec","Để {c} cột lại mái giùm {x}, lẹ lên.","Trời, có người phụ là quý. {X} đưa dây nè.","Cột hoài cũng bay. Thôi cột thì cột, dây nè.",[["viec","{X} kiếm thêm đồ, {c} cột chắc.","Ừ, nhờ {c} nha.","nho"],["dua","Bay thì mình làm nhà không nóc, ngắm sao.","Ha ha, ngắm sao mà mưa ướt.",""],["le","Dạ, {c} cột xong rồi {c} về.","Ừ, về lẹ kẻo giông.",""]]],["dua","Mái bay thì {x} có nhà mới, đẹp hơn.","Ha ha, tiền đâu làm nhà mới.","Giỡn lúc này hả? Tiền đâu làm nhà mới.",[["dua","Thì xóm góp mỗi nhà một tấm lá.","Ha ha, ý hay.",""],["viec","Thôi {c} phụ cột lại.","Vậy nhờ {c} nha.","nho"],["ca","Nhà {x} cũ quá rồi, bay cũng đáng.","Cũ mà ấm.",""]]],["hoi","{X} có cần {c} ở lại phụ hông?","Có {c} ở lại là {x} yên tâm.","Ở đây ướt hết… mà thôi, ở thì ở.",[["le","Dạ, {c} ở lại tới tạnh.","Ừ, ngồi đây ăn khoai.","tang"],["dua","Ở lại ăn ké luôn.","Ha ha, có khoai lang nè.",""],["viec","Mà {x} có cần chằng cây hông?","Có, nhờ {c} nè.","nho"]]]]},{"c":"giong","mo":"Hồi trưa giông lớn quá, cây dừa nhà {x} gãy một tàu rớt trúng chuồng gà.","r":[["hoi","Gà có sao hông {x}?","Không, gà nó chạy lẹ hơn người. Mà chuồng thì banh.","Gà không sao, chuồng thì banh.",[["viec","Để {c} sửa chuồng giùm.","Vậy {x} nhờ {c} đồ.","nho"],["dua","Gà chạy lẹ vậy cho đi thi.","Ha ha.",""],["le","Người với gà không sao là may rồi {x}.","Ừ, may. Cái chuồng thì từ từ.",""]]],["dua","Tàu dừa rớt trúng chuồng chắc gà tưởng trời sập.","Ha ha, tụi nó la như cháy nhà.","Giỡn hoài, mất cái chuồng đó. Tụi gà la như cháy nhà.",[["dua","Bữa nay gà nghỉ đẻ vì sợ.","Ha ha, chắc vậy.",""],["viec","Lấy tàu dừa làm mái chuồng mới luôn.","Ý hay, {x} cho {c} ít trứng nè.","tang"],["ca","Dừa già rồi chặt đi {x}.","Chặt cây dừa? Điên hả?",""]]],["viec","Dừa gãy thì {x} lấy tàu lợp chuồng luôn.","Đó, khéo. Mà phải có người leo dọn.","Tàu dừa mục rồi, mà cũng phải có người leo dọn.",[["viec","{C} leo dọn giùm.","Vậy {x} nhờ {c}.","nho"],["dua","Leo thì {x} leo, {c} đứng dưới vỗ tay.","Ha ha.",""],["ca","Leo dọn thì {x} kêu thằng cháu, nó trẻ.","Nó trẻ mà nó lười.",""]]]]},{"c":"lu","mo":"Nước nổi lên tới mắt cá rồi đó. Cá linh về quá trời mà nhà {x} thiếu người giăng lưới.","r":[["viec","Vậy mình giăng lưới bán cá chung đi {x}, lời chia đôi.","Ủa, {c} cũng biết tính ha. Mà chia đôi thì {c} phải ngâm nước từ bốn giờ sáng đó nghen.","Chia đôi? {C} có góp cái lưới nào đâu. Muốn chia thì ngâm nước từ bốn giờ sáng.",[["viec","Bốn giờ thì bốn giờ, {c} ngủ cũng có ai nuôi đâu.","Được, vậy {x} nhờ {c} đem đồ qua.","nho"],["dua","Bốn giờ hả… năm giờ được hông?","Năm giờ thì cá nó lên chợ trước {c} rồi.",""],["ca","Thôi {x} giăng đi, {c} đứng trên bờ coi chừng giùm.","Coi chừng cái gì, coi chừng {x} chết đuối hả?",""]]],["hoi","Nước lên vầy nhà {x} có ngập hông?","Ngập tới bậc thềm. Con heo nó tưởng nhà nó ra biển.","Ngập thì sao, {c} kê đồ giùm hả? Tới bậc thềm rồi, con heo tưởng ra biển.",[["viec","Để {c} qua phụ kê đồ lên cao.","Được, có người tử tế giữa mùa nước. Vậy {x} nhờ {c} luôn nghen.","nho"],["dua","Vậy cho heo đi bơi luôn, khỏi tắm.","Bơi xong nó cảm thì {c} nuôi hả?",""],["ca","Mùa nào chả vậy, {x} than chi.","Ờ, nhà {c} cao ráo nên nói ngon.",""]]],["dua","Cá linh về là {c} có nồi canh chua bông điên điển rồi!","Ha ha, đúng! Mà lo ăn thì lo, ruộng {c} cỏ cao hơn lúa rồi kìa.","Lo ăn hoài. Ruộng {c} cỏ mọc cao hơn lúa rồi kìa.",[["dua","Ăn no mới có sức nhổ cỏ chớ.","Lý sự. Mà thôi, cầm mớ cá về nấu.","tang"],["viec","Nhổ cỏ xong {c} qua học {x} nấu canh chua cá linh.","Vậy còn nghe được. Bí quyết là bông điên điển phải hái sáng sớm, nói nhỏ đó.","ke"],["ca","Cỏ đó {c} để nuôi dế.","Nuôi dế ăn cỏ hả? Thôi về đi.",""]]]]},{"c":"lu","mo":"Mùa nước nổi xuồng ghe chạy đầy kênh, {x} muốn đi chợ nổi mà xuồng thủng.","r":[["viec","Để {c} trét lại xuồng giùm {x}.","Trời, được thì quý. {X} thiếu chai trét.","Xuồng cũ quá rồi, trét thì trét, mà thiếu chai trét.",[["viec","{X} kiếm đồ, {c} trét.","Vậy nhờ {c} nha.","nho"],["dua","Xuồng thủng thì vừa chèo vừa tát nước.","Ha ha, vừa tập thể dục.",""],["hoi","Xuồng này {x} xài bao năm rồi?","Hơn chục năm, {x} quý nó lắm.","ke"]]],["dua","Xuồng thủng thì {x} bơi đi chợ cho khỏe.","Ha ha, bơi tới chợ thì chợ tan.","Bơi gì, già rồi. Bơi tới chợ thì chợ tan.",[["dua","Thì {c} chở {x} đi.","Ha ha, vậy mai đi chợ nha.","moi"],["hoi","{X} muốn mua gì ở chợ nổi?","Mê nhất là món này nè.","ke"],["ca","Già mà ham đi chợ.","Đi chợ là vui.",""]]],["hoi","Chợ nổi mùa này có gì vui hông {x}?","Vui lắm, bán đủ thứ, ăn hủ tiếu trên ghe.","Vui thì {c} đi một mình đi. Ăn hủ tiếu trên ghe đó.",[["dua","Hủ tiếu trên ghe ăn xong say sóng.","Ha ha.",""],["viec","{C} chở {x} đi, {x} chỉ chỗ mua rẻ.","Được, đi nha.","moi"],["le","Dạ, {x} chỉ {c} ghe nào nấu ngon nhất, bữa nào {c} đi thử.","Ghe hủ tiếu bà Tư, {x} mê nhất đó.","ke"]]]]},{"c":"xuan","mo":"Sắp Tết rồi, nhà {x} còn chưa gói bánh tét nữa {c} ơi.","r":[["viec","Để {c} qua phụ gói, {x} lo nếp với đậu.","Được, có người phụ là gói được nhiều. Mà {x} còn thiếu đồ.","{C} gói xấu hoắc. Mà thôi, {x} còn thiếu đồ nữa.",[["viec","Thiếu gì {c} kiếm.","Vậy nhờ {c} nha.","pq"],["dua","Đòn nào {c} gói méo thì để {c} ăn.","Ha ha, ăn hết thì lấy gì cúng.",""],["le","Dạ, {c} qua học {x} gói cho đẹp.","Ừ, qua học. Bí quyết là cột lạt cho chặt, {x} chỉ mình {c} thôi đó.","ke"]]],["dua","Bánh tét nhà {x} năm ngoái còn nhớ mùi.","Ha ha, năm nay ngon hơn. Gói xong cho {c} một đòn.","Nhớ mùi mà không nhớ phụ gói. Gói xong thì cho {c} một đòn, ráng mà nhớ.",[["dua","Một đòn ít quá, hai đòn đi.","Ha ha, tham. Thôi cầm luôn hai đòn nè.","tang"],["viec","Vậy năm nay {c} phụ gói.","Vậy nhờ {c} nha.","nho"],["ca","Năm ngoái hơi mặn.","Mặn thì đừng ăn.",""]]],["hoi","Tết năm nay nhà {x} có ai về hông?","Có, mấy đứa con trên thành phố về đủ.","Về đủ mà có phụ gì đâu, về ăn thôi.",[["khen","Vậy là nhà {x} đông vui nhất xóm.","Chớ sao. Tết qua chơi nha.","moi"],["dua","Về đủ thì nhà {x} chật như nêm.","Ha ha, chật mà vui.",""],["viec","Đông vậy chắc {x} cần thêm đồ đãi Tết.","Cần chớ, nhờ {c} nha.","nho"]]]]},{"c":"xuan","mo":"Mai vàng nhà {x} năm nay nở sớm quá, sợ Tết là rụng hết.","r":[["viec","Tưới nước đá lạnh vô gốc cho nó chậm lại {x}.","Thiệt hả? Ừ, để thử. Mà {x} mê mai lắm đó.","Nước đá đâu ra, xa xỉ. Mà {x} mê mai lắm, rụng là tiếc.",[["viec","{C} mang nước đá qua giùm.","Vậy {x} cảm ơn, cầm ít bánh mứt nè.","tang"],["hoi","{X} trồng mai bao lâu rồi?","Hai chục năm. {X} mê nhất là mai.","ke"],["dua","Mai rụng thì dán hoa giấy lên.","Ha ha, ai mà dán.",""]]],["khen","Mai nhà {x} đẹp nhất xóm.","Đó, nói đúng. Cả xóm qua chụp hình.","Đẹp gì, nở sớm vầy là xui.",[["khen","Nở sớm là Tết này nhà {x} nhiều lộc.","Ha ha, nói vậy {x} ưng. Tết qua chơi.","moi"],["hoi","{X} chăm mai kiểu gì vậy?","Lặt lá đúng ngày. Bí quyết đó.","ke"],["ca","Nở sớm thì Tết khỏi thấy.","Đừng có trù.",""]]],["dua","Mai nở sớm chắc nó nôn ăn Tết.","Ha ha, giống {c}.","Giỡn hoài. Nó nôn như {c} nôn lì xì vậy.",[["dua","Ừ, {c} cũng nôn lì xì.","Ha ha, lì xì thì {x} có.","tang"],["viec","Mà {x} có cần {c} phụ gì Tết hông?","Có, nhờ {c} nè.","nho"],["ca","Nôn gì, tại {x} lặt lá sớm thì có.","Rành hơn {x} hả?",""]]]]},{"c":"he","mo":"Trời hè nóng như lò bánh mì, {x} ngồi đây cũng đổ mồ hôi.","r":[["dua","Nóng vầy {x} làm nước đá bán, giàu luôn.","Ha ha, nước đá chưa kịp bán là tan.","Giỡn gì, nóng muốn xỉu. Nước đá chưa kịp bán là tan.",[["dua","Tan thì {x} bán nước lạnh.","Ha ha, ý hay.",""],["viec","Mà {x} có cần {c} gánh nước hông?","Có, nhờ {c} nha.","nho"],["hoi","{X} uống nước nhiều vô nha.","Ừ, {c} cũng vậy.",""]]],["hoi","Nóng vậy {x} có mệt hông?","Mệt, mà quen rồi. Ngồi đây uống ly chè đậu nè.","Mệt thì nằm, hỏi chi. Đó, ly chè đậu, uống đi.",[["le","Dạ, {c} cảm ơn.","Uống đi, còn nồi nữa đó.","tang"],["dua","Chè ngon vầy {c} uống ba ly.","Ha ha.",""],["viec","Mùa hè trái cây nhiều, {x} có bán hông?","Có, mà {x} mê ăn hơn bán.","ke"]]],["viec","Hè là mùa trái cây, {x} đem ra chợ bán đi.","Ừ, mà ai chở? {X} đi xe đạp mỏi giò.","Ăn còn không đủ. Mà có bán thì ai chở?",[["viec","{C} chở {x} ra chợ.","Vậy nhờ {c} nha.","nho"],["dua","Ăn không đủ thì {c} phụ ăn.","Ha ha.",""],["hoi","Vườn {x} trái gì ngon nhất?","Xoài cát. {X} mê nhất món này.","ke"]]]]},{"c":"thu","mo":"Mùa thu trời mát, mà nước bắt đầu lên rồi đó, coi chừng ruộng.","r":[["viec","Dạ, {c} đắp bờ cao rồi, {x} đắp chưa?","Chưa, đang tính kêu người.","Đắp thì đắp, nói chi. Mà chưa có người.",[["viec","{C} phụ {x} đắp.","Vậy nhờ {c}.","nho"],["dua","Kêu {c} là rẻ nhất.","Ha ha, trả bằng cơm.",""],["ca","Chưa đắp mà ngồi đây, nước tới là khóc.","Trù hoài.",""]]],["hoi","Mùa này {x} trồng gì?","Trồng ít rau, chờ nước rút gieo lúa.","Trồng gì kệ {x}. Thì ít rau, chờ nước rút gieo lúa.",[["viec","Mùa này rau muống ăn không hết.","Ừ, mà {x} mê món này hơn.","ke"],["dua","Trồng rau rồi nuôi cá luôn.","Ha ha.",""],["hoi","Rau gì vậy {x}, cho {c} xin ít giống.","Rau muống với cải. Cầm ít giống về nè.","tang"]]],["dua","Trời mát vầy ngủ trưa đã ghê {x}.","Ha ha, đúng, {x} ngủ một giấc tới chiều.","Ngủ hoài, ruộng ai lo. Mà công nhận ngủ trưa mùa này đã.",[["dua","Ruộng thì để trâu lo.","Ha ha.",""],["viec","Mà {x} có cần {c} phụ gì hông?","Có nè.","nho"],["ca","Ruộng {x} cũng có ai lo đâu.","Nói gì?",""]]]]},{"c":"dong","mo":"Mùa khô gió bấc lạnh lạnh, {x} nhớ hồi xưa đốt rơm sưởi.","r":[["hoi","Hồi xưa {x} sưởi rơm với ai vậy?","Với ông bà, rồi nướng khoai. Nhớ quá.","Hồi xưa thì kệ hồi xưa… mà nhớ, nướng khoai với ông bà.",[["dua","Vậy bữa nay mình nướng khoai đi {x}.","Ha ha, được, {x} có khoai nè.","tang"],["le","Dạ, nghe {x} kể thấy thương.","Ừ, {x} kể {c} nghe chuyện này.","ke"],["ca","Hồi xưa khổ mà nhớ chi.","Khổ mà vui.",""]]],["dua","Đốt rơm sưởi thì muỗi cũng tới sưởi ké.","Ha ha, muỗi nó cũng lạnh.","Giỡn vô duyên. Mà muỗi nó lạnh thiệt.",[["dua","Vậy {x} đốt thêm cho muỗi.","Ha ha.",""],["viec","Mùa khô phải trữ nước đó {x}.","Ừ, {x} thiếu lu, {c} kiếm giùm.","nho"],["hoi","Hồi xưa đốt rơm {x} có nướng gì ăn hông?","Khoai lang mật chớ gì. Nghe {x} kể nè.","ke"]]],["viec","Mùa khô là mùa gặt, {x} gặt chưa?","Chưa, thiếu người.","Gặt thì gặt, kệ {x}. Thiếu người thì từ từ.",[["viec","{C} phụ {x} gặt.","Vậy nhờ {c} nha.","nho"],["dua","Gặt xong {x} đãi bữa nhậu.","Ha ha, được.","moi"],["ca","Thiếu người là tại {x} trả công rẻ.","Rẻ mà có cơm.",""]]]]},{"c":"he","mo":"Trưa hè gà nó cũng nằm thè lưỡi. {X} tính bán bớt mấy con cho đỡ cực.","r":[["viec","Bán lúc này giá cao đó {x}, đúng mùa đám tiệc.","Vậy hả? Vậy {x} bán, mà cần người bắt gà.","Bán hay không là chuyện {x}. Mà bán thì cũng cần người bắt gà.",[["viec","{C} bắt giùm, {x} lo cân.","Được, nhờ {c} nha.","nho"],["dua","Bắt gà thì {c} té lăn cù.","Ha ha, té thì gà cười.",""],["ca","Bắt gà thì {x} tự bắt, tập thể dục.","Già rồi tập gì nổi.",""]]],["dua","Gà thè lưỡi chắc nó đòi máy lạnh.","Ha ha, gà nhà giàu.","Giỡn hoài. Máy lạnh người còn không có.",[["dua","Cho nó cái quạt mo là được.","Ha ha, quạt cho gà, thôi cầm vài trứng về.","tang"],["hoi","Mà {x} nuôi gà mấy năm rồi?","Lâu rồi, {x} mê nuôi gà lắm.","ke"],["ca","Gà nhà {x} yếu quá.","{C} yếu thì có.",""]]],["hoi","Nóng vầy {x} cho gà uống nước đủ hông?","Đủ, mà nó cứ đá đổ hoài.","Hỏi chi, {x} nuôi gà mấy chục năm. Đủ, mà nó cứ đá đổ hoài.",[["viec","Để {c} làm cái máng nước chắc hơn.","Vậy nhờ {c}.","nho"],["dua","Gà đá đổ chắc nó tập đá banh.","Ha ha.",""],["le","{X} để chậu nước trong bóng mát thì gà đỡ đá.","Ừ, để thử.",""]]]]},{"c":"dam","mo":"Tuần sau nhà {x} có đám, định làm mười mâm. Cả xóm phải biết nhà này làm lớn.","r":[["khen","Mười mâm lận! Cả làng chắc chỉ nhà {x} làm nổi.","Chớ sao. Mà nói nhỏ nghe, {x} còn thiếu mấy món, đi mua thì mất mặt.","Khen gì, nói như nịnh. Mà nói nhỏ nghe, {x} còn thiếu mấy món.",[["viec","Để {c} lo giùm, {x} cần gì?","Vậy nhờ {c} nha.","pq"],["dua","Thiếu thì làm chín mâm thôi.","Chín mâm thì nói ai nghe!",""],["le","Dạ, {c} kín miệng lắm, {x} yên tâm.","Ừ, nói nhỏ nè, {x} mê món này mà ngại đi mua.","ke"]]],["viec","Mười mâm tốn dữ lắm nha {x}.","Tốn thì tốn, tiền để làm gì? Để người ta nói nhà này keo hả?","Tiền {x}, {c} lo gì. Để người ta nói nhà này keo hả?",[["khen","Dạ, làm lớn là phải.","Đó, biết điều. Bữa đó qua nha.","moi"],["le","{C} hỏi vậy thôi, {x} đừng giận.","{X} đâu có giận.",""],["ca","Mười mâm mà khách ăn có năm.","Ăn không hết thì gói về, cho người ta nhớ.",""]]],["dua","Mười mâm thì {c} nhịn đói ba bữa trước để qua ăn.","Ăn thì ăn, mà nhớ khen đồ ăn ngon lớn lớn cho người ta nghe.","Ăn thì ăn, mà nhớ khen lớn lớn cho người ta nghe.",[["khen","{C} khen to nhất xóm luôn.","Đó. Nhớ qua nha.","moi"],["dua","Lỡ dở thì sao {x}?","Dở cũng khen!",""],["ca","{C} ăn thôi, khen là chuyện khác.","Vậy khỏi qua.",""]]]]},{"c":"dam","mo":"Đám nhà {x} sắp tới mà cái rạp còn chưa ai dựng, {x} rầu thúi ruột.","r":[["viec","Để {c} kêu mấy đứa trong xóm qua dựng.","Trời, được vậy thì quý. Mà {x} thiếu đồ dựng.","Kêu tụi nó thì phải bao nhậu. Mà {x} cũng thiếu đồ dựng.",[["viec","{X} kiếm đồ, {c} lo người.","Vậy nhờ {c} nha.","nho"],["dua","{X} bao tụi nó một chầu là tụi nó dựng hai cái rạp.","Ha ha, một cái thôi, nhậu ít thôi.",""],["hoi","Rạp dựng bao lớn {x}?","Đủ mười mâm. Nghe nè, {x} tính vầy.","ke"]]],["dua","Thôi làm đám ngoài trời, ngắm sao luôn.","Ha ha, mưa thì sao?","Giỡn lúc này hả? Mưa thì sao?",[["dua","Mưa thì phát áo mưa cho khách.","Ha ha, khách nào chịu.",""],["viec","Thôi {c} phụ dựng rạp.","Vậy nhờ {c}.","nho"],["ca","Mưa thì khách về sớm, đỡ tốn.","Nói vậy mà nghe được hả?",""]]],["hoi","{X} cần mấy người phụ?","Chừng năm người, mà ai cũng bận.","Cần thì {x} tự kêu… mà ai cũng bận, cần năm người.",[["le","{C} qua một người.","Ừ, quý lắm, bữa đó ở lại ăn.","moi"],["dua","{C} làm bằng năm người.","Ha ha, ăn bằng năm người thì có.",""],["viec","{C} kiếm đồ giùm luôn.","Vậy nhờ {c}.","pq"]]]]},{"c":"dam","mo":"Nhà {x} có đám mà khách mời đông quá, không biết ghế đâu đủ ngồi.","r":[["viec","{C} mượn ghế nhà mấy người trong xóm cho.","Vậy thì đỡ. Bữa đó {c} nhớ qua.","Mượn thì mượn, đừng làm hư. Bữa đó nhớ qua.",[["viec","Có gì {x} cần thêm hông?","Có, nhờ {c} nè.","nho"],["dua","Thiếu ghế thì cho khách ngồi chiếu.","Ha ha, ngồi chiếu cho vui.",""],["le","Dạ, bữa đó {c} qua sớm phụ bưng.","Ừ, qua sớm, {x} chừa chỗ.","moi"]]],["khen","Đông vậy là nhà {x} có tiếng.","Chớ sao. Bữa đó {c} qua phụ đãi khách nha.","Tiếng gì, mời cho có. Mà bữa đó qua phụ đãi khách nha.",[["khen","{C} qua liền.","Ừ.","moi"],["dua","Đông vậy chắc hết đồ ăn.","Ha ha, {x} nấu dư.",""],["ca","Mời nhiều chi cho tốn.","Lo cho {c} đi.",""]]],["dua","Thiếu ghế thì cho khách đứng ăn cho lẹ.","Ha ha, đứng ăn kiểu tiệc Tây.","Kỳ cục. Đứng ăn như tiệc Tây hả?",[["dua","Tiệc Tây miệt vườn.","Ha ha, sang quá.",""],["viec","Thôi {c} đi mượn ghế.","Vậy nhờ {c}.","nho"],["ca","Đông vậy chắc nửa xóm tới ăn chực.","Ăn chực mà có đem quà là được.",""]]]]},{"c":"nho","mo":"Món {x} nhờ hồi nãy {c} kiếm được chưa? {X} chờ dài cổ.","r":[["le","Dạ, {c} đang gom, chút xíu nữa {c} mang qua.","Ừ, nhớ đó, {x} cần gấp.","Chút xíu của {c} là ba ngày. {X} cần gấp à nha.",[["le","Dạ, {c} nhớ mà, chiều là có.","Ừ, chiều đó.",""],["dua","Gấp vậy chắc cổ {x} dài thành hươu cao cổ rồi.","Ha ha, tại {c} đó.",""],["ca","Gấp thì {x} tự đi mua.","Nói vậy hả?",""]]],["dua","Dạ, {c} đang kiếm, mà món đó trốn kỹ quá.","Ha ha, kiếm kỹ đi, {x} chờ.","Trốn gì, lười thì nói lười. {X} chờ đó.",[["dua","{X} cho {c} mượn con chó đánh hơi kiếm phụ đi.","Ha ha, nó còn lười hơn {c}.",""],["hoi","{X} cần chi mà gấp vậy?","À, chuyện này nè.","ke"],["le","Dạ, {c} đi kiếm tiếp liền.","Ừ.",""]]],["ca","Nhờ gì mà khó kiếm quá {x}.","Khó thì mới nhờ chớ dễ {x} tự làm.","Khó thì thôi, khỏi… mà {x} đang cần thiệt.",[["le","Dạ, {c} ráng.","Ừ.",""],["dua","Khó vậy {x} trả công gấp đôi nha.","Ha ha, tính toán dữ.",""],["ca","Thôi {c} không làm nữa.","Vậy về đi.",""]]]]},{"c":"nho","mo":"{C} nói lo giùm mà {x} chưa thấy gì, bộ quên rồi hả?","r":[["le","Dạ không quên, {c} đang lo.","Ừ, lo thì lo lẹ, {x} chờ hai bữa rồi.","Đang lo, đang lo, câu đó nghe hoài. Chờ hai bữa rồi.",[["hoi","Mà {x} cần gấp tới cỡ nào?","Gấp tới mức {x} hỏi ba lần rồi đó.",""],["dua","Chờ hai bữa thì chờ thêm một bữa cho tròn.","Tròn cái đầu {c}.",""],["le","Dạ, chiều nay {c} mang qua liền.","Ừ, chiều nay đó, đừng để mai.",""]]],["dua","Quên thì đâu có ghé {x}.","Ha ha, ghé mà tay không.","Ghé tay không thì ghé làm gì.",[["dua","Tay không mà có lòng.","Lòng không ăn được.",""],["le","Dạ, lần sau {c} mang đủ.","Ừ.",""],["ca","{X} khó quá trời.","Ừ.",""]]],["ca","{X} nhắc hoài {c} nhức đầu.","Không nhắc thì {c} quên.","Nhức đầu thì uống thuốc, còn món đồ thì vẫn phải đem.",[["le","Dạ, {c} không quên đâu, {c} lo liền.","Ừ, coi đó.",""],["dua","Nhắc nữa là {c} nhớ tới già luôn.","Nhớ tới già mà không đem thì cũng như không.",""],["ca","{X} nhắc nữa là {c} không làm luôn.","Vậy {x} nhờ người khác.",""]]]]},{"c":"nho","mo":"Món {x} nhờ đó, {c} thấy khó hông? Khó thì nói {x} biết.","r":[["hoi","Dạ, cũng hơi khó, mà {c} lo được.","Ừ, {c} giỏi mà.","Khó thì nói sớm, {x} còn nhờ người khác.",[["le","Dạ, {x} yên tâm, {c} không để {x} chờ lâu đâu.","Ừ, vậy {x} chờ.",""],["dua","Khó thì {x} cho {c} thêm ba ngày.","Ba ngày? Một ngày thôi.",""],["viec","Mà {x} cần đủ số đó hay thiếu chút cũng được?","Đủ số nha, thiếu là không đủ mâm.",""]]],["dua","Khó như hái sao trên trời.","Ha ha, đâu tới vậy.","Đừng có than, chưa tới mức hái sao đâu.",[["dua","Thì leo cây dừa hái sao.","Leo thì coi chừng té, rồi ai đem đồ cho {x}.",""],["le","Dạ, {c} không than nữa, {c} đi kiếm.","Ừ, đi đi.",""],["ca","Than chút cho đỡ mệt mà {x}.","Than xong rồi đó, đi kiếm đi.",""]]],["viec","Dạ, dễ, mai là có.","Đó, vậy mới được.","Mai của {c} là tuần sau.",[["le","Dạ, mai thiệt mà.","Ừ, mai {x} ngồi chờ.",""],["dua","Mai mà không có thì {x} qua nhà {c} ngồi chờ.","Qua là ăn cơm nhà {c} luôn đó.",""],["ca","Mai có rồi {x} nhớ trả công đàng hoàng nha.","Công gì, có cơm ăn là mừng rồi.",""]]]]},{"c":"than","mo":"Có {c} ghé là {x} vui. Mấy đứa nhỏ trong nhà cũng nhắc {c} hoài.","r":[["hoi","Mấy đứa nhỏ dạo này học hành sao {x}?","Học được, mà đứa út lười. {C} rảnh dạy nó giùm.","Học thì học, hỏi kỹ dữ. Đứa út thì lười.",[["le","Để {c} kèm nó học giùm {x}.","Ừ, quý lắm. Cầm ít đồ về.","tang"],["dua","Lười giống {c} hồi nhỏ.","Ha ha, vậy chắc lớn lên cũng ăn ké giỏi.",""],["viec","Đứa út lười thì giao nó việc nhà, việc ngoài đồng để {c}.","Ừ, việc ngoài đồng {x} nhờ {c} nè.","nho"]]],["dua","Nhắc {c} chắc tại {c} hay cho kẹo.","Ha ha, đúng rồi. Bữa nay có kẹo hông?","Cho kẹo hoài hư răng tụi nó. Bữa nay có đem hông?",[["dua","Bữa nay {c} quên, mai {c} mang.","Ừ, nhớ đó.",""],["hoi","Tụi nhỏ thích gì nhất {x}?","Tụi nó mê món này, {x} cũng mê.","ke"],["ca","Kẹo thì có, mà {c} ăn hết dọc đường rồi.","Ha ha, lớn đầu mà giành kẹo con nít.",""]]],["khen","Nhà {x} lúc nào cũng vui nhất xóm.","Đó, nói vậy {x} ưng. Ở lại ăn cơm.","Vui gì, ồn thì có. Mà thôi, ở lại ăn cơm.",[["khen","Cơm nhà {x} ngon nhất.","Ha ha, cầm thêm ít đồ về.","tang"],["dua","{C} ở lại tới tối.","Tối thì ở luôn.",""],["viec","Ăn xong có gì cần {c} phụ hông?","Có, nhờ {c} nè.","pq"]]]]},{"c":"than","mo":"{X} coi {c} như người nhà rồi đó. Có chuyện gì {x} cũng muốn kể {c} nghe.","r":[["hoi","Dạ, {x} có chuyện gì buồn hông?","Buồn thì có, mà thôi, kể chuyện vui đi.","Buồn gì, hỏi kỹ dữ. Thôi kể chuyện vui đi.",[["le","Dạ, {x} kể đi, {c} nghe.","Ừ, kể {c} nghe nè, mà đừng nói ai.","ke"],["dua","Chuyện vui là {c} ghé đó.","Ha ha, tự tin ghê.",""],["viec","Buồn thì đi làm cho quên, {x} có việc gì hông?","Có, nhờ {c} nè.","nho"]]],["dua","Người nhà thì {c} được ăn cơm miễn phí hả?","Ha ha, miễn phí, mà rửa chén.","Người nhà mà tính toán. Ăn thì rửa chén.",[["dua","Rửa chén thì {c} rửa bằng mắt.","Ha ha.",""],["viec","Rửa xong có gì nhờ thêm hông?","Có nè.","nho"],["le","Dạ, rửa chén thì {c} rửa sạch bóng.","Ừ, nói vậy mới là người nhà.",""]]],["le","Dạ, {c} cũng coi {x} như người nhà.","Ừ, vậy là được. Cầm ít đồ nhà làm về.","Nói nghe khách sáo quá. Người nhà thì cầm ít đồ nhà làm về, đừng từ chối.",[["le","Dạ, {c} cảm ơn.","Ừ, cầm đi.","tang"],["dua","Người nhà thì không cần cảm ơn.","Ha ha, đúng.",""],["hoi","{X} có cần gì hông?","Có nè.","nho"]]]]},{"c":"than","mo":"Hồi đó {c} mới về làng, {x} còn tưởng {c} ở không nổi một tháng.","r":[["dua","Dạ, {c} cũng tưởng vậy, mà cơm làng ngon quá ở luôn.","Ha ha, cơm làng giữ chân người.","Ở luôn mà làm biếng. Cơm làng giữ chân người thiệt.",[["dua","Ở luôn tới già.","Ha ha, già thì làm hàng xóm {x}.",""],["khen","Tại có hàng xóm như {x} nữa.","Trời, nói vậy {x} cảm động. Cầm nè.","tang"],["hoi","Hồi đó {x} có bao giờ tính đi đâu hông?","Có, mà đi đâu cũng nhớ cơm làng. Nghe {x} kể nè.","ke"]]],["hoi","Hồi đó {x} nghĩ {c} sao?","Nghĩ {c} người thành phố, ra đồng là xỉu.","Nghĩ {c} lười, ra đồng là xỉu.",[["dua","Xỉu mấy lần rồi mà quen.","Ha ha.",""],["le","Dạ, nhờ {x} chỉ dạy.","Ừ, {x} còn mẹo này nè.","ke"],["ca","Giờ {c} làm giỏi hơn {x}.","Giỏi thì làm giùm {x} nè.","nho"]]],["khen","Nhờ {x} chỉ dạy nên {c} mới trụ được.","Đó, biết nhớ ơn. {X} quý {c} lắm.","Nói hay ghê. Mà {x} quý {c} thiệt.",[["khen","Thiệt mà {x}.","Ừ, cầm ít đồ về nè.","tang"],["viec","Có gì {x} cần cứ nói.","Có nè.","pq"],["dua","Trả ơn bằng cách ăn cơm nhà {x}.","Ha ha.",""]]]]}]␀␀␀␀␀␀␀["hien","kho","vui","cham","tk","sd"]␀␀␀␀␀␀␀␀␀␀␀["Nguyễn","Trần","Lê","Phạm","Huỳnh","Võ","Phan","Trương","Đặng","Bùi","Đỗ","Hồ","Ngô","Dương","Lý","Cao","Lâm","Mai"]["Làng đẹp quá trời!","Ruộng lúa xanh mướt luôn!","Nhà cửa ngăn nắp ghê!","Ghé chơi vui quá, mai ghé nữa nha!","Vườn trái cây sai trĩu!","Sông nước hữu tình ghê!"]␀␀␀␀["nấu canh chiều","làm đám giỗ","đãi khách ở xa về","cho mấy đứa nhỏ","đem ra chợ huyện","cúng rằm","làm bánh cho cháu","gửi lên Sài Gòn cho con","nấu nồi chè","biếu bà sui"]␀␀␀["#b5653a","#5f8a3c","#c4932c","#4f7896","#7a5a8c","#3f8a7a","#a34d70","#8a6a2e","#4a7a4a","#9a5040"]␀␀␀␀␀␀␀␀␀␀␀["ngày giỗ ông bà","sinh nhật ông nội","ngày cưới của hai vợ chồng","ngày cúng tổ nghề"]␀␀␀␀␀␀␀␀␀␀␀␀␀␀{"cha":"Cha mẹ","con":"Con cháu","ae":"Anh em","sui":"Sui gia","bc":"Bà con trong họ","ban":"Bạn làm ăn","xom":"Hàng xóm"}␀␀␀␀␀␀␀␀␀␀{"cha":0.2,"con":0.2,"ae":0.2,"sui":0.15,"bc":0.1,"ban":0.1,"xom":0.05}␀␀␀␀␀␀␀␀␀["lua","carot","bap","cachua","duahau","ot","catim","khoai","bido","dauphong","nep","gung","nghe","sa","rau_muong","hanh","dau_xanh","mia","tieu","qua_xoai","qua_dua","qua_chuoi","qua_dudu","trung","sua","banh","mat_ong","gao","dien_dien","ca_ro"]␀␀␀␀␀␀␀␀␀{"nam":["Lộc","Phúc","Tài","Hên","Sang","Lợi","Thành","Đực","Tèo","Tý","Lành","Hiếu","Nghĩa","Trung","Dũng","Hùng","Cường","Quý","Bình","Tâm","Thiện","Sơn","Hải","Phát","Đạt","Vinh","Lực","Tới","Mãi","Phước"],"nu":["Mận","Đào","Lài","Huệ","Cúc","Hồng","Lan","Thơm","Hiền","Thắm","Mai","Nhàn","Xuân","Ngọc","Hoa","Lựu","Sen","Gấm","Nhung","Duyên","Thảo","Vân","Yến","Tuyết","Bông","Diệu","Liên","Hạnh","Mến","Trinh"]}␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀{"nam":["Bé Tí","Cu Tèo","Bé Bin"],"nu":["Bé Na","Bé Mít","Bé Su"]}␀␀␀␀␀["Hai","Ba","Tư","Năm","Sáu","Bảy","Tám","Chín","Mười","Út"]␀␀␀␀␀␀␀␀␀{"hien":{"n":"Hiền lành","d":"Dễ thương, lên thân nhanh, ít khi giận.","ton":"hoi","ghet":"ca","gain":1.3,"loss":0.7,"xu":1,"talk":[["{C} mới về hả? Có gì khó cứ qua {x} nha.","Bữa nay trời mát, {c} ghé chơi chút đi."],["{C} siêng quá, {x} thấy mà thương.","Nhà có nồi canh chua, {c} ở lại ăn cơm nha."],["{C} ghé là {x} vui rồi, khỏi đem gì hết.","Hồi trưa {x} còn nhắc {c} đó."],["Coi {c} như con cháu trong nhà vậy đó.","Nhà {x} lúc nào cũng có chén cơm cho {c}."]],"mo":["{C} ăn cơm chưa? {X} mới nấu nồi cá kho nè.","Trời nắng quá, vô đây uống ly nước mưa cho mát.","Mấy bữa nay hổng thấy {c}, {x} lo quá trời.","{C} làm ruộng có mệt hông?"]},"kho":{"n":"Khó tính","d":"Lên thân chậm, nhưng việc nhờ trả hậu hơn.","ton":"le","ghet":"dua","gain":0.7,"loss":1,"xu":1.3,"talk":[["Ai đó? À, đứa mới về làng hả.","Có chuyện gì thì nói lẹ, tui đang bận."],["Cũng biết điều đó chớ.","Ruộng {c} làm coi cũng được."],["Tui ít khi khen ai, mà {c} được.","Có gì khó cứ qua hỏi {x}."],["Cả xóm {x} tin {c} nhất đó.","Nhà {x} có chuyện gì cũng kêu {c} trước."]],"mo":["Ruộng nhà {c} cỏ mọc kìa, phải làm cho kỹ.","Hồi đó tui làm ruộng là thức từ ba giờ sáng.","Bây giờ mấy đứa nhỏ làm ăn ẩu quá.","{C} ghé có chuyện gì hông?"]},"vui":{"n":"Ham vui","d":"Hay mở tiệc, nhà này có đám thường hơn.","ton":"dua","ghet":"le","gain":1,"loss":1,"xu":1,"talk":[["Ê, người mới! Bữa nào qua nhậu chơi nha!","Làng mình vui lắm đó, rồi {c} coi."],["Bữa nay có đờn ca tài tử, {c} qua hông?","Ha ha, {c} ghé đúng lúc ghê."],["Thiếu {c} là cuộc vui mất hứng nha.","Cuối tuần nhà {x} đãi, nhớ qua đó!"],["{C} là tri kỷ của {x} rồi, ha ha!","Có {c} là vui nhất xóm."]],"mo":["Tối qua đám bên kia vui dữ thần luôn!","{C} có biết hát vọng cổ hông?","Bữa nay {x} vừa câu được con cá lóc bự chảng!","Lại đây, {x} kể chuyện này mắc cười lắm."]},"cham":{"n":"Chăm làm","d":"Thuê làm thì công rẻ hơn 15%.","ton":"viec","ghet":"dua","gain":1,"loss":1,"xu":1,"talk":[["Chào {c}. Làm ruộng thì phải siêng nghen.","Sáng nay {x} ra đồng từ sớm."],["Ruộng {c} lúa lên đẹp đó.","Siêng thì có ăn, {c} nhớ nha."],["Có cần người phụ thì kêu {x}.","{C} với {x} hợp tánh, ham làm."],["Ruộng {c} {x} coi như ruộng nhà.","{C} kêu là {x} qua liền."]],"mo":["Mùa này nước lên sớm, phải lo gặt cho kịp.","Phân bón năm nay mắc quá {c} ơi.","Lúa nhà {c} trổ bông chưa?","{X} mới mua cái liềm mới, bén lắm."]},"tk":{"n":"Tiết kiệm","d":"Trả tiền ít, nhưng hay cho thêm đồ nhà làm.","ton":"viec","ghet":"le","gain":1,"loss":1,"xu":0.7,"gift":1,"talk":[["Đồ đạc giờ mắc quá, phải ráng dành dụm.","{C} mới về hả, nhớ đừng xài hoang nha."],["{X} có mớ rau trong vườn, cần thì hái.","{C} biết tính toán vậy là được."],["Đồ nhà làm, {c} cầm về ăn đi.","{C} hiểu chuyện, {x} quý lắm."],["Có gì ngon {x} cũng để dành cho {c}.","{X} dặn {c} mấy mẹo tiết kiệm nè."]],"mo":["Giá gạo lên nữa rồi đó {c}.","{X} mới đổi được mớ khoai, lời chút đỉnh.","Điện nước tháng này mắc quá trời.","{C} có biết chỗ nào bán phân rẻ hông?"]},"sd":{"n":"Sĩ diện","d":"Thích được khen; để chờ lâu hay quên đám thì giận nặng.","ton":"khen","ghet":"ca","gain":1,"loss":1.5,"xu":1,"talk":[["Nhà tui có tiếng trong làng đó nghen.","Người mới thì phải biết nhà tui chớ."],["{C} thấy nhà tui đẹp hông?","Cả xóm ai cũng nể nhà tui."],["{C} biết điều, tui ưng.","Có {c} ghé, nhà tui sang lên hẳn."],["Cả làng biết {c} là người nhà tui đó.","{C} là niềm tự hào của nhà tui."]],"mo":["{C} thấy cái cổng nhà tui mới sơn chưa?","Nhà tui mới mua bộ ván gõ đỏ đó.","Hồi xưa ông nội tui làm hương cả trong làng.","Người ta khen bông kiểng nhà tui đẹp nhất xóm."]}}␀[{"ao":"#7a3a8c","quan":"#2a2622","non":1,"ro":1},{"ao":"#8a6a48","quan":"#2a2622","khan":1,"ro":1},{"ao":"#4a8ad8","quan":"#2a2622","non":1,"ro":1},{"ao":"#e8e0cc","quan":"#4a3a2a","khan":1,"ro":1},{"ao":"#f2f0e8","quan":"#3a3a40","non":1,"ro":1},{"ao":"#c0503a","quan":"#2a2622","non":1,"ro":1},{"ao":"#3a6a4a","quan":"#2a2622","khan":1,"ro":1},{"ao":"#d8a030","quan":"#3a3a40","non":1,"ro":1}]␀␀␀␀[{"k":"ba","ao":"#7a3a8c","quan":"#2a2622","non":1,"ro":1},{"k":"co","ao":"#4a8ad8","quan":"#2a2622","non":1,"ro":1},{"k":"chu","ao":"#8a6a48","quan":"#2a2622","khan":1},{"k":"anh","ao":"#f2f0e8","quan":"#3a3a40","non":1},{"k":"be","ao":"#f27a8a","quan":"#3a5a8a","kid":1},{"k":"ong","ao":"#e8e0cc","quan":"#4a3a2a","khan":1,"gay":1}]␀␀["Đi chợ giùm","Chuẩn bị đám giỗ","Đãi khách ở xa về","Làm mâm cúng rằm","Gửi quà lên tỉnh","Sửa nhà sau mưa"]{"nam":[["Ông"],["Chú","Bác","Dượng"],["Anh"]],"nu":[["Bà"],["Cô","Thím"],["Chị"]]}␀␀[{"id":"hutnho","kind":"builds","gx":7,"gy":0,"fw":2,"fd":2,"seed":0,"pc":"nha","ring":false,"wild":false,"pond":false,"sk":"hut@7,0"},{"id":"bamboo","kind":"plants","gx":0,"gy":0,"fw":1,"fd":1,"seed":0,"pc":"nha","ring":false,"wild":false,"pond":false,"sk":"bamboo@0,0"},{"id":"banana","kind":"plants","gx":1,"gy":0,"fw":1,"fd":1,"seed":0,"pc":"nha","ring":false,"wild":false,"pond":false,"sk":"banana@1,0"},{"id":"hibiscus","kind":"plants","gx":2,"gy":0,"fw":1,"fd":1,"seed":0,"pc":"nha","ring":false,"wild":false,"pond":false,"sk":"hibiscus@2,0"},{"id":"hibiscus","kind":"plants","gx":3,"gy":0,"fw":1,"fd":1,"seed":1,"pc":"nha","ring":false,"wild"