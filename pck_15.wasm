n","fact":"Thành phố đông dân nhất Việt Nam, tên cũ là Sài Gòn cho đến năm 1976.","tip":"Hệ Thống gợi ý: một ổ bánh mì và ly cà phê sữa đá ngay vỉa hè là đủ mở màn.","src":[["Wikipedia: Ho Chi Minh City","https://en.wikipedia.org/wiki/Ho_Chi_Minh_City"]],"r":"nam","lv":1,"use":"an:nhanh"},{"id":"ct","name":"Cần Thơ","lon":105.78,"lat":10.03,"r":"nam","lv":2,"unlock":3,"spec":"Bánh tét lá cẩm","use":"an:mat","fact":"Chợ nổi Cái Răng họp từ tờ mờ sáng trên sông Cần Thơ, ghe treo hàng lên cây bẹo để rao.","tip":"Hệ Thống gợi ý: ra chợ nổi trước 6 giờ, ăn tô hủ tiếu ngay trên ghe.","src":[]},{"id":"ag","name":"Châu Đốc","lon":105.12,"lat":10.7,"r":"nam","lv":3,"unlock":4,"spec":"Mắm Châu Đốc","use":"an:ben","fact":"Châu Đốc nằm sát biên giới Campuchia, nổi tiếng với các loại mắm và núi Sam.","tip":"Hệ Thống gợi ý: mua mắm thái về ăn với thịt luộc, nhớ đậy kín kẻo thơm cả xe.","src":[]},{"id":"dt","name":"Sa Đéc","lon":105.76,"lat":10.29,"r":"nam","lv":4,"unlock":5,"spec":"Hạt sen Đồng Tháp","use":"qua","fact":"Đồng Tháp có nhiều đầm sen; làng hoa Sa Đéc trồng hoa kiểng lâu đời, Tết rực rỡ cả xóm.","tip":"Hệ Thống gợi ý: đi làng hoa vào tháng Chạp, chụp ảnh là ăn tiền.","src":[]},{"id":"tv","name":"Cầu Kè","lon":106.34,"lat":9.93,"r":"nam","lv":5,"unlock":5,"spec":"Dừa sáp Cầu Kè","use":"qua","fact":"Dừa sáp Cầu Kè có cơm dừa dẻo, đặc như sáp, ăn với đá và đường là ngon nhất.","tip":"Hệ Thống gợi ý: dừa sáp lắc không kêu mới đúng sáp nha.","src":[]},{"id":"st","name":"Sóc Trăng","lon":105.97,"lat":9.6,"r":"nam","lv":6,"unlock":6,"spec":"Bánh pía Sóc Trăng","use":"an:xp","fact":"Sóc Trăng có đông đồng bào Khmer, nhiều ngôi chùa đẹp như chùa Dơi.","tip":"Hệ Thống gợi ý: mua bánh pía sầu riêng trứng muối, nhớ chia hàng xóm.","src":[]},{"id":"cm","name":"Mũi Cà Mau","lon":104.95,"lat":8.65,"r":"nam","lv":7,"unlock":6,"spec":"Cua Cà Mau","use":"an:gat","fact":"Mũi Cà Mau là điểm cực nam trên đất liền Việt Nam, rừng đước ngập mặn bạt ngàn.","tip":"Hệ Thống gợi ý: cua gạch hấp bia, ăn xong ráng đừng ngủ gục trên xuồng.","src":[]},{"id":"vt","name":"Vũng Tàu","lon":107.08,"lat":10.35,"r":"nam","lv":8,"unlock":7,"spec":"Bánh khọt Vũng Tàu","use":"an:nhanh","fact":"Vũng Tàu là thành phố biển gần Sài Gòn, có ngọn hải đăng trên núi Nhỏ.","tip":"Hệ Thống gợi ý: ăn bánh khọt nóng giòn, cuốn rau sống chấm nước mắm chua ngọt.","src":[]},{"id":"tn","name":"Núi Bà Đen","lon":106.17,"lat":11.37,"r":"nam","lv":9,"unlock":7,"spec":"Muối tôm Tây Ninh","use":"vat","fact":"Núi Bà Đen ở Tây Ninh là ngọn núi cao nhất Nam Bộ.","tip":"Hệ Thống gợi ý: đi cáp treo lên đỉnh lúc sáng, mây trôi ngang chân.","src":[]},{"id":"dl","name":"Đà Lạt","lon":108.46,"lat":11.94,"unlock":8,"spec":"Dâu tây Đà Lạt","fact":"Nằm ở độ cao khoảng 1.500 m, thuộc tỉnh Lâm Đồng, nổi tiếng với hoa, rau và trái cây.","tip":"Hệ Thống gợi ý: mang áo khoác, buổi sáng ở đây lạnh hơn đồng bằng nhiều.","src":[["Wikipedia: Da Lat","https://en.wikipedia.org/wiki/Da_Lat"]],"r":"trung","lv":10,"use":"giong"},{"id":"pt","name":"Mũi Né","lon":108.27,"lat":10.95,"r":"trung","lv":12,"unlock":8,"spec":"Bánh căn Mũi Né","use":"an:mat","fact":"Mũi Né nổi tiếng với đồi cát bay và nghề làm nước mắm lâu đời.","tip":"Hệ Thống gợi ý: trượt cát lúc hoàng hôn, nhớ giữ chặt điện thoại.","src":[]},{"id":"nt","name":"Nha Trang","lon":109.19,"lat":12.24,"r":"trung","lv":14,"unlock":9,"spec":"Yến sào Khánh Hòa","use":"qua","fact":"Vịnh Nha Trang có nhiều đảo; nghề khai thác yến sào ở Khánh Hòa có từ rất lâu.","tip":"Hệ Thống gợi ý: đi tàu ra đảo buổi sáng, chiều về tắm bùn khoáng.","src":[]},{"id":"bmt","name":"Buôn Ma Thuột","lon":108.04,"lat":12.67,"r":"trung","lv":16,"unlock":9,"spec":"Cà phê Ban Mê","use":"an:xp","fact":"Buôn Ma Thuột được gọi là thủ phủ cà phê của Việt Nam.","tip":"Hệ Thống gợi ý: uống cà phê phin chậm rãi, đừng uống ba ly một lúc như ký chủ.","src":[]},{"id":"py","name":"Gành Đá Đĩa","lon":109.29,"lat":13.36,"r":"trung","lv":18,"unlock":10,"spec":"Cá ngừ đại dương","use":"an:cau","fact":"Gành Đá Đĩa là bãi đá bazan xếp thành từng cột như chồng đĩa khổng lồ bên biển.","tip":"Hệ Thống gợi ý: đi lúc nước ròng để bước ra bãi đá đẹp nhất.","src":[]},{"id":"qn","name":"Quy Nhơn","lon":109.22,"lat":13.78,"r":"trung","lv":20,"unlock":10,"spec":"Bánh ít lá gai","use":"qua","fact":"Quy Nhơn có nhiều tháp Chăm cổ và bãi biển xanh trong.","tip":"Hệ Thống gợi ý: bánh ít lá gai để được vài ngày, mua về làm quà là chuẩn.","src":[]},{"id":"kt","name":"Kon Tum","lon":108,"lat":14.35,"r":"trung","lv":22,"unlock":11,"spec":"Gỏi lá Kon Tum","use":"an:ben","fact":"Kon Tum có nhà rông mái cao vút, nơi sinh hoạt chung của đồng bào Tây Nguyên.","tip":"Hệ Thống gợi ý: gỏi lá có vài chục loại lá, ăn từ từ mới thấm.","src":[]},{"id":"ha","name":"Hội An","lon":108.34,"lat":15.88,"unlock":11,"spec":"Cao lầu Hội An","fact":"Phố cổ Hội An được UNESCO ghi danh di sản thế giới năm 1999, là thương cảng Đông Nam Á còn giữ được nguyên vẹn.","tip":"Hệ Thống gợi ý: đi bộ phố cổ lúc chiều muộn, đèn lồng lên rất ăn ảnh.","src":[["UNESCO: Hoi An Ancient Town","https://whc.unesco.org/en/list/948"]],"r":"trung","lv":24,"use":"an:nhanh"},{"id":"dn","name":"Đà Nẵng","lon":108.22,"lat":16.05,"r":"trung","lv":26,"unlock":12,"spec":"Mì Quảng","use":"an:mat","fact":"Cầu Rồng bắc qua sông Hàn ở Đà Nẵng phun lửa, phun nước vào tối cuối tuần.","tip":"Hệ Thống gợi ý: ăn mì Quảng ít nước, thêm bánh tráng nướng bẻ vụn.","src":[]},{"id":"hue","name":"Huế","lon":107.59,"lat":16.46,"unlock":12,"spec":"Bún bò Huế","fact":"Quần thể di tích Cố đô Huế được UNESCO ghi danh năm 1993. Huế là kinh đô triều Nguyễn từ năm 1802 đến 1945.","tip":"Hệ Thống gợi ý: dành một buổi sáng cho Đại Nội, trưa ăn bún bò.","src":[["UNESCO: Complex of Hué Monuments","https://whc.unesco.org/en/list/678"]],"r":"trung","lv":28,"use":"an:gat"},{"id":"qb","name":"Phong Nha","lon":106.28,"lat":17.59,"r":"trung","lv":30,"unlock":13,"spec":"Cháo canh","use":"an:ben","fact":"Vườn quốc gia Phong Nha – Kẻ Bàng được UNESCO ghi danh di sản thiên nhiên thế giới.","tip":"Hệ Thống gợi ý: đi thuyền vào động Phong Nha, nhớ mang áo khoác mỏng.","src":[]},{"id":"na","name":"Vinh","lon":105.68,"lat":18.67,"r":"trung","lv":33,"unlock":13,"spec":"Cam Vinh","use":"giong","fact":"Cam Vinh vỏ mỏng, mọng nước, ngọt thanh, là đặc sản nổi tiếng xứ Nghệ.","tip":"Hệ Thống gợi ý: chọn cam vỏ còn xanh có đốm vàng mới ngọt.","src":[]},{"id":"nb","name":"Tràng An","lon":105.9,"lat":20.25,"r":"bac","lv":36,"unlock":14,"spec":"Cơm cháy Ninh Bình","use":"an:nhanh","fact":"Quần thể danh thắng Tràng An ở Ninh Bình được UNESCO ghi danh năm 2014.","tip":"Hệ Thống gợi ý: ngồi đò qua các hang động, nhớ cúi đầu kẻo đụng trần hang.","src":[]},{"id":"hn","name":"Hà Nội","lon":105.85,"lat":21.03,"unlock":15,"spec":"Cà phê trứng","fact":"Cà phê trứng ra đời ở Hà Nội năm 1946, khi sữa khan hiếm nên người ta đánh bông lòng đỏ trứng thay sữa.","tip":"Hệ Thống gợi ý: uống cà phê trứng lúc còn nóng, để nguội sẽ mất độ béo.","src":[["Mental Floss: Vietnamese egg coffee origin","https://www.mentalfloss.com/article/639760/vietnamese-egg-coffee-origin"]],"r":"bac","lv":40,"use":"an:xp"},{"id":"hp","name":"Hải Phòng","lon":106.68,"lat":20.86,"r":"bac","lv":44,"unlock":15,"spec":"Bánh đa cua","use":"an:mat","fact":"Hải Phòng là thành phố cảng lớn ở miền Bắc, được gọi là thành phố hoa phượng đỏ.","tip":"Hệ Thống gợi ý: bánh đa cua phải có chả lá lốt mới đủ bộ.","src":[]},{"id":"hl","name":"Hạ Long","lon":107.18,"lat":20.91,"unlock":16,"spec":"Chả mực Hạ Long","fact":"Vịnh Hạ Long được UNESCO ghi danh năm 1994. Mô tả tiếng Anh của UNESCO nêu 1.133 đảo và đảo nhỏ.","tip":"Hệ Thống gợi ý: đi thuyền buổi sáng sớm, mặt vịnh còn sương nên rất yên.","src":[["UNESCO: Ha Long Bay","https://whc.unesco.org/en/list/672"]],"r":"bac","lv":48,"use":"an:cau"},{"id":"tng","name":"Tân Cương","lon":105.75,"lat":21.57,"r":"bac","lv":52,"unlock":16,"spec":"Chè Thái Nguyên","use":"qua","fact":"Chè Tân Cương ở Thái Nguyên búp nhỏ, nước xanh, uống xong còn ngọt hậu.","tip":"Hệ Thống gợi ý: pha chè bằng nước sôi để nguội chừng 85 độ, đừng pha quá đặc.","src":[]},{"id":"mc","name":"Mộc Châu","lon":104.68,"lat":20.85,"r":"bac","lv":56,"unlock":17,"spec":"Sữa Mộc Châu","use":"qua","fact":"Cao nguyên Mộc Châu mát quanh năm, có đồi chè và trang trại bò sữa.","tip":"Hệ Thống gợi ý: tháng Ba đi ngắm hoa mận nở trắng đồi.","src":[]},{"id":"sp","name":"Sa Pa","lon":103.84,"lat":22.34,"unlock":18,"spec":"Cá hồi Sa Pa","fact":"Đỉnh Fansipan cách Sa Pa khoảng 9 km, cao khoảng 3.147 m, là đỉnh cao nhất bán đảo Đông Dương.","tip":"Hệ Thống gợi ý: sương mù dày, hãy canh buổi sáng sớm để thấy ruộng bậc thang.","src":[["Wikipedia: Fansipan","https://en.wikipedia.org/wiki/Fansipan"]],"r":"bac","lv":60,"use":"an:gat"},{"id":"cb","name":"Bản Giốc","lon":106.72,"lat":22.85,"r":"bac","lv":65,"unlock":19,"spec":"Bánh cuốn Cao Bằng","use":"an:xp","fact":"Thác Bản Giốc ở Cao Bằng nằm ngay đường biên giới phía bắc, đổ nước quanh năm.","tip":"Hệ Thống gợi ý: bánh cuốn Cao Bằng ăn với nước canh xương nóng, không chấm nước mắm.","src":[]},{"id":"hg","name":"Lũng Cú","lon":105.32,"lat":23.36,"r":"bac","lv":70,"unlock":20,"spec":"Bánh tam giác mạch","use":"vat","fact":"Cột cờ Lũng Cú nằm gần điểm cực bắc của Việt Nam, lá cờ đỏ tung bay trên đỉnh núi Rồng.","tip":"Hệ Thống gợi ý: mùa hoa tam giác mạch nở tím hồng vào khoảng tháng Mười.","src":[]}]␀␀␀␀␀␀␀␀␀␀[[112.33,16.83],[112.27,16.97],[111.62,16.53],[111.71,16.45],[111.2,15.78],[112.73,16.67],[112,16.6],[111.75,16.95],[111.48,16.43],[112.53,16.98]]␀␀␀␀␀␀␀␀␀␀␀␀␀␀{"pq":"l","hcm":"r","dl":"r","ha":"r","hue":"l","hn":"l","hl":"t","sp":"r","ag":"l","cm":"l","ct":"l","dt":"t","st":"r","tv":"r","vt":"r","tn":"l","pt":"r","bmt":"l","kt":"l","dn":"l","qb":"l","na":"l","nb":"r","hp":"b","tng":"l","mc":"l","cb":"l","hg":"l","qn":"r","py":"r","nt":"r"}␀␀␀␀{"all":[101.9,113.7,8.2,23.6],"nam":[102.3,108.8,8.6,12],"trung":[105.2,109.9,10.6,19.3],"bac":[102.2,108.3,18.2,23.5]}␀␀␀␀␀␀␀␀␀{"all":"Cả nước","nam":"Miền Nam","trung":"Miền Trung","bac":"Miền Bắc"}␀␀␀␀␀␀␀␀␀␀␀[[111.92,8.64],[114.33,11.43],[114.37,10.18],[114.33,9.88],[114.48,10.38],[112.92,7.89],[113.69,8.97],[114.6,9.9],[113.3,8.15],[112.25,8.85],[114.28,11.05],[114.42,10.68]]␀␀␀␀␀{"1":["Mưa hoài, chán ghê.","Không như quảng cáo."],"2":["Buồn quá, không có gì chơi.","Quán hết món, đói bụng ghê."],"3":["Cũng được, mà muốn có thêm chỗ chơi.","Ở tạm ổn, đồ ăn hơi ít món."],"4":["Ở vui, cảnh đẹp, đồ ăn ngon.","Homestay sạch sẽ, chủ nhà dễ thương."],"5":["Cơm quê ngon, đi xuồng vui quá trời!","Dân làng thân thiện, nhất định quay lại!","Làng đẹp như tranh vẽ, chụp hình mỏi tay!"]}␀␀␀␀␀␀[{"n":"Bình dân","xu":45,"r":0.5},{"n":"Vừa phải","xu":75,"r":0},{"n":"Sang","xu":120,"r":-0.5}]␀␀␀␀␀␀␀␀␀␀{"sg":{"n":"Khách Sài Gòn","looks":[{"ao":"#f27a8a","quan":"#3a5a8a"},{"ao":"#2fb0a8","quan":"#e8e0cc"},{"ao":"#f2c21e","quan":"#3a3a40"}]},"tay":{"n":"Khách Tây ba lô","looks":[{"ao":"#4a8ad8","quan":"#c8b48a"},{"ao":"#e8742a","quan":"#3a5a3a"},{"ao":"#f6f2e8","quan":"#2a4a6a"}]}}[["all","Tất cả"],["nong","Nông sản"],["trai","Trái cây"],["nuoi","Vật nuôi"],["song","Cá, sông nước"],["chebien","Chế biến"],["khac","Thủ công, khác"]]␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀{"book":"Sổ làng","barn":"Kho hàng","orders":"Đơn hàng","ups":"Nâng cấp","sys":"Hệ Thống","map":"Bản đồ","set":"Cài đặt","fish":"Câu cá","build":"Xây dựng làng","htx":"Hợp tác xã","vl":"Dân làng","gp":"Gia phả làng","kl":"Kỷ lục nông sản","nv":"Sổ nhiệm vụ","ut":"Uy tín làng","tn":"Thiên tai, hoạn nạn","hdn":"Hội đình","chng":"Nghề","clg":"Chuyện làng"}␀␀␀␀␀␀␀␀␀␀{"birds":"Chim sáo","paddy":"Ruộng lúa","dd":"Bông điên điển","ma":"Ma trơi","thu":"Thư nhà"}␀␀␀␀␀␀{"birds":"Đuổi chim","paddy":"Gặt lúa","hive":"Lấy mật","gavit":"Đuổi đi","dd":"Hái bông","fall":"Ra dọn cây","topple":"Cưa lấy củi","rung":"Lượm trái","thu":"Ra nhận thư","tat":"Ra tát ao","ray":"Phun thuốc","clt":"Ra hái trái","ongr":"Lấy mật ong","ma":"Đi theo coi","con":"Chơi với con"}␀␀{"rice":"gặt lúa, nếp","harvest":"thu hoạch cây trồng","collect":"thu sản 