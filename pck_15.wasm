.0036,1.0036,1.0036,1.0054,1.0054,1.0088,1.0088,1.0106,1.0088,1.0088,1.0088,1.0072,1.0054,1.0036,1.0036,1.0054,1.0054,1.0072,1.0088,1.0088,1.0106,1.0106,1.0088,1.0088,1.0072,1.0054,1.0054,1.0036,1.0036,1.0036,1.0054,1.0072,1.0088,1.0088,1.0088,1.0088,1.0088,1.0088,1.0072],[],[],[],[],[],[],[]],"stand":[0,0,0,0,0,0,0,0]}},"K":1.486}}␀␀␀␀{"de":"Giải đá dế","do":"Giải đố vui"}␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀["thuong","kha","hiem"]␀␀␀␀␀␀␀␀␀[["xu","xu"],["lua","giạ lúa"],["nhang","nhang"],["ruou_nep","rượu nếp"]]␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀["#d8402a","#f2c21e","#2f86c9","#3f9a3a","#f6f2e8"]␀␀␀␀␀␀␀␀␀␀␀␀␀["","nhất","nhì","ba"]␀␀␀␀␀␀␀["de","do"]␀␀␀␀␀[0,[10,3000],[6,1600],[3,800]]␀␀{"cong":["Dựng cổng chào tre","Hội đông hơn.",{"cui":15,"xu":300}],"co":["Treo cờ ngũ sắc, kết hoa","Hội đông hơn.",{"xu":400}]}␀␀␀␀␀␀␀␀␀␀["Vòng loại","Bán kết","Chung kết"]␀␀␀␀␀[{"id":"wx","g":"thoitiet","t":"Trời mưa: ruộng tự được tưới nhưng nhân vật đi chậm. Mặc Áo mưa trong Tủ đồ để đi bình thường."},{"id":"giong","g":"giong","t":"Giông tới! Cây cao có thể bị quật ngã, sét đánh cháy cây. Cột thu lôi hút sét trong vòng 7 ô."},{"id":"han","g":"thoitiet","t":"Nắng hạn: đất khô nhanh gấp rưỡi. Nhớ tưới ruộng thường hơn nha."},{"id":"fell","g":"giong","t":"Có cây bị giông quật ngã. Chạm vô cây đổ để dọn, được củi khô nấu bếp."},{"id":"rong","g":"nuoc","t":"Nước ròng! Bãi bùn hai bên sông lộ ra: chạm để bắt cá kèo, mò ốc, vớt lục bình."},{"id":"cho","g":"cho","t":"Chợ nổi đang họp trên sông Vàm (5–9 giờ sáng). Chạm ghe để mua bán."},{"id":"fest","g":"hoi","t":"Sắp tới ngày lễ! Bà con nhờ góp lễ vật ở đình. Đủ lễ thì cả làng nhận lộc."},{"id":"met","g":"nhanvat","t":"Nhân vật sắp hết sức. Nấu cơm ở bếp, ăn đồ ăn hoặc về nhà ngủ để hồi sức."},{"id":"buff","g":"bep","t":"Icon nhỏ dưới avatar là hiệu ứng đang có. Chạm vào để xem chi tiết và thời gian còn lại."},{"id":"dem","g":"ma","t":"Trời tối rồi. Ban đêm hồi sức nhanh hơn; ngoài đồng có khi lập lòe ma trơi…"},{"id":"dieu","g":"dieu","t":"Chiều nay có gió, thả diều được rồi! Mua diều trong bảng nhân vật."},{"id":"tat","g":"tat","t":"Tuần này chưa tát mương. Chạm cái gàu cạnh ao nhà để tát mương bắt cá."},{"id":"dam","g":"dam","t":"Hàng xóm mời đám! Mang quà tới phụ thì thêm ♥, ăn đám được hiệu ứng."},{"id":"vung","g":"khaihoang","t":"Có vùng đất mới để khai hoang: đồng ruộng phía nam, phía đông, rừng tràm U Minh và cù lao giữa vàm."},{"id":"culao","g":"culao","t":"Cù lao đã là của mình! Trái chín có bong bóng, chạm để hái; hái xong ít lâu lại chín."},{"id":"tram","g":"tram","t":"Rừng tràm có tổ ong mật. Chạm tổ ong để lấy mật; có củi thì tự hun khói, ít bị đốt."},{"id":"tim3","g":"nghe","t":"Đã thân 3 ♥ với một nhà! Ghé nhà họ để học nghề thủ công gia truyền."},{"id":"tim5","g":"cuoi","t":"Thân 5 ♥ rồi: nếu nhà đó có con chưa vợ chồng thì có thể dạm hỏi."},{"id":"ray","g":"ray","t":"Dịch rầy nâu! Chạm ô có dấu chấm than để phun thuốc, hoặc thả vịt ra đồng ăn rầy."},{"id":"lo","g":"lo","t":"Lờ lọp có cá rồi! Chạm vào bẫy dưới nước để nhân vật lội ra thăm."},{"id":"quan","g":"quan","t":"Quán cơm dựng xong! Chạm vào quán để nấu sẵn món, khách sẽ ghé ăn."},{"id":"hoicho","g":"hoicho","t":"Tối nay sân đình có hội chợ! Chạm sạp trò chơi để ném vòng, đập niêu, hoặc mua tờ lô tô."},{"id":"dulich","g":"dulich","t":"Có khách du lịch tới ở homestay! Phục vụ quán cơm, sạp đặc sản cho chu đáo để khách chấm sao cao."},{"id":"sao1","g":"trong","t":"Đủ xu và vật liệu để nâng sao ô ruộng! Chạm một ô đất, nâng lên 2★: cây lớn nhanh hơn, giữ nước lâu hơn."},{"id":"vatlieu","g":"trong","t":"Vừa nhặt được vật liệu nâng sao! Xem trong Kho › Vật liệu nâng sao. Vật liệu rơi ra khi gặt, thu vật nuôi, lấy hàng xưởng, giao đơn."},{"id":"chohang","g":"dulich2","t":"Mở Bản đồ, chọn TP. Hồ Chí Minh hay Phú Quốc rồi bấm Chở hàng đi bán: nơi xa trả giá cao hơn chợ làng."},{"id":"khoa","g":null,"t":"Mỗi cấp mở thêm cây, xưởng, đất mới. Xem cấp nào mở gì trong Sổ tay › Lộ trình 100 cấp."}]␀␀␀␀␀␀␀␀␀[{"sec":"Lộ trình 100 cấp","items":[{"id":"capdo","ic":"lua","n":"Cấp nào mở gì","b":["Mỗi cấp mở thêm cây, xưởng, chức năng, đất. Đồ đã mở rồi thì giữ nguyên. Cây giống từ ghe thương hồ trồng được dù chưa tới cấp.","Cấp 1: Cây lúa, Cây rau muống, tối đa 6 ô ruộng.","Cấp 2: Cây bắp, Cối xay, địa danh Cần Thơ, tối đa 8 ô ruộng.","Cấp 3: Lò bánh mì, địa danh Châu Đốc, nâng sao 1★ cho ô ruộng, xưởng, chuồng, sạp, Đất vườn rau, tối đa 10 ô ruộng.","Cấp 4: Cây hành lá, Chợ nổi, Nuôi chào mào, địa danh Sa Đéc, Đất ruộng làng, tối đa 12 ô ruộng.","Cấp 5: Cây đậu nành, Cây dừa, Ruộng muối, Nuôi mèo, Câu cá, Thăm làng bạn, địa danh Cầu Kè, Đất sân đình, tối đa 14 ô ruộng.","Cấp 6: Chuồng bò, địa danh Sóc Trăng, tối đa 16 ô ruộng.","Cấp 7: Cây mía, Xe nước mía, Lờ, lọp, giăng câu, Thả vịt, thả cá, địa danh Mũi Cà Mau, nâng sao 2★ cho ô ruộng, xưởng, chuồng, sạp, Đất ao sen, tối đa 18 ô ruộng.","Cấp 8: Cây cải xanh, Vại muối dưa, Tát mương, Hội chợ quê, địa danh Vũng Tàu, Đất bãi đất phía nam, tối đa 20 ô ruộng.","Cấp 9: Cây cà rốt, Người làm thuê, địa danh Núi Bà Đen, tối đa 22 ô ruộng.","Cấp 10: Cây chuối, Chuồng heo, Bếp củi, Quán cơm, Bắt ma trơi, Bảng xếp hạng, địa danh Đà Lạt, Đất đồng phía đông, tối đa 24 ô ruộng.","Cấp 11: Cây đậu phộng, Lò rang hạt.","Cấp 12: Cây sả, Cây đậu đen, Lò đường, Lò bánh quê, Lai giống, địa danh Mũi Né, nâng sao 3★ cho ô ruộng, xưởng, chuồng, sạp, Đất hồ cá lớn, tối đa 25 ô ruộng.","Cấp 13: Cây chàm, Chuồng cừu.","Cấp 14: Cây rau răm, Khung dệt, địa danh Nha Trang, Đất đồi phía bắc, tối đa 26 ô ruộng.","Cấp 15: Cây bí đỏ, Cây đu đủ, Lò nướng, Du lịch homestay, Chơi hụi, Đất bến sông, khúc giữa.","Cấp 16: Cây bầu, Giàn phơi, địa danh Buôn Ma Thuột, Đất xóm mới, tối đa 27 ô ruộng.","Cấp 17: Cây đậu bắp.","Cấp 18: Cây bông vải, Cây gừng, Nồi kho, địa danh Gành Đá Đĩa, Đất bãi bồi, tối đa 28 ô ruộng.","Cấp 19: Cây mướp, Cây nhãn.","Cấp 20: Cây cà tím, Chuồng dê, Lò bánh tráng, Hàng chả, Đám tiệc, địa danh Quy Nhơn, Đất rừng tràm, tối đa 29 ô ruộng.","Cấp 21: Cây bí đao.","Cấp 22: Cây đậu xanh, Cây khoai môn, Cây chôm chôm, Cây xoài, Nghề thủ công, địa danh Kon Tum, Đất gò hoang, tối đa 30 ô ruộng.","Cấp 24: Cây khổ qua, Cây me, Cối xay thứ 2, địa danh Hội An, Đất đồng lúa phía đông, tối đa 31 ô ruộng.","Cấp 25: Cây ớt, Quán chè, Cưới hỏi, nâng sao 4★ cho ô ruộng, xưởng, chuồng, sạp, Đất vàm sông, khúc đông.","Cấp 26: Cây đậu rồng, Cây thanh long, địa danh Đà Nẵng, tối đa 32 ô ruộng.","Cấp 27: Lò bánh mì thứ 2, Đất vườn quê tây nam.","Cấp 28: Cây nếp, Cây tiêu, địa danh Huế, tối đa 33 ô ruộng.","Cấp 30: Cây cà chua, Cây mận, địa danh Phong Nha, Đất sông vàm, khúc tây, Đất đồng lúa phía tây, tối đa 34 ô ruộng.","Cấp 31: Ruộng muối thứ 2.","Cấp 32: Cây lá dứa, Đất vườn quê phía nam, tối đa 35 ô ruộng.","Cấp 33: Xe nước mía thứ 2, địa danh Vinh.","Cấp 34: Cây dâu tây, tối đa 36 ô ruộng.","Cấp 35: Cây khoai lang, Lò bánh quê thứ 2, Đất rừng cao su đông nam.","Cấp 36: Cây điều, địa danh Tràng An, tối đa 37 ô ruộng.","Cấp 37: Vại muối dưa thứ 2.","Cấp 38: Đất đồng lúa tây nam, tối đa 38 ô ruộng.","Cấp 39: Lò rang hạt thứ 2.","Cấp 40: Cây dưa hấu, Cây nghệ, địa danh Hà Nội, nâng sao 5★ cho ô ruộng, xưởng, chuồng, sạp, tối đa 39 ô ruộng.","Cấp 41: Bếp củi thứ 2, Đất đồng lúa phía đông 2.","Cấp 42: Cây bưởi, tối đa 40 ô ruộng.","Cấp 43: Lò đường thứ 2, Đất đồng lúa phía nam.","Cấp 44: địa danh Hải Phòng, tối đa 41 ô ruộng.","Cấp 45: Lò nướng thứ 2.","Cấp 46: Đất đồng lúa phía tây 2, tối đa 42 ô ruộng.","Cấp 47: Khung dệt thứ 2.","Cấp 48: địa danh Hạ Long, tối đa 43 ô ruộng.","Cấp 49: Quán chè thứ 2, Đất rừng tràm u minh phía tây.","Cấp 50: Cây mè, tối đa 44 ô ruộng.","Cấp 51: Hàng chả thứ 2.","Cấp 52: địa danh Tân Cương, Đất đồng lúa đông nam.","Cấp 53: Giàn phơi thứ 2.","Cấp 54: Đất rừng tràm u minh phía tây 2.","Cấp 55: Nồi kho thứ 2.","Cấp 56: địa danh Mộc Châu.","Cấp 57: Cây măng cụt, Đất đồng lúa phía đông 3.","Cấp 58: Cây xà lách.","Cấp 59: Lò bánh tráng thứ 2.","Cấp 60: địa danh Sa Pa, Đất đồng lúa tây nam 2.","Cấp 62: chuồng chứa 6 con.","Cấp 63: Cây hướng dương, Đất rừng cao su phía đông.","Cấp 65: địa danh Bản Giốc.","Cấp 66: Cây mít, Đất rừng cao su tây nam.","Cấp 68: Cây hành tây, Đất vườn quê đông nam.","Cấp 70: Cây dưa leo, địa danh Lũng Cú.","Cấp 71: Cây cam, Đất rừng tràm u minh phía tây 3.","Cấp 74: Đất đồng lúa phía đông 4.","Cấp 76: Cây sầu riêng.","Cấp 77: Đất đồng lúa phía nam 2.","Cấp 79: Đất cù lao giữa vàm.","Cấp 82: Đất rừng tràm u minh tây nam, chuồng chứa 8 con.","Cấp 85: Đất rừng cao su đông nam 2.","Cấp 88: Đất đồng lúa phía nam 3.","Cấp 90: Đất vườn quê tây nam 2.","Cấp 93: Đất đồng lúa đông nam 2.","Cấp 96: Đất rừng tràm u minh tây nam 2.","Cấp 100: danh hiệu Lão nông tri điền, tượng Lão nông."]}]},{"sec":"Ruộng vườn","items":[{"id":"trong","ic":"lua","n":"Trồng trọt","b":["Chạm ô đất trống, chọn giống trong bảng hiện ra để gieo. Gieo 1 hạt, gặt được 2.","Nông sản trong kho cũng là hạt giống: bán thì nhớ chừa lại (nút Bán, chừa 4 giống). Hết giống thì mua ở Chợ phiên, nhà hàng xóm, hoặc chợ nổi sáng sớm (đổi nông sản lấy giống cũng được).","Mới đầu chỉ có lúa, rau muống. Lên cấp mở thêm giống mới theo nhịp Hay Day (bắp cấp 2, đậu nành cấp 5, mía cấp 7, chàm cấp 13, bí đỏ cấp 15, bông vải cấp 18, ớt cấp 25, cà chua cấp 30, dâu tây cấp 34...), được tặng 4 hạt mỗi thứ.","Cây tự lớn theo giờ thật, kể cả lúc bạn tắt game: lúa 2 phút, bắp 5 phút, cà chua 6 giờ, dâu tây 8 giờ. Cây khó lớn lâu thì bán giá cao, gặt được nhiều kinh nghiệm.","Tưới nước thì cây lớn nhanh hơn 10% trong lúc đất còn ướt. Mọi nguồn tăng tốc cộng lại tối đa +50%, giá bán cộng lại tối đa +25%; trời mưa ruộng tự được tưới.","Cây chín thì chạm để thu hoạch vào Kho. Có sâu thì chạm để bắt.","Nâng sao ô ruộng (chạm ô đất) từ 1★ tới 5★: cây lớn nhanh hơn, giữ nước lâu hơn. Xưởng, chuồng, sạp bán hàng cũng nâng sao được. Nâng sao cần xu và vật liệu (rơm, phân, vôi, ván, đinh, gạch, tre, lá dừa, mây, bạt, bảng hiệu, cân) rơi ra khi làm việc. Xem trong Kho › Vật liệu nâng sao."]},{"id":"menuo","ic":"lua","n":"Menu ô ruộng","b":["Chạm cây đang lớn: hiện 3 nút tròn và tên cây, thời gian còn lại.","Nút sen đỏ: làm cây chín và thu hoạch ngay, tốn sen đỏ (số ghi trong nút, có hỏi trước). Viền đỏ quanh nút là cây đã lớn tới đâu, đầy vòng là chín.","Nút sao: nâng sao ô ruộng. Viền 5 khúc, sáng mấy khúc là ô đang mấy sao.","Nút nước: tưới cho đầy. Viền xanh là lượng nước còn trong đất.","Cây chín: chạm vào cây hiện nút Thu hoạch.","Đất sẫm, bóng là còn ướt; đất nhạt, nứt nẻ là khô, nên tưới."]},{"id":"lai","ic":"lua","n":"Lai giống","b":["Trồng hai giống khác nhau sát bên nhau (cả chéo góc). Gặt ra thỉnh thoảng được hạt giống lai.","Có 7 giống lai: lúa thơm, lúa chịu mặn, cà chua bi, ớt hiểm, khoai tím, bắp nếp, dưa không hạt. Xem gợi ý ở bảng nhân vật › Giống lai.","Hạt lai chỉ có khi lai. Gặt giống lai ra nông sản để bán, không ra hạt: muốn trồng tiếp phải lai tiếp.","Giống lai là giống quý: ra trái khủng gấp 3, nặng hơn cây gốc, có hạng riêng trong tủ kỷ lục và hội thi tuần."]},{"id":"hoithi","ic":"mat_ong","n":"Hội thi làng","b":["Mỗi tối 19:00–19:15 (giờ thật trên máy) ở sân đình. Chạm nút 🔔 trên màn hình để vào thi.","Bạn bè online cùng thi một bộ 10 câu, bảng điểm hiện điểm từng người (🌐). 19:15 chốt Bảng vàng, ai nhất được thêm 150 xu.","10 câu đố rút từ hơn 100 câu về Nam Bộ: Sài Gòn, miền Đông, miền Tây, đặc sản, ca dao tục ngữ, cải lương, lễ hội Khmer, chuyện trong làng. Mỗi câu 12 giây, trả lời nhanh được thêm điểm. Tên tỉnh tính theo địa giới cũ (trước sáp nhập 7/2025).","Mỗi câu đúng được xu (cấp càng cao càng nhiều). Đúng từ 7 câu được thêm hạt giống và mật ong. Đứng nhất được thêm 90 xu và một nhà hàng xóm thêm thân. Đúng hết 10 câu là Rung chuông vàng: +300 xu và 2 hạt giống lai.","Thi liên tiếp mỗi tối được thưởng thêm 10% mỗi tối, tối đa 50%."]},{"id":"man","ic":"muoi_hot","n":"Hạn mặn mùa khô","b":["Mấy ngày cuối tháng (mùa khô) nước mặn lấn vô sông Vàm, theo kênh mương vô ruộng: cây chậm lớn còn 35–55%. Ô ruộng sát ao, hồ nước ngọt (2 ô) thì không sao.","Tưới bằng nước ngọt trong lu (mưa tự hứng, mua thêm được, đặt lu nước, chum sành để chứa nhiều hơn).","Xây cống ngăn mặn để bớt hẳn. Lúa chịu mặn (giống lai) không sợ mặn. Mùa mặn tôm về nhiều."]},{"id":"caytrai","ic":"qua_xoai","n":"Cây ăn trái","b":["Mua cây giống ở Xây dựng hoặc chợ nổi, trồng một lần là ra trái hoài.","Tưới cho cây đủ nước, trái chín thì chạm để hái.","Giông bão làm rụng nửa trái: dựng hàng rào hoặc chòi cách cây không quá 2 ô để che chắn. Trái rụng nằm dưới gốc, chạm để lượm."]},{"id":"vatnuoi","ic":"trung","n":"Vật nuôi, thả vịt thả cá","b":["Xây chuồng trước ở Xây dựng › Chuồng trại (chuồng gà, cừu, bò, heo, dê). Có chuồng rồi mới mua được con giống.","Con giống mua ở Sổ làng › Chợ phiên (lái gia súc dắt tới mỗi ngày) hoặc ghe cây giống ở chợ nổi sáng sớm. Chạm vào chuồng để xem và đi mua.","Chạm con đói rồi bấm Cho ăn, con có sản phẩm thì bấm Thu.","Mỗi con có tên. Vuốt ve mỗi ngày cho thân: thân thì cho hàng nhanh hơn, có khi gấp đôi. Chuồng có từ 2 con khỏe trở lên thì có khi đẻ con (gà ấp trứng nở gà con).","Bỏ đói lâu hoặc trở trời là con vật bệnh, không cho hàng. Chạm vào để mời thú y.","Dê ăn rau muống, cho sữa dê. Sữa dê làm phô mai, sữa chua, kẹo sữa, bánh flan, bánh tráng sữa, sữa dê nước dừa, bánh mì phô mai.","Thả vịt, thả cá: vào bảng nhân vật › Nuôi thêm, bấm chọn chỗ thả rồi chạm vào ao, mương nước trên bản đồ.","Vịt đẻ trứng vịt, cá lớn thì kéo lưới được cá tra."]},{"id":"ray","ic":"lua","n":"Rầy nâu, sâu bệnh","b":["Mùa hạ, mùa thu, trời mưa dễ có dịch rầy nâu. Ô bị rầy có dấu chấm than đỏ, cây teo dần rồi chết, rầy còn lây qua ô bên cạnh.","Chạm ô có rầy để phun thuốc: sạch luôn mấy ô xung quanh. Bình thuốc 150 xu được 5 lần phun.","Nuôi vịt thì vịt chạy đồng ăn rầy. Người làm ruộng thuê có thuốc thì tự phun giùm.","Đèn bẫy rầy (Xây dựng › Đồ vật) giữ ruộng trong vòng 6 ô không bị dịch."]},{"id":"xuong","ic":"banh","n":"Xưởng chế biến","b":["Xây xưởng rồi xếp món vào hàng đợi; xong thì chạm để thu.","Xưởng đặt gần Kho hàng làm nhanh hơn 25%.","Đồ chế biến bán được giá hơn nhiều so với bán nông sản thô.","Tiền lời tính đều theo phút nấu: món lâu hay món nhanh đều lời như nhau mỗi phút. Món lễ lời gấp 2,5.","Món trong xưởng xếp theo cấp mở. Món cần nguyên liệu cấp cao thì mở muộn hơn cấp xưởng.","Mỗi loại xưởng xây được cái thứ hai khi lên cấp cao hơn."]},