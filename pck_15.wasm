"", "cls": "", "r": [219.28, 210.66, 14.81, 9], "css": {"display": "block", "position": "static", "background-color": "rgba(0, 0, 0, 0)", "background-image": "none", "background-size": "auto", "background-position": "0% 0%", "background-repeat": "repeat", "border-top": "0px none rgb(90, 62, 20)", "border-right": "0px none rgb(90, 62, 20)", "border-bottom": "0px none rgb(90, 62, 20)", "border-left": "0px none rgb(90, 62, 20)", "border-radius": "0px", "backdrop-filter": "none", "gap": "normal", "justify-content": "normal", "align-items": "normal", "flex-direction": "row", "box-shadow": "none", "color": "rgb(90, 62, 20)", "font-size": "12px", "font-weight": "500", "text-align": "center", "text-shadow": "none", "opacity": "0.75", "padding-left": "0px", "padding-right": "0px", "padding-top": "0px", "padding-bottom": "0px", "line-height": "12px", "letter-spacing": "normal", "white-space": "normal", "overflow": "visible", "transform": "none", "filter": "none", "visibility": "visible", "z-index": "auto"}, "text": "0/9", "tr": [219.28, 209.66, 14.81, 11]}]}, {"z": 0.75, "tag": "button", "id": "", "cls": "khchip on", "r": [247.59, 200.91, 114.55, 28.5], "css": {"display": "flex", "position": "relative", "background-color": "rgba(0, 0, 0, 0)", "background-image": "linear-gradient(rgb(78, 155, 68) 0%, rgb(81, 159, 70) 50%, rgb(88, 169, 77) 100%)", "background-size": "auto", "background-position": "0% 0%", "background-repeat": "repeat", "border-top": "0px none rgb(255, 255, 255)", "border-right": "0px none rgb(255, 255, 255)", "border-bottom": "0px none rgb(255, 255, 255)", "border-left": "0px none rgb(255, 255, 255)", "border-radius": "10px", "backdrop-filter": "none", "gap": "5px", "justify-content": "normal", "align-items": "center", "flex-direction": "row", "box-shadow": "rgb(63, 116, 41) 0px 0px 0px 1px inset, rgba(150, 215, 130, 0.45) 0px 2px 0px 0px inset, rgba(10, 55, 10, 0.2) 0px 0px 8px 3px inset, rgba(30, 70, 20, 0.32) 0px 1px 2px 0px", "color": "rgb(255, 255, 255)", "font-size": "14.5px", "font-weight": "700", "text-align": "center", "text-shadow": "none", "opacity": "1", "padding-left": "10px", "padding-right": "12px", "padding-top": "0px", "padding-bottom": "0px", "line-height": "14.5px", "letter-spacing": "normal", "white-space": "normal", "overflow": "visible", "transform": "none", "filter": "none", "visibility": "visible", "z-index": "auto"}, "::before": {"content": "\"\"", "w": "16px", "h": "16px", "left": "auto", "top": "auto", "right": "auto", "bottom": "auto", "bg": "rgb(255, 255, 255)", "bgi": "none", "bgs": "auto", "bgp": "0% 0%", "bgr": "repeat", "br": "0px", "bt": "0px none rgb(255, 255, 255)", "btc": "rgb(255, 255, 255)", "bdr": "0px none rgb(255, 255, 255)", "color": "rgb(255, 255, 255)", "fs": "14.5px", "fw": "700", "pos": "static", "dsp": "block", "zi": "auto", "mask": "url(\"data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2024%2024%22%3E%3Cpath%20d%3D%22M2.5%2011.5L12%203.5l9.5%208H19V21h-5v-6h-4v6H5v-9.5z%22%2F%3E%3C%2Fsvg%3E\")", "mr": "0px", "pd": "0px", "bxs": "content-box", "transform": "none", "op": "1", "bs": "none"}, "kids": [{"z": 0.75, "tag": "span", "id": "", "cls": "", "r": [270.84, 209.72, 55.84, 10.88], "css": {"display": "block", "position": "static", "background-color": "rgba(0, 0, 0, 0)", "background-image": "none", "background-size": "auto", "background-position": "0% 0%", "background-repeat": "repeat", "border-top": "0px none rgb(255, 255, 255)", "border-right": "0px none rgb(255, 255, 255)", "border-bottom": "0px none rgb(255, 255, 255)", "border-left": "0px none rgb(255, 255, 255)", "border-radius": "0px", "backdrop-filter": "none", "gap": "normal", "justify-content": "normal", "align-items": "normal", "flex-direction": "row", "box-shadow": "none", "color": "rgb(255, 255, 255)", "font-size": "14.5px", "font-weight": "700", "text-align": "center", "text-shadow": "none", "opacity": "1", "padding-left": "0px", "padding-right": "0px", "padding-top": "0px", "padding-bottom": "0px", "line-height": "14.5px", "letter-spacing": "normal", "white-space": "normal", "overflow": "visible", "transform": "none", "filter": "none", "visibility": "visible", "z-index": "auto"}, "text": "Công trình", "tr": [270.84, 207.72, 55.84, 14]}, {"z": 0.75, "tag": "em", "id": "", "cls": "", "r": [332.69, 210.66, 20.45, 9], "css": {"display": "block", "position": "static", "background-color": "rgba(0, 0, 0, 0)", "background-image": "none", "background-size": "auto", "background-position": "0% 0%", "background-repeat": "repeat", "border-top": "0px none rgb(255, 255, 255)", "border-right": "0px none rgb(255, 255, 255)", "border-bottom": "0px none rgb(255, 255, 255)", "border-left": "0px none rgb(255, 255, 255)", "border-radius": "0px", "backdrop-filter": "none", "gap": "normal", "justify-content": "normal", "align-items": "normal", "flex-direction": "row", "box-shadow": "none", "color": "rgb(255, 255, 255)", "font-size": "12px", "font-weight": "500", "text-align": "center", "text-shadow": "none", "opacity": "0.75", "padding-left": "0px", "padding-right": "0px", "padding-top": "0px", "padding-bottom": "0px", "line-height": "12px", "letter-spacing": "normal", "white-space": "normal", "overflow": "visible", "transform": "none", "filter": "none", "visibility": "visible", "z-index": "auto"}, "text": "0/83", "tr": [332.69, 209.66, 20.45, 11]}]}]}]}}␀␀␀␀␀␀␀[{"sec":"Ruộng vườn","items":[{"id":"trong","ic":"lua","n":"Trồng trọt","b":["Chạm ô đất trống, chọn giống trong bảng hiện ra để gieo. Gieo 1 hạt, gặt được 2.","Nông sản trong kho cũng là hạt giống: bán thì nhớ chừa lại (nút Bán, chừa 4 giống). Hết giống thì mua ở Chợ phiên, nhà hàng xóm, hoặc chợ nổi sáng sớm (đổi nông sản lấy giống cũng được).","Mới đầu chỉ có lúa, rau muống. Lên cấp mở thêm giống mới theo nhịp Hay Day (bắp cấp 2, đậu nành cấp 5, mía cấp 7, chàm cấp 13, bí đỏ cấp 15, bông vải cấp 18, ớt cấp 25, cà chua cấp 30, dâu tây cấp 34...), được tặng 4 hạt mỗi thứ.","Cây tự lớn theo giờ thật, kể cả lúc bạn tắt game: lúa 2 phút, bắp 5 phút, cà chua 6 giờ, dâu tây 8 giờ. Cây khó lớn lâu thì bán giá cao, gặt được nhiều kinh nghiệm.","Tưới nước thì cây lớn nhanh hơn 10% trong lúc đất còn ướt. Mọi nguồn tăng tốc cộng lại tối đa +50%, giá bán cộng lại tối đa +25%; trời mưa ruộng tự được tưới.","Cây chín thì chạm để thu hoạch vào Kho. Có sâu thì chạm để bắt.","Nâng sao ô ruộng (chạm ô đất) từ 1★ tới 5★: cây lớn nhanh hơn, giữ nước lâu hơn. Xưởng, chuồng, sạp bán hàng cũng nâng sao được. Nâng sao cần xu và vật liệu (rơm, phân, vôi, ván, đinh, gạch, tre, lá dừa, mây, bạt, bảng hiệu, cân) rơi ra khi làm việc. Xem trong Kho › Vật liệu nâng sao."]},{"id":"menuo","ic":"lua","n":"Menu ô ruộng","b":["Chạm cây đang lớn: hiện 3 nút tròn và tên cây, thời gian còn lại.","Nút sen đỏ: làm cây chín và thu hoạch ngay, tốn sen đỏ (số ghi trong nút, có hỏi trước). Viền đỏ quanh nút là cây đã lớn tới đâu, đầy vòng là chín.","Nút sao: nâng sao ô ruộng. Viền 5 khúc, sáng mấy khúc là ô đang mấy sao.","Nút nước: tưới cho đầy. Viền xanh là lượng nước còn trong đất.","Cây chín: chạm vào cây hiện nút Thu hoạch.","Đất sẫm, bóng là còn ướt; đất nhạt, nứt nẻ là khô, nên tưới."]},{"id":"lai","ic":"lua","n":"Lai giống","b":["Trồng hai giống khác nhau sát bên nhau (cả chéo góc). Gặt ra thỉnh thoảng được hạt giống lai.","Có 7 giống lai: lúa thơm, lúa chịu mặn, cà chua bi, ớt hiểm, khoai tím, bắp nếp, dưa không hạt. Xem gợi ý ở bảng nhân vật › Giống lai.","Hạt lai chỉ có khi lai. Gặt giống lai ra nông sản để bán, không ra hạt: muốn trồng tiếp phải lai tiếp.","Giống lai là giống quý: ra trái khủng gấp 3, nặng hơn cây gốc, có hạng riêng trong tủ kỷ lục và hội thi tuần."]},{"id":"hoithi","ic":"mat_ong","n":"Hội thi làng","b":["Mỗi tối 19:00–19:15 (giờ thật trên máy) ở sân đình. Chạm nút 🔔 trên màn hình để vào thi.","Bạn bè online cùng thi một bộ 10 câu, bảng điểm hiện điểm từng người (🌐). 19:15 chốt Bảng vàng, ai nhất được thêm 150 xu.","10 câu đố rút từ hơn 100 câu về Nam Bộ: Sài Gòn, miền Đông, miền Tây, đặc sản, ca dao tục ngữ, cải lương, lễ hội Khmer, chuyện trong làng. Mỗi câu 12 giây, trả lời nhanh được thêm điểm. Tên tỉnh tính theo địa giới cũ (trước sáp nhập 7/2025).","Mỗi câu đúng được xu (cấp càng cao càng nhiều). Đúng từ 7 câu được thêm hạt giống và mật ong. Đứng nhất được thêm 90 xu và một nhà hàng xóm thêm thân. Đúng hết 10 câu là Rung chuông vàng: +300 xu và 2 hạt giống lai.","Thi liên tiếp mỗi tối được thưởng thêm 10% mỗi tối, tối đa 50%."]},{"id":"man","ic":"muoi_hot","n":"Hạn mặn mùa khô","b":["Mấy ngày cuối tháng (mùa khô) nước mặn lấn vô sông Vàm, theo kênh mương vô ruộng: cây chậm lớn còn 35–55%. Ô ruộng sát ao, hồ nước ngọt (2 ô) thì không sao.","Tưới bằng nước ngọt trong lu (mưa tự hứng, mua thêm được, đặt lu nước, chum sành để chứa nhiều hơn).","Xây cống ngăn mặn để bớt hẳn. Lúa chịu mặn (giống lai) không sợ mặn. Mùa mặn tôm về nhiều."]},{"id":"caytrai","ic":"qua_xoai","n":"Cây ăn trái","b":["Mua cây giống ở Xây dựng hoặc chợ nổi, trồng một lần là ra trái hoài.","Tưới cho cây đủ nước, trái chín thì chạm để hái.","Giông bão làm rụng nửa trái: dựng hàng rào hoặc chòi cách cây không quá 2 ô để che chắn. Trái rụng nằm dưới gốc, chạm để lượm."]},{"id":"vatnuoi","ic":"trung","n":"Vật nuôi, thả vịt thả cá","b":["Xây chuồng trước ở Xây dựng › Chuồng trại (chuồng gà, cừu, bò, heo, dê). Có chuồng rồi mới mua được con giống.","Con giống mua ở Sổ làng › Chợ phiên (lái gia súc dắt tới mỗi ngày) hoặc ghe cây giống ở chợ nổi sáng sớm. Chạm vào chuồng để xem và đi mua.","Chạm con đói rồi bấm Cho ăn, con có sản phẩm thì bấm Thu.","Mỗi con có tên. Vuốt ve mỗi ngày cho thân: thân thì cho hàng nhanh hơn, có khi gấp đôi. Chuồng có từ 2 con khỏe trở lên thì có khi đẻ con (gà ấp trứng nở gà con).","Bỏ đói lâu hoặc trở trời là con vật bệnh, không cho hàng. Chạm vào để mời thú y.","Dê ăn rau muống, cho sữa dê. Sữa dê làm phô mai, sữa chua, kẹo sữa, bánh flan, bánh tráng sữa, sữa dê nước dừa, bánh mì phô mai.","Thả vịt, thả cá: vào bảng nhân vật › Nuôi thêm, bấm chọn chỗ thả rồi chạm vào ao, mương nước trên bản đồ.","Vịt đẻ trứng vịt, cá lớn thì kéo lưới được cá tra."]},{"id":"ray","ic":"lua","n":"Rầy nâu, sâu bệnh","b":["Mùa hạ, mùa thu, trời mưa dễ có dịch rầy nâu. Ô bị rầy có dấu chấm than đỏ, cây teo dần rồi chết, rầy còn lây qua ô bên cạnh.","Chạm ô có rầy để phun thuốc: sạch luôn mấy ô xung quanh. Bình thuốc 150 xu được 5 lần phun.","Nuôi vịt thì vịt chạy đồng ăn rầy. Người làm ruộng thuê có thuốc thì tự phun giùm.","Đèn bẫy rầy (Xây dựng › Đồ vật) giữ ruộng trong vòng 6 ô không bị dịch."]},{"id":"xuong","ic":"banh","n":"Xưởng chế biến","b":["Xây xưởng rồi xếp món vào hàng đợi; xong thì chạm để thu.","Xưởng đặt gần Kho hàng làm nhanh hơn 25%.","Đồ chế biến bán được giá hơn nhiều so với bán nông sản thô.","Tiền lời tính đều theo phút nấu: món lâu hay món nhanh đều lời như nhau mỗi phút. Món lễ lời gấp 2,5.","Món trong xưởng xếp theo cấp mở. Món cần nguyên liệu cấp cao thì mở muộn hơn cấp xưởng.","Mỗi loại xưởng xây được cái thứ hai khi lên cấp cao hơn."]},{"id":"kho","ic":"nuoc_mia","n":"Kho, đơn hàng, giá bán","b":["Chạm Kho để bán; giá lên xuống theo ngày. Chạm một món để xem biểu đồ giá 7 ngày.","Bán dồn một món thì giá tụt dần theo từng cái (tối đa còn 60%), mỗi tiếng hồi lại một phần.","Rau trái đúng mùa rẻ, trái mùa đắt; sắp bão, lũ, hạn, dịch thì đồ thiếu lên giá; gần lễ thì đồ cúng lên giá.","Tin chợ trong Chuyện làng › Buôn bán báo trước món nào mai lên, xuống giá.","Đơn hàng trả thưởng cao hơn bán lẻ.","Độ đẹp của làng nâng giá bán mọi thứ, tối đa thêm 40%."]}]},{"sec":"Làm ăn","items":[{"id":"quan","ic":"banh_mi_thit","n":"Quán cơm","b":["Xây Quán cơm (Xây dựng › Nhà), chạm vào quán để mở bảng quán.","Bấm \"Nấu nồi\": nhân vật ra quán nấu, mỗi nồi được 4 phần, tốn nguyên liệu và 1 bó củi.","Khách ghé từ 6 tới 21 giờ, đông nhất giờ cơm. Khách gọi trúng món hết thì quán mất sao. Quán nhiều sao thì đông khách, được boa.","Chọn giá Bình dân để mau lên sao, giá Sang thì lời nhiều mà khách thưa."]},{"id":"lo","ic":"luon","n":"Lờ, lọp, giăng câu","b":["Bảng nhân vật › Lờ lọp: mua lờ tre, lọp lươn, dây câu giăng.","Bấm Đặt rồi chạm mặt nước sát bờ. Lọp mồi bằng ốc, câu giăng mồi bằng tôm, đặt trên sông Vàm.","Đợi 10–20 phút rồi chạm để thăm. Ban đêm cá ăn mạnh hơn; để lâu quá cá xổng bớt; thỉnh thoảng rái cá ăn mất.","Mỗi cái dùng được 8–10 lần rồi mục."]},{"id":"chophien","ic":"qua_mangcut","n":"Sạp quê","b":["Chạm Sạp bán hàng (hoặc Sổ làng › Sạp quê) để bày đồ dư trong kho, tự đặt giá, tối đa 6 món.","Bạn bè ghé làng mua được; khách lẻ trong làng thỉnh thoảng cũng mua nếu giá không đắt quá 30% giá chợ.","Sạp không tự bán đồ trong kho nữa, nên cứ để dành hàng làm đơn lớn."]},{"id":"taphoa","ic":"keo_dua","n":"Tạp hóa, quán cà phê võng","b":["Tạp hóa đầu ngõ: lâu lâu có đơn sỉ đồ chế biến, trả hơn giá chợ khoảng 25%, có kinh nghiệm. Giữ tối đa 2 đơn, mỗi đơn đợi 4 tiếng.","Quán cà phê võng: ban ngày khách ghé gọi nước (nước mía, sinh tố, chè…). Mang ra kịp được trả tiền và tiền boa.","Có đơn hay có khách thì trên mái hiện bong bóng, chạm vào để giao."]},{"id":"dulich","ic":"qua_mangcut","n":"Du lịch miệt vườn","b":["Có nhà dân và quán cơm hoặc sạp thì khách Sài Gòn, khách Tây ba lô tới ở homestay (ban ngày 7–16 giờ).","Khách đi quán, mua đặc sản ở sạp (trả giá cao), lên đình, chụp hình chỗ cảnh đẹp, đi xuồng ở bến ghe, ra cù lao.","Ngủ lại một đêm rồi trả tiền phòng và chấm sao. Danh tiếng cao thì khách tới thường hơn. Chỉnh giá phòng ở Sổ làng › Du lịch."]},{"id":"hoicho","ic":"banh","n":"Đêm hội chợ quê","b":["Cách một ngày có hội chợ ở sân đình từ 18g30 tới 22g30 (ngày lễ cũng có). Muốn chơi liền thì bỏ 2.000 xu tổ chức tối nay (bảng Trời đất).","Ném vòng trúng chai, bịt mắt đập niêu, hát lô tô ăn tiền thưởng. Chạm vào sạp trò chơi hoặc sân khấu để chơi.","Dân làng kéo nhau đi hội chợ đông vui."]},{"id":"xephang","ic":"kem","n":"Bảng xếp hạng","b":["Sổ làng › Bảng xếp hạng: so làng đẹp, giàu có, cấp độ, quán ngon với bạn bè.","Mỗi tuần, đứng hạng 1–3 bảng nào (cần ít nhất 3 làng) thì nhận giải bảng đó."]}]},{"sec":"Nhân vật","items":[{"id":"nhanvat","ic":"sua","n":"Sức khỏe, cấp độ","b":["Chạm vào vật nào thì hiện bảng của nó, chọn việc xong nhân vật mới đi tới làm, mỗi việc tốn chút sức.","Chạm ô đất trống rồi bấm chip xanh Đi đến đây để dắt nhân vật đi dạo. Đang đi thì góc dưới trái có nút tròn Dừng, bấm là đứng lại và bỏ hết việc đang chờ.","Hết sức thì đi chậm gần một nửa, làm lâu gấp đôi. Ăn đồ ăn, nấu cơm hoặc về nhà ngủ để hồi sức; ban đêm hồi nhanh hơn.","Làm việc được kinh nghiệm để lên cấp, mở thêm đồ nghề, áo quần, xe đạp."]},{"id":"bep","ic":"ca_loc","n":"Nấu ăn và hiệu ứng","b":["Bảng nhân vật › Bếp: nấu món từ đồ trong kho, mỗi lần tốn 1 bó củi.","Món ăn hồi nhiều sức và cho hiệu ứng có hạn: Chân sáo (đi nhanh), Tay mát (thu thêm), Dẻo dai (đỡ tốn sức), Sáng dạ (thêm kinh nghiệm), No ấm (hồi sức nhanh), Tay câu đỏ (dễ câu cá quý).","Hiệu ứng tốt, xấu đang có hiện thành icon nhỏ dưới avatar; chạm vào để xem chi tiết và thời gian còn lại."]},{"id":"cui","ic":"cui","n":"Củi khô","b":["Mua 5 bó 60 xu ở Bếp, mua ở chợ nổi.","Dọn cây bị giông quật ngã được 2–4 bó.","Chặt cây tràm ở rừng tràm U Minh được 2 bó mỗi cây."]}]},{"sec":"Trời đất","items":[{"id":"thoitiet","ic":"rau_muong","n":"Thời tiết","b":["Mỗi ngày chia 4 buổi, mỗi buổi 6 tiếng, thời tiết có thể đổi theo buổi. Chạm ô thời tiết ở góc trên để xem dự báo.","Mưa, giông: ruộng tự tưới nhưng đi chậm 20–30%. Mặc Áo mưa (Tủ đồ) để đi bình thường.","Nắng hạn: đất khô nhanh gấp rưỡi, nhớ tưới thường xuyên."]},{"id":"giong","ic":"qua_chuoi","n":"Giông bão và sét","b":["Giông lớn quật ngã cây cao (dừa, cau, chuối, xoài…). Chạm cây đổ để dọn lấy củi; ít phút sau cây con mọc lại.","Sét có thể đánh cháy cây. Cột thu lôi (Xây dựng › Vật dụng) hút sét trong vòng 7 ô.","Cây ăn trái bị rụng trái nếu không có rào hay chòi che gần đó."]},{"id":"nuoc","ic":"ca_keo","n":"Con nước lớn ròng","b":["Sông Vàm lên xuống theo con nước, khoảng 12 tiếng một vòng. Giờ nước ròng, nước lớn ghi trong bảng Trời đất.","Nước ròng lộ bãi bùn hai bên bờ: bắt cá kèo, mò ốc, vớt lục bình.","Nước lớn thì ghe thương hồ vô bến lẹ hơn."]},{"id":"nuocnoi","ic":"dien_dien","n":"Mùa nước nổi","b":["Mùa thu nước lên, phù sa bồi: cây trái lớn nhanh hơn 4%.","Có cá linh để câu. Ven sông mọc điên điển, súng ma, kèo nèo: chạm để hái, mỗi ngày một lần."]}]},{"sec":"Sông nước, hội hè","items":[{"id":"cho","ic":"qua_thanhlong","n":"Chợ nổi","b":["Mở một khúc sông Vàm thì có chợ nổi, họp từ 5 tới 9 giờ sáng.","Bốn ghe bán đủ thứ: cây giống, con giống, hạt giống, củi, đồ khô và đồ hiếm thương lái gửi. Mỗi kèo mua bán một lần mỗi ngày."]},{"id":"ghe","ic":"dua_cai","n":"Ghe thương hồ","b":["Đặt Bến ghe sát bờ sông, ghe thương hồ sẽ cập bến kèm một đơn lớn 5–6 thùng hàng.","Ghe đậu 4 tiếng. Chất thùng nào trả tiền thùng đó; chất đủ hết thì thưởng thêm xu, kinh nghiệm và vật liệu hiếm.","Ghe đi rồi khoảng 1–2 tiếng sau mới có ghe khác."]},{"id":"hoi","ic":"kem","n":"Lễ hội","b":["Bốn lễ trong năm: Tết, Vu Lan, Trung Thu, Kỳ Yên. Lịch ghi trong bảng Trời đất.","Ba ngày trước lễ, bà con nhờ góp lễ vật. Đủ lễ thì ngày hội cả làng nhận lộc, cây lớn nhanh hơn 4%."]},{"id":"tat","ic":"ca_ro","n":"Tát mương bắt cá","b":["Mỗi tuần một lần, chạm cái gàu cạnh ao nhà để tát mương.","Chạm nhanh vào cá dưới bùn để bắt. Xong rồi có thể trúi cá tặng hàng xóm, thêm ♥."]},{"id":"dieu","ic":"mia","n":"Thả diều","b":["Mùa Đông, mùa Xuân có gió từ 14 tới 18 giờ.","Mua diều trong bảng nhân vật, thả diều nghe sáo kêu; có hội thi diều với giải thưởng."]},{"id":"ma","ic":"nhang","n":"Ma trơi ban đêm","b":["Đêm khuya đôi khi có đốm ma trơi lập lòe ngoài đồng.","Đi theo thì có khi được của, có khi bị lạc, có khi nghe một câu chuyện xưa."]},{"id":"cau","ic":"ca_chep","n":"Câu cá","b":["Bấm Câu cá rồi chạm chỗ có nước. Hồ lớn, sông Vàm có cá quý hơn."]}]},{"sec":"Làng xóm","items":[{"id":"lang","ic":"qua_mit","n":"Hàng xóm và ♥","b":["Chạm nhà hàng xóm để thăm, tặng quà, phụ việc. Càng thân càng nhiều ♥.","3 ♥: được truyền nghề thủ công. 5 ♥: nhà có con thì có thể dạm hỏi cưới.","Thân rồi thì mướn được người nhà họ làm thuê.","Dân làng ở trong mấy căn nhà bạn xây: ban ngày họ ra quán ăn cơm, ra sạp mua đồ, lên đình, qua nhà nhau chơi, có khi ghé thăm cho quà. Làng càng đông nhà, quán và sạp càng đông khách."]},{"id":"thue","ic":"khoai","n":"Người làm thuê","b":["Sổ làng › Người làm thuê để quản lý.","Giao việc: làm ruộng (chọn cây gieo), coi xưởng (chọn món), chăm vườn cây trái, chăn nuôi.","Trả công theo ngày; hết việc để làm thì họ tự nghỉ.","Giờ làm: sáng 6:00–11:30, chiều 13:00–18:00. Trưa nghỉ ăn cơm, tối về nhà ngủ tới sáng. Giờ nghỉ không tính công. Để chế độ luôn ngày thì làm suốt, luôn đêm thì nghỉ suốt."]},{"id":"nghe","ic":"chieu","n":"Nghề thủ công","b":["Học nghề ở nhà hàng xóm đủ 3 ♥: 10 nghề như đan giỏ, dệt chiếu, se nhang, gói bánh phu thê, nấu rượu nếp, thêu khăn.","Cả dòng họ chung một nghề, mỗi làng xếp nghề khác nhau. Tiền học nghề đầu 4.000 xu, nghề sau gấp 1,5; mỗi 7 ngày học 1 nghề mới.","Mở bảng Nghề (nhóm Làm ăn) để làm. Mỗi món +1 điểm tay nghề, tối đa 15 điểm một ngày. Đủ điểm, đủ hàng đã làm thì qua thầy thi lên sao. Chỉ 3 nghề chính lên được 4★, 5★.","Sao cao ra hàng khéo, tinh xảo giá cao; mỗi nghề biết thêm bớt 1% tỉ lệ. Bán hàng nghề cho chợ chỉ được 60%.","Bảng Nghề còn có đơn làng: bà con đặt hàng cho đám cưới, hội đình, nhà gặp nạn, lễ Tết. Quá hạn không giao là mất thân, mất uy tín; bỏ 3 đơn trong 7 ngày thì mang tiếng. Thiếu món thì mua thương lái hoặc đặt thợ bạn bè làm."]},{"id":"cuoi","ic":"banh_pt","n":"Cưới hỏi","b":["Thân 5 ♥ với nhà có con chưa vợ chồng thì dạm hỏi được.","Chuẩn bị mâm sính lễ, tiền cưới. Cưới xong vợ hoặc chồng phụ việc nhà, ít lâu sau có em bé."]},{"id":"hui","ic":"dp_rang","n":"Chơi hụi","b":["Sổ làng › Hụi làng. Một dây 6 phần, mỗi kỳ 12 tiếng trong game.","Hốt sớm thì được ít, hốt muộn được nhiều hơn. Chủ hụi càng thân thì càng ít rủi ro bể hụi."]},{"id":"dam","ic":"lx_tuoi","n":"Đám tiệc","b":["Hàng xóm có đám cưới, đám giỗ sẽ mời. Mang quà tới phụ thì thêm ♥, ăn đám được hiệu ứng như ăn cơm nhà."]},{"id":"khach","ic":"qua_mangcut","n":"Thăm làng bạn bè","b":["Sổ làng › Khách ghé thăm: ghé làng của người khác.","Phụ tưới, bắt sâu, cho ăn (10 lần một ngày) được cảm ơn; hái trộm (5 lần mỗi nhà mỗi ngày) thì coi chừng chó rượt rớt dép, đi chậm một lúc."]},{"id":"thu","ic":"chuoi_say","n":"Thư từ, radio","b":["Bác đưa thư đạp xe tới khoảng 9–12 giờ, có khi mang thư, quà.","Radio có bản tin lúc 6 giờ và 18 giờ."]}]},{"sec":"Mở mang đất đai","items":[{"id":"khaihoang","ic":"bap","n":"Khai hoang","b":["Chạm biển Khai hoang để mua khu đất kề khu mình đã có.","Đất mới có cây, nhà cũ: chạm để dọn lấy xu, chạm ruộng để gặt lúa, dọn tới đâu xây tới đó.","Vùng đất mới xa làng (phía nam, phía đông, rừng tràm, cù lao) giá cao hơn nhưng có sản vật riêng."]},{"id":"culao","ic":"qua_saurieng","n":"Cù lao giữa vàm","b":["Ở phía đông, sông Vàm phình ra thành vàm lớn ôm một cù lao. Mở khúc sông phía đông rồi mới khai hoang được cù lao.","Cù lao có sầu riêng, măng cụt, chôm chôm, mít, xoài, bưởi mọc hoang. Trái chín có bong bóng, chạm để hái; hái xong khoảng 30 phút lại chín."]},{"id":"tram","ic":"mat_ong","n":"Rừng tràm U Minh","b":["Rừng tràm ngập nước ở phía tây. Chặt tràm được củi.","Cây tràm có tổ ong: chạm để lấy mật ong, khoảng 25 phút ong làm mật lại.","Có củi trong kho thì nhân vật hun khói trước (tốn 1 bó), ít bị ong đốt. Bị đốt mất 12 sức."]},{"id":"yte","ic":"nhang","n":"Trạm y tế","b":["Xây Trạm y tế (Xây dựng › Nhà, 3x3 ô, xoay được). Chạm vào trạm để mở.","Khám sức khỏe: hồi đầy sức ngay, nghỉ 8 phút mới khám lại. Chén thuốc bổ: \"Dẻo dai\" 10 phút, mỗi ngày một chén.","Bị ong đốt thì ra trạm bôi thuốc miễn phí. Dân trong xóm cũng hay ghé khám."]},{"id":"xay","ic":"gach","n":"Xây dựng, độ đẹp","b":["Nút Xây dựng: đặt nhà, chòi, hàng rào, cây kiểng. Chạm giữ để dời, xoay.","Độ đẹp càng cao giá bán càng tăng, tối đa thêm 40%."]}]}]␀␀␀␀␀␀␀{".u2pop":[{"z":1,"tag