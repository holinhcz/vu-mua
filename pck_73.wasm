îr[CpãPùÿ4Ûæ@Äû␀␀␀␀␀␀␀␀␀␀␀␀␀// Chá»‰nh mÃ u cáº£ cáº£nh + quÃ¢n (dÆ°á»›i tháº», chá»¯): náº¯ng trÆ°a áº¥m, tÆ°Æ¡i hÆ¡n, bá»›t Ä‘Ã¹ (Link 11-21 "nhÃ¬n cá»© Ä‘Ã¹ Ä‘Ã¹")
shader_type canvas_item;
uniform sampler2D S : hint_screen_texture, filter_nearest;
uniform float sat = 1.25;
uniform float con = 1.10;
uniform vec3 gain = vec3(1.10, 1.05, 0.96);
uniform float lift = 0.02;
void fragment() {
	vec3 c = texture(S, SCREEN_UV).rgb;
	float l = dot(c, vec3(0.299, 0.587, 0.114));
	c = mix(vec3(l), c, sat);
	c = (c - 0.5) * con + 0.5;
	c = c * gain + lift;
	COLOR = vec4(clamp(c, 0.0, 1.0), 1.0);
}
␀␀␀␀␀␀␀␀␀␀shader_type canvas_item;
// bÃ³ng Ä‘á»• má»m cá»§a Ä‘á»“ váº­t: láº¥y alpha á»Ÿ mipmap tháº¥p (má»), tÃ´ mÃ u bÃ³ng
uniform sampler2D tex : filter_linear_mipmap;
uniform float lod = 4.0;
uniform float alpha = 0.42;
uniform vec3 col = vec3(0.09, 0.11, 0.18);
void fragment() {
	COLOR = vec4(col, textureLod(tex, UV, lod).a * alpha);
}
shader_type canvas_item;
// giÃ³ cho tÃ¡n cÃ¢y/bá»¥i chuá»‘i/bÃ³ng: láº¯c theo khoáº£ng cÃ¡ch tá»›i gá»‘c + lÃ¡ rung tá»«ng chá»— + Ã¡nh náº¯ng láº¥p lÃ¡nh
uniform sampler2D noise : filter_linear, repeat_enable;
uniform sampler2D tex : filter_linear_mipmap;
uniform vec2 tex_size = vec2(512.0);
uniform vec2 pivot = vec2(0.0);      // gá»‘c cÃ¢y theo pixel cá»§a áº£nh
uniform float reach = 600.0;
uniform float amp = 6.0;            // biÃªn Ä‘á»™ láº¯c cáº£ cÃ nh (px)
uniform float flutter = 2.0;        // lÃ¡ rung (px)
uniform float bend = 0.0;           // xoay quanh gá»‘c (radian) cho chuá»‘i
uniform float phase = 0.0;
uniform float glint = 0.1;
uniform float fleck = 0.0;          // Ä‘á»‘m náº¯ng cháº¡y trong bÃ³ng
uniform float shadow = 0.0;         // >0: váº½ bÃ³ng (Ä‘áº­m), má» báº±ng mipmap
uniform float lod = 0.0;
uniform float px_scale = 1.0;
uniform vec3 shadow_col = vec3(0.09, 0.11, 0.18);
void fragment() {
	vec2 p = UV * tex_size;
	float d = clamp(length(p - pivot) / reach, 0.0, 1.0);
	float t = TIME;
	float gust = texture(noise, vec2(t * 0.025 + phase, 0.37)).r;
	float g = 0.55 + 0.9 * gust;
	vec2 sway = vec2(sin(t * 0.85 + phase) + 0.35 * sin(t * 2.3 + phase * 1.9),
	                 0.6 * cos(t * 0.65 + phase * 1.3) + 0.25 * sin(t * 1.7 + phase)) * amp * d * d * g;
	vec2 n = texture(noise, p / (160.0 * px_scale) + vec2(t * 0.045, t * 0.03)).rg - 0.5;
	vec2 off = sway + n * flutter * d * g;
	vec2 q = p - off;
	if (bend != 0.0) {
		float a = bend * d * (sin(t * 0.8 + phase) + 0.3 * sin(t * 1.9 + phase)) * g;
		vec2 r = q - pivot;
		q = pivot + vec2(r.x * cos(a) + r.y * sin(a), -r.x * sin(a) + r.y * cos(a));
	}
	vec4 c = shadow > 0.0 ? vec4(shadow_col, textureLod(tex, q / tex_size, lod).a * shadow) : texture(tex, q / tex_size);
	float gl = texture(noise, p / (70.0 * px_scale) + vec2(-t * 0.07, t * 0.05)).b;
	c.rgb *= 1.0 + glint * smoothstep(0.62, 0.78, gl) * d;
	if (fleck > 0.0) {
		float f = texture(noise, p / (55.0 * px_scale) + vec2(t * 0.05, -t * 0.035)).g;
		c.a *= 1.0 - fleck * smoothstep(0.5, 0.8, f);
	}
	COLOR = c;
}
