":0,"day":1,"n":"Tết Nguyên Đán","sh":"Tết","cand":["gao","thit","qua_chuoi","qua_dua","duong","trung","hanh","qua_xoai","dua_cai","lua"],"d":"Cả làng gói bánh tét, chưng mai vàng, giao thừa bắn pháo hoa.","why":"gói bánh tét, cúng ông bà ba ngày Tết"},{"id":"vulan","sea":1,"day":6,"n":"Rằm tháng Bảy","sh":"Rằm tháng Bảy","cand":["gao","bot_gao","qua_chuoi","qua_xoai","duong","qua_dua","bido"],"d":"Cúng chay, tối thả đèn hoa đăng trôi trên sông, trên ao.","why":"nấu cỗ chay, làm đèn hoa đăng"},{"id":"trungthu","sea":2,"day":7,"n":"Rằm tháng Tám","sh":"Trung thu","cand":["bot","trung","duong","dauphong","qua_dua","qua_buoi","bot_gao"],"d":"Làm bánh nướng bánh dẻo, treo lồng đèn, tối trẻ con rước đèn ông sao quanh xóm.","why":"làm bánh trung thu, lồng đèn cho tụi nhỏ"},{"id":"kyyen","sea":3,"day":4,"n":"Lễ Kỳ Yên cúng đình","sh":"Cúng đình","cand":["gao","thit","qua_buoi","qua_chuoi","qua_dua","trung","lua","qua_xoai"],"d":"Bày mâm cỗ cúng thần làng ở sân đình, treo cờ, đánh trống, ăn cỗ chung.","why":"bày mâm cỗ cúng thần làng"}][{"id":"sao","n":"Diều sáo","xu":300,"lv":1,"c1":"#f2c63a","c2":"#c4302a","d":"Diều giấy có ống sáo tre, bay lên kêu vi vu."},{"id":"ca","n":"Diều cá chép","xu":700,"lv":3,"c1":"#e8542a","c2":"#f6d24a","d":"Hình con cá chép đỏ, đuôi dài phất phới."},{"id":"en","n":"Diều cánh én","xu":1500,"lv":5,"c1":"#2a3a5a","c2":"#f6f2e8","d":"Cánh én đen trắng, lướt gió êm. Thắng thi diều cũng được tặng."}]␀␀␀␀␀␀␀␀␀␀␀␀{"well":{"name":"Giếng sâu","base":250,"mul":1.9,"max":8},"fert":{"name":"Phân bón","base":400,"mul":2.1,"max":8},"stall":{"name":"Quầy hàng","base":500,"mul":2.2,"max":8},"pen":{"name":"Máng ăn","base":450,"mul":2,"max":8},"xuong":{"name":"Xưởng nhanh tay","base":600,"mul":2,"max":8}}␀␀␀␀␀{"harvest":[["voi",0.015],["rom",0.015]],"rice":[["rom",0.03],["voi",0.01]],"collect":[["phan",0.07],["la",0.035],["tre",0.035],["may",0.01]],"work":[["van",0.08],["dinh",0.06],["gach",0.04]],"chop":[["van",0.15],["dinh",0.07],["tre",0.07]],"clear":[["tre",0.07],["may",0.03],["la",0.04]],"lo":[["phao",0.08],["luoi",0.12],["cuoc",0.08]],"deliver":[["van",0.2],["dinh",0.15],["gach",0.08]],"help":[["van",0.1],["dinh",0.1],["la",0.05],["may",0.03]],"trip":[["van",0.4],["dinh",0.3],["gach",0.3]],"fish":[["phao",0.14],["cuoc",0.08],["luoi",0.05]]}␀␀␀␀␀␀␀␀␀␀␀␀␀{"xe":{"name":"Thùng xe hàng","base":12,"mul":2,"max":3}}␀␀␀␀␀{"rom":{"n":"Rơm khô","g":"ruong"},"phan":{"n":"Phân chuồng","g":"ruong"},"voi":{"n":"Vôi bột","g":"ruong"},"van":{"n":"Ván gỗ","g":"xuong"},"dinh":{"n":"Đinh sắt","g":"xuong"},"gach":{"n":"Gạch nung","g":"xuong"},"tre":{"n":"Cây tre","g":"chuong"},"la":{"n":"Lá dừa nước","g":"chuong"},"may":{"n":"Dây mây","g":"chuong"},"phao":{"n":"Phao lông nhím","g":"cau"},"cuoc":{"n":"Dây cước","g":"cau"},"luoi":{"n":"Lưỡi câu thép","g":"cau"}}␀␀␀␀␀␀␀␀␀["Tay vậy mà đòi học nghề hả {c}?","Cái này đem cho gà, gà còn chê.","Thôi, lần đầu ai cũng vậy. Làm lại đi.","Hư rồi. Ráng lên, {x} hồi đó còn tệ hơn."]␀␀␀␀␀␀␀␀␀␀␀{"dinh":[["nhang",5,1],["chieu",2,1]],"chua":[["nhang",6,1],["long_den",2,1]],"truong":[["chieu",3,0],["gio_lb",3,0]],"tramyt":[["chieu",3,0],["nhang",2,0]],"gate":[["long_den",3,0],["choi_rom",2,0]],"causong":[["gio_lb",3,0],["choi_rom",3,0]]}␀␀␀␀␀␀␀␀␀␀␀␀[["banh_pt",4,1],["chieu",1,1],["khan_theu",2,0],["ruou_nep",2,0]]␀␀␀␀␀␀␀␀␀␀␀␀␀␀{"bao":[["chieu",1,0],["gio_lb",2,0]],"lu":[["chieu",1,0],["gio_lb",2,0]],"chay":[["chieu",2,0],["gio_lb",2,0]],"han":[["gio_lb",3,0],["chao",2,0]],"dich":[["nhang",3,0],["chao",2,0]]}␀␀␀␀␀␀␀␀[["nhang",6,0],["ruou_nep",2,0],["choi_rom",3,0]]␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀{"tet":[["mut_gung",4,1],["nhang",4,0]],"vulan":[["nhang",4,0],["chao",3,0]],"trungthu":[["long_den",4,1],["banh_pt",2,0]],"kyyen":[["nhang",5,0],["ruou_nep",2,0]]}␀␀␀␀␀␀␀␀␀␀␀␀[{"s":"","n":"thường","m":1},{"s":"_k","n":"khéo","m":1.6},{"s":"_x","n":"tinh xảo","m":2.6}]␀␀␀␀␀␀␀␀␀␀␀␀␀[0,50,200,600,1500]␀␀␀␀␀␀␀␀␀␀␀␀␀[{"id":"gio_lb","n":"Đan giỏ lục bình","in":[["luc_binh",4]],"t":60,"tt":30,"d":"Phơi khô cọng lục bình vớt ngoài sông rồi đan giỏ.","tip":["Lục bình phải phơi tới khô queo, còn ướt mà đan là mốc meo, bán ai mua.","Đan thì nhặt mối cho đều tay, đừng vừa đan vừa ngó trời ngó đất."]},{"id":"chieu","n":"Dệt chiếu cói","in":[["lua",8],["soi",1]],"t":72,"tt":45,"d":"Cói phơi khô, se với sợi dệt thành chiếu bông.","tip":["Sợi cói chẻ cho đều, chẻ ẩu là chiếu nằm cấn lưng cả đêm.","Dệt chiếu cưới thì chữ Song Hỷ phải thẳng, cong là bị nhà trai chê tới già."]},{"id":"nhang","n":"Se nhang trầm","in":[["cui",2],["bot",1]],"t":42,"tt":35,"d":"Giã củi khô thành bột trầm, se nhang phơi nắng.","tip":["Bột trầm trộn keo vừa thôi, nhiều keo là nhang cháy khét như đốt vỏ xe.","Se xong phơi đủ ba nắng, phơi một nắng là nhang ẩm, cúng ông bà ông bà ho."]},{"id":"banh_pt","n":"Gói bánh phu thê","in":[["bot_gao",2],["qua_dua",1],["dauphong",1]],"t":54,"tt":40,"d":"Bánh xu xê nhân dừa gói lá, đãi đám cưới, làm mâm quả.","tip":["Bột khuấy tới khi trong veo, còn đục là bánh dai như dây thun.","Nhân dừa sên xong để nguội rồi gói, đừng có ăn vụng hết trước."]},{"id":"choi_rom","n":"Bó chổi rơm","in":[["lua",10]],"t":36,"tt":30,"pn":"Chổi rơm","sell":75,"d":"Rơm nếp phơi khô, bó chặt thành chổi quét sân.","tip":["Lấy rơm nếp, cọng dai, rơm tẻ bó xong quét hai bữa là trụi lủi.","Bó chặt tay vô, lỏng là quét tới đâu rụng tới đó, quét nhà thành rải rơm."],"art":"<path d=\"M30 6h4v30h-4z\" fill=\"#a8743a\"/><path d=\"M20 36h24l8 22H12z\" fill=\"#e3c25a\" stroke=\"rgba(0,0,0,.3)\" stroke-width=\"1.2\"/><path d=\"M24 40l-4 16M32 40v17M40 40l4 16\" stroke=\"#b8942e\" stroke-width=\"1.6\"/><path d=\"M19 38h26\" stroke=\"#8a2a1a\" stroke-width=\"3\"/>"},{"id":"ruou_nep","n":"Nấu rượu nếp","in":[["nep",6],["bot",1]],"t":72,"tt":50,"pn":"Rượu nếp","sell":190,"d":"Nếp nấu chín, rắc men, ủ ba ngày ra rượu nếp thơm.","tip":["Men tán cho thật mịn, rắc đều, chỗ có chỗ không là rượu chua như giấm.","Ủ đủ ba ngày, đừng có mở ra nếm hoài, nếm hết thì lấy gì bán."],"art":"<path d=\"M24 10h16v8l6 8v26a4 4 0 0 1-4 4H22a4 4 0 0 1-4-4V26l6-8z\" fill=\"#e8dcc0\" stroke=\"rgba(0,0,0,.3)\" stroke-width=\"1.3\"/><path d=\"M19 32h26v18H19z\" fill=\"#c4302a\" opacity=\".85\"/><path d=\"M24 8h16v5H24z\" fill=\"#8a5a2a\"/><circle cx=\"32\" cy=\"41\" r=\"5\" fill=\"#f2d24a\"/>"},{"id":"khan_theu","n":"Thêu khăn","in":[["vai",1],["soi",1]],"t":84,"tt":55,"pn":"Khăn thêu","sell":330,"d":"Căng vải lên khung, thêu bông sen bông súng làm khăn.","tip":["Căng khung cho thẳng, vải chùng là thêu bông sen ra bông súng.","Mũi kim đi đều, đừng ham lẹ, khăn thêu là bán cái công chớ bán gì."],"art":"<path d=\"M10 14h44v36H10z\" fill=\"#f4efe2\" stroke=\"rgba(0,0,0,.3)\" stroke-width=\"1.3\"/><path d=\"M10 44h44\" stroke=\"#3a7ac4\" stroke-width=\"2\"/><path d=\"M32 22c4 4 6 9 0 14-6-5-4-10 0-14z\" fill=\"#e2708a\"/><path d=\"M26 30c4 0 6 3 6 6-4 0-6-3-6-6zM38 30c-4 0-6 3-6 6 4 0 6-3 6-6z\" fill=\"#e89aa8\"/><path d=\"M32 36v6\" stroke=\"#4a9a3a\" stroke-width=\"2\"/>"},{"id":"mut_gung","n":"Sên mứt gừng","in":[["gung",4],["duong",1]],"t":78,"tt":60,"pn":"Mứt gừng","sell":440,"d":"Gừng non xắt mỏng, xả nước cho bớt cay, sên đường tới khi kết hạt.","tip":["Gừng luộc xả hai nước cho bớt cay, không là ăn một miếng khóc một dòng.","Sên lửa liu riu, lửa lớn là đường cháy, mứt gừng thành kẹo đắng."],"art":"<ellipse cx=\"32\" cy=\"46\" rx=\"22\" ry=\"8\" fill=\"#c4302a\" stroke=\"rgba(0,0,0,.3)\" stroke-width=\"1.2\"/><path d=\"M16 42q16-26 32 0z\" fill=\"#f2e2a8\" stroke=\"#c8a85a\" stroke-width=\"1.2\"/><path d=\"M22 36l6-8M30 34l4-10M38 36l-2-9\" stroke=\"#fff\" stroke-width=\"2.4\" stroke-linecap=\"round\"/>"},{"id":"chao","n":"Làm chao","in":[["dau_nanh",4],["muoi_hot",1]],"t":48,"tt":40,"pn":"Chao","sell":135,"d":"Đậu hũ ép ráo, ủ mốc trắng rồi ngâm rượu muối thành chao.","tip":["Đậu hũ ép cho ráo, ướt nhẹp là lên mốc xanh chớ hổng lên mốc trắng.","Ngâm rượu muối cho đủ, thiếu muối là chao hư, thừa muối là mặn chát."],"art":"<path d=\"M16 22h32v28a6 6 0 0 1-6 6H22a6 6 0 0 1-6-6z\" fill=\"#e8f0f4\" stroke=\"rgba(0,0,0,.3)\" stroke-width=\"1.3\" opacity=\".9\"/><path d=\"M14 16h36v7H14z\" fill=\"#c4302a\"/><rect x=\"21\" y=\"32\" width=\"10\" height=\"10\" rx=\"2\" fill=\"#f2d07a\"/><rect x=\"33\" y=\"38\" width=\"10\" height=\"10\" rx=\"2\" fill=\"#f2d07a\"/><path d=\"M17 30h30\" stroke=\"#e8c87a\" stroke-width=\"2\"/>"},{"id":"long_den","n":"Làm lồng đèn","in":[["cui",4],["soi",1]],"t":60,"tt":45,"pn":"Lồng đèn","sell":150,"d":"Chẻ nan tre chuốt trơn, uốn khung, dán giấy kiếng làm lồng đèn.","tip":["Nan chuốt cho trơn, còn dằm là con nít cầm vô khóc thét.","Giấy kiếng dán căng như mặt trống, nhăn là thắp lên nhìn như bánh tráng nướng."],"art":"<path d=\"M32 4v8\" stroke=\"#6a4a2a\" stroke-width=\"2\"/><path d=\"M32 12l18 18-18 22-18-22z\" fill=\"#e8483a\" stroke=\"#8a2a1a\" stroke-width=\"1.6\"/><path d=\"M32 12v40M14 30h36\" stroke=\"#f2d24a\" stroke-width=\"1.6\"/><circle cx=\"32\" cy=\"30\" r=\"4\" fill=\"#ffe27a\"/><path d=\"M28 52h8l-2 8h-4z\" fill=\"#f2d24a\"/>"}]␀␀␀{"cuoi":{"th":40,"ut":5},"nan":{"th":40,"ut":5},"hoi":{"ut":4},"ct":{"ut":4},"thuong":{"th":15},"le":{"ut":2}}␀␀[null,null,{"xp":50,"mk":30,"k":0,"x":0,"nop":[[0,5]],"tim":3,"xu":0,"rot":0},{"xp":200,"k":20,"x":0,"nop":[[1,5]],"tim":4,"xu":2000,"rot":0},{"xp":600,"k":60,"x":5,"nop":[[2,3],[1,5]],"tim":5,"xu":8000,"rot":0.3},{"xp":1500,"k":150,"x":30,"nop":[[2,5]],"tim":5,"xu":25000,"rot":0,"le":1}]␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀[0,0.15,0.3,0.4,0.45]␀␀␀␀␀␀␀␀␀␀␀[0,0,0.03,0.1,0.2]␀␀␀␀␀␀␀␀␀␀␀␀␀␀{"meo":5,"cho":4,"chim":4,"cau":5,"khach":5,"lo":7,"vit":7,"tat":8,"hoicho":8,"thue":9,"quan":10,"ma":10,"xephang":10,"lai":12,"dulich":15,"dam":20,"nghe":22,"cuoi":25}␀␀␀␀␀␀␀␀{"fall":3,"pet":2,"cho":1,"fest":1,"walk":0,"plant":0,"water":0,"harvest":2,"bug":2,"twater":1,"tharvest":4,"animal":2,"work":3,"scn":2,"paddy":1,"nha":1,"ghe":1,"xe":1,"hive":2,"dd":2,"gavit":1,"dog":1,"birds":1,"bun":2,"lo":3,"phun":2,"quan":3,"kham":1,"clt":3,"ongr":3}{"fall":3,"pet":1,"plant":1,"water":0.5,"harvest":1,"bug":1,"twater":0.5,"tharvest":1,"animal":1,"w