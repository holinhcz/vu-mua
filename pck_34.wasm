:[null,null,null,null,null,null,null,null],"ht":[[0.9791,0.9791,0.9791,0.9791,0.9771,0.9741,0.9741,0.9771,0.9791,0.9791,0.9791,0.9791],[0.929,0.929,0.929,0.929,0.927,0.924,0.924,0.927,0.929,0.929,0.929,0.929],[0.901,0.901,0.901,0.901,0.901,0.898,0.901,0.898,0.901,0.901,0.901,0.901],[0.907,0.907,0.907,0.907,0.905,0.905,0.907,0.907,0.907,0.907,0.907,0.907],[0.933,0.933,0.933,0.933,0.931,0.931,0.931,0.931,0.931,0.933,0.933,0.933],[0.906,0.906,0.906,0.906,0.906,0.906,0.906,0.906,0.906,0.906,0.906,0.906],[0.92,0.92,0.92,0.92,0.92,0.92,0.92,0.92,0.92,0.92,0.92,0.92],[0.9491,0.9491,0.9491,0.9491,0.9491,0.9471,0.9471,0.9471,0.9491,0.9491,0.9491,0.9491]],"kv":[0.9069553671739353,0.9526372443487621,0.9678135405105438,0.9448732083792722,0.9335476956055734,0.9326710816777042,0.9510869565217391,0.922979664945738]},"run":{"src":"img/nga_run.webp","fw":308,"fh":397,"fhs":1.0334,"n":6,"fd":0.0933,"dirs":["down","southwest","left","northwest","up","northeast","right","southeast"],"cx":[0.493,0.486,0.453,0.383,0.501,0.61,0.55,0.506],"feet":[0.854,0.827,0.85,0.825,0.807,0.814,0.85,0.825],"stand":[0,0,0,0,0,0,0,0],"stand2":[2,3,4,4,4,4,4,4],"fc":[[[],[],[],[],[],[]],[[],[],[],[],[],[]],[[],[],[],[],[],[]],[[],[],[],[],[],[]],[[],[],[],[],[],[]],[[],[],[],[],[],[]],[[],[],[],[],[],[]],[[],[],[],[],[],[]]],"stride":1.191,"strides":[1.191,1.191,1.191,1.191,1.191,1.191,1.191,1.191],"ht":[[0.836,0.8288,0.7937,0.8267,0.834,0.7999],[0.7719,0.7657,0.7368,0.7657,0.7657,0.7368],[0.803,0.7937,0.7719,0.803,0.7957,0.7626],[0.8081,0.7968,0.7771,0.8061,0.7988,0.7699],[0.8247,0.8112,0.7895,0.8226,0.8112,0.7802],[0.7968,0.7854,0.7699,0.7988,0.7875,0.7637],[0.8143,0.8009,0.7782,0.8112,0.805,0.774],[0.7771,0.7699,0.7461,0.7751,0.7719,0.743]],"go":[2,5,5,1,5,5,5,5]}}␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀{"de":"Giải đá dế","do":"Giải đố vui"}␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀[["xu","xu"],["lua","giạ lúa"],["nhang","nhang"],["ruou_nep","rượu nếp"]]␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀["de","do"]␀␀␀␀␀[{"id":"wx","g":"thoitiet","t":"Trời mưa: ruộng tự được tưới nhưng nhân vật đi chậm. Mặc Áo mưa trong Tủ đồ để đi bình thường."},{"id":"giong","g":"giong","t":"Giông tới! Cây cao có thể bị quật ngã, sét đánh cháy cây. Cột thu lôi hút sét trong vòng 7 ô."},{"id":"han","g":"thoitiet","t":"Nắng hạn: đất khô nhanh gấp rưỡi. Nhớ tưới ruộng thường hơn nha."},{"id":"fell","g":"giong","t":"Có cây bị giông quật ngã. Chạm vô cây đổ để dọn, được củi khô nấu bếp."},{"id":"rong","g":"nuoc","t":"Nước ròng! Bãi bùn hai bên sông lộ ra: chạm để bắt cá kèo, mò ốc, vớt lục bình."},{"id":"cho","g":"cho","t":"Chợ nổi đang họp trên sông Vàm (5–9 giờ sáng). Chạm ghe để mua bán."},{"id":"met","g":"nhanvat","t":"Nhân vật sắp hết sức. Nấu cơm ở bếp, ăn đồ ăn hoặc về nhà ngủ để hồi sức."},{"id":"buff","g":"bep","t":"Icon nhỏ dưới avatar là hiệu ứng đang có. Chạm vào để xem chi tiết và thời gian còn lại."},{"id":"dem","g":"ma","t":"Trời tối rồi. Ban đêm hồi sức nhanh hơn; ngoài đồng có khi lập lòe ma trơi…"},{"id":"dieu","g":"dieu","t":"Chiều nay có gió, thả diều được rồi! Mua diều trong bảng nhân vật."},{"id":"tat","g":"tat","t":"Tuần này chưa tát mương. Chạm cái gàu cạnh ao nhà để tát mương bắt cá."},{"id":"dam","g":"dam","t":"Hàng xóm mời đám! Mang quà tới phụ thì thêm ♥, ăn đám được hiệu ứng."},{"id":"vung","g":"khaihoang","t":"Có vùng đất mới để khai hoang: đồng ruộng phía nam, phía đông, rừng tràm U Minh và cù lao giữa vàm."},{"id":"culao","g":"culao","t":"Cù lao đã là của mình! Trái chín có bong bóng, chạm để hái; hái xong ít lâu lại chín."},{"id":"tram","g":"tram","t":"Rừng tràm có tổ ong mật. Chạm tổ ong để lấy mật; có củi thì tự hun khói, ít bị đốt."},{"id":"tim3","g":"nghe","t":"Đã thân 3 ♥ với một nhà! Ghé nhà họ để học nghề thủ công gia truyền."},{"id":"tim5","g":"cuoi","t":"Thân 5 ♥ rồi: nếu nhà đó có con chưa vợ chồng thì có thể dạm hỏi."},{"id":"ray","g":"ray","t":"Dịch rầy nâu! Chạm ô có dấu chấm than để phun thuốc, hoặc thả vịt ra đồng ăn rầy."},{"id":"lo","g":"lo","t":"Lờ lọp có cá rồi! Chạm vào bẫy dưới nước để nhân vật lội ra thăm."},{"id":"quan","g":"quan","t":"Quán cơm dựng xong! Chạm vào quán để nấu sẵn món, khách sẽ ghé ăn."},{"id":"hoicho","g":"hoicho","t":"Tối nay sân đình có hội chợ! Chạm sạp trò chơi để ném vòng, đập niêu, hoặc mua tờ lô tô."},{"id":"dulich","g":"dulich","t":"Có khách du lịch tới ở homestay! Phục vụ quán cơm, sạp đặc sản cho chu đáo để khách chấm sao cao."},{"id":"sao1","g":"trong","t":"Đủ xu và vật liệu để nâng sao ô ruộng! Chạm một ô đất, nâng lên 2★: cây lớn nhanh hơn, giữ nước lâu hơn."},{"id":"vatlieu","g":"trong","t":"Vừa nhặt được vật liệu nâng sao! Xem trong Kho › Vật liệu nâng sao. Vật liệu rơi ra khi gặt, thu vật nuôi, lấy hàng xưởng, giao đơn."},{"id":"chohang","g":"dulich2","t":"Mở Bản đồ, chọn TP. Hồ Chí Minh hay Phú Quốc rồi bấm Chở hàng đi bán: nơi xa trả giá cao hơn chợ làng."},{"id":"khoa","g":null,"t":"Mỗi cấp mở thêm cây, xưởng, đất mới. Xem cấp nào mở gì trong Sổ tay › Lộ trình 100 cấp."}]␀␀[{"sec":"Chung","items":[{"id":"capdo","ic":"lua","n":"Cấp nào mở gì","b":["Mỗi cấp mở thêm cây, xưởng, chức năng, đất. Đồ đã mở rồi thì giữ nguyên. Cây giống từ ghe thương hồ trồng được dù chưa tới cấp.","Cấp 1: Cây lúa, Cây rau muống, tối đa 6 ô ruộng.","Cấp 2: Cây bắp, Cối xay, địa danh Cần Thơ, tối đa 8 ô ruộng.","Cấp 3: Lò bánh nướng, địa danh Châu Đốc, nâng sao 1★ cho ô ruộng, xưởng, chuồng, sạp, Đất vườn rau, tối đa 10 ô ruộng.","Cấp 4: Cây hành lá, Chợ nổi, Nuôi chào mào, địa danh Sa Đéc, Đất ruộng làng, tối đa 12 ô ruộng.","Cấp 5: Cây đậu nành, Cây dừa, Ruộng muối, Nuôi mèo, Câu cá, Thăm làng bạn, địa danh Cầu Kè, Đất sân đình, tối đa 14 ô ruộng.","Cấp 6: Chuồng bò, địa danh Sóc Trăng, tối đa 16 ô ruộng.","Cấp 7: Cây mía, Xe nước mía, Lờ, lọp, giăng câu, Thả vịt, thả cá, địa danh Mũi Cà Mau, nâng sao 2★ cho ô ruộng, xưởng, chuồng, sạp, Đất ao sen, tối đa 18 ô ruộng.","Cấp 8: Cây cải xanh, Vại muối dưa, Tát mương, Hội chợ quê, địa danh Vũng Tàu, Đất bãi đất phía nam, tối đa 20 ô ruộng.","Cấp 9: Cây cà rốt, Người làm thuê, địa danh Núi Bà Đen, tối đa 22 ô ruộng.","Cấp 10: Cây chuối, Chuồng heo, Bếp củi, Quán cơm, Bắt ma trơi, Bảng xếp hạng, địa danh Đà Lạt, Đất đồng phía đông, tối đa 24 ô ruộng.","Cấp 11: Cây đậu phộng, Lò rang hạt.","Cấp 12: Cây sả, Cây đậu đen, Lò đường, Lò bánh quê, Lai giống, địa danh Mũi Né, nâng sao 3★ cho ô ruộng, xưởng, chuồng, sạp, Đất hồ cá lớn, tối đa 25 ô ruộng.","Cấp 13: Cây chàm, Chuồng cừu.","Cấp 14: Cây rau răm, Khung dệt, địa danh Nha Trang, Đất đồi phía bắc, tối đa 26 ô ruộng.","Cấp 15: Cây bí đỏ, Cây đu đủ, Bếp nướng, Du lịch homestay, Đất bến sông, khúc giữa.","Cấp 16: Cây bầu, Giàn phơi, địa danh Buôn Ma Thuột, Đất xóm mới, tối đa 27 ô ruộng.","Cấp 17: Cây đậu bắp.","Cấp 18: Cây bông vải, Cây gừng, Nồi kho, địa danh Gành Đá Đĩa, Đất bãi bồi, tối đa 28 ô ruộng.","Cấp 19: Cây mướp, Cây nhãn.","Cấp 20: Cây cà tím, Chuồng dê, Lò bánh tráng, Hàng chả, Đám tiệc, địa danh Quy Nhơn, Đất rừng tràm, tối đa 29 ô ruộng.","Cấp 21: Cây bí đao.","Cấp 22: Cây đậu xanh, Cây khoai môn, Cây chôm chôm, Cây xoài, Nghề thủ công, địa danh Kon Tum, Đất gò hoang, tối đa 30 ô ruộng.","Cấp 24: Cây khổ qua, Cây me, Cối xay thứ 2, địa danh Hội An, Đất đồng lúa phía đông, tối đa 31 ô ruộng.","Cấp 25: Cây ớt, Quán chè, Cưới hỏi, nâng sao 4★ cho ô ruộng, xưởng, chuồng, sạp, Đất vàm sông, khúc đông.","Cấp 26: Cây đậu rồng, Cây thanh long, địa danh Đà Nẵng, tối đa 32 ô ruộng.","Cấp 27: Lò bánh nướng thứ 2, Đất vườn quê tây nam.","Cấp 28: Cây nếp, Cây tiêu, địa danh Huế, tối đa 33 ô ruộng.","Cấp 30: Cây cà chua, Cây mận, địa danh Phong Nha, Đất sông vàm, khúc tây, Đất đồng lúa phía tây, tối đa 34 ô ruộng.","Cấp 31: Ruộng muối thứ 2.","Cấp 32: Cây lá dứa, Đất vườn quê phía nam, tối đa 35 ô ruộng.","Cấp 33: Xe nước mía thứ 2, địa danh Vinh.","Cấp 34: Cây dâu tây, tối đa 36 ô ruộng.","Cấp 35: Cây khoai lang, Lò bánh quê thứ 2, Đất rừng cao su đông nam.","Cấp 36: Cây điều, địa danh Tràng An, tối đa 37 ô ruộng.","Cấp 37: Vại muối dưa thứ 2.","Cấp 38: Đất đồng lúa tây nam, tối đa 38 ô ruộng.","Cấp 39: Lò rang hạt thứ 2.","Cấp 40: Cây dưa hấu, Cây nghệ, địa danh Hà Nội, nâng sao 5★ cho ô ruộng, xưởng, chuồng, sạp, tối đa 39 ô ruộng.","Cấp 41: Bếp củi thứ 2, Đất đồng lúa phía đông 2.","Cấp 42: Cây bưởi, tối đa 40 ô ruộng.","Cấp 43: Lò đường thứ 2, Đất đồng lúa phía nam.","Cấp 44: địa danh Hải Phòng, tối đa 41 ô ruộng.","Cấp 45: Bếp nướng thứ 2.","Cấp 46: Đất đồng lúa phía tây 2, tối đa 42 ô ruộng.","Cấp 47: Khung dệt thứ 2.","Cấp 48: địa danh Hạ Long, tối đa 43 ô ruộng.","Cấp 49: Quán chè thứ 2, Đất rừng tràm u minh phía tây.","Cấp 50: Cây mè, tối đa 44 ô ruộng.","Cấp 51: Hàng chả thứ 2.","Cấp 52: địa danh Tân Cương, Đất đồng lúa đông nam.","Cấp 53: Giàn phơi thứ 2.","Cấp 54: Đất rừng tràm u minh phía tây 2.","Cấp 55: Nồi kho thứ 2.","Cấp 56: địa danh Mộc Châu.","Cấp 57: Cây măng cụt, Đất đồng lúa phía đông 3.","Cấp 58: Cây xà lách.","Cấp 59: Lò bánh tráng thứ 2.","Cấp 60: địa danh Sa Pa, Đất đồng lúa tây nam 2.","Cấp 62: chuồng chứa 6 con.","Cấp 63: Cây hướng dương, Đất rừng cao su phía đông.","Cấp 65: địa danh Bản Giốc.","Cấp 66: Cây mít, Đất rừng cao su tây nam.","Cấp 68: Cây hành tây, Đất vườn quê đông nam.","Cấp 70: Cây dưa leo, địa danh Lũng Cú.","Cấp 71: Cây cam, Đất rừng tràm u minh phía tây 3.","Cấp 74: Đất đồng lúa phía đông 4.","Cấp 76: Cây sầu riêng.","Cấp 77: Đất đồng lúa phía nam 2.","Cấp 79: Đất cù lao giữa vàm.","Cấp 82: Đất rừng tràm u minh tây nam, chuồng chứa 8 con.","Cấp 85: Đất rừng cao su đông nam 2.","Cấp 88: Đất đồng lúa phía nam 3.","Cấp 90: Đất vườn quê tây nam 2.","Cấp 93: Đất đồng lúa đông nam 2.","Cấp 96: Đất rừng tràm u minh tây nam 2.","Cấp 100: danh hiệu Lão nông tri điền, tượng Lão nông."],"s":"Mở thêm theo cấp"},{"id":"nhanvat","ic":"sua","n":"Sức khỏe, cấp","b":["Chạm vào vật nào thì hiện bảng của nó, chọn việc xong nhân vật mới đi tới làm, mỗi việc tốn chút sức.","Chạm ô đất trống rồi bấm chip xanh Đi đến đây để dắt nhân vật đi dạo. Đang đi thì góc dưới trái có nút tròn Dừng, bấm là đứng lại và bỏ hết việc đang chờ.","Hết sức thì đi chậm gần một nửa, làm lâu gấp đôi. Ăn đồ ăn, nấu cơm hoặc về nhà ngủ để hồi sức; ban đêm hồi nhanh hơn.","Làm việc được kinh nghiệm để lên cấp, mở thêm đồ nghề, áo quần, xe đạp."],"s":"Sức, kinh nghiệm"},{"id":"hethong","ic":"lua","n":"Hệ Thống","b":["Làm nhiệm vụ Hệ Thống (3 cái mỗi ngày, 1 cái mỗi tuần, nhiệm vụ khẩn có giờ, thành tựu) và lên cấp (+5) để có điểm Hệ Thống.","Phát triển: 4 nhánh Nông, Thương, Nghề, Làng, mỗi nhánh 5 tầng mở theo cấp. Cấp 15 chọn 1 nhánh chính (lên tới tầng 5) và 1 nhánh phụ (tới tầng 3), nhánh khác chỉ tầng 1. Tẩy điểm chọn lại tốn 50 sen đỏ.","Cửa hàng: đồ dùng mua bằng điểm, có món giới hạn mỗi ngày."],"s":"Nhiệm vụ, phần thưởng"},{"id":"thoitiet","ic":"rau_muong","n":"Thời tiết","b":["Mỗi ngày chia 4 buổi, mỗi buổi 6 tiếng, thời tiết có thể đổi theo buổi. Chạm ô thời tiết ở góc trên để xem dự báo.","Mưa, giông: ruộng tự tưới nhưng đi chậm 20–30%. Mặc Áo mưa (Tủ đồ) để đi bình thường.","Nắng hạn: đất khô nhanh gấp rưỡi, nhớ tưới thường xuyên."],"s":"Nắng mưa 4 buổi"},{"id":"giong","ic":"qua_chuoi","n":"Giông bão","b":["Giông lớn quật ngã cây cao (dừa, cau, chuối, xoài…). Chạm cây đổ để dọn lấy củi; ít phút sau cây con mọc lại.","Sét có thể đánh cháy cây. Cột thu lôi (Xây dựng › Vật dụng) hút sét trong vòng 7 ô.","Cây ăn trái bị rụng trái nếu không có rào hay chòi che gần đó."],"s":"Cây đổ, sét đánh"},{"id":"dulich2","ic":"qua_dua","n":"Bản đồ","b":["Mở Bản đồ, chọn Cả nước hoặc từng miền để phóng to. Mỗi địa danh mở theo cấp, rồi trả điểm Hệ Thống để mở khóa.","Du hành: tốn xu vé, đi 4 phút tới gần 1 tiếng tùy xa gần; tới nơi nhận xu, điểm và 1 đặc sản.","Chở hàng đi bán: mỗi nơi mỗi ngày cần 4 món, trả gấp 1,25 tới 1,6 lần giá làng tùy xa gần. Xe chở 20 món, nâng Thùng xe hàng ở cửa hàng Hệ Thống để chở thêm.","Bản đồ có quần đảo Hoàng Sa và Trường Sa của Việt Nam."],"s":"31 địa danh khắp nước"}]},{"sec":"Ruộng vườn","items":[{"id":"trong","ic":"lua","n":"Trồng trọt","b":["Chạm ô đất trống, chọn giống trong bảng hiện ra để gieo. Gieo 1 hạt, gặt được 2.","Nông sản trong kho cũng là hạt giống: bán thì nhớ chừa lại (nút Bán, chừa 4 giống). Hết giống thì mua ở Chợ phiên, nhà hàng xóm, hoặc chợ nổi sáng sớm (đổi nông sản lấy giống cũng được).","Mới đầu chỉ có lúa, rau muống. Lên cấp mở thêm giống mới (bắp cấp 2, đậu nành cấp 5, mía cấp 7, chàm cấp 13, bí đỏ cấp 15, bông vải cấp 18, ớt cấp 25, cà chua cấp 30, dâu tây cấp 34...), được tặng 4 hạt mỗi thứ.","Cây tự lớn theo giờ thật, kể cả lúc bạn tắt game: lúa 2 phút, bắp 5 phút, cà chua 6 giờ, dâu tây 8 giờ. Cây khó lớn lâu thì bán giá cao, gặt được nhiều kinh nghiệm.","Tưới nước thì cây lớn nhanh hơn 10% trong lúc đất còn ướt. Mọi nguồn tăng tốc cộng lại tối đa +50%, giá bán cộng lại tối đa +25%; trời mưa ruộng tự được tưới.","Cây chín thì chạm để thu hoạch vào Kho. Có sâu thì chạm để bắt.","Nâng sao ô ruộng (chạm ô đất) từ 1★ tới 5★: cây lớn nhanh hơn, giữ nước lâu hơn. Xưởng, chuồng, kho cũng nâng sao được. Nâng sao cần xu và vật liệu (rơm, phân, vôi, ván, đinh, gạch, tre, lá dừa, mây) rơi ra khi làm việc. Đồ câu (phao, dây cước, lưỡi câu) chỉ ra khi câu cá, thăm lờ lọp, giăng câu. Xem trong Kho › Vật liệu nâng sao."],"s":"Gieo hạt, tưới, gặt"},{"id":"menuo","ic":"lua","n":"Menu ô ruộng","b":["Chạm cây đang lớn: hiện 3 nút tròn và tên cây, thời gian còn lại.","Nút sen đỏ: làm cây chín và thu hoạch ngay, tốn sen đỏ (số ghi trong nút, có hỏi trước). Viền đỏ quanh nút là cây đã lớn tới đâu, đầy vòng là chín.","Nút sao: nâng sao ô ruộng. Viền 5 khúc, sáng mấy khúc là ô đang mấy sao.","Nút nước: tưới cho đầy. Viền xanh là lượng nước còn trong đất.","Cây chín: chạm vào cây hiện nút Thu hoạch.","Đất sẫm, bóng là còn ướt; đất nhạt, nứt nẻ là khô, nên tưới."],"s":"Tưới, bón, nhổ cây"},{"id":"lai","ic":"lua","n":"Lai giống","b":["Trồng hai giống khác nhau sát bên nhau (cả chéo góc). Gặt ra thỉnh thoảng được hạt giống lai.","Có 7 giống lai: lúa thơm, lúa chịu mặn, cà chua bi, ớt hiểm, khoai tím, bắp nếp, dưa không hạt. Xem gợi ý ở bảng nhân vật › Giống lai.","Hạt lai chỉ có khi lai. Gặt giống lai ra nông sản để bán, không ra hạt: muốn trồng tiếp phải lai tiếp.","Giống lai là giống quý: ra trái khủng gấp 3, nặng hơn cây gốc, có hạng riêng trong tủ kỷ lục và hội thi tuần."],"s":"Trồng sát ra giống quý"},{"id":"caytrai","ic":"qua_xoai","n":"Cây ăn trái","b":["Mua cây giống ở Xây dựng hoặc chợ nổi, trồng một lần là ra trái hoài.","Tưới cho cây đủ nước, trái chín thì chạm để hái.","Giông bão làm rụng nửa trái: dựng hàng rào hoặc chòi cách cây không quá 2 ô để che chắn. Trái rụng nằm dưới gốc, chạm để lượm."],"s":"Trồng 1 lần, hái hoài"},{"id":"man","ic":"muoi_hot","n":"Hạn mặn","b":["Mấy ngày cuối tháng (mùa khô) nước mặn lấn vô sông Vàm, theo kênh mương vô ruộng: cây chậm lớn còn 35–55%. Ô ruộng sát ao, hồ nước ngọt (2 ô) thì không sao.","Tưới bằng nước ngọt trong lu (mưa tự hứng, mua thêm được, đặt lu nước, chum sành để chứa nhiều hơn).","Xây cống ngăn mặn để bớt hẳn. Lúa chịu mặn (giống lai) không sợ mặn. Mùa mặn tôm về nhiều."],"s":"Mặn vô cuối mùa khô"},{"id":"ray","ic":"lua","n":"Rầy, sâu bệnh","b":["Mùa hạ, mùa thu, trời mưa dễ có dịch rầy nâu. Ô bị rầy có dấu chấm than đỏ, cây teo dần rồi chết, rầy còn lây qua ô bên cạnh.","Chạm ô có rầy để phun thuốc: sạch luôn mấy ô xung quanh. Bình thuốc 150 xu được 5 lần phun.","Nuôi vịt thì vịt chạy đồng ăn rầy. Người làm ruộng thuê có thuốc thì tự phun giùm.","Đèn bẫy rầy (Xây dựng › Đồ vật) giữ ruộng trong vòng 6 ô không bị dịch."],"s":"Rầy mùa mưa, phun"},{"id":"cui","ic":"cui","n":"Củi khô","b":["Mua 5 bó 60 xu ở Bếp, mua ở chợ nổi.","Dọn cây bị giông quật ngã được 2–4 bó.","Chặt cây tràm ở rừng tràm U Minh được 2 bó mỗi cây."],"s":"Mua, chặt, dọn ra củi"},{"id":"khaihoang","ic":"bap","n":"Khai hoang","b":["Chạm biển Khai hoang để mua khu đất kề khu mình đã có.","Đất mới có cây, nhà cũ: chạm để dọn lấy xu, chạm ruộng để gặt lúa, dọn tới đâu xây tới đó.","Vùng đất mới xa làng (phía nam, phía đông, rừng tràm, cù lao) giá cao hơn nhưng có sản vật riêng."],"s":"Mua thêm đất cạnh nhà"}]},{"sec":"Sông nước","items":[{"id":"vatnuoi","ic":"trung","n":"Vật nuôi","b":["Xây chuồng trước ở Xây dựng › Chuồng trại (chuồng gà, cừu, bò, heo, dê). Có chuồng rồi mới mua được con giống.","Con giống mua ở Sổ làng › Chợ phiên (lái gia súc dắt tới mỗi ngày) hoặc ghe cây giống ở chợ nổi sáng sớm. Chạm vào chuồng để xem và đi mua.","Chạm con đói rồi bấm Cho ăn, con có sản phẩm thì bấm Thu.","Mỗi con có tên. Vuốt ve mỗi ngày cho thân: thân thì cho hàng nhanh hơn, có khi gấp đôi. Chuồng có từ 2 con khỏe trở lên thì có khi đẻ con (gà ấp trứng nở gà con).","Bỏ đói lâu hoặc trở trời là con vật bệnh, không cho hàng. Chạm vào để mời thú y.","Dê ăn rau muống, cho sữa dê. Sữa dê làm phô mai, sữa chua, kẹo sữa, bánh flan, bánh tráng sữa, sữa dê nước dừa, bánh mì phô mai.","Thả vịt, thả cá: vào bảng nhân vật › Nuôi thêm, bấm chọn chỗ thả rồi chạm vào ao, mương nước trên bản đồ.","Vịt đẻ trứng vịt, cá lớn thì kéo lưới được cá tra."],"s":"Chuồng trại, ao cá"},{"id":"cau","ic":"ca_chep","n":"Câu cá","b":["Bấm Câu cá rồi chạm chỗ có nước. Hồ lớn, sông Vàm có cá quý hơn."],"s":"Câu ở ao, hồ, sông"},{"id":"lo","ic":"luon","n":"Lờ, lọp, câu","b":["Bảng nhân vật › Lờ lọp: mua lờ tre, lọp lươn, dây câu giăng.","Bấm Đặt rồi chạm mặt nước sát bờ. Lọp mồi bằng ốc, câu giăng mồi bằng tôm, đặt trên sông Vàm.","Đợi 10–20 phút rồi chạm để thăm. Ban đêm cá ăn mạnh hơn; để lâu quá cá xổng bớt; thỉnh thoảng rái cá ăn mất.","Mỗi cái dùng được 8–10 lần rồi mục."],"s":"Đặt lờ bắt lươn, cá"},{"id":"tat","ic":"ca_ro","n":"Tát mương","b":["Mỗi tuần một lần, chạm cái gàu cạnh ao nhà để tát mương.","Chạm nhanh vào cá dưới bùn để bắt. Xong rồi có thể trúi cá tặng hàng xóm, thêm ♥."],"s":"Mỗi tuần 1 lần"},{"id":"cho","ic":"qua_thanhlong","n":"Chợ nổi","b":["Mở một khúc sông Vàm thì có chợ nổi, họp từ 5 tới 9 giờ sáng.","Bốn ghe bán đủ thứ: cây giống, con giống, hạt giống, củi, đồ khô và đồ hiếm thương lái gửi. Mỗi kèo mua bán một lần mỗi ngày."],"s":"Họp 5–9 giờ sáng"},{"id":"ghe","ic":"dua_cai","n":"Ghe thương hồ","b":["Đặt Bến ghe sát bờ sông, ghe thương hồ sẽ cập bến kèm một đơn lớn 5–6 thùng hàng.","Ghe đậu 4 tiếng. Chất thùng nào trả tiền thùng đó; chất đủ hết thì thưởng thêm xu, kinh nghiệm và vật liệu hiếm.","Ghe đi rồi khoảng 1–2 tiếng sau mới có ghe khác."],"s":"Cập bến, đơn lớn"},{"id":"nuoc","ic":"ca_keo","n":"Con nước","b":["Sông Vàm lên xuống theo con nước, khoảng 12 tiếng một vòng. Giờ nước ròng, nước lớn ghi trong bảng Trời đất.","Nước ròng lộ bãi bùn hai bên bờ: bắt cá kèo, mò ốc, vớt lục bình.","Nước lớn thì ghe thương hồ vô bến lẹ hơn."],"s":"Lớn ròng 12 tiếng"},{"id":"nuocnoi","ic":"dien_dien","n":"Nước nổi","b":["Mùa thu nước lên, phù sa bồi: cây trái lớn nhanh hơn 4%.","Có cá linh để câu. Ven sông mọc điên điển, súng ma, kèo nèo: chạm để hái, mỗi ngày một lần."],"s":"Phù sa, cây lớn nhanh"},{"id":"culao","ic":"qua_saurieng","n":"Cù lao","b":["Ở phía đông, sông Vàm phình ra thành vàm lớn ôm một cù lao. Mở khúc sông phía đông rồi mới khai hoang được cù lao.","Cù lao có sầu riêng, măng cụt, chôm chôm, mít, xoài, bưởi mọc hoang. Trái chín có bong bóng, chạm để hái; hái xong khoảng 30 phút lại chín."],"s":"Đất giữa vàm phía đông"},{"id":"tram","ic":"mat_ong","n":"Rừng tràm","b":["Rừng tràm ngập nước ở phía tây. Chặt tràm được củi.","Cây tràm có tổ ong: chạm để lấy mật ong, khoảng 25 phút ong làm mật lại.","Có củi trong kho thì nhân vật hun khói trước (tốn 1 bó), ít bị ong đốt. Bị đốt mất 12 sức."],"s":"Củi, mật ong"}]},{"sec":"Làm ăn","items":[{"id":"xuong","ic":"banh","n":"Xưởng","b":["Xây xưởng rồi xếp món vào hàng đợi; xong thì chạm để thu.","Xưởng đặt gần Kho hàng làm nhanh hơn 25%.","Đồ chế biến bán được giá hơn nhiều so với bán nông sản thô.","Tiền lời tính đều theo phút nấu: món lâu hay món nhanh đều lời như nhau mỗi phút. Món lễ lời gấp 2,5.","Món trong xưởng xếp theo cấp mở. Món cần nguyên liệu cấp cao thì mở muộn hơn cấp xưởng.","Mỗi loại xưởng xây được cái thứ hai khi lên cấp cao hơn."],"s":"Chế biến món"},{"id":"kho","ic":"nuoc_mia","n":"Kho, giá bán","b":["Chạm Kho để bán; giá lên xuống theo ngày. Chạm một món để xem biểu đồ giá 7 ngày.","Bán dồn một món thì giá tụt dần theo từng cái (tối đa còn 60%), mỗi tiếng hồi lại một phần.","Rau trái đúng mùa rẻ, trái mùa đắt; sắp bão, lũ, hạn, dịch thì đồ thiếu lên giá; gần lễ thì đồ cúng lên giá.","Tin chợ trong Chuyện làng › Buôn bán báo trước món nào mai lên, xuống giá.","Đơn hàng trả thưởng cao hơn bán lẻ.","Độ đẹp của làng nâng giá bán mọi thứ, tối đa thêm 40%."],"s":"Giá lên xuống mỗi ngày"},{"id":"quan","ic":"banh_mi_thit","n":"Quán cơm","b":["Xây Quán cơm (Xây dựng › Nhà), chạm vào quán để mở bảng quán.","Bấm \"Nấu nồi\": nhân vật ra quán nấu, mỗi nồi được 4 phần, tốn nguyên liệu và 1 bó củi.","Khách ghé từ 6 tới 21 giờ, đông nhất giờ cơm. Khách gọi trúng món hết thì quán mất sao. Quán nhiều sao thì đông khách, được boa.","Chọn giá Bình dân để mau lên sao, giá Sang thì lời nhiều mà khách thưa."],"s":"Nấu món, bán cho khách"},{"id":"chophien","ic":"qua_mangcut","n":"Sạp quê","b":["Chạm Sạp bán hàng (hoặc Sổ làng › Sạp quê) để bày đồ dư trong kho, tự đặt giá, tối đa 6 món.","Bạn bè ghé làng mua được; khách lẻ trong làng thỉnh thoảng cũng mua nếu giá không đắt quá 30% giá chợ.","Sạp không tự bán đồ trong kho nữa, nên cứ để dành hàng làm đơn lớn."],"s":"Bày đồ, tự đặt giá"},{"id":"taphoa","ic":"keo_dua","n":"Tạp hóa, cà phê","b":["Tạp hóa đầu ngõ: lâu lâu có đơn sỉ đồ chế biến, trả hơn giá chợ khoảng 25%, có kinh nghiệm. Giữ tối đa 2 đơn, mỗi đơn đợi 4 tiếng.","Quán cà phê võng: ban ngày khách ghé gọi nước (nước mía, sinh tố, chè…). Mang ra kịp được trả tiền và tiền boa.","Có đơn hay có khách thì trên mái hiện bong bóng, chạm vào để giao."],"s":"Đơn sỉ, cà phê"},{"id":"dacsan","ic":"banh","n":"Đặc sản","b":["Đặc sản để trong Hệ Thống › Túi đặc sản.","Đồ ăn: hồi 30 sức và được hiệu ứng 20 phút. Quà: biếu nhà ít thân nhất +1 ♥. Giống: ra hạt giống, Cam Vinh cho cây giống cam. Vật liệu: đổi 2 vật liệu nâng sao."],"s":"Đặc sản các vùng"},{"id":"dulich","ic":"qua_mangcut","n":"Du lịch","b":["Có nhà dân và quán cơm hoặc sạp thì khách Sài Gòn, khách Tây ba lô tới ở homestay (ban ngày 7–16 giờ).","Khách đi quán, mua đặc sản ở sạp (trả giá cao), lên đình, chụp hình chỗ cảnh đẹp, đi xuồng ở bến ghe, ra cù lao.","Ngủ lại một đêm rồi trả tiền phòng và chấm sao. Danh tiếng cao thì khách tới thường hơn. Chỉnh giá phòng ở Sổ làng › Du lịch."],"s":"Homestay, chấm sao"},{"id":"hoicho","ic":"banh","n":"Hội chợ quê","b":["Cách một ngày có hội chợ ở sân đình từ 18g30 tới 22g30 (ngày lễ cũng có). Muốn chơi liền thì bỏ 2.000 xu tổ chức tối nay (bảng Trời đất).","Ném vòng trúng chai, bịt mắt đập niêu, hát lô tô ăn tiền thưởng. Chạm vào sạp trò chơi hoặc sân khấu để chơi.","Dân làng kéo nhau đi hội chợ đông vui."],"s":"Trò chơi đêm"},{"id":"logach","ic":"dat_set","n":"Lò gạch","b":["Lò gạch (Xây dựng › Nhà) nung gạch: mỗi mẻ 4 đất sét + 2 củi khô ra 5 viên gạch nung, nung 2 tiếng. Chạm lò để nạp mẻ, lấy gạch.","Đất sét: mò ở bãi bùn lúc nước ròng, dọn đất hoang, tát mương.","Gạch nung dùng nâng đồ nghề, góp xây công trình chung, giúp nhà gặp thiên tai."],"s":"Nung đất sét ra gạch"},{"id":"xay","ic":"gach","n":"Xây dựng","b":["Nút Xây dựng: đặt nhà, chòi, hàng rào, cây kiểng. Chạm giữ để dời, xoay.","Độ đẹp càng cao giá bán càng tăng, tối đa thêm 40%."],"s":"Đặt nhà, độ đẹp"}]},{"sec":"Làng xóm","items":[{"id":"lang","ic":"qua_mit","n":"Hàng xóm","b":["Chạm nhà hàng xóm để thăm, tặng quà, phụ việc. Càng thân càng nhiều ♥.","3 ♥: được truyền nghề thủ công. 5 ♥: nhà có con thì có thể dạm hỏi cưới.","Thân rồi thì mướn được người nhà họ làm thuê.","Dân làng ở trong mấy căn nhà bạn xây: ban ngày họ ra quán ăn cơm, ra sạp mua đồ, lên đình, qua nhà nhau chơi, có khi ghé thăm cho quà. Làng càng đông nhà, quán và sạp càng đông khách."],"s":"Thăm, tặng quà"},{"id":"thue","ic":"khoai","n":"Làm thuê","b":["Sổ làng › Người làm thuê để quản lý.","Giao việc: làm ruộng (chọn cây gieo), coi xưởng (chọn món), chăm vườn cây trái, chăn nuôi.","Trả công theo ngày; hết việc để làm thì họ tự nghỉ.","Giờ làm: sáng 6:00–11:30, chiều 13:00–18:00. Trưa nghỉ ăn cơm, tối về nhà ngủ tới sáng. Giờ nghỉ không tính công. Để chế độ luôn ngày thì làm suốt, luôn đêm thì nghỉ suốt."],"s":"Thuê làm ruộng, vườn"},{"id":"nghe","ic":"chieu","n":"Nghề thủ công","b":["Học nghề ở nhà hàng xóm đủ 3 ♥: 10 nghề như đan giỏ, dệt chiếu, se nhang, gói bánh phu thê, nấu rượu nếp, thêu khăn.","Cả dòng họ chung một nghề, mỗi làng xếp nghề khác nhau. Tiền học nghề đầu 4.000 xu, nghề sau gấp 1,5; mỗi 7 ngày học 1 nghề mới.","Mở bảng Nghề (nhóm Làm ăn) để làm. Mỗi món +1 điểm tay nghề, tối đa 15 điểm một ngày. Đủ điểm, đủ hàng đã làm thì qua thầy thi lên sao. Chỉ 3 nghề chính lên được 4★, 5★.","Sao cao ra hàng khéo, tinh xảo giá cao; mỗi nghề biết thêm bớt 1% tỉ lệ. Bán hàng nghề cho chợ chỉ được 60%.","Bảng Nghề còn có đơn làng: bà con đặt hàng cho đám cưới, hội đình, nhà gặp nạn, lễ Tết. Quá hạn không giao là mất thân, mất uy tín; bỏ 3 đơn trong 7 ngày thì mang tiếng. Thiếu món thì mua thương lái hoặc đặt thợ bạn bè làm."],"s":"Học nghề ở nhà dạy"},{"id":"cuoi","ic":"banh_pt","n":"Cưới hỏi","b":["Thân 5 ♥ với nhà có con chưa vợ chồng thì dạm hỏi được.","Chuẩn bị mâm sính lễ, tiền cưới. Cưới xong vợ hoặc chồng phụ việc nhà, ít lâu sau có em bé."],"s":"Dạm hỏi, thân 5 tim"},{"id":"dam","ic":"lx_tuoi","n":"Đám tiệc","b":["Hàng xóm có đám cưới, đám giỗ sẽ mời. Mang quà tới phụ thì thêm ♥, ăn đám được hiệu ứng như ăn cơm nhà."],"s":"Đi đám cưới, đám giỗ"},{"id":"khach","ic":"qua_mangcut","n":"Thăm làng bạn","b":["Sổ làng › Khách ghé thăm: ghé làng của người khác.","Phụ tưới, bắt sâu, cho ăn (10 lần một ngày) được cảm ơn; hái trộm (5 lần mỗi nhà mỗi ngày) thì coi chừng chó rượt rớt dép, đi chậm một lúc."],"s":"Ghé làng bạn bè"},{"id":"thu","ic":"chuoi_say","n":"Thư, radio","b":["Bác đưa thư đạp xe tới khoảng 9–12 giờ, có khi mang thư, quà.","Radio có bản tin lúc 6 giờ và 18 giờ."],"s":"Thư, quà mỗi sáng"},{"id":"yte","ic":"nhang","n":"Trạm y tế","b":["Xây Trạm y tế (Xây dựng › Nhà, 3x3 ô, xoay được). Chạm vào trạm để mở.","Khám sức khỏe: hồi đầy sức ngay, nghỉ 8 phút mới khám lại. Chén thuốc bổ: \"Dẻo dai\" 10 phút, mỗi ngày một chén.","Bị ong đốt thì ra trạm bôi thuốc miễn phí. Dân trong xóm cũng hay ghé khám."],"s":"Chữa bệnh, đỡ dịch"},{"id":"hoithi","ic":"mat_ong","n":"Hội thi làng","b":["Mỗi tối 19:00–19:15 (giờ thật trên máy) ở sân đình. Chạm nút 🔔 trên màn hình để vào thi.","Bạn bè online cùng thi một bộ 10 câu, bảng điểm hiện điểm từng người (🌐). 19:15 chốt Bảng vàng, ai nhất được thêm 150 xu.","10 câu đố rút từ hơn 100 câu về Nam Bộ: Sài Gòn, miền Đông, miền Tây, đặc sản, ca dao tục ngữ, cải lương, lễ hội Khmer, chuyện trong làng. Mỗi câu 12 giây, trả lời nhanh được thêm điểm. Tên tỉnh tính theo địa giới cũ (trước sáp nhập 7/2025).","Mỗi câu đúng được xu (cấp càng cao càng nhiều). Đúng từ 7 câu được thêm hạt giống và mật ong. Đứng nhất được thêm 90 xu và một nhà hàng xóm thêm thân. Đúng hết 10 câu là Rung chuông vàng: +300 xu và 2 hạt giống lai.","Thi liên tiếp mỗi tối được thưởng thêm 10% mỗi tối, tối đa 50%."],"s":"Đố vui 19 giờ tối"},{"id":"hoi","ic":"kem","n":"Ngày lễ","b":["Bốn lễ trong năm: Tết, Vu Lan, Trung Thu, Kỳ Yên. Lịch ghi trong bảng Trời đất."],"s":"Tết, Vu Lan, Trung Thu"},{"id":"xephang","ic":"kem","n":"Xếp hạng","b":["Sổ làng › Bảng xếp hạng: so làng đẹp, giàu có, cấp độ, quán ngon với bạn bè.","Mỗi tuần, đứng hạng 1–3 bảng nào (cần ít nhất 3 làng) thì nhận giải bảng đó."],"s":"So làng với bạn bè"},{"id":"dieu","ic":"mia","n":"Thả diều","b":["Mùa Đông, mùa Xuân có gió từ 14 tới 18 giờ.","Mua diều trong bảng nhân vật, thả diều nghe sáo kêu; có hội thi diều với giải thưởng."],"s":"Gió chiều thả diều"},{"id":"ma","ic":"nhang","n":"Ma trơi","b":["Đêm khuya đôi khi có đốm ma trơi lập lòe ngoài đồng.","Đi theo thì có khi được của, có khi bị lạc, có khi nghe một câu chuyện xưa."],"s":"Đốm sáng đêm khuya"}]}]␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀["Hai Lúa","Ba Tèo","Tư Sang","Năm Tâm","Sáu Hùng","Út Hiếu","Bảy Thành","Tám Phúc"]␀␀␀␀␀␀␀␀␀␀␀␀␀{"ga":3,"de":2,"cuu":2,"bo":1,"heo":1}␀␀␀␀␀␀␀␀␀␀["ga","cuu","bo","heo","de"]␀␀␀␀["Út Mến","Hai Thương","Ba Hiền","Tư Lan","Năm Hồng","Sáu Duyên","Bảy Thảo","Tám Nhi"]␀␀␀␀␀␀␀␀[null,{"ng":1,"xu":100,"n":"Rương quà nhỏ"},{"ng":2,"xu":200,"n":"Rương quà vừa"},{"ng":4,"xu":400,"m":2,"n":"Rương quà lớn"}]␀␀␀["Cô Tư","Chú Bảy","Bà Năm","Ông Sáu","Anh Hai","Chị Ba","Thím Út","Dượng Tám","Cô Chín","Bác Mười","Chị Hai","Chú Út","Bà Ba","Anh Tư","Cô Sáu","Ông Bảy","Chị Năm","Chú Tám"]␀␀␀␀␀␀␀␀␀␀[0,120,300,900,1800,3600,7200]␀␀["well","fert","pen","stall","xuong"]␀␀␀␀␀␀␀␀␀␀␀["qua_saurieng","mat_ong","luon","qua_mangcut","chieu","banh_pt","gio_lb","ca_loc","trung_muoi"]["ruong","vuon","chan","xuong"]␀[0,500,1500,4000,9000,18000]␀␀␀␀{"duanuoc":"bụi dừa nước","reed":"bụi lau","tram":"cây tràm","ft_saurieng":"cây sầu riêng","ft_mangcut":"cây măng cụt","ft_chomchom":"cây chôm chôm","ft_mit":"cây mít","ft_xoai":"cây xoài","ft_buoi":"cây bưởi","caosu":"cây cao su","dieu":"cây điều","mango":"cây xoài","jackfruit":"cây mít","coconut":"cây dừa","banana":"cây chuối","areca":"cây cau","bamboo":"bụi tre","haystack":"đống rơm","house":"nhà cũ","hut":"nhà tranh cũ","boat":"thuyền cũ","tallgrass":"cỏ","wildbush":"bụi cây","hibiscus":"bụi dâm bụt","hutnho":"nhà tranh cũ","hutnho2":"nhà tranh cũ"}␀␀␀␀␀␀␀␀{"lua":["g",3.5,12,"Bông lúa","Dài bông",25,0],"lua_thom":["g",3.9,16,"Bông lúa","Dài bông",26,0],"lua_man":["g",3.9,16,"Bông lúa","Dài bông",24,0],"nep":["g",3.3,11,"Bông nếp","Dài bông",24,0],"rau_muong":["g",60,400,"Ngọn","Dài",45,0],"bap":["kg",350,1200,"Trái","Dài",20,12],"bap_nep":["kg",385,1560,"Trái","Dài",18,14],"hanh":["g",40,250,"Cây","Cao",35,0],"dau_nanh":["g",80,400,"Bụi","Cao",60,0],"mia":["kg",2500,12000,"Cây","Dài",250,18],"cai":["kg",400,3000,"Cây","Cao",35,0],"carot":["kg",150,6000,"Củ","Dài",18,8],"dauphong":["g",150,1000,"Bụi","Số củ",30,0],"cham":["g",300,2000,"Bó lá","Cao",70,0],"bido":["kg",5000,60000,"Trái","Vòng",75,9],"bong_vai":["g",300,1500,"Cây","Cao",90,0],"cat