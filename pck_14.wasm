hồn mấy người chôn hũ bạc bỏ quên, ai có phước thì được chỉ chỗ.","Tụi nhỏ trong xóm đồn ma trơi sợ tiếng chó sủa, nên chó Vện sủa là nó biến mất.","Chú Bảy bảo thật ra là khí đầm lầy bốc cháy, nhưng nói vậy chứ đêm tối vẫn không dám đi một mình."]␀␀␀␀["bầy gà","bầy vịt","con heo nái","con bò","bầy dê","con trâu"]␀␀␀␀[{"c":"A","t":"{A} đi câu từ sáng tới trưa, được đúng con cá rô bằng ba ngón tay."},{"c":"A","t":"{A} phơi lúa ngoài sân, mưa ập tới cả xóm chạy ra hốt phụ."},{"c":"A","t":"Con chó nhà {A} tha mất chiếc dép, cả nhà lục tung vườn mới thấy."},{"c":"A","t":"{A} trồng thử luống {cay} mới, khoe với ai đi ngang cũng chỉ cho coi."},{"c":"A","t":"Nhà {A} nấu nồi {mon} thơm lừng, mùi bay qua tới mấy nhà bên."},{"c":"A","t":"{A} ngồi vá lưới trước hiên từ chiều tới tối mịt."},{"c":"A","t":"Tụi nhỏ nhà {A} trèo cây ổi, té một cái nhưng phủi đít đứng dậy cười."},{"c":"A","t":"{A} sửa lại cái chái bếp, đóng đinh cốc cốc nguyên buổi."},{"c":"A","t":"{A} đi chợ về mua được con cá lóc to, khoe cả xóm."},{"c":"A","t":"{A} mất ngủ, ra ngồi uống trà dưới gốc dừa tới khuya."},{"c":"A","t":"Nhà {A} mới sơn lại cánh cửa màu xanh, ai đi ngang cũng ngó."},{"c":"A","t":"{A} đi đám xóm trên về kể chuyện ăn uống quá trời."},{"c":"A","t":"Con gà mái nhà {A} đẻ trứng hai lòng đỏ, cả nhà lấy làm lạ."},{"c":"A","t":"{A} tập đờn kìm, cả xóm nghe bài vọng cổ hơi bị lạc dây."},{"c":"A","t":"Đêm qua chuột cắn bao lúa nhà {A}, sáng ra lúa vương đầy sân."},{"c":"A","t":"{A} dẫn tụi nhỏ ra mương tắm, tiếng cười rộn cả khúc sông."},{"c":"A","t":"{A} đan xong cái rổ tre, nói để dành đựng trái cây cúng rằm."},{"c":"A","t":"{A} lên tỉnh khám răng, về tới nhà còn ôm má."},{"c":"A","t":"Nhà {A} có khách dưới quê lên chơi, nhà cửa rộn ràng cả ngày."},{"c":"A","t":"{A} kể chuyện ma cây gáo, tụi nhỏ trong xóm sợ không dám ra sau hè."},{"c":"A","t":"{A} bắt được con rắn nước trong bờ đìa, cả xóm bu lại coi."},{"c":"A","t":"{A} đổi cái nồi đồng cũ lấy bộ chén mới của ghe hàng."},{"c":"A","t":"Con mèo nhà {A} đẻ một ổ bốn con, đứa nào cũng đòi xin."},{"c":"A","t":"{A} thức sớm quét sân, quét luôn khúc đường trước ngõ."},{"c":"A","t":"Nhà {A} cúng rằm, bày mâm trái cây đẹp như tranh."},{"c":"A","t":"Cây mai trước ngõ nhà {A} trổ bông lác đác, ai cũng khen.","s":[0]},{"c":"A","t":"{A} đặt lờ dưới mương, sáng ra được mớ tép đem kho."},{"c":"A","t":"{A} trúng số an ủi, khao cả nhà nồi chè đậu."},{"c":"A","t":"Nhà {A} cất thêm cái chuồng mới cho {con}."},{"c":"A","t":"{A} ngồi chẻ lạt tre, nói mai mốt bó chả cho đám giỗ."},{"c":"A","tp":"vui","t":"{A} nhậu tới khuya, sáng ngủ quên trễ giờ ra đồng."},{"c":"A","tp":"vui","t":"{A} rủ cả xóm ra bờ sông hát karaoke, vui tới nửa đêm."},{"c":"A","tp":"vui","t":"{A} bày trò đá gà kiểng ngoài sân, thua một chầu cà phê."},{"c":"A","tp":"vui","t":"{A} mới mua cái loa kẹo kéo, mở nhạc bolero cả ngày."},{"c":"A","tp":"kho","t":"{A} cự thằng nhỏ thả trâu ăn lúa nguyên buổi sáng."},{"c":"A","tp":"kho","t":"{A} chê nồi canh chua của chợ thiếu me, đòi nấu lại."},{"c":"A","tp":"kho","t":"{A} rào lại cái ngõ, cấm tụi nhỏ đi tắt qua vườn."},{"c":"A","tp":"kho","t":"{A} đòi bên ghe hàng bớt tiền vì bó rau héo."},{"c":"A","tp":"tk","t":"{A} mặc cả với ghe hàng tới nửa buổi, bớt được hai trăm."},{"c":"A","tp":"tk","t":"{A} gom vỏ dừa khô về để dành nhóm bếp cả tháng."},{"c":"A","tp":"tk","t":"{A} vá lại cái áo cũ lần thứ ba, nói còn mặc tốt chán."},{"c":"A","tp":"tk","t":"{A} bỏ ống heo được nửa năm, đập ra đếm cả buổi."},{"c":"A","tp":"cham","t":"{A} ra đồng từ lúc gà chưa gáy, tối mịt mới về."},{"c":"A","tp":"cham","t":"{A} cuốc xong nguyên công đất trong một buổi sáng."},{"c":"A","tp":"cham","t":"{A} vừa gặt xong lúa đã lo cày ải cho vụ sau."},{"c":"A","tp":"cham","t":"{A} tranh thủ trưa nắng đan thêm mấy cái giỏ đem bán."},{"c":"A","tp":"hien","t":"{A} đem nồi cháo qua cho bà cụ neo đơn đầu xóm."},{"c":"A","tp":"hien","t":"{A} cho tụi nhỏ trong xóm hái ổi nhà mình ăn thoải mái."},{"c":"A","tp":"hien","t":"{A} lượm được cái ví rớt ngoài đường, đem lên ấp trả lại."},{"c":"A","tp":"hien","t":"{A} nhường chỗ phơi lúa cho nhà bên vì sân nhà họ ngập."},{"c":"A","tp":"sd","t":"{A} mới sắm bộ bàn ghế gỗ, mời cả xóm qua uống trà coi."},{"c":"A","tp":"sd","t":"{A} mặc áo dài khăn đóng đi chợ, ai hỏi cũng nói đi việc lớn."},{"c":"A","tp":"sd","t":"{A} treo bằng khen của con lên giữa nhà, ai tới cũng chỉ."},{"c":"A","tp":"sd","t":"{A} cúng đình mâm xôi gà to nhất xóm."},{"c":"AB","t":"{A} với {B} cãi nhau vì con mương ranh đất, ai cũng nói mình đúng.","a":{"l":"Qua khuyên giải","th":10,"tb":10,"ut":2,"m":"Bạn qua phân trần, hai nhà dịu lại, bắt tay làm hòa."}},{"c":"AB","t":"Gà nhà {A} qua bới nát luống rau nhà {B}, hai nhà to tiếng.","a":{"l":"Qua khuyên giải","th":10,"tb":10,"ut":2,"m":"Bạn đứng giữa nói đỡ, {A} chịu đền bó rau, chuyện êm."}},{"c":"AB","t":"{A} cho {B} mượn chiếc xuồng đi chợ, tới chiều chưa thấy trả."},{"c":"AB","t":"{A} với {B} ngồi đánh cờ tướng dưới gốc me, thua thắng cãi rân."},{"c":"AB","t":"{A} qua phụ {B} lợp lại mái nhà trước mùa mưa.","a":{"l":"Qua phụ một tay","xu":0,"th":15,"tb":15,"m":"Bạn leo lên phụ lợp, ba người làm nhanh hơn hẳn."}},{"c":"AB","t":"Nhà {A} với nhà {B} góp gạo nấu nồi cơm chung đãi thợ."},{"c":"AB","t":"{A} hỏi mượn {B} cái cối xay bột, hứa mai trả."},{"c":"AB","t":"{A} với {B} hùn tiền mua con heo giống về nuôi chung."},{"c":"AB","t":"Tụi nhỏ nhà {A} và nhà {B} giành nhau con diều, khóc bù lu.","a":{"l":"Làm thêm con diều","xu":60,"th":15,"tb":15,"m":"Bạn làm thêm con diều, tụi nhỏ mỗi đứa một con, hết giành."}},{"c":"AB","t":"{A} đi ngang nghe {B} than nhà hết gạo.","a":{"l":"Đem gạo qua","it":["gao",2],"tb":25,"ut":2,"m":"Bạn đem gạo qua, {B} cảm động cảm ơn hoài."}},{"c":"AB","t":"{A} kể {B} vừa trúng mùa {cay}, ai nghe cũng mừng lây."},{"c":"AB","t":"{A} với {B} rủ nhau đi xem hát bội ở chợ quận."},{"c":"AB","t":"{A} nói xấu {B} sau lưng, chuyện tới tai cả xóm.","a":{"l":"Nói giùm một câu","th":-5,"tb":20,"m":"Bạn lên tiếng bênh {B}, {A} hơi phật ý nhưng xóm thấy bạn phải."}},{"c":"AB","t":"Trâu nhà {A} sổng chuồng chạy qua ruộng {B}.","a":{"l":"Phụ bắt trâu","th":15,"tb":10,"m":"Bạn chạy phụ lùa trâu về, lúa nhà {B} bớt dập."}},{"c":"AB","t":"{A} đem biếu {B} buồng chuối chín cây."},{"c":"AB","t":"{A} với {B} cá cược coi ai câu được nhiều cá hơn, rốt cuộc huề."},{"c":"sui","t":"Hai nhà sui {A} và {B} qua lại biếu nhau mâm bánh."},{"c":"sui","t":"Sui gia {A} với {B} giận nhau vì chuyện đám giỗ mời trễ.","a":{"l":"Qua nói giùm","th":15,"tb":15,"ut":3,"m":"Bạn nói vô vài câu, hai nhà sui cười xòa bỏ qua."}},{"c":"sui","t":"Nhà sui {B} lên thăm {A}, đem theo giỏ trái cây miệt vườn."},{"c":"sui","t":"{A} với sui gia {B} hẹn nhau đi chùa đầu tháng."},{"c":"ae","t":"Anh em họ {A} và {B} họp mặt bàn chuyện sửa mả ông bà."},{"c":"ae","t":"{A} và {B} chung họ mà giành nhau miếng đất hương hỏa.","a":{"l":"Qua hòa giải","th":10,"tb":10,"ut":4,"m":"Bạn khuyên chia đôi lo hương khói chung, hai nhà nghe theo."}},{"c":"ae","t":"Cả họ {A} kéo qua nhà {B} ăn mừng cháu đầu lòng."},{"c":"ae","t":"{A} dẫn đám con cháu trong họ qua nhà {B} học đờn."},{"c":"A","t":"Heo nhà {A} đẻ một bầy {so} con, ai cũng qua coi.","a":{"l":"Qua mừng","xu":50,"th":20,"m":"Bạn đem chút quà qua mừng, {A} vui lắm."}},{"c":"A","t":"Nhà {A} mới cất xong căn bếp, mời bà con qua ăn tân gia.","a":{"l":"Qua ăn tân gia","xu":100,"th":25,"m":"Bạn bỏ phong bì mừng tân gia, {A} quý lắm."}},{"c":"A","t":"Con nhà {A} đậu đại học trên thành phố, cả xóm mừng.","a":{"l":"Qua chúc mừng","xu":100,"th":25,"ut":1,"m":"Bạn qua chúc mừng, cho đứa nhỏ chút tiền xe."}},{"c":"A","t":"{A} bị trặc chân lúc gánh lúa, nằm nhà mấy bữa.","a":{"l":"Qua thăm","it":["trung",3],"th":25,"m":"Bạn đem mấy trứng gà qua thăm, {A} cảm động lắm."}},{"c":"A","t":"Nhà {A} thiếu người gặt, lúa chín rục ngoài đồng.","a":{"l":"Qua phụ gặt","th":25,"ut":2,"m":"Bạn ra phụ gặt nguyên buổi, lúa vô bồ kịp."}},{"c":"A","t":"Bà cụ nhà {A} tròn tám mươi, con cháu làm mâm mừng thọ.","a":{"l":"Qua mừng thọ","xu":80,"th":25,"m":"Bạn qua mừng thọ bà cụ, được mời ở lại ăn cơm."}},{"c":"A","t":"Nhà {A} hết củi nấu cơm mà trời mưa dầm.","a":{"l":"Đem củi qua","it":["cui",3],"th":20,"m":"Bạn đem củi khô qua, nồi cơm nhà {A} kịp chín."}},{"c":"A","t":"{A} sắp đi xa làm ăn, nhờ người coi nhà giùm mấy bữa.","a":{"l":"Nhận coi giùm","th":20,"m":"Bạn nhận coi nhà giùm, {A} yên tâm lên đường."}},{"c":"A","t":"Đứa nhỏ nhà {A} sốt cả đêm, nhà lo cuống lên.","a":{"l":"Chở đi trạm","xu":40,"th":25,"ut":1,"m":"Bạn chở đứa nhỏ đi trạm, sáng ra hạ sốt."}},{"c":"A","t":"{A} làm mâm cỗ cúng tạ đất, mời hàng xóm ở lại ăn.","a":{"l":"Ghé dự","th":15,"m":"Bạn ghé dự, ăn no mà ngồi nghe chuyện tới tối."}},{"c":"A","t":"{A} tậu được chiếc ghe mới, làm lễ hạ thủy ở bến.","a":{"l":"Qua mừng","xu":60,"th":20,"m":"Bạn qua mừng ghe mới, {A} chở một vòng vàm sông."}},{"c":"","s":[0],"t":"Mùa xuân, cả xóm rủ nhau dọn mả ông bà, cắm nhang khói nghi ngút."},{"c":"A","s":[0],"t":"{A} lặt lá mai cho kịp Tết, cả nhà ngồi lặt tới tối."},{"c":"A","s":[0],"t":"Nhà {A} gói bánh tét, nồi bánh luộc cả đêm, tụi nhỏ ngồi canh lửa."},{"c":"","s":[0],"t":"Hoa đào hoa mai nở rộ dọc đường làng, ai đi ngang cũng chụp hình."},{"c":"","s":[1],"t":"Mưa đầu mùa, cả xóm ra hứng nước mưa đổ lu đổ khạp."},{"c":"A","s":[1],"t":"Mưa xuống, ếch nhái kêu inh ỏi, {A} đi soi ếch được cả giỏ."},{"c":"","s":[1],"t":"Gió mùa về, tụi nhỏ trong xóm thả diều kín trời chiều."},{"c":"A","s":[1],"t":"{A} đội nón lá ra đồng cấy, mưa lâm râm cả buổi."},{"c":"","s":[2],"t":"Nước nổi tràn đồng, xóm dưới đi giăng lưới cá linh."},{"c":"A","s":[2],"t":"Bông điên điển nở vàng mương, {A} hái về nấu canh chua."},{"c":"A","s":[2],"t":"Nước lên tới mé sân nhà {A}, cả nhà kê đồ lên cao."},{"c":"","s":[2],"t":"Trăng rằm tháng Tám sáng vằng vặc, tụi nhỏ rước đèn khắp xóm."},{"c":"","s":[3],"t":"Nắng hạn, giếng làng cạn, bà con xếp hàng gánh nước từ sáng sớm."},{"c":"A","s":[3],"t":"{A} ngồi canh lúa phơi ngoài sân, nắng chang chang tới trưa."},{"c":"","s":[3],"t":"Nước mặn lấn vô kênh, xóm dưới lo trữ nước ngọt trong lu."},{"c":"A","s":[3],"t":"Ruộng khô nứt nẻ, {A} tát nước từ mương lên tưới cả buổi."},{"c":"","s":[3],"t":"Mùa khô, cả xóm rủ nhau tát đìa bắt cá lóc, cá trê."},{"c":"","t":"Ghe hàng bông từ chợ nổi ghé bến, cả xóm ra mua bán rộn ràng."},{"c":"","t":"Đêm qua cúp điện, cả xóm thắp đèn dầu ngồi kể chuyện xưa."},{"c":"","t":"Có gánh hát lô tô ghé ngã ba, xóm kéo nhau ra coi tới khuya."},{"c":"","t":"Ông thầy thuốc nam đi ngang, bà con ra hỏi thuốc nhức mỏi."},{"c":"","t":"Ngoài vàm có ghe chài chở gạo neo lại, dân xóm ra coi đông nghẹt."},{"c":"","t":"Ấp họp bàn chuyện sửa lại cây cầu khỉ đầu xóm."},{"c":"","t":"Đám trẻ trong xóm đá banh ngoài ruộng khô, la hét cả chiều."},{"c":"","t":"Chiều nay chùa đánh chuông, tiếng ngân xa tới tận cuối xóm."},{"c":"","t":"Có người lạ đi bán cây giống, xóm mua mỗi nhà một hai cây."},{"c":"","t":"Ông bán kem đạp xe leng keng, tụi nhỏ bu lại đòi mua."}]␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀{"nha":"Nhà mình","xom":"Xóm làng","tt":"Thiên tai","buon":"Buôn bán"}␀␀␀{"well":1,"shrine":1,"bridge":1,"caukhi":1,"caukhid":1,"choi":1,"causong":2,"gate":2,"tramyt":2,"truong":2,"dinh":3,"chua":3}␀␀␀{"tramyt":1}␀␀␀␀[["xu","Xu",1],["cui","Củi khô",8],["gach","Gạch nung",30],["cong","Công phụ dựng",100]]␀␀␀␀␀␀␀␀␀␀␀␀␀␀[0,0,4,12]␀␀␀␀␀␀[0,0,4,7]␀␀␀␀␀␀␀{"tk":"cui","hien":"gach","cham":"cong"}␀␀␀␀␀␀␀␀["","bậc xóm","bậc ấp","bậc làng"]␀␀␀␀[{"id":"p1","vnd":20000,"ng":60,"b":0,"pile":1},{"id":"p2","vnd":50000,"ng":150,"b":15,"pile":2,"tag":"Phổ biến"},{"id":"p3","vnd":100000,"ng":300,"b":45,"pile":3},{"id":"p4","vnd":200000,"ng":600,"b":120,"pile":4},{"id":"p5","vnd":500000,"ng":1500,"b":400,"pile":6,"tag":"Lời nhất"}]␀␀␀␀␀␀␀␀␀␀␀␀[{"vnd":10000,"t":"60 sen đỏ + đèn lồng đỏ"},{"vnd":10000,"t":"60 sen đỏ + 10 vật liệu xưởng"},{"vnd":20000,"t":"130 sen đỏ + 3 con gà mái đẻ"},{"vnd":20000,"t":"130 sen đỏ + nâng kho 1 bậc"},{"vnd":20000,"t":"130 sen đỏ + thợ giỏi 2★"},{"vnd":50000,"t":"350 sen đỏ + bùa +50% EXP 7 ngày"},{"