			o = over(o, vec4(rb * a, a));
		}
	}
	// at night the white water catches only the moon: keep it from glowing against the dark village
	o.rgb *= mix(1.0, 0.72, uNight);
	COLOR = o;
}
␀␀␀␀␀shader_type canvas_item;
#include "res://night.gdshaderinc"
// (n16, Link "Ä‘Ã¡ ngay chÃ¢n thÃ¡c thÃ¬ cá»© nhÆ° lÆ¡ lá»­ng trÃªn máº·t nÆ°á»›c"): the pool rocks (n/fallrock.webp, padded below
// by main.gd) sit IN the water. Their lowest part is under the surface (seen through teal water, fading out), a
// broken ring of foam laps at the waterline and moves, and a dark wobbling reflection lies on the water under them.
// Distances are found by walking the picture's alpha up/down this column (picture px, 6 px = 1 world unit).
float hh(vec2 p) { vec3 q = fract(vec3(p.xyx) * 0.1031); q += dot(q, q.yzx + 33.33); return fract((q.x + q.y) * q.z); }
float vno(vec2 p) { vec2 i = floor(p), f = p - i; f = f * f * (3.0 - 2.0 * f);
	float a = hh(i), b = hh(i + vec2(1.0, 0.0)), c = hh(i + vec2(0.0, 1.0)), d = hh(i + vec2(1.0, 1.0));
	return a + (b - a) * f.x + (c - a) * f.y + (a - b - c + d) * f.x * f.y; }
varying vec2 wp;
void vertex() { wp = (MODEL_MATRIX * vec4(VERTEX, 0.0, 1.0)).xy; }
void fragment() {
	vec2 tp = TEXTURE_PIXEL_SIZE;
	vec4 c = texture(TEXTURE, UV);
	float t = TIME;
	vec3 wat = vec3(0.30, 0.58, 0.58);
	float wl = 11.0 + 2.2 * sin(wp.x * 0.9 + t * 1.7) + 1.4 * sin(wp.x * 2.3 - t * 2.6) + 2.0 * (vno(vec2(wp.x * 0.6, t * 0.7)) - 0.5);
	vec4 o = vec4(0.0);
	if (c.a > 0.05) {
		// how far down this column the rock goes on from here
		float db = 60.0;
		for (int k = 1; k <= 20; k++) {
			float dy = float(k) * 1.5;
			if (texture(TEXTURE, UV + vec2(0.0, dy * tp.y)).a < 0.3) { db = dy; break; }
		}
		vec3 rc = c.rgb;
		float sub = smoothstep(wl + 1.0, wl - 1.0, db);
		// under water: darker, teal, then gone into the water
		vec3 uc = mix(rc * 0.55, wat * 0.8, 0.55);
		float ua = mix(0.85, 0.0, smoothstep(wl - 1.0, 0.0, db));
		// wet dark band just above the waterline
		float wetB = smoothstep(wl + 9.0, wl + 1.0, db) * (1.0 - sub);
		rc *= 1.0 - 0.3 * wetB;
		vec3 col = mix(rc, uc, sub);
		float a = mix(c.a, c.a * ua, sub);
		// foam lapping at the waterline, broken and moving
		float fl = (1.0 - smoothstep(0.0, 1.6, abs(db - wl))) * smoothstep(0.35, 0.6, vno(vec2(wp.x * 1.3 - t * 1.2, 3.0)));
		col = mix(col, vec3(0.93, 0.97, 0.97), fl * 0.85);
		a = max(a, fl * 0.85 * c.a);
		o = vec4(col, a);
	} else {
		// water below a rock: its reflection (the rock flipped at its waterline), wobbling, and a ring of foam
		float du = 60.0;
		for (int k = 1; k <= 20; k++) {
			float dy = float(k) * 1.5;
			if (texture(TEXTURE, UV - vec2(0.0, dy * tp.y)).a > 0.3) { du = dy; break; }
		}
		if (du < 30.0) {
			float wob = 1.6 * sin(wp.y * 3.0 + t * 3.0) + 1.0 * sin(wp.x * 1.7 - t * 2.0);
			vec4 rf = texture(TEXTURE, UV + vec2(wob * tp.x, -(2.0 * du + 2.0 * wl) * tp.y));
			float ra = rf.a * 0.55 * (1.0 - du / 30.0) * smoothstep(0.25, 0.55, vno(vec2(wp.x * 0.8, wp.y * 2.4 - t * 1.5)) + 0.2);
			vec3 rcol = mix(rf.rgb * 0.45, wat * 0.5, 0.5);
			o = vec4(rcol, ra);
			float ring = (1.0 - smoothstep(0.0, 3.5, du)) * smoothstep(0.4, 0.62, vno(vec2(wp.x * 1.1 + t * 0.8, 9.0)));
			o.rgb = mix(o.rgb, vec3(0.93, 0.97, 0.97), ring);
			o.a = max(o.a, ring * 0.75);
		}
	}
	if (o.a < 0.003) discard;
	COLOR = vec4(night_col(o.rgb), o.a);
}
␀␀␀␀␀␀␀␀␀␀␀␀␀␀shader_type canvas_item;
#include "res://night.gdshaderinc"
// Native village ground (no captured pictures).
// Layer 1 (n41, NEN2.draw): bought land = the game's lawn (n2_co recoloured C.base), unbought land = wild grass (n2_codai,
// C.wild) as NEN2's zone 2: per-tile value (1 unbought, else the rough round a wild bush still standing), eased between tile
// centres + the game's own value noise (Me() lattice in uNZ), cut at .5, with the soft outside fade of NEN2 soft().
// Layer 2: tiles with their own ground (paddy, rubber, tram, cu lao, yard) from per-tile data: kind + the game's tile colour.
//   Paddy = TH.pad: tile colour, rice rows (TH rowPat), raised bunds every 3 tiles (bu: t%3==0, bv: a%3==1).
uniform sampler2D uNZ : filter_nearest;   // R: Me lattice for vn(x/8.5..), G: for vn(x/23..), B: per-tile wild value (run time)
uniform vec4 uNL = vec4(-1.0, 12.0, 31.0, 8.0);   // lattice origins: /8.5 i0 j0, /23 i0 j0
uniform vec2 uNL4 = vec2(6.0, 12.0);   // A: /8.5 lattice of the yard zone
uniform vec3 gY = vec3(1.0173, 1.0118, 1.0097);   // NEN2 C.yard recolour of n2_dat
uniform vec3 oY = vec3(0.0129, 0.0074, 0.0044);
uniform float tY = 153.6;      // 128 * 1.2
uniform vec3 gC = vec3(1.06);
uniform vec3 oC = vec3(0.2453, 0.3123, 0.1303);   // NEN2 lawn (C.base) recolour of n2_co, same +offset as the wild grass
uniform float tC = 179.2;      // world units per lawn texture repeat (128 * 1.4)
uniform sampler2D uTC : filter_nearest;   // tile colour (RGB) + A = kind*16 + flags (flag 1: rows run the other way, 2: unbought lot)
uniform vec3 gW = vec3(1.06);
uniform vec3 oW = vec3(0.1700, 0.2650, 0.0920);   // NEN2 wild recolour, +6/+3/+3 to match the game's unbought grass on screen
uniform float tS = 281.6;      // world units per grass texture repeat (128 * 2.2, as the game)
uniform vec4 uT;               // ki, hi, F0, vo
uniform vec2 uTN;              // tile texture size
// Layer 3: roads (DUONG). Per tile: R tier (2 earth band, 3 footpath, 4 laid road), G connections (bit k = D4[k]:
// +u, -u, +v, -v), B kind (dat do cat soi gach da). Surfaces are the game's own dg2_<kind> textures, recoloured like dtx().
uniform sampler2D uRD : filter_nearest;
// the 6 road surfaces (+ 6 wild grass, 7 lawn, 8 yard earth) in one texture array: phones allow few textures per shader (Adreno: 16 incl. Godot's own)
uniform sampler2DArray uRA : repeat_enable, filter_linear_mipmap;
uniform vec3 rG[6];
uniform vec3 rO[6];
uniform vec3 rRG[6];
uniform vec3 rRO[6];
uniform vec3 eSg; uniform vec3 eSo; uniform vec3 eBg; uniform vec3 eBo; uniform vec3 eEg; uniform vec3 eEo;
uniform float uRoads = 0.0;
uniform float uWet = 0.0;   // mÆ°a: Ä‘áº¥t cá» tháº¥m nÆ°á»›c, sáº«m láº¡i (lÃªn dáº§n khi mÆ°a, khÃ´ dáº§n khi táº¡nh)
// Layer 4: ponds, canal and ditches (AOW, the game's non-WebGL path). Fields at 4 samples a tile (n/pond.png: shore F,
// mud Fm, grass lip Fl, depth D), the game's colours, and its bank detail textures laid in "overlay" like BTX.
uniform sampler2D uPF : filter_linear, repeat_disable;
uniform vec4 uPB = vec4(0.0, 0.0, 1.0, 1.0);   // X0, Y0, NX, NY (samples)
uniform sampler2D uPT1 : repeat_enable, filter_linear_mipmap;   // co, vach, bun, dat
uniform sampler2D uPT2 : repeat_enable, filter_linear_mipmap;   // ria grey, ria alpha, rach alpha, loang alpha
uniform sampler2D uPT3 : repeat_enable, filter_linear_mipmap;   // glint streaks
uniform vec3 pMid; uniform vec3 pMudS; uniform vec3 pDpc; uniform vec3 pSky; uniform vec3 pBand;
uniform vec3 pLip; uniform vec3 pMud; uniform vec3 pFace; uniform vec3 pFaceW; uniform vec3 pFaceD;
uniform float uPond = 0.0;
varying vec2 wp;
void vertex() { wp = VERTEX; }

float hh(vec2 p) { return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453); }
float vno(vec2 p) { vec2 i = floor(p), f = p - i; f = f * f * (3.0 - 2.0 * f);
	float a = hh(i), b = hh(i + vec2(1.0, 0.0)), c = hh(i + vec2(0.0, 1.0)), d = hh(i + vec2(1.0, 1.0));
	return a + (b - a) * f.x + (c - a) * f.y + (a - b - c + d) * f.x * f.y; }
// road texture of kind k: dat/do/cat/soi anchored to the world (112 / 96 units a repeat), gach/da on the tile grid (2 tiles)
vec3 rtex(int k, vec2 w, vec2 t) {
	if (k < 3) return texture(uRA, vec3(w / 112.0, float(k))).rgb;
	if (k == 3) return texture(uRA, vec3(w / 96.0, 3.0)).rgb;
	return texture(uRA, vec3(t / 2.0, float(k))).rgb;
}
// signed distance (tile units, < 0 inside) of a laid road of half width w: a bar from the centre to every connected edge,
// and a rounded square (|x|^4+|y|^4) at the centre unless the road runs straight through
float rsd(vec2 f, int m, float w) {
	float d = 1e3;
	vec2 q = f - 0.5;
	if ((m & 1) != 0) d = min(d, max(-q.x, abs(q.y) - w));
	if ((m & 2) != 0) d = min(d, max(q.x, abs(q.y) - w));
	if ((m & 4) != 0) d = min(d, max(-q.y, abs(q.x) - w));
	if ((m & 8) != 0) d = min(d, max(q.y, abs(q.x) - w));
	if (m != 3 && m != 12) d = min(d, pow(pow(abs(q.x), 4.0) + pow(abs(q.y), 4.0), 0.25) - w);
	return d;
}
// distance to the footpath centre lines (centre to each connected edge)
float fpd(vec2 f, int m) {
	vec2 q = f - 0.5;
	float d = length(q);
	if ((m & 1) != 0) d = min(d, length(vec2(q.x - clamp(q.x, 0.0, 0.5), q.y)));
	if ((m & 2) != 0) d = min(d, length(vec2(q.x - clamp(q.x, -0.5, 0.0), q.y)));
	if ((m & 4) != 0) d = min(d, length(vec2(q.x, q.y - clamp(q.y, 0.0, 0.5))));
	if ((m & 8) != 0) d = min(d, length(vec2(q.x, q.y - clamp(q.y, -0.5, 0.0))));
	return d;
}

// coverage of a line at perpendicular distance d (world units), width w, with pixel-size anti-aliasing
float line(float d, float w, float px) { return clamp((w * 0.5 - abs(d)) / px + 0.5, 0.0, 1.0); }

// ---- layer 4 helpers
vec2 s2g(vec2 w) { vec2 d = w - uT.xy; float a = d.x / 32.0, b = d.y / 16.0; return vec2((a + b) * 0.5, (b - a) * 0.5); }
vec4 PFg(vec2 g) {
	vec2 uv = (g - uPB.xy) * 4.0 / uPB.zw;
	if (uv.x < 0.0 || uv.y < 0.0 || uv.x > 1.0 || uv.y > 1.0) return vec4(-0.1, -0.1, -0.1, 0.0);
	return (texture(uPF, uv) * 255.0 - 20.0) / 200.0;
}
vec4 PF(vec2 w) { return PFg(s2g(w)); }
float sst(float a, float b, float x) { float t = clamp((x - a) / (b - a), 0.0, 1.0); return t * t * (3.0 - 2.0 * t); }
vec3 ovl(vec3 b, float s) { return mix(2.0 * b * s, 1.0 - 2.0 * (1.0 - b) * (1.0 - s), step(0.5, b)); }
float aa(float d, float px) { return clamp(d / px + 0.5, 0.0, 1.0); }
// (n16, Link "lÃ m má»›i, bá» code cÅ©"): the ground only lays the water's bed colour under the pond; the water is
// pondwater.gdshader, the banks are the river's bank drawing (pondriver.gd)
vec3 pond(vec3 c, vec2 w) {
	vec2 g = s2g(w);
	vec4 f = PFg(g);
	if (f.x < 0.3) return c;
	float px = max(fwidth(w.x), 1e-4);
	const float e = 1.5;
	float gx = (PF(w + vec2(e, 0.0)).x - PF(w - vec2(e, 0.0)).x) / (2.0 * e);
	float gy = (PF(w + vec2(0.0, e)).x - PF(w - vec2(0.0, e)).x) / (2.0 * e);
	float dF = (f.x - 0.5) / max(sqrt(gx * gx + gy * gy), 1e-4);
	return mix(c, pMid * 0.92, aa(dF, px));
}


// ---- layer 1: bought lawn / wild grass (NEN2 zone 2)
float nzL(ivec2 p, int ch) {
	ivec2 q = clamp(p, ivec2(0), ivec2(1023));
	vec4 t = texelFetch(uNZ, q, 0);
	return ch == 0 ? t.r : (ch == 1 ? t.g : t.a);
}
float vnL(vec2 X, int ch) {
	vec2 i0 = floor(X), f = X - i0;
	f = f * f * (3.0 - 2.0 * f);
	ivec2 o = ivec2(i0) - (ch == 0 ? ivec2(int(uNL.x), int(uNL.y)) : (ch == 1 ? ivec2(int(uNL.z), int(uNL.w)) : ivec2(int(uNL4.x), int(uNL4.y))));
	float a = nzL(o, ch), b = nzL(o + ivec2(1, 0), ch), c = nzL(o + ivec2(0, 1), ch), d = nzL(o + ivec2(1, 1), ch);
	return a + (b - a) * f.x + (c - a) * f.y + (a - b - c + d) * f.x * f.y;
}
// B: wild value * 100, + 128 on a yard tile
float tB(ivec2 t) {
	ivec2 q = t - ivec2(uT.zw);
	if (q.x < 0 || q.y < 0 || q.x >= int(uTN.x) || q.y >= int(uTN.y)) return 100.0;
	return floor(texelFetch(uNZ, q, 0).b * 255.0 + 0.5);
}
float twild(ivec2 t) { float b = tB(t); return min(1.0, mod(b, 128.0) / 100.0); }
float tyard(ivec2 t) { return tB(t) >= 128.0 ? 1.0 : 0.0; }
float yardv(vec2 w) {
	vec2 d = w - uT.xy;
	float u = (d.y / 16.0 + d.x / 32.0) / 2.0 - 0.5, v = (d.y / 16.0 - d.x / 32.0) / 2.0 - 0.5;
	vec2 i0 = floor(vec2(u, v)), f = vec2(u, v) - i0;
	f = f * f * (3.0 - 2.0 * f);
	ivec2 t = ivec2(i0);
	float a = tyard(t), b = tyard(t + ivec2(1, 0)), c = tyard(t + ivec2(0, 1)), e = tyard(t + ivec2(1, 1));
	if (a + b + c + e == 0.0) return 0.0;
	float base = a + (b - a) * f.x + (c - a) * f.y + (a - b - c + e) * f.x * f.y;
	float n = vnL(vec2(w.x / 23.0 + 69.2, w.y / 23.0 + 20.4), 1) * 0.9 + vnL(vec2(w.x / 8.5 + 13.2, w.y / 8.5 + 30.8), 2) * 0.1 - 0.5;
	return base + n * 0.36;
}
// NEN2 soft(): the zone filled, plus strokes 18/12/7/3 wide at alpha .14/.18/.22/.28 outside its edge
float softz(float val, float pw) {
	float gl = max(length(vec2(dFdx(val), dFdy(val))) / max(pw, 1e-5), 1e-4);
	float dz = (0.5 - val) / gl;
	float ko = 1.0;
	ko *= 1.0 - 0.14 * clamp((9.0 - dz) / pw + 0.5, 0.0, 1.0);
	ko *= 1.0 - 0.18 * clamp((6.0 - dz) / pw + 0.5, 0.0, 1.0);
	ko *= 1.0 - 0.22 * clamp((3.5 - dz) / pw + 0.5, 0.0, 1.0);
	ko *= 1.0 - 0.28 * clamp((1.5 - dz) / pw + 0.5, 0.0, 1.0);
	return max(clamp(0.5 - dz / pw, 0.0, 1.0), 1.0 - ko);
}
float wildv(vec2 w) {
	vec2 d = w - uT.xy;
	float u = (d.y / 16.0 + d.x / 32.0) / 2.0 - 0.5, v = (d.y / 16.0 - d.x / 32.0) / 2.0 - 0.5;
	vec2 i0 = floor(vec2(u, v)), f = vec2(u, v) - i0;
	f = f * f * (3.0 - 2.0 * f);
	ivec2 t = ivec2(i0);
	float a = twild(t), b = twild(t + ivec2(1, 0)), c = twild(t + ivec2(0, 1)), e = twild(t + ivec2(1, 1));
	if (a + b + c + e == 0.0) return 0.0;
	float base = a + (b - a) * f.x + (c - a) * f.y + (a - b - c + e) * f.x * f.y;
	float n = vnL(vec2(w.x / 23.0 + 34.6, w.y / 23.0 + 10.2), 1) * 0.7 + vnL(vec2(w.x / 8.5 + 6.6, w.y / 8.5 + 15.4), 0) * 0.3 - 0.5;
	return base + n * 0.84;
}
void fragment() {
	if (wp.y < 350.0) { discard; }   // (b60) web TH.hz: above xf + HZL (360 - 10) the ground is cleared, the sky shows
	vec3 cw = texture(uRA, vec3(wp / tS, 6.0)).rgb * gW + oW;
	vec3 cl = texture(uRA, vec3(wp / tC, 7.0)).rgb * gC + oC;
	float pw = length(vec2(dFdx(wp.x), dFdy(wp.x)));               // world units per screen pixel
	vec3 c = mix(cl, cw, softz(wildv(wp), pw));
	// zone 4: swept earth yard round houses, pavilions, shrines (NEN2 YD), the game's n2_dat recoloured C.yard
	float yv = yardv(wp);
	c = mix(c, texture(uRA, vec3(wp / tY, 8.0)).rgb * gY + oY, softz(yv, pw));
	vec2 d = wp - uT.xy;
	float u = (d.y / 16.0 + d.x / 32.0) / 2.0;
	float v = (d.y / 16.0 - d.x / 32.0) / 2.0;
	vec2 tf = vec2(floor(u), floor(v));
	ivec2 ti = ivec2(tf - uT.zw);
	if (ti.x >= 0 && ti.y >= 0 && ti.x < int(uTN.x) && ti.y < int(uTN.y)) {
		int kf = int(texelFetch(uTC, ti, 0).a * 255.0 + 0.5);
		int kind = kf / 16;
		if (kind > 0) {
			vec3 tc = texelFetch(uTC, ti, 0).rgb;
			c = tc;
			if (kind == 1) {
				float px = max(fwidth(wp.x), 1e-4);
				// rice rows: pattern in world space, lines of slope +-1/2 every 4 units (TH rowPat)
				bool al = (kf & 1) == 1;
				float sl = al ? -0.5 : 0.5;
				float base = wp.y + sl * wp.x;
				float e1 = (fract((base - 0.4) / 4.0 + 0.5) - 0.5) * 4.0 * 0.894;
				// dashed 1.6 on / 1.38 off with round caps (canvas lineCap round): a dash is a capsule of radius .55
				float sa = mod((wp.x + 2.0) * 1.118, 2.98);
				float da = max(0.0, max(-sa, sa - 1.6));
				da = min(da, 2.98 - sa);
				float r1 = sqrt(da * da + e1 * e1);
				c = mix(c, vec3(30.0, 40.0, 10.0) / 255.0, 0.2 * clamp((0.55 - r1) / px + 0.5, 0.0, 1.0));
				float e2 = (fract((base + 0.6) / 4.0 + 0.5) - 0.5) * 4.0 * 0.894;
				c = mix(c, vec3(255.0, 255.0, 230.0) / 255.0, 0.15 * line(e2, 0.7, px));
				// bunds (bá» ruá»™ng)
				float fu = u - tf.x, fv = v - tf.y;
				bool bu = int(mod(tf.x, 3.0)) == 0;
				bool bv = int(mod(tf.y, 3.0)) == 1;
				const float W = 0.085;
				const float K = 28.62;   // world units per tile unit across an edge
				vec3 top = vec3(143.0, 162.0, 78.0) / 255.0;
				if (bu) {
					float a = clamp((W - fu) * K / px + 0.5, 0.0, 1.0);
					c = mix(c, top, a);
					c = mix(c, vec3(40.0, 50.0, 20.0) / 255.0, 0.28 * line((fu - W) * K - 0.27, 1.1, px));
					c = mix(c, vec3(255.0, 250.0, 210.0) / 255.0, 0.3 * line(fu * K - 0.1, 0.8, px));
				}
				if (bv) {
					float a = clamp((W - fv) * K / px + 0.5, 0.0, 1.0);
					c = mix(c, top, a);
					c = mix(c, vec3(40.0, 50.0, 20.0) / 255.0, 0.28 * line((fv - W) * K - 0.36, 1.1, px));
					c = mix(c, vec3(255.0, 250.0, 210.0) / 255.0, 0.3 * line(fv * K - 0.45, 0.8, px));
				}
			}
		}
	}
	if (uPond > 0.5) c = pond(c, wp);
	if (uRoads > 0.5 && ti.x >= 0 && ti.y >= 0 && ti.x < int(uTN.x) && ti.y < int(uTN.y)) {
		vec4 rd = texelFetch(uRD, ti, 0);
		int tier = int(rd.r * 255.0 + 0.5);
		if (tier > 0) {
			int m = int(rd.g * 255.0 + 0.5);
			int k = int(rd.b * 255.0 + 0.5);
			vec2 f = vec2(u, v) - tf;
			float px = max(fwidth(u), 1e-5) * 0.7;   // one screen pixel in tile units (across an edge)
			vec3 dat = texture(uRA, vec3(wp / 112.0, 0.0)).rgb;
			if (tier == 4) {
				int rk = (k == 4 || k == 5) ? 0 : k;
				vec3 rim = rtex(rk, wp, vec2(u, v)) * rRG[k] + rRO[k];
				vec3 sur = rtex(k, wp, vec2(u, v)) * rG[k] + rO[k];
				c = mix(c, rim, clamp(-rsd(f, m, 0.5) / px + 0.5, 0.0, 1.0));
				c = mix(c, sur, clamp(-rsd(f, m, 0.455) / px + 0.5, 0.0, 1.0));
			} else if (tier == 3) {
				float dd = fpd(f, m);
				c = mix(c, dat * eEg + eEo, clamp((0.13 - dd) / px + 0.5, 0.0, 1.0));
				c = mix(c, dat * eBg + eBo, clamp((0.11 - dd) / px + 0.5, 0.0, 1.0));
			} else if (tier == 2) {
				// earth band: ragged edges (ew noise), darker rim, lighter top inset on one side
				float n1 = vno(vec2(u, v) * 0.62 * 1.0 + 40.1) - 0.5, n2 = vno(vec2(u, v) * 1.9 + 3.7) - 0.5;
				float wa = 0.5 + 0.11 * n1 + 0.06 * n2;
				float dd = rsd(f, m, wa);
				c = mix(c, dat * eSg + eSo, clamp(-dd / px + 0.5, 0.0, 1.0));
				float ins = 0.045 + 0.05 * vno(vec2(u, v) * 1.3 + vec2(3.3, -8.1));
				c = mix(c, dat * eBg + eBo, clamp(-rsd(f, m, wa - ins) / px + 0.5, 0.0, 1.0));
			}
		}
	}
	if (uWet > 0.0) {
		c = clamp(c, 0.0, 1.0);
		vec3 wc = pow(c, vec3(1.35)) * 0.9;   // Æ°á»›t: sáº«m hÆ¡n, mÃ u Ä‘áº­m hÆ¡n
		c = mix(c, wc, uWet);
	}
	COLOR = vec4(night_col(clamp(c, 0.0, 1.0)), 1.0);
}
␀␀␀␀␀␀shader_type canvas_item;
#include "res://night.gdshaderinc"
// The hill's top was one flat lime colour in its picture: lay the village's own grass there instead (the ground's
// n2_codai texture with the same wild recolour, in world space so it joins the ground's grain), a little darker and
// drier towards the edge where the soil is thin, the rim band as the earth-and-grass lip of the cliff.
// Mask n/hilltop.webp (tools/fallrock.py): R top, G rim band, B distance in from the edge, A cover. 2 samplers.
uniform sampler2D uCodai : repeat_enable, filter_linear_mipmap;
uniform vec3 gW = vec3(1.06);
uniform vec3 oW = vec3(0.1700, 0.2650, 0.0920);
uniform float tS = 281.6;
varying vec2 wp;
void vertex() { wp = (MODEL_MATRIX * vec4(VERTEX, 0.0, 1.0)).xy; }
float hh(vec2 p) { return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453); }
float vno(vec2 p) { vec2 i = floor(p), f = p - i; f = f * f * (3.0 - 2.0 * f);
	float a = hh(i), b = hh(i + vec2(1.0, 0.0)), c = hh(i + vec2(0.0, 1.0)), d = hh(i + vec2(1.0, 1.0));
	return a + (b - a) * f.x + (c - a) * f.y + (a - b - c + d) * f.x * f.y; }
// (n15, Link "thÃ¡c ... logic hÆ¡n"): the fall needs water up here. A spring comes out from under the rock at the back
// right, runs as a little brook and gathers in a pool right behind the notch, which spills over the lip.
// Distances on the ground plane (y doubled: iso).
float seg(vec2 p, vec2 a, vec2 b) { vec2 ab = b - a; float t = clamp(dot(p - a, ab) / dot(ab, ab), 0.0, 1.0); return length(p - a - ab * t); }
const vec2 BK[5] = vec2[](vec2(4684.0, 262.0), vec2(4670.0, 268.5), vec2(4655.0, 274.0), vec2(4641.0, 279.0), vec2(4628.0, 284.0));
vec3 spring(vec2 w) {   // x: signed distance to the water's edge (plane units, < 0 in the water), yz: flow direction (screen)
	vec2 q = vec2(w.x, w.y * 2.0);
	vec2 pc = vec2(4624.0, 285.5 * 2.0);
	vec2 pr = vec2(23.0, 17.0);
	float dp = (length((q - pc) / pr) - 1.0) * min(pr.x, pr.y);
	float db = 1e3; vec2 fd = vec2(-0.9, 0.45);
	for (int k = 0; k < 0; k++) {   // (n16, Link: no channel cut across the top - the pool is a spring, wells up in place)
		vec2 a = BK[k] * vec2(1.0, 2.0), b = BK[k + 1] * vec2(1.0, 2.0);
		float wd = mix(2.6, 5.0, float(k) / 3.0);
		float d = seg(q, a, b) - wd;
		if (d < db) { db = d; fd = normalize(BK[k + 1] - BK[k]); }
	}
	float k2 = 5.0, hgap = clamp(0.5 + 0.5 * (db - dp) / k2, 0.0, 1.0);
	float d = mix(db, dp, hgap) - k2 * hgap * (1.0 - hgap);
	d += (vno(w * 0.35) - 0.5) * 2.6 + (vno(w * 1.1 + 5.0) - 0.5) * 0.9;
	vec2 dir = mix(fd, vec2(0.0, 1.0), hgap);
	return vec3(d, dir);
}
void fragment() {
	vec4 m = texture(TEXTURE, UV);
	if (m.a < 0.004) discard;
	vec3 g = texture(uCodai, wp / tS).rgb * gW + oW;
	float n = vno(wp * 0.06) * 0.6 + vno(wp * 0.17 + 3.0) * 0.4;
	float ed = smoothstep(0.0, 0.6, m.b);
	// thin, drier turf near the edge, patchy
	g = mix(g, g * vec3(1.06, 1.0, 0.82), (1.0 - ed) * 0.22 * smoothstep(0.3, 0.7, n));
	g *= 1.0 + 0.04 * ed + 0.05 * (n - 0.5);
	// the lip: grass hanging over a strip of dark earth
	float lipN = vno(vec2(wp.x * 0.5, wp.y * 0.2));
	vec3 earth = mix(vec3(0.30, 0.24, 0.16), vec3(0.42, 0.34, 0.22), lipN);
	vec3 lip = mix(earth, g * 0.78, smoothstep(0.35, 0.65, lipN + 0.25 * (UV.y - 0.5)));
	vec3 c = mix(g, lip, m.g);
	// the notch's two stones were flat grey faces: wet rock with layers, cracks, dark streaks where water runs, moss
	if (m.r + m.g < 0.04) {
		float L = m.b;
		float lay = vno(vec2(wp.x * 0.15, wp.y * 1.1)) * 0.6 + vno(vec2(wp.x * 0.5, wp.y * 2.6) + 4.0) * 0.4;
		float ck = 1.0 - smoothstep(0.0, 0.06, abs(vno(vec2(wp.x * 0.35 + 9.0, wp.y * 0.9)) - 0.5));
		float wet = smoothstep(0.45, 0.75, vno(vec2(wp.x * 0.9, wp.y * 0.08) + 2.0));
		vec3 rk = mix(vec3(0.33, 0.32, 0.29), vec3(0.56, 0.53, 0.48), lay);
		rk *= 0.5 + 0.75 * L;
		rk *= 1.0 - 0.35 * ck - 0.3 * wet;
		float ms = smoothstep(0.68, 0.8, vno(wp * 0.7 + 11.0)) * (1.0 - wet);
		rk = mix(rk, vec3(0.30, 0.38, 0.17), ms * 0.6);
		c = rk;
	}
	if (m.r > 0.3) {
		vec3 sp = spring(wp);
		float d = sp.x;
		if (d < 4.5) {
			float t = TIME;
			// bank: wet dark earth under a lip of lush grass
			float lipN = vno(wp * 0.9 + 3.0);
			vec3 bank = mix(vec3(0.20, 0.17, 0.11), vec3(0.30, 0.25, 0.16), vno(wp * 0.5));
			float bk = (1.0 - smoothstep(0.5 + 0.8 * lipN, 1.4 + 0.8 * lipN, d)) * 0.8;   // a thin wet edge, grass right to the water
			vec3 cg = mix(c, c * vec3(0.82, 0.9, 0.8), 1.0 - smoothstep(2.0, 4.5, d));
			c = mix(cg, bank, bk);
			if (d < 0.6) {
				vec2 fd = sp.yz;
				vec2 fn = vec2(-fd.y, fd.x);
				float al = dot(wp, fd), ac = dot(wp, fn);
				float deep = smoothstep(0.0, 9.0, -d);
				vec3 wc = mix(vec3(0.40, 0.56, 0.44), vec3(0.24, 0.48, 0.48), deep);
				// (n16c) a clear shallow spring: its pebbly bottom shows through, not a dark bowl
				float pb = vno(wp * 1.6 + 3.0) * 0.6 + vno(wp * 3.7) * 0.4;
				wc *= 0.86 + 0.24 * pb;
				float r1 = vno(vec2(al * 0.22 - t * 1.6, ac * 0.7)), r2 = vno(vec2(al * 0.4 - t * 2.4, ac * 1.1) + 7.0);
				wc *= 0.92 + 0.16 * (r1 * 0.6 + r2 * 0.4);
				float sky = smoothstep(0.6, 0.85, r1 * r2 * 1.7);
				wc = mix(wc, vec3(0.72, 0.88, 0.86), 0.35 * sky);
				float glint = smoothstep(0.93, 0.98, vno(vec2(al * 0.9 - t * 3.0, ac * 2.2) + 3.0)) * deep;
				wc = mix(wc, vec3(1.0, 1.0, 0.95), 0.6 * glint);
				// pale bubbles where the spring wells up
				float sw = 1.0 - smoothstep(0.0, 7.0, length((wp - vec2(4627.0, 283.0)) * vec2(1.0, 2.0)) * 0.6);
				wc = mix(wc, vec3(0.85, 0.94, 0.92), sw * smoothstep(0.55, 0.75, vno(wp * 1.4 + vec2(0.0, -t * 2.0))) * 0.6);
				// darker band right under the bank, a thin pale edge line
				wc *= 1.0 - 0.12 * (1.0 - smoothstep(-2.5, 0.0, d)) * smoothstep(-0.2, -1.5, d);
				float a = smoothstep(0.6, -0.4, d);
				c = mix(c, wc, a);
				c = mix(c, vec3(0.75, 0.86, 0.80), 0.35 * (1.0 - smoothstep(0.0, 0.5, abs(d + 0.5))));
			}
			// (n16c) the spring's rim is a ring of mossy stones half in the water, not a bare dark bowl
			if (d > -1.6 && d < 2.8) {
				vec2 q = vec2(wp.x, wp.y * 2.0) / 2.8;
				vec2 ci = floor(q), cf = q - ci;
				float best = 9.0; vec2 bo = vec2(0.0); vec2 bid = vec2(0.0);
				for (int j = -1; j <= 1; j++) for (int i = -1; i <= 1; i++) {
					vec2 id = ci + vec2(float(i), float(j));
					vec2 o = vec2(float(i), float(j)) + 0.25 + 0.5 * vec2(hh(id + 1.0), hh(id + 2.0)) - cf;
					float rr = 0.42 + 0.2 * hh(id + 3.0);
					float e = length(o) / rr;
					if (e < best && hh(id + 5.0) > 0.45) { best = e; bo = o / rr; bid = id; }
				}
				float band = smoothstep(-1.6, -0.6, d) * (1.0 - smoothstep(1.8, 2.8, d));
				float sa = clamp((1.0 - best) * 6.0, 0.0, 1.0) * band;
				if (sa > 0.0) {
					vec3 st = mix(vec3(0.40, 0.39, 0.35), vec3(0.60, 0.57, 0.50), hh(bid + 4.0));
					st *= 1.12 - 0.45 * smoothstep(-0.7, 0.8, -bo.y) * 0.0 - 0.4 * smoothstep(-0.5, 0.9, bo.y);
					st = mix(st, vec3(0.30, 0.38, 0.17), 0.45 * smoothstep(0.62, 0.8, vno(wp * 0.9 + bid)) * smoothstep(0.2, -0.6, bo.y));
					st *= mix(0.72, 1.0, smoothstep(-0.8, 0.8, d));   // wet low down
					c = mix(c * (1.0 - 0.3 * clamp((1.3 - length(bo - vec2(0.0, 0.35))) * 3.0, 0.0, 1.0) * band), st, sa);
				}
			}
		}
	}
	COLOR = vec4(night_col(c), m.a);
}
␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀// Ban Ä‘Ãªm, shared by every village shader: the game's night colours as one formula of the day colour (no extra pass,
// no texture). Fitted (least squares, 2nd order in r g b) from the web game's own day and night captures of the same
// views (tools/nightfit.py); mean error ~4/255. uNight 0 = day, 1 = night (main._night_tick sets it on every material).
uniform float uNight = 0.0;
vec3 night_col(vec3 c) {
	// (b54, Link 11-13 19:51 web vs Godot night screenshots: Godot was about half as bright as the web) the web's night is
	// the day picture a little darker and bluer: the godot/ export night frames are day x (0.64 0.68 0.80) on average,
	// the web's night field is day x (0.52 0.66 0.69); one per-channel factor between the two
	if (uNight <= 0.0) return c;
	return mix(c, c * vec3(0.60, 0.68, 0.78), uNight);
}
␀␀␀␀␀␀shader_type canvas_item;
#include "res://night.gdshaderinc"
#include "res://rain.gdshaderinc"
// Ponds, the canal and the brook get the RIVER's water (water.gdshader v5, Link 2026-11-12 "hiá»‡u á»©ng nÆ°á»›c nhÆ° sÃ´ng
// Ä‘Ã¢u"): the same layered wave field from the noise map, gusts, sky in the wave faces, sun glitter, the light web in the
// shallows and the white flecks riding the current. Body colour = the game's pond shade map (as ground.gdshader pond()),
// so the water keeps the ponds' own colour. Drawn over the ground (z -38): fades in from the shore so the ground's
// rim, mud film and the far bank's earth face stay; under the tree reflections, hanging grass and the mats.
// The brook flows down its centre line (FLW), ponds and the canal only drift. 4 samplers.
uniform sampler2D uPF : filter_linear, repeat_disable;
uniform vec4 uPB; uniform vec2 uKH;
uniform sampler2D uN : filter_linear_mipmap, repeat_enable;
uniform sampler2D uTC : filter_nearest, repeat_disable;
uniform vec2 uT0;
uniform vec3 pMid; uniform vec3 pMudS; uniform vec3 pDpc; uniform vec3 pSky; uniform vec3 pBand;
uniform vec4 uK = vec4(520., .22, 120., .75);
uniform vec3 uG = vec3(190., 1.1, .12);
uniform vec3 uV = vec3(360., 14., .2);
uniform vec3 uGain = vec3(0.88, 0.914, 0.916);
varying vec2 wpos;
void vertex() { wpos = (MODEL_MATRIX * vec4(VERTEX, 0.0, 1.0)).xy; }
vec2 s2g(vec2 w) { vec2 d = w - uKH; float a = d.x / 32.0, b = d.y / 16.0; return vec2((a + b) * 0.5, (b - a) * 0.5); }
vec4 PFg(vec2 g) {
	vec2 uv = (g - uPB.xy) * 4.0 / uPB.zw;
	if (uv.x < 0.0 || uv.y < 0.0 || uv.x > 1.0 || uv.y > 1.0) return vec4(-0.1, -0.1, -0.1, 0.0);
	return (texture(uPF, uv) * 255.0 - 20.0) / 200.0;
}
vec4 PF(vec2 w) { return PFg(s2g(w)); }
float sst(float a, float b, float x) { float t = clamp((x - a) / (b - a), 0.0, 1.0); return t * t * (3.0 - 2.0 * t); }
float hh(vec2 p) { return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453); }
float vno(vec2 p) { vec2 i = floor(p), f = p - i; f = f * f * (3.0 - 2.0 * f);
	float a = hh(i), b = hh(i + vec2(1.0, 0.0)), c = hh(i + vec2(0.0, 1.0)), d = hh(i + vec2(1.0, 1.0));
	return a + (b - a) * f.x + (c - a) * f.y + (a - b - c + d) * f.x * f.y; }
const vec2 FLW[15] = vec2[](vec2(-7.6, -18.4), vec2(-7.1, -17.2), vec2(-6.5, -15.6), vec2(-5.6, -14.5), vec2(-5.5, -13.5),
	vec2(-5.6, -12.5), vec2(-6.5, -11.5), vec2(-7.5, -10.5), vec2(-7.5, -9.5), vec2(-7.5, -8.5), vec2(-7.6, -7.5),
	vec2(-8.5, -6.5), vec2(-9.5, -5.5), vec2(-9.5, -4.5), vec2(-9.6, -3.4));
vec3 brookAt(vec2 g) {
	float best = 1e9; vec2 dsum = vec2(0.0); float wsum = 0.0;
	for (int k = 0; k < 14; k++) {
		vec2 a = FLW[k], b = FLW[k + 1], ab = b - a;
		float t = clamp(dot(g - a, ab) / dot(ab, ab), 0.0, 1.0);
		float d = length(g - a - ab * t);
		best = min(best, d);
		vec2 sd = vec2((ab.x - ab.y) * 32.0, (ab.x + ab.y) * 16.0);
		float wt = exp(-d * d * 2.0);
		dsum += normalize(sd) * wt; wsum += wt;
	}
	vec2 fd = wsum > 1e-4 ? normalize(dsum) : vec2(0.0, 1.0);
	return vec3(1.0 - smoothstep(1.3, 2.0, best), fd);
}
vec2 nrm(vec2 q) { return texture(uN, q).xy * 2. - 1.; }
float hgt(vec2 q) { return texture(uN, q).z; }
vec3 lay(vec2 x, float th, float lam, float asp, float spd, float t, vec2 off) {
	float c = cos(th), s = sin(th);
	vec2 du = vec2(c, s) / lam, dv = vec2(-s, c) / (lam * asp);
	vec2 xx = x - vec2(c, s) * spd * t;
	vec2 uv = vec2(dot(xx, du), dot(xx, dv)) + off;
	vec3 tx = texture(uN, uv).xyz;
	float k = 2. * tx.z - 1., a = sqrt(k * k + .006);
	vec2 g = (k / a) * 2. * (tx.xy * 2. - 1.);
	return vec3(1. - a, g.x * du + g.y * dv);
}
vec3 HG(vec2 x, float t) {
	vec3 r = lay(x, .66, 520., 2.6, 55., t, vec2(0.)) + .7 * lay(x, 1.08, 300., 2.2, 42., t, vec2(.37, .11))
		+ .45 * lay(x, .21, 170., 2., 34., t, vec2(.71, .53)) + .25 * lay(x, -.52, 95., 1.6, 25., t, vec2(.13, .83));
	return r / 2.4;
}
void fragment() {
	vec2 g = s2g(wpos);
	vec4 f = PFg(g);
	if (f.x < 0.47) discard;
	const float e = 1.5;
	float gx = (PF(wpos + vec2(e, 0.0)).x - PF(wpos - vec2(e, 0.0)).x) / (2.0 * e);
	float gy = (PF(wpos + vec2(0.0, e)).x - PF(wpos - vec2(0.0, e)).x) / (2.0 * e);
	float gl = max(sqrt(gx * gx + gy * gy), 1e-4);
	float dF = (f.x - 0.5) / gl;                  // world px from the shore
	vec2 nn = vec2(gx, gy) / gl;
	float far = clamp((nn.y - 0.25) * 1.6, 0.0, 1.0), nb = 1.0 - smoothstep(0.3, 0.4, far);
	// (n16) the water starts right at the shore, crisp; the banks (pondriver.gd) lie over its edge
	float px = max(fwidth(dF), 1e-3);
	float cov = clamp(dF / px + 0.5, 0.0, 1.0);
	if (cov <= 0.0) discard;
	// the game's pond shade map: darker under the far bank, the muddy bottom by the near one, sky in the middle
	float sky = sst(0.45, 0.95, f.w);
	float fr = sst(0.62, 0.3, PFg(g - 0.2).x) * 0.55 + sst(0.62, 0.3, PFg(g - 0.42).x) * 0.45;
	float rn = vno(vec2(g.x * 0.8 + 3.3, g.y * 1.6 + 1.1)) * 0.6 + vno(vec2(g.x * 2.1 + 7.0, g.y * 0.9 + 2.0)) * 0.4;
	vec3 body = pMid + (pDpc - pMid) * 0.32 * (1.0 - sky);
	body += (pSky - body) * 0.42 * sky;
	// (n16, Link "váº«n má»": no pale muddy shallows along the near bank - that was the haze)
	body += (pBand - body) * 0.62 * fr;
	body *= 1.0 + 0.07 * (rn - 0.5);
	// the river's wave field: the brook runs down its line, still water only drifts
	vec3 bk = brookAt(g);
	// (n16, Link "máº¥y vÃ²ng trÃ²n gÃ¬ Ä‘Ã¢y"): one clock everywhere - a speed that changes from place to place shears the
	// waves into rings round the brook's mouth that grow denser with time. The brook runs by its flow offset only.
	float uT = TIME * 0.55;
	vec2 p = wpos * 4.2;
	float d = dF * 3.0;
	vec2 dir = normalize(mix(vec2(0.62, 0.78), bk.yz, bk.x));
	vec2 q = vec2(p.x, p.y * 2.), dq = normalize(vec2(dir.x, dir.y * 2.));
	float fo = nb;
	float deep = mix(smoothstep(0., 150., d), 0.85, 0.35);
	float calm = 1.0;   // (n16, Link "váº«n má»": flatter waves by the shore mirrored more pale sky = a pale band; same waves right up to the bank)
	float ph = uT * .3, f0 = fract(ph), f1 = fract(ph + .5), w0 = 1. - abs(2. * f0 - 1.);
	float L = uV.x * mix(0.12, 1.0, bk.x) * mix(.35, 1., deep);
	vec2 a0 = q - dq * f0 * L, a1 = q - dq * f1 * L + vec2(91., 37.);
	mat2 R1 = mat2(vec2(.80, .60), vec2(-.60, .80)), R2 = mat2(vec2(.34, -.94), vec2(.94, .34));
	vec2 wq = (nrm(a0 / 430.) * w0 + nrm(a1 / 430.) * (1. - w0)) * uV.y + nrm(R2 * q / 173.) * uV.y * .35;
	vec2 dr = vec2(.707, .707) * uT;
	float gust = mix(.6, 1.0, hgt(R1 * (q - dr * 40.) / 1100.)) * calm;
	vec2 x = q + wq; vec3 hg = HG(x, uT); float h0 = hg.x;
	vec3 N = normalize(vec3(hg.yz * uK.x * gust, 1.));
	body *= 1. + (h0 - .6) * uK.y * gust;
	vec3 V = normalize(vec3(0., .55, .83)), Rr = reflect(-V, N);
	vec3 env = mix(vec3(.13, .32, .22), vec3(.78, .93, .89), smoothstep(.55, .95, Rr.z));
	vec3 w = mix(body, env, uV.z);
	float sh = (1. - smoothstep(8., 130., d)) * smoothstep(1., 10., d) * (.35 + .65 * fo);
	float cw = lay(x * 1.7, 1.9, 260., 1., 30., uT, vec2(.4, .2)).x * lay(x * 1.7, .3, 330., 1., 24., uT, vec2(.9, .6)).x;
	w += vec3(.95, 1., .9) * smoothstep(.62, .9, cw) * .06 * sh;
	vec3 Ld = normalize(vec3(-.45, -.55, .70)); float sd = max(dot(Rr, Ld), 0.);
	float tw = .5 + hgt(R2 * q / 11. + uT * vec2(.9, .6));
	w += vec3(1., .98, .9) * (pow(sd, uG.x) * uG.y * tw + pow(sd, 24.) * .10) * mix(.5, 1., deep);
	float fk = smoothstep(.70, .80, hgt(a0 / 41.)) * smoothstep(.56, .74, hgt(R1 * a0 / 290. + .5)) * w0
		+ smoothstep(.70, .80, hgt(a1 / 41.)) * smoothstep(.56, .74, hgt(R1 * a1 / 290. + .5)) * (1. - w0);
	w = mix(w, vec3(.90, .94, .90), fk * mix(uG.z, uG.z * 1.4, bk.x) * deep);
	w *= uGain;
	// water on a lot not bought yet: the game's dull wash (as the ground does)
	vec2 lq = g - 0.5 - uT0, l0 = floor(lq), lf = lq - l0;
	float k00 = float((int(texelFetch(uTC, ivec2(l0), 0).a * 255.0 + 0.5) & 2) != 0);
	float k10 = float((int(texelFetch(uTC, ivec2(l0) + ivec2(1, 0), 0).a * 255.0 + 0.5) & 2) != 0);
	float k01 = float((int(texelFetch(uTC, ivec2(l0) + ivec2(0, 1), 0).a * 255.0 + 0.5) & 2) != 0);
	float k11 = float((int(texelFetch(uTC, ivec2(l0) + ivec2(1, 1), 0).a * 255.0 + 0.5) & 2) != 0);
	float lk = mix(mix(k00, k10, lf.x), mix(k01, k11, lf.x), lf.y);
	// (unbought-lot wash off, Link 2026-11-12)
	w = mix(w, vec3(1.), rain_rings(wpos) * .55);
	COLOR = vec4(night_col(w), cov);
}
␀␀␀␀␀␀␀␀␀␀␀␀␀␀// mÆ°a: vÃ²ng gá»£n trÃªn máº·t nÆ°á»›c, chÃ©p web nuocgl (rain rings, flat on the ground = iso ellipses in tile space)
// uRain = lÆ°á»£ng mÆ°a (web oj: mÆ°a .7, giÃ´ng 1) x Ä‘á»™ zoom (web zf = smoothstep(.3,.75,zoom)), main.gd Ä‘áº·t
uniform float uRain = 0.0;
float rh21(vec2 p) { p = fract(p * vec2(123.34, 456.21)); p += dot(p, p + 45.32); return fract(p.x * p.y); }
float rain_rings(vec2 w) {
	if (uRain <= 0.0) return 0.0;
	vec2 d = w - vec2(4268.0, 968.0);
	float ga = d.x / 32.0, gb = d.y / 16.0;
	vec2 g = vec2((ga + gb) * 0.5, (gb - ga) * 0.5) * 3.0;
	float tt = TIME, rr = 0.0;
	for (int j = 0; j < 2; j++) {
		vec2 off = vec2(float(j) * 0.5);
		vec2 c2 = floor(g + off), ff = fract(g + off);
		vec2 c0 = 0.5 + (vec2(rh21(c2), rh21(c2 + 7.1)) - 0.5) * 0.5;
		float ph = fract(tt * 0.9 + rh21(c2 + 3.3));
		float dd = length(ff - c0);
		rr += smoothstep(0.06, 0.0, abs(dd - ph * 0.42)) * (1.0 - ph) * step(0.3, rh21(c2 + 1.7));
	}
	return min(rr * uRain, 1.0);
}
shader_type canvas_item;
#include "res://night.gdshaderinc"
// Tree reflections: every scenery picture standing at the water's edge is drawn again upside down under its foot
// (main.gd _build_refl), only where the river is (uA distance-to-shore > 0), swaying with the ripples, darker and
// tinted by the water, fading towards the crown. 2 samplers (the picture + the river map).
uniform sampler2D uA : filter_linear, repeat_disable;   // the river map: G = distance to the shore
uniform vec4 uMap;
uniform sampler2D uF : filter_linear, repeat_disable;   // nÆ°á»›c ná»•i map (R: signed distance to the flood's edge)
uniform float uFlood = 0.;
uniform float uPond = 0.;   // 1: the ponds / canal / creek set, clipped to the pond field instead of the river map
uniform sampler2D uPF : filter_linear, repeat_disable;
uniform vec4 uPB;
uniform vec2 uKH;
float fF(vec2 w) {
	vec2 d = w - uKH; float a = d.x / 32.0, b = d.y / 16.0;
	vec2 uv = (vec2((a + b) * 0.5, (b - a) * 0.5) - uPB.xy) * 4.0 / uPB.zw;
	if (uv.x < 0.0 || uv.y < 0.0 || uv.x > 1.0 || uv.y > 1.0) return 0.0;
	return (texture(uPF, uv).r * 255.0 - 20.0) / 200.0;
}
uniform vec3 uTint = vec3(.165, .306, .267);   // the game's reflection tint #2a4e44
uniform float uAlpha = .3;   // the game draws them at .3 over the GL water
varying vec2 wp;
void vertex() { wp = (MODEL_MATRIX * vec4(VERTEX, 0.0, 1.0)).xy; }
void fragment() {
	vec2 muv = (wp - uMap.xy) / uMap.zw;
	float wm;
	if (uPond > .5) wm = smoothstep(.5, .58, fF(wp));
	else wm = smoothstep(.5, 3., texture(uA, muv).g * 255.);
	if (uFlood > .5 && uPond < .5) wm = max(wm, smoothstep(0., 3., (texture(uF, muv).r * 255. - 128.) * .25));
	if (wm <= 0.) discard;
	float t = TIME;
	float wob = sin(wp.y * .55 + t * 2.4 + sin(wp.x * .031 + t * .7) * 2.) * 1.3 + sin(wp.y * .21 - t * 1.3) * .8;
	vec4 c = texture(TEXTURE, UV + vec2(wob, 0.) * TEXTURE_PIXEL_SIZE * 6.);   // pictures are 6 px a world px
	float depth = 1. - UV.y;   // 0 at the foot (the waterline), 1 at the crown (deepest)
	// like the game: fades away towards the crown (1 -> .88 at 30 % -> .12), thin breaks across it where the surface moves
	float fade = depth < .3 ? mix(1., .88, depth / .3) : mix(.88, .12, (depth - .3) / .7);
	float yy = wp.y / 5.5 + sin(wp.x * .02 + t * .5) * .15;
	float cy = floor(yy);
	float h1 = fract(sin(cy * 12.9898) * 43758.547), h2 = fract(sin(cy * 78.233) * 12543.31);
	float cut = step(fract(yy), .1 + .06 * h2) * step(fract(wp.x / (70. + 60. * h2) + h1 + t * .02), .2 + .5 * h1);
	float a = c.a * uAlpha * fade * (1. - .6 * cut) * wm;
	COLOR = vec4(night_col(mix(c.rgb, uTint, .42)), a);
}
␀shader_type canvas_item;
#include "res://night.gdshaderinc"
// every plain picture of the village (scenery, objects, verges, pond and bank plants, the sky), then the night colours.
// One shared material, so the pictures still batch.
// Sharpness (Link 11-12 "váº«n má»"): a picture drawn smaller than its pixels was shrunk by one bilinear lookup (or a
// box-filtered mip), which washes out the thin dark outlines. The web game's canvas shrinks with a sharp filter. Here
// each screen pixel averages its own footprint on the picture (2x2 taps spread over it, no aliasing), then a Lanczos-
// like lift (footprint average minus a wider average) brings the edges and outlines back to full contrast.
varying vec4 vmod;
const float SHARP = 0.6;
uniform float uSway = 0.0;
uniform float uFast = 0.0;   // test ?do2 only: plain lookup, to measure what the sharp filter costs   // 1 while the web would sway plants (zoom >= .7)
void vertex() {
	vmod = COLOR;
	if (COLOR.a > 0.993 && COLOR.a < 0.998) {   // a swaying plant (alpha 254/255): local origin = its foot
		vmod.a = 1.0;
		if (uSway > 0.0) {
			// web: rotate(sin(t*1.1 + ph) * .017) about the foot; ph from the plant's place, so neighbours move apart
			vec2 wo = MODEL_MATRIX[3].xy;
			float ph = fract(sin(dot(floor(wo), vec2(12.9898, 78.233))) * 43758.5453) * 6.2832;
			float a = sin(TIME * 1.1 + ph) * 0.017;
			float c = cos(a), s = sin(a);
			VERTEX = vec2(c * VERTEX.x - s * VERTEX.y, s * VERTEX.x + c * VERTEX.y);
		}
	}
}
vec4 box4(sampler2D t, vec2 uv, vec2 ax, vec2 ay, float lod) {
	return 0.25 * (textureLod(t, uv + ax + ay, lod) + textureLod(t, uv - ax + ay, lod)
		+ textureLod(t, uv + ax - ay, lod) + textureLod(t, uv - ax - ay, lod));
}
void fragment() {
	vec2 ts = vec2(textureSize(TEXTURE, 0));
	vec2 dx = dFdx(UV), dy = dFdy(UV);
	float d = max(length(dx * ts), length(dy * ts));   // picture pixels per screen pixel
	vec4 c;
	if (d <= 1.05 || uFast > 0.5) {
		c = texture(TEXTURE, UV, -1.0);
	} else {
		float lod = max(0.0, log2(d * 0.5));            // each bilinear tap then covers half the footprint
		vec4 a = box4(TEXTURE, UV, dx * 0.25, dy * 0.25, lod);
		vec4 w = box4(TEXTURE, UV, dx * 0.75, dy * 0.75, lod);
		// lift only where the picture is solid, so cut-out edges get no halo
		float k = SHARP * clamp(min(a.a, w.a) * 1.25 - 0.25, 0.0, 1.0);
		c = vec4(clamp(a.rgb + (a.rgb - w.rgb) * k, 0.0, 1.0), a.a);
	}
	c *= vmod;
	c.rgb = night_col(c.rgb);
	COLOR = c;
}
␀␀␀␀␀␀␀␀␀␀␀shader_type canvas_item;
#include "res://night.gdshaderinc"
// footpaths (web NEN2 tracks()): the yard's earth (n2_dat recoloured C.yard, the ground's own uRA layer 8), world-space
uniform sampler2DArray uRA : repeat_enable, filter_linear_mipmap;
uniform vec3 gY = vec3(1.0173, 1.0118, 1.0097);
uniform vec3 oY = vec3(0.0129, 0.0074, 0.0044);
uniform float tY = 153.6;
uniform float uWet = 0.0;
varying vec2 wpos;
void vertex() { wpos = (MODEL_MATRIX * vec4(VERTEX, 0.0, 1.0)).xy; }
void fragment() {
	vec3 c = clamp(texture(uRA, vec3(wpos / tY, 8.0)).rgb * gY + oY, 0.0, 1.0);
	c = mix(c, pow(c, vec3(1.35)) * 0.9, uWet);
	COLOR = vec4(night_col(c), COLOR.a);
}
␀␀␀␀␀␀␀␀␀shader_type canvas_item;
#include "res://night.gdshaderinc"
#include "res://rain.gdshaderinc"
// River water v5 (song test page), ported. Drawn under the ground pieces; the river is a hole in them, so only the
// water shows here, and what stands over the water (boats, overhanging leaves, stakes) is in the pieces above.
// The shore is the river's own outline only: nothing standing in the water gets foam, shallows or rings.
// Works in "capture pixels" (3 per world unit) like the test page, so all the tuned numbers stay the same.
uniform sampler2D uA : filter_linear, repeat_disable;   // up/1020, dist/255, earth bank, near-tree shade
uniform sampler2D uB : filter_linear, repeat_disable;   // flow x, flow y, mirror weight, (unused)
uniform sampler2D uR : filter_linear, repeat_disable;   // the whole map, small (0.375 px/unit): what the far bank mirrors
uniform sampler2D uN : filter_linear_mipmap, repeat_enable; // tiling wave height + slope
uniform vec4 uMap;      // world x, y, w, h of uA/uB
uniform vec4 uRef;      // world x, y, w, h of uR
uniform vec3 uDeep;
uniform vec3 uShal;
uniform vec4 uK = vec4(900., .4, 120., .75);
uniform vec3 uG = vec3(190., 2.2, .3);
uniform vec3 uV = vec3(360., 22., .24);
uniform vec4 uDbg = vec4(1.);   // test switches: shallows, foam, mirror, light web
uniform vec3 uGain = vec3(1.);
// nÆ°á»›c ná»•i: the flood map (tools/floodmap.py; R = signed distance to the flood's edge, 128 + 4 per world px) and the switch
uniform sampler2D uF : filter_linear, repeat_disable;
uniform float uFlood = 0.;  // brings the average water colour onto the game's (measured: v5 came out lighter and greener)

varying vec2 wpos;
void vertex() { wpos = (MODEL_MATRIX * vec4(VERTEX, 0.0, 1.0)).xy; }

vec2 nrm(vec2 q) { return texture(uN, q).xy * 2. - 1.; }
float hgt(vec2 q) { return texture(uN, q).z; }
vec3 lay(vec2 x, float th, float lam, float asp, float spd, float t, vec2 off) {
	float c = cos(th), s = sin(th);
	vec2 du = vec2(c, s) / lam, dv = vec2(-s, c) / (lam * asp);
	vec2 xx = x - vec2(c, s) * spd * t;
	vec2 uv = vec2(dot(xx, du), dot(xx, dv)) + off;
	vec3 tx = texture(uN, uv).xyz;
	float k = 2. * tx.z - 1., a = sqrt(k * k + .006);
	vec2 g = (k / a) * 2. * (tx.xy * 2. - 1.);
	return vec3(1. - a, g.x * du + g.y * dv);
}
vec3 HG(vec2 x, float t) {
	vec3 r = lay(x, .66, 520., 2.6, 55., t, vec2(0.)) + .7 * lay(x, 1.08, 300., 2.2, 42., t, vec2(.37, .11))
		+ .45 * lay(x, .21, 170., 2., 34., t, vec2(.71, .53)) + .25 * lay(x, -.52, 95., 1.6, 25., t, vec2(.13, .83));
	return r / 2.4;
}
void fragment() {
	vec2 muv = (wpos - uMap.xy) / uMap.zw;
	if (muv.x < 0. || muv.y < 0. || muv.x > 1. || muv.y > 1.) discard;
	vec4 ax = texture(uA, muv);
	vec4 fz = texture(uB, muv);
	float d = ax.g * 255., rw = fz.b;
	float fd = -1.;
	if (uFlood > .5) fd = (texture(uF, muv).r * 255. - 128.) * .25;
	bool fland = d < .5 && rw < .01;
	if (fland && fd <= 0.) discard;     // land: nothing to draw (in the flood, land out of the flood's reach)
	float fcov = fland ? clamp(fd / max(fwidth(wpos.x), 1e-3) + .5, 0., 1.) : 1.;
	if (fland) { d = 40.; rw = 0.; }      // flooded land: open water, no far-bank mirror
	if (fd > 0.) { d = max(d, 40.); rw = 0.; }   // under the flood the old shore is gone: one sheet with the river, no far-bank shade
	float uT = TIME;
	vec2 p = wpos * 3.;                   // capture pixels
	float up = ax.r * 1020.;
	vec2 dir = normalize(fz.rg * 2. - 1. + 1e-4);
	vec2 q = vec2(p.x, p.y * 2.), dq = normalize(vec2(dir.x, dir.y * 2.));
	float fo = ax.b, sn = ax.a;
	if (fd > 0.) { fo = 0.; sn = 0.; }   // under the flood the old shore is no shore: no foam, no bed, no tree shade
	if (fland) up = 0.;
	float deep = smoothstep(0., 150., d); deep = mix(max(deep, .8), deep, fo);
	float calm = mix(.45, 1., smoothstep(2., 70., d));
	float ph = uT * .3, f0 = fract(ph), f1 = fract(ph + .5), w0 = 1. - abs(2. * f0 - 1.), L = uV.x * mix(.35, 1., deep);
	vec2 a0 = q - dq * f0 * L, a1 = q - dq * f1 * L + vec2(91., 37.);
	mat2 R1 = mat2(vec2(.80, .60), vec2(-.60, .80)), R2 = mat2(vec2(.34, -.94), vec2(.94, .34));
	vec2 wp = (nrm(a0 / 430.) * w0 + nrm(a1 / 430.) * (1. - w0)) * uV.y + nrm(R2 * q / 173.) * uV.y * .35;
	vec2 dr = vec2(.707, .707) * uT;
	float gust = mix(.55, 1.2, hgt(R1 * (q - dr * 40.) / 1100.)) * calm;
	vec2 x = q + wp; vec3 hg = HG(x, uT); float h0 = hg.x;
	vec3 N = normalize(vec3(hg.yz * uK.x * gust, 1.));
	vec3 body = mix(uShal, uDeep, deep);
	body *= 1. + (h0 - .6) * uK.y * gust;
	body *= mix(1., mix(.78, 1., smoothstep(0., 90., up)), rw) * (1. - .15 * sn);
	float bed = (1. - smoothstep(0., 34., d)) * fo;
	body = mix(body, vec3(.69, .85, .80) * (.92 + .16 * h0), bed * .5 * uDbg.x);
	vec3 V = normalize(vec3(0., .55, .83)), Rr = reflect(-V, N);
	vec3 env = mix(vec3(.13, .32, .22), vec3(.78, .93, .89), smoothstep(.55, .95, Rr.z));
	vec3 w = mix(body, env, uV.z);
	float rk = 0.; vec3 rc = vec3(0.);
	if (up > 0. && up < 520. && uDbg.z > .5) {   // the old captured mirror (off: trees now mirror themselves, refl.gdshader)
		float wob = N.x * (7. + up * .05) + sin(p.y * .42 + uT * 2.6 + N.y * 5.) * (1. + up * .012);
		for (int k = -1; k <= 1; k++) {
			vec2 rp = vec2(p.x + wob + float(k) * (1. + up * .008), p.y - 2. * up + N.y * (6. + up * .06));
			vec2 ruv = (rp / 3. - uRef.xy) / uRef.zw;
			if (ruv.y > 0.) { vec4 rr = texture(uR, ruv); rc += rr.rgb * rr.a / 3.; rk += rr.a / 3.; }
		}
		rk *= exp(-up / uK.z) * rw;
	}
	w = mix(w, rc * .66 + body * .2, uK.w * rk * uDbg.z);
	float sh = (1. - smoothstep(8., 130., d)) * smoothstep(1., 10., d) * (.35 + .65 * fo) * uDbg.w;
	float cw = lay(x * 1.7, 1.9, 260., 1., 30., uT, vec2(.4, .2)).x * lay(x * 1.7, .3, 330., 1., 24., uT, vec2(.9, .6)).x;
	w += vec3(.95, 1., .9) * smoothstep(.62, .9, cw) * .13 * sh * (1. - .6 * rk);
	vec3 Ld = normalize(vec3(-.45, -.55, .70)); float sd = max(dot(Rr, Ld), 0.);
	float tw = .5 + hgt(R2 * q / 11. + uT * vec2(.9, .6));
	w += vec3(1., .98, .9) * (pow(sd, uG.x) * uG.y * tw + pow(sd, 24.) * .10) * (1. - .75 * rk) * mix(.5, 1., deep);
	float fk = smoothstep(.70, .80, hgt(a0 / 41.)) * smoothstep(.56, .74, hgt(R1 * a0 / 290. + .5)) * w0
		+ smoothstep(.70, .80, hgt(a1 / 41.)) * smoothstep(.56, .74, hgt(R1 * a1 / 290. + .5)) * (1. - w0);
	w = mix(w, vec3(.90, .94, .90), fk * uG.z * deep);
	float lap = 1.6 + 1.3 * sin(uT * 1.25 + (p.x + p.y) * .014), br = hgt(q / 64. + uT * .012);
	float foam = (1. - smoothstep(0., 3. + lap + br * 4., d)) * (.25 + .6 * br);
	float band = smoothstep(.72, 1., sin(d * .42 + uT * 2.4 + br * 5.)) * (1. - smoothstep(5., 24., d)) * smoothstep(.5, 3., d);
	foam = max(foam, band * .45 * (.4 + .6 * br)) * fo;
	w = mix(w, vec3(.90, .93, .87), foam * .75 * uDbg.y);
	w = mix(w, vec3(1.) / max(uGain, vec3(.01)), rain_rings(wpos) * .55);   // web: rr*.55 white
	COLOR = vec4(night_col(w * uGain), fland ? .94 * fcov : 1.);
}
