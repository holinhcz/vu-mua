n":["Nắng muốn cháy da luôn.","Nhớ tưới cây nghen, nắng hạn rồi."],"hoi":["Sắp tới ngày hội rồi đó!","Góp lễ cho đình chưa?"],"quan":["Quán cơm đầu xóm ngon lắm.","Trưa nay ra quán ăn cơm tấm hông?"],"ray":["Ngoài đồng có rầy đó, coi chừng.","Phun thuốc chưa? Rầy lên rồi."],"dem":["Tối rồi, về nghỉ thôi."]}␀␀␀␀␀␀{"ruong":["Lúa lên đều quá trời!","Tưới xong luống này nghỉ chút.","Sâu ở đâu ra hoài vậy nè!","Năm nay chắc trúng mùa!","Cấy lẹ lẹ còn về ăn cơm.","Đất này tốt ghê, cắm cây gì cũng lên."],"xuong":["Máy chạy êm ru!","Mẻ này thơm phức luôn!","Làm xong mẻ này đi ăn cơm.","Bà con đặt hàng quá trời.","Coi chừng khét nghen!"],"vuon":["Trái chín cây rồi nè!","Tưới gốc này cái đã.","Xoài năm nay sai trái ghê!","Con chim nào mổ trái vậy nè?"],"chan":["Ăn đi tụi bây!","Con heo này mập ghê!","Gà đẻ trứng rồi nè!","Đứng yên coi, cho ăn nè!"],"nha":["Ăn cơm chưa con?","Bữa nay trời đẹp ghê!","Tụi nhỏ đi học về chưa?","Chiều nay đi chợ hông?","Ủa, con Vện đi đâu rồi?","Nồi cá kho tộ thơm nức mũi!","Rảnh ghé nhà chơi nghen!"],"quan":["Cơm ngon quá trời!","Canh này nêm vừa ăn ghê.","Cho thêm chén nữa nghen!","Quán này phải ghé hoài.","No căng bụng rồi!","Nước mắm pha ngon ghê!"],"sap":["Rau tươi ghê!","Bớt chút đi cô ơi!","Mua về nấu canh chiều.","Trứng gà ta hả? Lấy chục!"],"go":{"hoicho":["Đi hội chợ thôi!","Tối nay sân đình vui lắm!"],"yte":["Đi khám bệnh chút.","Ra trạm xin thuốc."],"quan":["Đi ăn cơm tấm thôi!","Đói bụng quá trời!"],"sap":["Ra sạp mua rau.","Đi chợ chút nè."],"dinh":["Lên đình thắp nhang.","Cầu cho mưa thuận gió hòa."],"xom":["Qua nhà hàng xóm chơi.","Đi tám chuyện chút!"],"dong":["Ra đồng coi lúa.","Đi thăm ruộng nè."],"tham":["Ghé thăm nhà con nè!"],"back":["Về nhà nghỉ thôi.","Về nấu cơm chiều."]},"vui":["Hôm qua câu được con cá lóc bự lắm!","Con gà nhà ai chạy qua đây vậy?","Trời ơi, quên tắt bếp rồi!","Ai thấy cái nón lá của tui hông?","Tối nay đờn ca tài tử nghen!","Thằng Tèo lại trốn học đi thả diều!","Bữa nay ăn gì ta?"],"mua":["Mưa quá trời, khỏi tưới cây.","Đội nón vô kẻo ướt!","Mưa dầm thấm lâu ghê."],"han":["Nắng muốn cháy da luôn.","Nắng hạn, nhớ tưới cây nghen!"],"dem":["Tối rồi, về nghỉ thôi.","Trăng sáng ghê ta."],"sang":["Sáng sớm mát ghê!","Chào buổi sáng bà con!"],"hoi":["Sắp tới ngày hội rồi đó!","Góp lễ cho đình chưa?"],"ray":["Ngoài đồng có rầy đó, coi chừng!","Phun thuốc chưa? Rầy lên rồi."],"nuoc":["Nước nổi rồi, đi bắt cá linh!","Bông điên điển nở vàng sông rồi."]}␀␀␀␀␀␀␀[{"c":"chao","mo":"Ủa, bữa nay ghé sớm vậy? Bộ ruộng nhà {c} tự mọc lúa hả?","r":[["dua","Dạ, lúa nhà {c} biết tự lo rồi, {c} rảnh đi thăm xóm.","Ha ha, lúa gì ngoan dữ. Cho {x} mượn vài bụi về dạy lúa nhà {x} coi.","Lúa tự lo hả? Vậy cho {x} mượn vài bụi về dạy lúa nhà {x}, xạo là biết liền.",[["dua","Lúa nhà {c} mắc lắm, {x} trả bằng ly trà nha.","Ly trà thì có. Vô ngồi đi, cái miệng dẻo ghê.",""],["viec","Mượn thì không có, mà {c} chỉ {x} cách bón cho lúa lên đều.","Ờ, chỉ thì {x} nghe. Mà {x} cũng có mẹo riêng nè.","ke"],["ca","Lúa nhà {x} mà dạy được thì cỏ nhà {x} đã biết tự nhổ rồi.","Cỏ đó {x} để làm hàng rào, biết gì mà nói.",""]]],["viec","Dạ, {c} mới tưới xong, ghé coi ruộng nhà {x} sao.","Ruộng {x} thì lúa trổ đều, mà con chuột nó phá quá trời.","Coi thì coi, đừng có chỉ trỏ. Lúa trổ đều, chỉ có con chuột là phá.",[["viec","Chuột nhiều thì đặt bẫy tre, {c} đặt giùm cho.","Vậy hả, vậy {x} nhờ {c} một chuyện luôn.","nho"],["dua","Nuôi con mèo đi {x}, chuột nó sợ chạy hết.","Mèo nhà {x} với chuột là bạn nhậu đó {c}.",""],["hoi","Chuột phá vậy {x} có lỗ nhiều hông?","Lỗ thì hông, mà tức. Thôi có {c} hỏi là đỡ tức.",""]]],["ca","Dạ, {c} ghé coi {x} còn sống hông.","Còn, còn khỏe hơn {c} nữa đó.","Mới sáng sớm mà ăn nói vậy hả? Còn sống, còn khỏe hơn {c} nữa đó.",[["dua","Khỏe vậy mai {x} ra ruộng phụ {c} đi.","Phụ thì phụ, nhưng {c} bao cơm.",""],["le","Dạ {c} giỡn chơi, {x} khỏe là {c} mừng.","Ờ, {x} biết mà, giỡn thì giỡn vừa thôi.",""],["ca","Khỏe mà sao mặt {x} như mất sổ gạo vậy?","Mặt {x} vậy từ hồi sinh ra rồi. Thôi về đi.",""]]]]},{"c":"chao","mo":"Bữa nay giá phân bón lên nữa rồi đó {c}. Kiểu này làm ruộng nuôi tiệm phân chớ nuôi ai.","r":[["viec","Vậy mình ủ phân chuồng xài đi {x}, đỡ được khối.","Đó, có đứa biết tính. Mà ủ thì hôi lắm à nha.","Ủ phân thì hôi rình, {c} ủ đi, {x} không rảnh ngửi.",[["viec","Hôi mà ra tiền thì {c} chịu.","Được, mai {x} gom phân gà cho {c} một bao.","tang"],["dua","Hôi thì mình ủ sát nhà hàng xóm.","Ha ha, ác dữ. Mà hay à nha.",""],["hoi","Mà {x} có biết cách ủ cho mau hoai, đỡ hôi hông?","Biết chớ. Trộn tro bếp với chút rơm, đậy kỹ là xong.","ke"]]],["ca","Thì {x} trồng ít lại, khỏi bón.","Trồng ít thì lấy gì ăn, {c} nói như đúng rồi.","Ăn nói kiểu đó mà cũng làm ruộng được hả? Trồng ít thì lấy gì ăn?",[["dua","Thì ăn ké nhà {x} chớ sao.","Ăn ké thì phải rửa chén nghen.",""],["viec","Ý {c} là trồng ít mà trồng thứ có giá.","Ờ, vậy nghe còn lọt tai. Trồng ớt, trồng gừng coi bộ được.","ke"],["ca","Thì ăn cháo, cháo cũng no.","Thôi {c} về ăn cháo một mình đi.",""]]],["hoi","Giá lên vậy {x} có xoay xở nổi hông?","Xoay chớ sao. Nghèo quen rồi, nghèo thêm chút cũng vậy.","Hỏi chi, bộ {c} cho {x} mượn tiền hả? Nghèo quen rồi, nghèo thêm chút cũng vậy.",[["le","Tiền thì {c} không có, mà việc gì {c} phụ được thì {x} cứ nói.","Có, {x} đang kẹt món này, nhờ {c} nha.","nho"],["dua","Nghèo mà vui là được {x} ơi.","Vui cái gì, vui thì {c} lấy tiền vui đóng phân giùm {x}.",""],["viec","{C} có mớ phân dư, để {c} chia {x}.","Thiệt hả? Vậy {x} đổi lại cho {c} ít đồ nhà làm.","tang"]]]]},{"c":"chao","mo":"Hồi khuya con chó nhà {x} sủa cả đêm, chắc có trộm rình gà.","r":[["hoi","Mất con gà nào hông {x}?","Hông mất, mà {x} thức trắng đêm canh, giờ mắt như con cú.","Hỏi gà hoài, bộ {c} tính mua hả? Hông mất con nào, mà {x} thức trắng đêm canh.",[["viec","Để {c} làm cái chuồng gà chắc chắn, {x} khỏi thức.","Ờ, vậy được. Mà {x} thiếu đồ làm, {c} kiếm giùm nghen.","nho"],["dua","Chắc trộm thấy {x} thức nên sợ quá bỏ chạy.","Ha ha, thấy cái mặt {x} lúc ba giờ sáng ai mà không sợ.",""],["hoi","{X} có báo ấp hông?","Báo làm gì, ông trưởng ấp còn ngủ say hơn {x}.",""]]],["dua","Chắc con chó nó thấy ma chớ trộm đâu.","Ma gì, ma đói thì có. Mà nói vậy {x} nổi da gà nè.","Nói chuyện ma lúc này là {x} đuổi về đó. Ma gì, ma đói rình gà thì có.",[["dua","Ma đói thì {x} cúng nó nồi cháo gà.","Gà còn không đủ nuôi người, cúng ma cái gì.",""],["hoi","{X} có nghe ai trong xóm mất đồ hông?","Nghe nói nhà bên kia mất bao lúa. Ờ mà {c} nhớ khóa cửa đó.","ke"],["ca","Hay con chó nó sủa tại {x} ngáy to quá.","Nói ai ngáy? Về đi.",""]]],["viec","{X} gắn cái đèn ngoài chuồng đi, trộm sợ ánh sáng.","Ờ, ý hay. Mà đèn thì tốn điện, điện thì mắc.","Đèn đóm gì, điện mắc muốn chết.",[["viec","Gắn đèn dầu thôi {x}, rẻ mà sáng.","Ờ, vậy được. Bữa nào {x} cho {c} ít trứng gà để cảm ơn.","tang"],["dua","Vậy {x} ngồi canh luôn khỏi gắn đèn.","Canh thì {c} canh, {x} già rồi.",""],["ca","Tiếc điện mà không tiếc gà, {x} tính kỳ ghê.","{C} có tính hơn {x} đâu.",""]]]]},{"c":"chao","mo":"Thằng cháu {x} mới đậu đại học trên thành phố đó {c}. Cả xóm chưa đứa nào đậu.","r":[["khen","Trời, giỏi dữ! Nhà {x} đúng là có học.","Chớ sao, giống ông nội nó. Bữa nào nó về {x} đãi cả xóm.","Khen gì, nó giỏi chứ có phải {x} đâu. Mà bữa nào nó về {x} cũng đãi cả xóm.",[["khen","Đãi thì {c} qua phụ, nhà {x} làm gì cũng lớn.","Đó, nói vậy {x} ưng. Tới bữa đó {x} kêu {c}.","moi"],["hoi","Nó học ngành gì vậy {x}?","Nông nghiệp! Học xong về làm ruộng giỏi hơn {c}.","ke"],["ca","Lên thành phố rồi chắc nó hết muốn về.","Trù nó hả? Ăn nói vậy hả?",""]]],["viec","Học xong về làng mở trại giống là giàu luôn {x}.","Đó, {x} cũng nói vậy. Mà tiền học phí nghe muốn xỉu.","Mở trại thì tính sau, tiền học phí trước mắt còn muốn xỉu đây nè.",[["viec","Thiếu thì {c} phụ {x} bán ít đồ gom tiền.","Thiệt hả? Vậy {x} nhờ {c} chút việc.","pq"],["dua","Thì {x} bán bớt con heo chớ sao.","Heo nó nghe là nó trốn đó.",""],["hoi","Nhà mình tính sao cho nó học nổi {x}?","Thì gom góp, xóm giềng phụ chút đỉnh. {C} hỏi vậy {x} thấy thương.",""]]],["dua","Đậu đại học rồi thì nó hết thèm phụ {x} cắt lúa.","Ha ha, nó có phụ bao giờ đâu mà hết.","Nói gì kỳ vậy, nó ngoan lắm. Có điều… ờ, nó chưa phụ bữa nào.",[["dua","Vậy {c} phụ {x} thế nó.","Được, {c} còn siêng hơn nó. Vậy {x} nhờ {c} chuyện này nè.","nho"],["khen","Thôi nó học giỏi là nhà {x} có tiếng rồi.","Chớ sao. Cả xóm phải nể.",""],["ca","Học xong chắc nó làm ông này bà nọ, quên {x} luôn.","Nói vậy {x} buồn đó.",""]]]]},{"c":"chao","mo":"{X} mới mua cái tivi màn hình bự, coi đá banh đã gì đâu {c} ơi.","r":[["khen","Tivi bự vậy là nhất xóm rồi {x}!","Chớ sao! Tối nay qua coi chung, {x} nấu nồi chè.","Khen nghe giả trân quá. Mà thôi, tối nay qua coi chung, {x} nấu nồi chè.",[["khen","Tối {c} qua liền, kêu cả xóm qua luôn.","Ờ, kêu đi, cho người ta biết nhà {x} có tivi mới.","moi"],["dua","Tivi bự quá {x} coi muốn lé mắt.","Ha ha, lé thì lé, coi đã là được.",""],["viec","Mà tivi đó chắc tốn dữ lắm {x}.","Tốn thì tốn, sống mấy hồi. Mà {c} hỏi tiền làm chi?",""]]],["ca","Mua tivi bự mà nhà còn dột {x} ơi.","Dột thì {x} để cái thau, tivi thì phải bự.","Qua đây để chê hả? Dột thì để cái thau, tivi thì phải bự.",[["dua","Vậy coi đá banh mà nghe mưa nhỏ giọt cũng vui.","Ha ha, như ngồi sân vận động vậy.",""],["viec","Để {c} vá mái giùm, {x} kiếm đồ nghen.","Ờ, vậy được, {x} nhờ {c} luôn.","nho"],["ca","Tivi bự mà coi toàn phim bộ thì phí.","Phim bộ là nghệ thuật, {c} hiểu gì.",""]]],["hoi","Bữa nay đá trận nào vậy {x}?","Đội nhà đá với đội Thái, tối nay {x} hét banh nóc.","{C} có coi đâu mà hỏi. Đội nhà đá với đội Thái, tối nay {x} hét banh nóc.",[["dua","Hét nhỏ nhỏ thôi {x}, con chó nhà bên nó sợ.","Kệ nó, nó cũng phải yêu nước chớ.",""],["le","Tối {c} xin qua coi ké được hông {x}?","Được chớ, mà nhớ đem theo bịch đậu phộng.","moi"],["ca","Đội nhà đá thua là {x} khỏi ngủ.","Trù hoài à, về đi.",""]]]]},{"c":"chao","mo":"Mấy bữa nay con gà mái nhà {x} đẻ trứng đôi hoài, chắc trúng số.","r":[["dua","Trứng đôi là điềm giàu đó {x}, mua vé số liền đi.","Ha ha, mua rồi, trúng thì {x} chia {c} một nửa.","Vé số {x} lỡ mua rồi, mà nói trước, trúng là không chia ai hết.",[["dua","Trúng rồi nhớ mua cho {c} con trâu.","Trâu thì hơi mắc, cho {c} con gà mái đẻ trứng đôi.","tang"],["viec","Trúng hay không thì trứng đôi bán chợ cũng được giá hơn đó {x}.","Thiệt hả? Vậy {x} để dành bán. Mà nói nhỏ, {x} mê nhất món này nè.","ke"],["ca","Gà đẻ trứng đôi chắc tại {x} cho ăn nhiều quá, mập.","Gà mập vậy mới đẻ, còn {c} mập thì làm được gì?",""]]],["hoi","{X} cho gà ăn gì mà đẻ dữ vậy?","Lúa với cám, thêm chút rau muống. Bí quyết đó nghen.","Bí mật… thôi nói nhỏ: lúa với cám, thêm chút rau muống.",[["viec","Vậy {c} đổi {x} ít lúa lấy mớ trứng nha.","Được, đổi thì đổi, mà {x} cần ít đồ nữa.","nho"],["le","Dạ, {c} cảm ơn {x} chỉ, về {c} làm theo.","Ờ, còn mẹo này nữa, nói nhỏ thôi nghen.","ke"],["dua","Rau muống thì {c} cũng ăn mà có đẻ trứng đâu.","Ha ha, {c} mà đẻ trứng thì nổi tiếng rồi.",""]]],["khen","Gà nhà {x} đẹp nhất xóm luôn.","Đó, {c} có mắt nhìn. Con mái đó {x} cưng nhất.","Khen gà làm chi, bộ tính xin hả? Con mái đó {x} cưng nhất, đừng có mơ.",[["khen","Nuôi gà khéo vậy chắc trồng cây cũng khéo.","Khéo chớ, {x} mê nhất là món này nè.","ke"],["dua","Cưng vậy bữa nào {x} cho nó đi thi hoa hậu gà.","Ha ha, thi chắc đậu.",""],["ca","Đẹp vậy mà để chồn tha thì tiếc.","Trù {c} bị chồn tha trước.",""]]]]},{"c":"chao","mo":"Bà sui bên kia lại nói xấu nhà {x} nữa đó {c}. Nói {x} keo.","r":[["hoi","Bả nói vậy {x} có buồn hông?","Buồn gì, nghe hoài quen rồi. Mà tức thì có.","Hỏi chi, bộ {c} cũng thấy {x} keo hả? Buồn thì không, mà tức.",[["khen","Nhà {x} mà keo thì cả làng này keo hết.","Đó, nói vậy {x} mát ruột. Cầm nè, {x} cho.","tang"],["dua","Thôi {x} mời bả qua ăn một bữa cho bả hết nói.","Mời thì tốn, mà thôi cũng được. Bữa đó {c} qua ngồi chung cho {x} có đồng minh nghen.","moi"],["ca","Thì {x} keo thiệt mà.","Về đi.",""]]],["dua","Bả nói {x} keo thì {x} đãi bả nước lã cho đúng luôn.","Ha ha, ý hay! Nước lã thêm cục đá cho sang.","Giỡn hoài, {x} tức thiệt đó. Mà nước lã… nghe cũng đáng.",[["dua","Thêm cái bánh tráng cho bả nhai đỡ buồn.","Ha ha, {c} ác ghê, mà {x} thích.",""],["hoi","Hai nhà có chuyện gì mà căng vậy {x}?","Chuyện hồi đám cưới, lấy thiếu một mâm quả. Lớn chuyện ghê.","ke"],["le","Thôi {x} bỏ qua đi, nhà sui mà.","Ừ, {c} nói cũng phải.",""]]],["ca","Chắc bả rảnh quá nên mới đi nói.","Đúng! Rảnh thì đi cấy giùm {x} đi.","Nói vậy chớ {c} cũng rảnh có thua ai. Mà đúng, bả rảnh thì đi cấy giùm {x} đi.",[["dua","Vậy {x} giao ruộng cho bả làm luôn.","Ha ha, cho bả biết tay.",""],["viec","Mình sống tốt là bả hết nói {x}.","Ừ, mà {x} nhờ {c} chuyện này.","nho"],["ca","Hay tại {x} keo thiệt nên bả nói.","Thôi về, khỏi ở đây.",""]]]]},{"c":"chao","mo":"Bữa nay ra đồng thấy con rắn bự cỡ cổ tay, {x} chạy muốn rớt dép.","r":[["dua","Rắn nó thấy {x} chắc nó cũng chạy muốn rớt vảy.","Ha ha ha, cái đứa này. Mà thiệt, nó bự lắm.","Giỡn hoài, {x} sợ muốn chết. Con rắn đó bự thiệt chớ bộ.",[["viec","Rắn nhiều là ruộng nhiều chuột, phải bẫy chuột đi {x}.","Đó, đúng rồi. {C} phụ {x} đặt bẫy nha.","nho"],["hoi","Nó có cắn {x} hông?","Hông, nó bò mất tiêu. May dữ.",""],["dua","Bự vậy bắt về ngâm rượu đi {x}.","Bắt? {C} bắt đi, {x} đứng coi.",""]]],["hoi","{X} có sao hông? Rắn đó có độc hông?","Không sao, rắn nước thôi. Mà nhìn nó sợ thiệt.","Hỏi hoài, không sao. Rắn nước thôi.",[["le","Lần sau {x} đi đồng nhớ mang ủng nha.","Ờ, {c} lo cho {x} vậy là quý.",""],["viec","Để {c} dọn bờ cỏ cho {x}, rắn hết chỗ trốn.","Vậy {x} nhờ {c} luôn, cảm ơn trước.","nho"],["dua","Rắn nước thì nó chỉ muốn tắm chung với {x} thôi.","Ha ha, tắm một mình được rồi.",""]]],["ca","Ruộng {x} cỏ cao vậy rắn không ở mới lạ.","Cỏ cao tại {x} đau lưng, chứ ai muốn.","Nói ruộng {x} dơ hả? Cỏ cao tại {x} đau lưng chớ ai muốn.",[["viec","Để {c} phát cỏ giùm cho.","Vậy hả, vậy {x} cho {c} ít đồ.","tang"],["dua","Thì {x} nuôi rắn luôn, bán cho quán nhậu.","Ý hay mà {x} sợ rắn.",""],["ca","Đau lưng mà đi nhậu được.","Thôi đi về đi.",""]]]]},{"c":"chao","mo":"Thấy {c} hồi sáng chạy ngang đây, đi đâu mà vội vậy?","r":[["viec","Dạ, {c} chở hàng đi giao đơn cho kịp.","Siêng dữ. Bữa nào {x} gửi hàng {c} chở luôn, mà chạy chậm chút nghen.","Giao gì mà chạy như ăn cướp. Bữa nào {x} gửi hàng thì chạy chậm thôi nghen.",[["viec","Được, {x} có gì cần cứ gửi.","Vậy {x} nhờ {c} gom ít đồ.","nho"],["dua","Chạy chậm thì hàng tới nơi khách đói xỉu rồi.","Ha ha, khách gì yếu dữ.",""],["le","Dạ, lần sau {c} chạy chậm lại.","Ừ, đường xóm con nít chơi, coi chừng.",""]]],["dua","Dạ, {c} chạy trốn con chó nhà {x} đó.","Ha ha, con Vện nó hiền mà, sủa vậy thôi.","Chó nhà {x} hiền khô, nó sủa vậy thôi, ai mà sợ.",[["dua","Hiền mà nó rượt {c} ba vòng xóm.","Tại {c} chạy nên nó tưởng chơi.",""],["hoi","Con Vện bao nhiêu tuổi rồi {x}?","Mười tuổi rồi, tính theo tuổi chó là già hơn {x}.","ke"],["ca","Hiền mà nhe răng như muốn ăn thịt người.","Nó ghét người ăn nói như {c} đó.",""]]],["ca","Bộ {x} rảnh lắm hả, ngồi canh người ta đi đâu.","Già rồi không canh thì làm gì. Mà {c} ăn nói vậy hả?","Rảnh thì sao? Già rồi không canh người ta thì làm gì.",[["dua","Vậy {x} làm bảo vệ xóm luôn đi.","Ha ha, có lương hông?",""],["le","{C} giỡn chơi thôi {x}.","Ờ, giỡn vừa vừa.",""],["ca","Canh vậy chắc biết hết chuyện xóm ha.","Biết hết, kể cả chuyện {c} nợ tiền quán.",""]]]]},{"c":"chao","mo":"Trời ơi mấy đứa nhỏ trong xóm hái trộm xoài nhà {x} hoài.","r":[["hoi","Mất nhiều hông {x}?","Mất mấy chục trái, cây còn trơ cuống.","Mất nhiều thì {c} đền hả? Mấy chục trái chớ ít gì.",[["viec","{X} rào cái bờ tre lại, tụi nhỏ hết leo.","Ừ, mà {x} thiếu tre, {c} kiếm giùm.","nho"],["dua","Tụi nhỏ hái thì cho nó ăn đi {x}, tuổi thơ mà.","Tuổi thơ của nó là tuổi già của {x} đó.",""],["le","Để {c} nói ba má tụi nhỏ giùm {x}.","Ừ, có người nói giùm thì đỡ.",""]]],["dua","Hồi nhỏ {x} chắc cũng hái trộm xoài nhà người ta.","Ha ha, có, mà {x} hái lẹ hơn, không bị bắt.","Hồi nhỏ {x} ngoan lắm. Có hái thì… cũng hái lẹ, không bị bắt.",[["dua","Vậy {x} dạy tụi nhỏ hái cho chuyên nghiệp.","Ha ha, dạy rồi tụi nó hái sạch.",""],["khen","Xoài nhà {x} ngọt nhất xóm nên tụi nó mới mê.","Chớ sao. Cầm vài trái về ăn nè.","tang"],["ca","Hồi nhỏ hái trộm, giờ già thì giữ của.","Nói ai giữ của?",""]]],["viec","Để {c} làm con bù nhìn dựng dưới gốc cho tụi nhỏ sợ.","Ý hay! Làm cái mặt cho dữ dữ nghen.","Bù nhìn gì, tụi nó lớn rồi. Mà làm cái mặt dữ dữ thì may ra.",[["dua","Lấy cái áo cũ của {x} làm, tụi nó tưởng {x} đứng canh.","Ha ha, vậy chắc tụi nó sợ thiệt.",""],["viec","{X} kiếm cho {c} ít rơm với tre.","Được, mà {x} còn nhờ {c} chuyện nữa.","nho"],["ca","Thôi {x} ngồi đó canh luôn, khỏi bù nhìn.","{C} ngồi đi, {x} ngủ.",""]]]]},{"c":"chao","mo":"Giá lúa bữa nay lên đó {c}. Lên được có trăm đồng mà thương lái làm như ban ơn.","r":[["viec","Vậy mình gom lúa cả xóm bán chung cho được giá {x}.","Đó, ý hay. Có người đứng ra là {x} theo liền.","Gom chung rồi ai giữ tiền? {C} hả? Có người đứng ra đàng hoàng thì {x} mới theo.",[["viec","{C} đứng ra lo, {x} phụ gom đồ.","Được, vậy {x} nhờ {c} việc riêng này.","pq"],["dua","Thì {x} đứng ra luôn đi, thương lái thấy mặt {x} là hết dám ép giá.","Ha ha, đúng, {x} mà ra mặt thì tụi nó run.",""],["le","Dạ, mình bàn với xóm trước đã {x}.","Ừ, từ từ mà làm.",""]]],["ca","Thương lái là vậy mà, {x} còn lạ gì.","Biết mà vẫn tức. {C} không tức hả?","Biết rồi, nhắc làm gì cho thêm tức.",[["dua","Tức thì {x} nhậu cho quên.","Nhậu thì cũng tốn tiền, càng tức.",""],["viec","Mình phơi lúa thật khô là ép lại giá được.","Ừ, lúa khô bán được hơn thiệt. Mà {x} có mẹo phơi này nè.","ke"],["ca","Tức thì tự chở lên huyện bán.","Nói như đúng rồi, chở bằng gì?",""]]],["hoi","Năm nay nhà {x} được mùa hông?","Được, mà được mùa thì mất giá. Làm ruộng là vậy.","Được hay không thì cũng vậy. Được mùa thì mất giá.",[["le","Dạ, có gì cần {c} phụ thì {x} nói.","Có, {x} đang cần ít đồ.","nho"],["dua","Mất giá thì {x} nấu rượu bán.","Ha ha, nấu rượu xong uống hết thì lấy gì bán.",""],["khen","Mà ruộng {x} lúc nào cũng tốt nhất xóm.","Đó, {c} nói phải. Cầm ít gạo về nấu.","tang"]]]]},{"c":"chao","mo":"Nghe nói tối qua ông trưởng ấp nhậu xỉn té ao đó {c}.","r":[["dua","Ổng té ao chắc cá trong ao cũng say luôn.","Ha ha ha, cá say nổi lềnh bềnh hết.","Chuyện người ta, nói vậy coi chừng ổng nghe. Mà ao đó cá chắc cũng say thiệt.",[["dua","Vậy sáng nay ra vớt cá say đem nấu.","Ha ha, cá ướp rượu sẵn.",""],["hoi","Ổng có sao hông {x}?","Không sao, ổng bò lên ngủ luôn ở bờ ao.",""],["viec","Ao đó nên rào lại {x}, con nít lỡ té.","Ừ, {c} nói phải, {x} nhờ {c} rào giùm.","nho"]]],["hoi","Ổng có bị gì hông {x}?","Không, ướt như chuột lột thôi. Sáng nay còn đi họp.","Hỏi ổng làm gì. Ướt như chuột lột, sáng nay còn đi họp.",[["dua","Họp chắc ổng ngồi nhỏ nước.","Ha ha, nhỏ nước tong tong.",""],["le","Dạ, vậy là may rồi.","Ừ, may.",""],["ca","Trưởng ấp gì mà nhậu tới té ao.","Ờ, mà đừng nói to, ổng nghe.",""]]],["le","Dạ, chuyện người ta mình không nên nói {x}.","Ờ, {c} nói phải. Mà thôi, {x} kể {c} chuyện khác.","Ờ, đứng đắn quá ha. Vậy {x} kể chuyện khác.",[["hoi","Chuyện gì vậy {x}?","{X} kể nè, mà {c} đừng nói ai nghe.","ke"],["dua","Chuyện khác mà là chuyện ma thì thôi nha {x}, {c} sợ.","Ha ha, ma đâu, chuyện nhà {x} thôi.",""],["ca","Chuyện khác chắc cũng chuyện người ta.","Vậy thôi về đi.",""]]]]},{"c":"chao","mo":"Nhà {x} mới sửa cái bếp, nấu cơm không còn khói nữa.","r":[["khen","Bếp mới đẹp quá {x}, nấu ăn chắc ngon hơn.","Chớ sao, trưa nay {x} nấu cá kho, ở lại ăn.","Ngon dở là do người nấu. Mà trưa nay {x} kho cá, ở lại ăn thử thì biết.",[["khen","Cá kho {x} nấu là nhất rồi.","Ăn đi rồi biết, cầm về một tô nữa.","tang"],["dua","{C} ở lại ăn hết nồi luôn nha.","Ăn hết thì rửa nồi.",""],["ca","Bếp mới mà cá kho khét như bếp cũ thì sao.","Ăn hết rồi mới chê.",""]]],["viec","Bếp này tốn nhiều củi hông {x}?","Ít củi hơn, mà {x} vẫn thiếu củi, kiếm hoài không đủ.","Củi đóm gì, hỏi kỹ dữ. Ít củi hơn, mà {x} vẫn thiếu.",[["viec","Để {c} kiếm củi giùm.","Được, vậy {x} nhờ {c}.","nho"],["dua","Thiếu củi thì đốt bớt đồ cũ đi {x}.","Đồ cũ của {x} toàn đồ quý nha.",""],["hoi","{X} sửa bếp hết bao nhiêu vậy?","Có mấy trăm, mà đáng.",""]]],["dua","Hết khói thì muỗi nó về đầy nhà đó {x}.","Ha ha, đúng rồi, tối qua bị muỗi chích quá trời.","Muỗi thì có mùng, lo xa. Mà tối qua bị chích quá trời thiệt.",[["dua","Vậy {x} nấu cơm xong hun chút khói đuổi muỗi.","Ha ha, vậy sửa bếp làm chi.",""],["viec","Trồng vài bụi sả quanh nhà là muỗi chạy.","Ý hay, {x} mê sả lắm đó.","ke"],["ca","Muỗi chích chắc tại {x} ngọt.","Nói như đúng rồi.",""]]]]},{"c":"chao","mo":"Con trâu nhà {x} hồi sáng sổng chuồng chạy vô ruộng nhà {c}, có phá gì hông?","r":[["dua","Nó ăn có hai bụi lúa, chắc nó đói.","Ha ha, trâu nhà {x} biết chọn ruộng ngon.","Hai bụi cũng là lúa. Thôi {x} đền, đừng có kể công.",[["dua","Bữa sau {x} cho nó ăn sáng rồi hẵng thả.","Ha ha, được, {x} cho nó ăn no.",""],["le","Thôi không sao đâu {x}, hai bụi lúa mà.","Vậy hả, {x} cảm ơn, cầm ít đồ về.","tang"],["ca","Trâu gì mà hư như chủ.","Nói ai hư?",""]]],["viec","Dạ, nó giẫm hư một góc bờ, {x} phụ đắp lại nha.","Được, mai {x} qua đắp, mà {c} phụ đem đất.","Đắp thì {x} đắp, mà {c} cũng phải đem đất chớ.",[["viec","Được, {c} đem đất, {x} đem cuốc.","Ừ, vậy {x} nhờ {c} thêm chuyện này.","nho"],["dua","Cho con trâu đắp luôn {x}, nó làm hư thì nó sửa.","Ha ha, trâu biết đắp bờ thì {x} đã giàu.",""],["ca","{X} không đắp là {c} giữ trâu luôn.","Dám hông?",""]]],["hoi","Con trâu có bị gì hông {x}? Nó chạy dữ quá.","Không sao, nó khỏe re. Cảm ơn {c} hỏi.","Hỏi trâu mà không hỏi người. Trâu thì khỏe re.",[["hoi","Còn {x} có mệt hông, rượt trâu cả buổi.","Mệt muốn đứt hơi. Có {c} hỏi là đỡ.",""],["viec","Để {c} làm lại cái chốt chuồng chắc hơn.","Vậy {x} nhờ {c} luôn.","nho"],["dua","Trâu khỏe vậy cho nó đi chọi đi {x}.","Ha ha, chọi thì nó chạy mất.",""]]]]},{"c":"chao","mo":"{X} mới học được món mắm kho, mai {x} nấu thử, dám ăn hông?","r":[["dua","Dám chớ, {c} ăn xong mà còn sống là món ngon.","Ha ha, coi thường {x} quá.","Không ăn thì thôi, nói chi kỳ. Mai {x} nấu, dám thì qua.",[["dua","{C} ăn với hai chén cơm cho chắc.","Ba chén nha, mắm kho mà.","moi"],["khen","Món gì {x} nấu cũng ngon, mai {c} qua liền.","Đó, nói vậy {x} mới vui.",""],["ca","Mắm kho mà {x} nấu chắc mặn chát.","Không ăn thì đừng có chê.",""]]],["khen","{X} nấu ăn khéo nhất xóm, món gì cũng ngon.","Đó, có người biết khen. Mai qua ăn nha.","Khen để được ăn chớ gì. Thôi mai qua ăn.",[["khen","Mai {c} qua sớm phụ {x} nấu.","Được, mà {x} còn thiếu đồ, {c} kiếm giùm.","nho"],["hoi","Mắm kho nấu với rau gì {x}?","Rau đồng, bông điên điển, {x} mê nhất món này đó.","ke"],["dua","Ngon thì {x} mở quán luôn đi.","Mở quán thì {c} rửa chén.",""]]],["ca","Mắm kho mùi nồng lắm, hàng xóm than đó {x}.","Than thì than, ăn thì ai cũng xin.","Hàng xóm nào than? {C} hả? Than mà tới bữa ai cũng xin.",[["dua","Vậy {x} nấu xong mời hết xóm ăn cho hết than.","Ha ha, ý hay, mời luôn.","moi"],["le","{C} giỡn thôi, mai {c} qua ăn.","Ừ, qua đi.",""],["ca","{C} than đó, mà {c} cũng muốn ăn.","Muốn ăn mà than, kiểu gì vậy.",""]]]]},{"c":"chao","mo":"Đứa con gái {x} đòi lên thành phố làm công nhân, {x} rầu quá {c} ơi.","r":[["hoi","Nó đi rồi nhà còn ai phụ {x}?","Còn ai, còn {x} với con trâu thôi.","Thì còn {x} với con trâu, mắc gì {c} hỏi.",[["viec","Thiếu người thì {x} cứ kêu {c} phụ.","Vậy {x} nhờ {c} chuyện này luôn.","nho"],["dua","Con trâu siêng hơn người là được {x}.","Ha ha, trâu nó cũng biết mệt.",""],["le","{X} đừng buồn, nó lớn rồi để nó đi.","Ừ, {c} nói cũng phải.",""]]],["dua","Lên thành phố rồi chừng Tết nó về chở {x} đi chơi.","Ha ha, chở bằng xe gì, nó còn chưa có xe.","Đi chơi gì, nó đi là {x} cực. Mà nó có xe đâu mà chở.",[["dua","Thì nó chở bằng xe buýt.","Xe buýt chật như nêm, {x} chịu sao nổi.",""],["viec","Nó đi làm gửi tiền về là mua xe được thôi {x}.","Ừ, mà {x} vẫn lo. Cảm ơn {c}.",""],["khen","Con gái {x} giỏi, đi đâu cũng làm được.","Đó, nó giống {x}. Cầm ít trái cây về nè.","tang"]]],["ca","Thành phố có gì đâu mà mê, khói bụi muốn chết.","Đó, {x} nói vậy mà nó đâu có nghe.","Nói vậy rồi sao, {c} khuyên nó giùm hả? Nó có nghe {x} đâu.",[["le","Để bữa nào {c} nói chuyện với nó.","Ừ, có người nói giùm thì {x} mừng.",""],["dua","Cho nó đi một tháng, hít bụi đã là về.","Ha ha, chắc vậy thiệt.",""],["ca","Chắc ở nhà {x} cằn nhằn quá nên nó muốn đi.","Về đi.",""]]]]},{"c":"lai","mo":"Ủa, lại ghé nữa hả? Bộ nhà {c} hết gạo nấu hả?","r":[["dua","Dạ, nhà {c} hết chuyện nói nên qua nói với {x}.","Ha ha, vậy ngồi đi, {x} cũng đang rảnh.","Hết chuyện thì về ngủ. Mà thôi, ngồi đi, {x} cũng đang rảnh.",[["hoi","{X} rảnh thì kể {c} nghe chuyện xóm.","Chuyện xóm thì nhiều, mà nghe nè.","ke"],["dua","Rảnh thì mình ngồi đếm muỗi.","Ha ha, đếm tới trăm rồi đó.",""],["viec","Rảnh thì {x} có cần phụ gì hông?","Có chớ, {x} đang cần nè.","nho"]]],["le","Dạ, {c} quên hỏi {x} chuyện hồi sáng.","Chuyện gì, nói đi.","Hỏi gì hỏi lẹ, {x} sắp nấu cơm.",[["viec","Hồi sáng {x} nói cần đồ, giờ còn cần hông?","Còn chớ, {x} nhờ {c} nha.","nho"],["hoi","Dạ, {x} ăn cơm chưa mà mặt mệt vậy?","Chưa, đói muốn xỉu. Bộ {c} mời hả?",""],["dua","Dạ… đi tới đây quên mất tiêu rồi.","Ha ha, đi tới đây mới quên.",""]]],["ca","Bộ {x} không muốn {c} ghé hả?","Muốn chớ, mà ghé hoài thì {x} hết đồ đãi.","Ghé hoài thì người ta nói, {x} cũng hết đồ đãi.",[["dua","Khỏi đãi, {c} ngồi chơi thôi.","Vậy ngồi đi, ngồi ghế đó, ghế này gãy.",""],["le","Dạ, vậy {c} ghé chút rồi về.","Ừ, vậy cũng được.",""],["ca","Người ta nói thì kệ người ta.","Nói nghe dễ ghê.",""]]]]},{"c":"lai","mo":"Lại là {c}. Ghé lần này là lần thứ mấy rồi, {x} tính tiền ghế ngồi à nha.","r":[["dua","Tiền ghế {x} ghi sổ, cuối năm {c} trả bằng lúa.","Ha ha, ghi rồi, nợ chồng chất rồi đó.","Ghi sổ thì ghi, {x} tính thiệt đó. Nợ chồng chất rồi.",[["dua","Nợ nhiều thì {c} ở lại làm công trả nợ.","Được, vậy làm giùm {x} việc này.","nho"],["viec","Mà {x} có cần lúa thiệt hông?","Cần chớ, đổi đi, {x} cho lại đồ khác.","tang"],["ca","{X} tính toán quá trời.","Không tính sao giàu.",""]]],["hoi","Dạ, {c} ghé coi {x} nghỉ trưa chưa.","Chưa, đang tính nằm thì {c} tới.","Đang tính nằm thì bị {c} tới, vui ghê.",[["le","Vậy {c} về cho {x} nghỉ.","Thôi ngồi chút đi, {x} kể chuyện này.","ke"],["dua","{C} ngồi quạt cho {x} ngủ luôn.","Ha ha, có người quạt thì sướng.",""],["ca","Ngủ hoài vậy {x}?","Già rồi ngủ là chuyện thường.",""]]],["viec","Dạ, {c} ghé hỏi {x} có gì nhờ hông.","Có chớ, đang tính kêu {c} đây.","Nhờ gì… mà thôi, cũng đang tính kêu {c}.",[["viec","Gì cũng được, {c} làm liền.","Vậy {x} nhờ {c} nè.","nho"],["dua","Nhờ ăn cơm giùm thì {c} rành nhất.","Ha ha, mấy cái đó thì {c} giỏi.",""],["le","Dạ, vậy {x} cứ từ từ nghĩ, có gì kêu {c}.","Ừ, có gì {x} kêu.",""]]]]},{"c":"lai","mo":"Ghé nữa hả? Coi bộ ở nhà {c} buồn lắm.","r":[["dua","Dạ, ở nhà nói chuyện với con gà mà nó không thèm trả lời.","Ha ha, ít ra {x} còn biết trả lời.","Gà không trả lời thì qua đây bắt {x} trả lời hả?",[["dua","Dạ, {x} trả lời hay hơn con gà nhiều.","Ha ha, so {x} với con gà. Thôi ngồi đi.",""],["hoi","Vậy {x} kể {c} nghe chuyện gì vui đi.","Chuyện vui hả, nghe nè.","ke"],["le","Dạ, {c} qua ngồi chút cho có người nói chuyện.","Ờ, ngồi đi, {x} cũng buồn.",""]]],["hoi","Dạ, {c} ghé coi {x} có cần gì thêm hông.","Có đó, đang thiếu chút đồ.","Ghé hoài để hỏi câu đó. Ờ thì cũng đang thiếu chút đồ.",[["viec","Thiếu gì {x} nói {c} đi kiếm.","Vậy {x} nhờ {c} nè.","nho"],["dua","Thiếu tiền thì {c} cũng thiếu.","Ha ha, vậy thôi khỏi.",""],["le","Dạ, cần gì {x} cứ kêu {c}.","Ừ, có gì {x} kêu.",""]]],["ca","Bộ nhà {x} vui lắm hả mà {c} không ghé được?","Vui chớ, có con chó với con mèo.","Bắt bẻ hả? Vui chớ, có con chó với con mèo, đỡ hơn {c}.",[["dua","Vậy {c} ghé chơi với con mèo.","Mèo nó khó tính lắm đó.",""],["le","{C} giỡn thôi, nhà {x} vui mà.","Ừ, giỡn vậy được.",""],["ca","Chó mèo mà vui gì.","Vậy về đi.",""]]]]},{"c":"lai","mo":"Mới đi đó đã quay lại, bộ để quên cái gì hả?","r":[["dua","Dạ, để quên cái bụng đói ở đây.","Ha ha, vô lấy chén cơm nguội nè.","Đói thì về nhà nấu. Còn chén cơm nguội đó, ăn thì ăn.",[["dua","Cơm nguội với mắm là ngon nhất.","Đó, biết ăn. Cầm về ít mắm nữa nè.","tang"],["le","Dạ, {c} giỡn, {c} ăn rồi.","Ờ, vậy ngồi chơi.",""],["ca","Cơm nguội thì thôi {c} nhịn.","Kén ăn dữ.",""]]],["viec","Dạ, quên hỏi {x} có muốn {c} mang gì qua hông.","Có, {x} cần nè.","Cần gì {x} tự kiếm… mà thôi, cũng đang cần chút đồ.",[["viec","{X} cứ nói, {c} kiếm.","Vậy nhờ {c} nha.","nho"],["hoi","Mà {x} thích ăn gì nhất?","À, {x} mê món này nhất.","ke"],["dua","Mang con gà qua nhậu được hông?","Ha ha, nhậu thì tối nha.",""]]],["le","Dạ, quên chào {x} cho đàng hoàng.","Trời, lễ phép dữ, chào rồi đó thôi.","Chào gì chào hoài, chào rồi đó thôi.",[["dua","Chào hai lần cho chắc.","Ha ha, ba lần đi cho đủ bộ.",""],["le","Dạ, chào {x} rồi {c} về, {x} giữ sức khỏe nha.","Ừ, {c} cũng vậy.",""],["ca","Chào mà {x} không chào lại.","Chào chào chào, được chưa.",""]]]]},{"c":"lai","mo":"Trời, {c} lại tới. Chắc {c} thương {x} rồi đó.","r":[["dua","Dạ, thương nhà {x} có nồi cơm ngon.","Ha ha, thương cơm chớ thương ai.","Thương cơm chớ thương ai, biết mà.",[["dua","Thương luôn người nấu.","Ha ha, miệng dẻo. Cầm ít bánh về ăn.","tang"],["le","Dạ, thương {x} thiệt mà.","Ờ, vậy được.",""],["ca","Cơm nhà {x} cũng thường.","Thường mà ăn ba chén.",""]]],["khen","Dạ, nhà {x} vui nhất xóm nên {c} ghé hoài.","Đó, nói phải. Ngồi đi.","Vui gì, nhà {x} buồn hiu.",[["khen","Có {x} là vui rồi.","Trời, nghe sướng lỗ tai.",""],["hoi","Bữa nay {x} có chuyện gì vui hông?","Có, nghe