; Engine configuration file.
config_version=5

[application]
config/name="Nong Trai Godot thu lang"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")

[display]
window/size/viewport_width=1280
window/size/viewport_height=800
window/dpi/allow_hidpi=true
window/stretch/mode="disabled"
window/vsync/vsync_mode=1

[input_devices]
pointing/emulate_mouse_from_touch=false
pointing/emulate_touch_from_mouse=false

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
textures/vram_compression/import_s3tc_bptc=true
textures/canvas_textures/default_texture_filter=1
environment/defaults/default_clear_color=Color(0.5, 0.6, 0.35, 1)
2d/snap/snap_2d_transforms_to_pixel=false
